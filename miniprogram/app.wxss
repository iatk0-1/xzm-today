/**app.wxss**/
.order-promotion-value { display: flex; align-items: center; gap: 14rpx; }
.order-promotion-arrow { display: inline-block; color: #999; font-size: 26rpx; transition: transform .15s; }
.order-promotion-arrow.expanded { transform: rotate(90deg); }
.order-promotion-details { padding: 6rpx 20rpx; border-radius: 8rpx; background: #fafafa; }
.order-promotion-detail-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 12rpx 0; font-size: 24rpx; color: #888; }
.order-promotion-detail-amount { color: #c14534; white-space: nowrap; }
.order-promotion-empty { padding: 16rpx 0; color: #999; font-size: 24rpx; }
.order-item-price-pair { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; min-width: 0; }
.order-item-original-price { font-size: 22rpx; font-weight: 400; color: #999; }

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.message-tab-label { position: relative; }
.message-tab-badge {
  position: absolute; top: -18rpx; left: 100%; margin-left: 2rpx;
  min-width: 28rpx; height: 28rpx; padding: 0 5rpx;
  border-radius: 18rpx; box-sizing: border-box;
  background: #ed4545; color: #fff; text-align: center;
  font-size: 18rpx; font-weight: 500; line-height: 28rpx;
}
