<view class="sku-mask {{showSku ? 'fade-in' : ''}}" wx:if="{{showSku}}" capture-bind:touchstart="onSkuQuantityTouchStart" catchtap="closeSkuPanel"></view>

<view class="sku-panel {{showSku ? 'slide-up' : ''}} {{skuDetailMode ? 'sku-panel-detail' : ''}}" wx:if="{{showSku}}" capture-bind:touchstart="onSkuQuantityTouchStart" bindtap="onSkuPanelTap">
  <view class="sku-close" catchtap="closeSkuPanel">×</view>

  <view class="sku-header {{!promotionOffers.length ? 'without-promotions' : ''}}" wx:if="{{currentProduct}}">
    <view class="sku-image-column">
      <view class="sku-img-wrap">
        <image class="sku-img" src="{{skuPanelImagePaths[currentSkuImage || currentProduct.coverUrl || currentProduct.image] || imagePaths[currentSkuImage || currentProduct.coverUrl || currentProduct.image] || currentSkuImage || currentProduct.coverUrl || currentProduct.image}}" mode="aspectFill" catchtap="previewSkuPanelImage" binderror="onSkuPanelImageError" data-url="{{currentSkuImage || currentProduct.coverUrl || currentProduct.image}}"></image>
        <view class="sold-out-overlay sku-sold-out-overlay" wx:if="{{currentSkuId ? currentSkuSoldOut : currentProduct.soldOut}}"><text>售罄</text></view>
      </view>
    </view>
    <view class="sku-main">
      <view class="sku-summary-slot">
        <scroll-view class="sku-price-scroll" scroll-x show-scrollbar="{{false}}">
          <view class="sku-price {{pickedHasDiscount ? 'has-discount' : ''}}">
            <text wx:if="{{pickedTotalCount > 0}}">￥{{skuMoneyText.pickedGoodsPrice}}</text>
            <text wx:elif="{{bundleSelections.length === 0}}">￥{{currentSkuOriginalPriceText}}</text>
            <text wx:else>{{bundlePriceRange}}</text>
            <block wx:if="{{pickedHasDiscount}}">
              <view class="sku-before-total"><text>￥{{skuMoneyText.pickedOriginalPrice}}</text><view class="sku-price-strike"></view></view>
            </block>
            <text class="sku-average-price {{pickedHasDiscount ? 'active' : ''}}" wx:if="{{pickedTotalCount > 1}}">￥{{skuMoneyText.pickedAverageUnitPrice}}/件</text>
          </view>
        </scroll-view>
      </view>
      <view class="sku-summary-slot">
        <view class="sku-stock sku-stock-low" wx:if="{{bundleSelections.length === 0 && currentSkuFreeStockQty > 0}}">现货：{{currentSkuFreeStockQty}}件</view>
        <view class="sku-stock sku-stock-low" wx:elif="{{bundleSelections.length === 0 && !currentSkuUnlimited && currentSkuStock != null && currentSkuStock <= 3}}">库存：仅剩{{currentSkuStock}}件</view>
        <view class="sku-stock" wx:elif="{{bundleSelections.length === 0 && (isAdmin || isStallManager) && currentSkuStock != null}}">库存：{{currentSkuStockText}}</view>
      </view>
      <view class="sku-summary-slot">
        <view class="sku-meta-row" wx:if="{{bundleSelections.length === 0}}">
          <view class="sku-choose-tip">已选：{{selectedColor || '颜色'}} / {{selectedSize || '尺码'}}</view>
          <view class="sku-quantity">
            <view class="sku-quantity-control">
              <view class="sku-quantity-btn {{quantity <= 0 ? 'disabled' : ''}}" catchtap="skuQuantityMinus">-</view>
              <input id="sku-quantity-input" class="sku-quantity-input" type="number" value="{{quantity}}" hold-keyboard="{{true}}" bindfocus="skuQuantityInputFocus" bindinput="skuQuantityInput" bindblur="skuQuantityInputBlur" />
              <view class="sku-quantity-btn {{!currentSkuUnlimited && currentSkuStock !== null && currentSkuStock <= quantity ? 'disabled' : ''}}" catchtap="skuQuantityPlus">+</view>
            </view>
          </view>
        </view>
        <view class="sku-choose-tip" wx:else>已选：{{bundleNamesStr}}</view>
      </view>
    </view>
  </view>

  <view class="sku-discount-entry" wx:if="{{promotionOffers.length}}" catchtap="openSkuPromotions">
    <view class="sku-discount-label">
      <view class="sku-title">优惠</view>
      <view class="sku-discount-question" catchtap="openSkuPromotions" aria-label="查看优惠规则">?</view>
    </view>
    <text class="sku-discount-entry-amount" wx:if="{{pickedHasDiscount}}">-{{skuMoneyText.pickedDiscountPrice}}元</text>
  </view>
  <view class="sku-promotion-message" wx:if="{{promotionOffersError}}" catchtap="loadSkuPromotions">优惠信息加载失败，点击重试</view>
  <view class="sku-promotion-message" wx:elif="{{skuQuoteError}}" catchtap="retrySkuPromotionQuote">优惠计算失败，点击重试</view>

  <!-- 套装商品子项选择 -->
  <scroll-view class="sku-options-scroll" scroll-y style="max-height: 55vh; padding: 0 16rpx; padding-bottom: 0rpx;" wx:if="{{bundleSelections.length > 0}}">
    <view class="bundle-group-card {{sel.isOutOfStock ? 'out-of-stock-card' : ''}}" wx:for="{{bundleSelections}}" wx:key="index" wx:for-item="sel" wx:for-index="bgIdx">

      <image class="bundle-card-img" src="{{skuPanelImagePaths[sel.selectedSku.imageUrl || sel.skus[0].imageUrl || currentProduct.coverUrl] || imagePaths[sel.selectedSku.imageUrl || sel.skus[0].imageUrl || currentProduct.coverUrl] || sel.selectedSku.imageUrl || sel.skus[0].imageUrl || currentProduct.coverUrl}}" mode="aspectFill" bindtap="previewBundleImage" binderror="onSkuPanelImageError" data-url="{{sel.selectedSku.imageUrl || sel.skus[0].imageUrl || currentProduct.coverUrl}}"></image>

      <view class="bundle-card-right">
        <view class="bundle-card-header">
          <view class="bundle-card-title">
            <text class="bg-step">{{bgIdx + 1}}</text>
            <text>{{sel.bundleGroupName}}</text>
          </view>
        </view>

        <view class="bundle-card-specs" wx:if="{{sel.uniqueColors.length > 0}}">
          <text class="spec-label">颜色</text>
          <view class="sku-options minimal">
            <view class="sku-tag minimal {{sel.selectedColor === item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}" wx:for="{{sel.colorOptions}}" wx:key="value" wx:for-item="item" bindtap="selectBundleColor" data-index="{{bgIdx}}" data-color="{{item.value}}"><block wx:if="{{skuDetailMode}}"><text class="sku-tag-measure" aria-hidden="true">{{item.value}}</text><view class="sku-tag-label"><text>{{item.value}}</text></view></block><text wx:else>{{item.value}}</text><text class="sku-ready-stock-badge" wx:if="{{item.hasReadyStock}}">现货</text><text class="sku-count-badge" wx:if="{{item.showPickedCount && item.pickedCount > 0}}">{{item.pickedCountText}}</text></view>
          </view>
        </view>

        <view class="bundle-card-specs" wx:if="{{sel.uniqueSizes.length > 0}}">
          <text class="spec-label">尺码</text>
          <view class="sku-options minimal">
            <view class="sku-tag minimal {{sel.selectedSize === item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}" wx:for="{{sel.sizeOptions}}" wx:key="value" wx:for-item="item" bindtap="selectBundleSize" data-index="{{bgIdx}}" data-size="{{item.value}}"><block wx:if="{{skuDetailMode}}"><text class="sku-tag-measure" aria-hidden="true">{{item.value}}</text><view class="sku-tag-label"><text>{{item.value}}</text></view></block><text wx:else>{{item.value}}</text><text class="sku-ready-stock-badge" wx:if="{{item.hasReadyStock}}">现货</text><text class="sku-count-badge" wx:if="{{item.showPickedCount && item.pickedCount > 0}}">{{item.pickedCountText}}</text></view>
          </view>
        </view>

        <view class="sku-stock sku-stock-low" wx:if="{{sel.selectedSku.freeStockQty > 0}}">现货：{{sel.selectedSku.freeStockQty}}件</view>

        <view class="bundle-card-footer">
          <view class="bundle-sku-price" style="color: #1a1a1a;">
            <block wx:if="{{sel.promotionPrice.discounted}}">￥{{sel.promotionPrice.unitPriceDisplay}}<text class="sku-original-price">￥{{sel.originalPriceDisplay}}</text></block>
            <block wx:else>￥{{sel.originalPriceDisplay}}</block>
          </view>
          <view class="stepper" wx:if="{{sel.selectedSku}}">
            <view class="step-btn {{sel.quantity <= 0 ? 'disabled' : ''}}" catchtap="bundleMinus" data-index="{{bgIdx}}">-</view>
            <input id="bundle-quantity-{{bgIdx}}" class="step-input" type="number" value="{{sel.quantity}}" hold-keyboard="{{true}}" bindfocus="skuQuantityInputFocus" bindinput="bundleInput" bindblur="bundleInputBlur" data-index="{{bgIdx}}" />
            <view class="step-btn {{(!sel.selectedSku.unlimitedStock && sel.quantity >= sel.selectedSku.stock) ? 'disabled' : ''}}" catchtap="bundlePlus" data-index="{{bgIdx}}">+</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 普通商品颜色/尺码选择 -->
  <scroll-view class="sku-options-scroll" scroll-y style="max-height: 50vh;" wx:else>
    <view class="sku-section" wx:if="{{uniqueColors.length > 0}}">
      <view class="sku-title">颜色</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedColor === item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}" wx:for="{{colorOptions}}" wx:key="value" bindtap="selectColor" data-color="{{item.value}}"><block wx:if="{{skuDetailMode}}"><text class="sku-tag-measure" aria-hidden="true">{{item.value}}</text><view class="sku-tag-label"><text>{{item.value}}</text></view></block><text wx:else>{{item.value}}</text><text class="sku-ready-stock-badge" wx:if="{{item.hasReadyStock}}">现货</text><text class="sku-count-badge" wx:if="{{item.showPickedCount && item.pickedCount > 0}}">{{item.pickedCountText}}</text></view>
      </view>
    </view>

    <view class="sku-section" wx:if="{{uniqueSizes.length > 0}}">
      <view class="sku-title">尺码</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedSize === item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}" wx:for="{{sizeOptions}}" wx:key="value" bindtap="selectSize" data-size="{{item.value}}"><block wx:if="{{skuDetailMode}}"><text class="sku-tag-measure" aria-hidden="true">{{item.value}}</text><view class="sku-tag-label"><text>{{item.value}}</text></view></block><text wx:else>{{item.value}}</text><text class="sku-ready-stock-badge" wx:if="{{item.hasReadyStock}}">现货</text><text class="sku-count-badge" wx:if="{{item.showPickedCount && item.pickedCount > 0}}">{{item.pickedCountText}}</text></view>
      </view>
    </view>
  </scroll-view>

  <view class="sku-purchase-footer {{showPickedSkus ? 'has-picked-list' : ''}}">
    <include src="./skuSelectedList.wxml" />
    <block wx:if="{{!pickedTotalCount && currentSkuStock <= 0 && currentSkuStock !== null && !currentSkuUnlimited && !bundleSelections.length}}">
      <include src="./skuSelectionSummary.wxml" />
      <view class="sku-actions-new sku-footer-action">
        <view class="sku-btn-item sold-out">已售罄</view>
      </view>
    </block>
    <block wx:else>
      <view class="sku-footer-left">
        <include src="./skuSelectionSummary.wxml" />
        <view class="sku-actions-new sku-footer-action {{purchasePending ? 'sku-picked-busy' : ''}}">
          <view class="sku-btn-item cart" catchtap="confirmAddToCart" data-action="cart">加入购物车</view>
        </view>
      </view>
      <view class="sku-actions-new sku-footer-action {{purchasePending ? 'sku-picked-busy' : ''}}">
        <view class="sku-btn-item buy" catchtap="confirmAddToCart" data-action="buy">立即购买</view>
      </view>
    </block>
  </view>
  <include src="./skuPromotionDetails.wxml" />
</view>
