.sku-tag { position: relative; overflow: visible; min-width: 96rpx; box-sizing: border-box; text-align: center; }
/* 为左右两个角标预留宽度，角标绝对定位，不参与标签的文字布局。 */
.sku-ready-stock-badge { position: absolute; left: 0; top: -16rpx; height: 26rpx; line-height: 26rpx; padding: 0 6rpx; border: 0; box-sizing: border-box; border-radius: 14rpx; background: #1a1a1a; color: #ffffff; font-size: 18rpx; font-weight: 500; white-space: nowrap; pointer-events: none; z-index: 1; }
.sku-panel .sku-options.minimal { row-gap: 20rpx; }
.sku-panel .bundle-card-specs { margin-bottom: 20rpx; }
.sku-options-scroll { min-height: 0; flex-shrink: 1; }
.sku-purchase-footer { position: relative; display: flex; align-items: center; gap: 20rpx; flex-shrink: 0; z-index: 3; background: #fff; border-top: 1rpx solid #eee; padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom)); }
.sku-purchase-footer.has-picked-list { border-top-color: transparent; }
.sku-actions-new.sku-footer-action { flex: 1; min-width: 0; padding: 0; }
/* 同一排按钮共用半高圆角，避免窄按钮沿用旧圆角后由渲染器自行缩放。 */
.sku-purchase-footer .sku-btn-item { height: 80rpx; line-height: 80rpx; font-size: 28rpx; border-radius: 40rpx; }
.sku-footer-left { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.sku-picked-summary, .sku-actions-new { flex-shrink: 0; }
.sku-count-badge {
  position: absolute;
  right: -10rpx;
  top: -12rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #d32f2f;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 30rpx;
  text-align: center;
  white-space: nowrap;
  z-index: 1;
}
.sku-picked-summary { display: flex; align-items: center; flex: 0 0 112rpx; min-width: 0; }
.sku-picked-summary .sku-picked-entry { position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; white-space: nowrap; }
.sku-picked-busy { opacity: .6; pointer-events: none; }
.sku-picked-mask { position: absolute; left: -40rpx; right: -40rpx; bottom: 100%; height: 100vh; background: rgba(0,0,0,.45); z-index: 1; }
.sku-picked-panel { position: absolute; left: -40rpx; right: -40rpx; bottom: 100%; box-sizing: border-box; max-height: calc(92vh - 240rpx - env(safe-area-inset-bottom)); display: flex; flex-direction: column; padding: 28rpx 32rpx 24rpx; background: #fff; border-radius: 28rpx 28rpx 0 0; z-index: 2; }
.sku-picked-panel::after { content: ''; position: absolute; left: 32rpx; right: 32rpx; bottom: 0; border-top: 1rpx solid #eee; pointer-events: none; }
.sku-picked-heading { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; min-height: 56rpx; line-height: 1.2; font-size: 30rpx; font-weight: 600; padding-bottom: 22rpx; }
.sku-picked-close { display: flex; align-items: center; justify-content: flex-end; height: 56rpx; line-height: 1; font-size: 42rpx; font-weight: 400; color: #999; width: 60rpx; }
.sku-picked-heading-actions { display: flex; align-items: center; height: 56rpx; gap: 16rpx; }
.sku-picked-clear { display: flex; align-items: center; height: 56rpx; line-height: 1; color: #999; font-size: 24rpx; font-weight: 400; padding-left: 20rpx; }
.sku-picked-scroll { max-height: 48vh; min-height: 0; flex-shrink: 1; }
.sku-picked-empty { padding: 60rpx 20rpx; font-size: 26rpx; text-align: center; color: #999; }
.sku-picked-row { display: flex; gap: 22rpx; padding: 24rpx 0; border-top: 1rpx solid #f0f0f0; }
.sku-picked-image { width: 132rpx; height: 132rpx; border-radius: 10rpx; flex-shrink: 0; background: #f5f5f5; }
.sku-picked-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.sku-picked-group { font-size: 24rpx; color: #999; margin-bottom: 5rpx; }
.sku-picked-spec { font-size: 26rpx; color: #333; word-break: break-all; }
.sku-picked-spec-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 48rpx; }
.sku-picked-spec-row .sku-picked-spec { flex: 1; min-width: 0; }
.sku-picked-spec-row .sku-quantity-control { flex-shrink: 0; }
.sku-picked-item-bottom { display: flex; align-items: baseline; gap: 12rpx; margin-top: 12rpx; }
.sku-picked-unit-price { font-size: 28rpx; color: #1a1a1a; font-weight: 600; }
.sku-picked-unit-price.active { color: #d32f2f; }
.sku-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; }
.sku-original-price { font-size: 23rpx; color: #999; font-weight: 400; margin-left: 10rpx; }
.sku-amount-row { display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; color: #999; padding: 10rpx 0; }
.sku-discount-amount { color: #999; }
.sku-discount-amount.active { color: #d32f2f; }
.sku-picked-amounts { flex-shrink: 0; border-top: 1rpx solid #eee; margin-top: 12rpx; padding-top: 12rpx; }
.sku-promotion-message { color: #999; font-size: 23rpx; padding: 14rpx 0; }
.sku-promotion-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.4); border-radius: inherit; z-index: 20; }
.sku-promotion-panel { position: absolute; left: 0; right: 0; bottom: 0; max-height: 80%; box-sizing: border-box; display: flex; flex-direction: column; padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 28rpx 28rpx 0 0; z-index: 21; }
.sku-promotion-scroll { max-height: 50vh; min-height: 0; }
.sku-promotion-offer { padding: 22rpx 0; border-top: 1rpx solid #f0f0f0; }
.sku-promotion-title { display: flex; align-items: center; gap: 16rpx; font-size: 28rpx; color: #333; font-weight: 600; }
.sku-promotion-status { background: #f2f2f2; color: #999; font-size: 22rpx; font-weight: 400; border-radius: 6rpx; padding: 4rpx 10rpx; }
.sku-promotion-rule { font-size: 26rpx; color: #666; line-height: 1.8; margin-top: 8rpx; }
.sku-picked-footer { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; border-top: 1rpx solid #eee; padding-top: 26rpx; margin-top: 20rpx; color: #666; font-size: 26rpx; }
.sku-picked-total { color: #1a1a1a; font-size: 34rpx; font-weight: 700; margin-left: 10rpx; }
.sku-picked-savings, .sku-picked-final, .sku-picked-saving-amount { color: #1a1a1a; }
.sku-picked-final { margin-left: auto; }
.sku-picked-total.active, .sku-picked-saving-amount.active { color: #d32f2f; }
.embedded-detail .sku-picked-panel .sku-picked-scroll { max-height: 44vh !important; }
