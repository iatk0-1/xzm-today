.collapsible-toolbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 500;
  padding: 16rpx 16rpx 0;
  background: #f6f7f9;
  box-sizing: border-box;
}
.collapsible-toolbar-space { width: 100%; flex-shrink: 0; }
.collapsible-panel { overflow: hidden; flex-shrink: 0; }
.collapsible-panel.is-expanded { overflow: visible; }
.collapsible-panel.is-collapsed { pointer-events: none; }
.collapsible-panel-content { display: flex; flex-direction: column; width: 100%; box-sizing: border-box; }
