.nav-back {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  background: rgba(255,255,255,.8);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(5px);
  box-shadow: 0 2px 6px rgba(0,0,0,.05);
  pointer-events: auto;
}
.back-arrow {
  width: 10px;
  height: 10px;
  border-top: 2px solid #333;
  border-left: 2px solid #333;
  transform: rotate(-45deg);
  margin-left: 4px;
}
