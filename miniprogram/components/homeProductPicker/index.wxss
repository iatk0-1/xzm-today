.picker-mask { position: fixed; inset: 0; z-index: 3000; background: rgba(0,0,0,.45); display: flex; align-items: flex-end; }
.picker-sheet { width: 100%; height: 88vh; background: #f8f9fa; border-radius: 28rpx 28rpx 0 0; display: flex; flex-direction: column; overflow: hidden; color: #222; }
.picker-header { padding: 26rpx 30rpx 14rpx; display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 600; }
.picker-close { width: 64rpx; text-align: right; font-size: 48rpx; line-height: 48rpx; }
.picker-search { margin: 10rpx 24rpx 18rpx; padding: 16rpx 20rpx; background: #fff; border-radius: 14rpx; display: flex; gap: 20rpx; font-size: 26rpx; }
.picker-search input { flex: 1; min-width: 0; }
.picker-status { width: 100%; }
.picker-inline { display: flex; align-items: center; width: max-content; padding: 0 12rpx; }
.picker-tag { flex-shrink: 0; padding: 10rpx 18rpx; margin: 4rpx; border-radius: 10rpx; font-size: 24rpx; color: #777; white-space: nowrap; }
.picker-tag.active { background: #222; color: #fff; }
.picker-filter { display: flex; align-items: center; padding: 2rpx 20rpx; font-size: 24rpx; }
.picker-filter > text { flex-shrink: 0; color: #777; margin-right: 8rpx; }
.picker-filter scroll-view { flex: 1; min-width: 0; width: 0; }
.picker-products { flex: 1; height: 0; min-height: 0; margin-top: 14rpx; }
.picker-product { margin: 0 24rpx 14rpx; padding: 18rpx; display: flex; align-items: center; gap: 18rpx; background: #fff; border-radius: 16rpx; }
.picker-product.existing { opacity: .45; }
.picker-check { width: 36rpx; height: 36rpx; border: 2rpx solid #ccc; border-radius: 50%; flex-shrink: 0; text-align: center; line-height: 36rpx; color: #fff; font-size: 24rpx; }
.picker-check.checked { background: #222; border-color: #222; }
.picker-image { width: 112rpx; height: 112rpx; border-radius: 10rpx; flex-shrink: 0; background: #eee; }
.picker-info { flex: 1; min-width: 0; }
.picker-name { font-size: 28rpx; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.picker-article { margin-top: 12rpx; font-size: 24rpx; color: #999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-empty, .picker-error { text-align: center; padding: 40rpx 20rpx; font-size: 26rpx; color: #999; }
.picker-error { color: #b42318; }
.picker-footer { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; font-size: 26rpx; }
.picker-footer button { margin: 0; background: #222; color: #fff; font-size: 26rpx; border-radius: 12rpx; padding: 0 40rpx; }
.picker-footer button[disabled] { background: #ddd; color: #999; }
