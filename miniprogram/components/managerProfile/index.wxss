:host { display: block; min-width: 0; }
.profile { display: flex; align-items: center; min-width: 0; gap: 16rpx; }
.avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #eef1f4; flex-shrink: 0; }
.info { flex: 1; min-width: 0; }
.nickname { color: #1f2933; font-size: 27rpx; line-height: 36rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.phone { color: #7b858f; font-size: 23rpx; line-height: 32rpx; white-space: nowrap; }
.compact { gap: 6px; }
.compact .avatar { width: 28px; height: 28px; }
.compact .nickname { font-size: 11px; line-height: 15px; }
.compact .phone { font-size: 10px; line-height: 14px; }
