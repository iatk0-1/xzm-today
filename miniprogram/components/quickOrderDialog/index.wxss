.quick-mask{position:fixed;inset:0;z-index:2400;background:rgba(0,0,0,.42);display:flex;align-items:center;justify-content:center;padding:36rpx;box-sizing:border-box}.quick-dialog{width:100%;max-width:650rpx;max-height:85vh;overflow-y:auto;background:#fff;border-radius:28rpx;padding:36rpx;box-sizing:border-box}.quick-title{font-size:36rpx;font-weight:600;margin-bottom:24rpx}.quick-row{display:flex;align-items:center;border-bottom:1rpx solid #eee;padding:22rpx 0;font-size:28rpx}.quick-row>text{width:145rpx;flex-shrink:0}.quick-row input{flex:1;min-width:0}.quick-label{margin:28rpx 0 18rpx;font-size:28rpx}.quick-label text{color:#999;font-size:24rpx;margin-left:15rpx}.quick-images{display:flex;flex-wrap:wrap;gap:16rpx}.quick-image,.quick-add{position:relative;width:calc((100% - 32rpx)/3);aspect-ratio:1;border-radius:12rpx;overflow:hidden}.quick-image image{width:100%;height:100%}.quick-add{display:flex;align-items:center;justify-content:center;background:#f4f4f4;color:#999;font-size:48rpx}.quick-remove{position:absolute;top:0;right:0;background:rgba(0,0,0,.6);color:white;width:40rpx;height:40rpx;line-height:36rpx;text-align:center}.quick-prices{display:flex;gap:24rpx;margin:28rpx 0;font-size:26rpx}.quick-prices>view{flex:1;min-width:0}.quick-prices input{border:1rpx solid #ddd;border-radius:12rpx;padding:20rpx 16rpx;margin-top:14rpx}.quick-hint{font-size:23rpx;line-height:1.6;color:#888}.quick-actions{display:flex;gap:20rpx;margin-top:30rpx}.quick-actions button{flex:1;font-size:28rpx}.quick-confirm{background:#222;color:#fff}
