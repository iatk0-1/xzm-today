<view class="draft-status"><view class="draft-status-row"><text>{{saving ? '草稿保存中…' : dirty ? '有未保存修改' : saved || '填写内容后可保存草稿'}}</text><button bindtap="open" disabled="{{saving}}">草稿箱（{{count}}）</button></view><view wx:if="{{problem}}" class="draft-problem">{{problem}}</view><view wx:for="{{warnings}}" wx:key="*this" class="draft-warning">{{item}}</view><view wx:if="{{conflict}}" class="conflict-actions"><button bindtap="reload">打开最新版本</button><button wx:if="{{canReload}}" bindtap="latest">载入当前商品核对</button></view></view>
