<view wx:if="{{problem || warnings.length || conflict}}" class="draft-status"><view wx:if="{{problem}}" class="draft-problem">{{problem}}</view><view wx:for="{{warnings}}" wx:key="*this" class="draft-warning">{{item}}</view><view wx:if="{{conflict}}" class="conflict-actions"><button bindtap="reload" disabled="{{saving}}">打开最新版本</button><button wx:if="{{canReload}}" bindtap="latest" disabled="{{saving}}">载入当前商品核对</button></view></view>
