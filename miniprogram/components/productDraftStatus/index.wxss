.draft-status { margin:20rpx 24rpx; padding:14rpx 20rpx; background:#fff; border:1rpx solid #e9e9e9; border-radius:14rpx; font-size:24rpx; color:#777; }.draft-status-row { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }.draft-status button { margin:0; padding:0 12rpx; line-height:56rpx; font-size:24rpx; background:transparent; color:#333; }.draft-status button::after { border:0; }.draft-problem,.draft-warning { line-height:1.7; margin-top:10rpx; color:#986219; }.draft-problem { color:#b23f2c; }.conflict-actions { display:flex; justify-content:flex-end; gap:10rpx; flex-wrap:wrap; }.conflict-actions button { color:#845f24; text-decoration:underline; }
