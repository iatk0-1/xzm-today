<view class="page-wrapper product-document">

  <view wx:if="{{!embedded}}" class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px; height: 44px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
  </view>

  <view class="product-load-state" wx:if="{{loading}}">正在加载商品...</view>
  <view class="product-load-state product-load-error" wx:elif="{{loadError}}" bindtap="retryProduct">{{loadError}} · 点击重试</view>
  <view class="main-swiper-wrap {{embedded && galleryAnimating ? 'gallery-animating' : ''}}" style="{{embedded ? 'height: ' + galleryHeight + 'px;' : ''}}" wx:if="{{product.id}}" data-gesture="image" data-gallery="banner">
    <view wx:if="{{!embedded}}" class="banner-strip page-banner-strip" data-gesture="image" data-gallery="banner"
          bindtouchstart="onPageBannerTouchStart" bindtouchmove="onPageBannerTouchMove"
          bindtouchend="onPageBannerTouchEnd" bindtouchcancel="onPageBannerTouchCancel">
      <view class="banner-track {{bannerDragging ? '' : 'gallery-settling'}}"
            style="{{'height: ' + bannerBaseHeight + 'px; transform: translate3d(' + bannerTranslateX + 'px, 0, 0);'}}">
        <view wx:if="{{product.videoUrl}}" class="banner-cell banner-video-cell" style="width: {{bannerBaseWidth}}px;">
          <video id="productBannerVideo" class="swiper-video" style="{{bannerVideoStyle}}" src="{{product.videoUrl}}" poster="{{product.image}}"
                 object-fit="{{bannerVideoFit}}" data-src="{{product.videoUrl}}"
                 bindloadedmetadata="onBannerVideoMetadata" show-play-btn="{{true}}" controls="{{false}}" autoplay="{{false}}" muted loop />
        </view>
        <view wx:for="{{bannerImgs}}" wx:key="*this" class="banner-cell" style="width: {{bannerBaseWidth}}px;">
          <image class="swiper-img" src="{{item}}" mode="{{bannerImageModes[index] || 'aspectFit'}}"
                 bindload="onBannerImageLoad" data-src="{{item}}" catchtap="previewBannerImage" data-index="{{index}}" />
        </view>
      </view>
      <view wx:if="{{bannerImgs.length + (product.videoUrl ? 1 : 0) > 1}}" class="banner-dots">
        <view wx:if="{{product.videoUrl}}" class="banner-dot {{bannerIndex === 0 ? 'active' : ''}}" />
        <view wx:for="{{bannerImgs}}" wx:key="*this" class="banner-dot {{bannerIndex === index + (product.videoUrl ? 1 : 0) ? 'active' : ''}}" />
      </view>
    </view>
    <view wx:else class="banner-strip" data-gesture="image" data-gallery="banner">
      <view class="banner-track {{gallerySettling ? 'gallery-settling' : ''}} {{galleryAnimating ? 'gallery-transform-animating' : ''}}" style="{{'height: ' + galleryBaseHeight + 'px; transform: translate3d(' + galleryTranslateX + 'px, 0, 0) scale(' + galleryScale + ');'}}" data-gesture="image" data-gallery="banner">
        <view wx:if="{{product.videoUrl}}" class="banner-cell banner-video-cell" style="width: {{galleryBaseWidth}}px;" data-gesture="image" data-gallery="banner">
          <video id="productBannerVideo" class="swiper-video" style="{{bannerVideoStyle}}" data-gesture="image" data-gallery="banner" src="{{product.videoUrl}}" poster="{{product.image}}" object-fit="{{bannerVideoFit}}" data-src="{{product.videoUrl}}" bindloadedmetadata="onBannerVideoMetadata" controls="{{false}}" autoplay="{{false}}" muted loop />
        </view>
        <view wx:for="{{bannerImgs}}" wx:key="*this" class="banner-cell" style="width: {{galleryBaseWidth}}px;" data-gesture="image" data-gallery="banner">
          <image class="swiper-img" data-gesture="image" data-gallery="banner" src="{{item}}" mode="{{bannerImageModes[index] || 'aspectFit'}}" bindload="onBannerImageLoad" data-src="{{item}}" catchtap="previewBannerImage" data-index="{{index}}" />
        </view>
      </view>
      <view wx:if="{{bannerImgs.length + (product.videoUrl ? 1 : 0) > 1}}" class="banner-dots">
        <view wx:if="{{product.videoUrl}}" class="banner-dot {{bannerIndex === 0 ? 'active' : ''}}" />
        <view wx:for="{{bannerImgs}}" wx:key="*this" class="banner-dot {{bannerIndex === index + (product.videoUrl ? 1 : 0) ? 'active' : ''}}" />
      </view>
    </view>
    <view class="sold-out-overlay main-sold-out-overlay" data-gesture="image" data-gallery="banner" wx:if="{{product.offSale}}"><text data-gesture="image" data-gallery="banner">已下架</text></view>
    <view class="sold-out-overlay main-sold-out-overlay" data-gesture="image" data-gallery="banner" wx:elif="{{product.soldOut}}"><text data-gesture="image" data-gallery="banner">售罄</text></view>
  </view>

  <view class="content-wrapper">
    <!-- <view class="shipping-info" wx:if="{{product.shippingInfo}}">{{product.shippingInfo}}</view> 发货时间暂时不写 -->
    <view class="detail-title">{{product.title}}</view>
    <view class="detail-price">¥ {{product.displayPrice || product.price}}</view>

    <view class="product-options-row">
      <view class="consult-section">
        <view class="consult-left">
          <image class="consult-icon" src="/images/icons/customer-service.svg" mode="aspectFit"></image>
          <text class="consult-label">咨询客服</text>
        </view>
        <button class="consult-contact-button" open-type="contact" bindcontact="handleCustomerServiceContact" session-from="product:{{product.id}}" show-message-card="true" send-message-title="{{product.title}}" send-message-path="/pages/detail/detail?id={{product.id}}" send-message-img="{{product.image}}"></button>
      </view>
      <view class="options-section" bindtap="openSkuPanel" data-action="cart">
        <view class="size-selector">
          <text class="size-text" style="color: #333;">{{selectedColor || '颜色'}} / {{selectedSize || '尺码'}}</text>
          <text class="select-icon">›</text>
        </view>
      </view>
    </view>

<!-- 四段提示信息 -->
<view class="aura-tabs-container" wx:if="{{product.description || product.fabricCare || product.sizeChartTip || product.warmTips}}">

      <view class="aura-tabs-header">
        <view class="aura-tab {{currentAuraTab === 'desc' ? 'active' : ''}}" wx:if="{{product.description}}" bindtap="switchAuraTab" data-tab="desc">详情</view>
        <view class="aura-tab {{currentAuraTab === 'fabric' ? 'active' : ''}}" wx:if="{{product.fabricCare}}" bindtap="switchAuraTab" data-tab="fabric">材质</view>
        <view class="aura-tab {{currentAuraTab === 'size' ? 'active' : ''}}" wx:if="{{product.sizeChartTip}}" bindtap="switchAuraTab" data-tab="size">尺码</view>
        <view class="aura-tab {{currentAuraTab === 'tips' ? 'active' : ''}}" wx:if="{{product.warmTips}}" bindtap="switchAuraTab" data-tab="tips">提示</view>
      </view>

      <view class="aura-tabs-content">
        <view class="aura-tab-panel" wx:if="{{product.description && currentAuraTab === 'desc'}}">
          <text class="panel-text">{{product.description}}</text>
        </view>
        <view class="aura-tab-panel" wx:if="{{product.fabricCare && currentAuraTab === 'fabric'}}">
          <text class="panel-text">{{product.fabricCare}}</text>
        </view>
        <view class="aura-tab-panel" wx:if="{{product.sizeChartTip && currentAuraTab === 'size'}}">
          <text class="panel-text">{{product.sizeChartTip}}</text>
        </view>
        <view class="aura-tab-panel" wx:if="{{product.warmTips && currentAuraTab === 'tips'}}">
          <text class="panel-text">{{product.warmTips}}</text>
        </view>
      </view>

    </view>
  </view>

  <view class="lookbook-section" wx:if="{{lookbookImgs && lookbookImgs.length > 0}}">
    <image class="lookbook-img" wx:for="{{lookbookImgs}}" wx:key="*this" src="{{item}}" mode="widthFix" bindload="onDocumentImageLoad" catchtap="previewLookbookImage" data-index="{{index}}"></image>
  </view>

  <view class="detail-views-section" wx:if="{{detailImgs && detailImgs.length > 0}}">
    <view class="detail-views-header">
      <text class="detail-title-eng">Detail Views</text>
      <text class="detail-counter">{{currentDetailIndex}} / {{detailImgs.length}}</text>
    </view>
    <view class="detail-gallery">
      <swiper wx:if="{{!embedded}}" data-gesture="image" data-gallery="detail" class="detail-swiper" current="{{currentDetailIndex - 1}}" bindchange="onDetailSwiperChange">
        <swiper-item data-gesture="image" data-gallery="detail" class="detail-swiper-item" wx:for="{{detailImgs}}" wx:key="*this">
          <image class="detail-swiper-img" data-gesture="image" data-gallery="detail" src="{{item}}" mode="{{detailImageModes[index] || 'aspectFit'}}" bindload="onDetailImageLoad" data-src="{{item}}" catchtap="previewDetailImage" data-index="{{index}}"></image>
        </swiper-item>
      </swiper>
      <view wx:else class="detail-swiper detail-strip" data-gesture="image" data-gallery="detail">
        <view class="detail-strip-track" style="{{'transform: translateX(-' + ((currentDetailIndex - 1) * 100) + '%);'}}" data-gesture="image" data-gallery="detail">
          <view class="detail-strip-cell" wx:for="{{detailImgs}}" wx:key="*this" data-gesture="image" data-gallery="detail">
            <image class="detail-swiper-img" data-gesture="image" data-gallery="detail" src="{{item}}" mode="{{detailImageModes[index] || 'aspectFit'}}" bindload="onDetailImageLoad" data-src="{{item}}" catchtap="previewDetailImage" data-index="{{index}}" />
          </view>
        </view>
      </view>
      <view wx:if="{{currentDetailIndex > 1}}" class="detail-gallery-arrow detail-gallery-arrow-left" aria-role="button" aria-label="上一张细节图" catchtap="changeDetailImage" data-step="-1" data-gesture="image" data-gallery="detail"><view class="detail-gallery-chevron" data-gesture="image" data-gallery="detail" /></view>
      <view wx:if="{{currentDetailIndex < detailImgs.length}}" class="detail-gallery-arrow detail-gallery-arrow-right" aria-role="button" aria-label="下一张细节图" catchtap="changeDetailImage" data-step="1" data-gesture="image" data-gallery="detail"><view class="detail-gallery-chevron" data-gesture="image" data-gallery="detail" /></view>
    </view>
  </view>

  <view class="purchase-notice-section" wx:if="{{product.purchaseNotice}}">
    <view class="purchase-notice-title">购买须知</view>
    <text class="purchase-notice-content" user-select="true">{{product.purchaseNotice}}</text>
  </view>

  <view class="related-products-section" wx:if="{{relatedProducts.length > 0}}">
    <view class="section-title-eng" style="text-align: left; padding-left: 20px;">关联商品</view>
    <view class="related-grid">
      <view class="related-item" wx:for="{{relatedProducts}}" wx:key="id" bindtap="goToRelatedDetail" data-id="{{item.id}}">
        <image class="related-img" src="{{item.image}}" mode="aspectFill" catchtap="goToRelatedDetail" data-id="{{item.id}}"></image>
        <view class="related-info">
          <view class="related-title">{{item.title}}</view>
          <view class="related-price">¥ {{item.displayPrice || item.price}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
