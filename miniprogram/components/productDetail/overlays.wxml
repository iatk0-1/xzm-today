<view class="share-float" wx:if="{{canShowShareFloat}}" style="left: {{shareFloatLeft}}px; top: {{shareFloatTop}}px;" catchtouchstart="startShareFloatDrag" catchtouchmove="moveShareFloat" catchtouchend="endShareFloatDrag" catchtouchcancel="cancelFloatTouch">
  <text>分享</text>
</view>
<view class="share-float" wx:if="{{canShowShareFloat && product.id}}" style="left: {{editFloatLeft}}px; top: {{editFloatTop}}px;" catchtouchstart="startEditFloatDrag" catchtouchmove="moveEditFloat" catchtouchend="endEditFloatDrag" catchtouchcancel="cancelFloatTouch">
  <text>编辑</text>
</view>

<!-- 分享卡片专用画布：按图片数量生成单图、双图或三联图，不影响页面展示 -->
<canvas canvas-id="detailShareCanvasSingle" class="share-canvas" width="500" height="400"></canvas>
<canvas canvas-id="detailShareCanvasDouble" class="share-canvas" width="500" height="400"></canvas>
<canvas canvas-id="detailShareCanvasTriple" class="share-canvas" width="500" height="400"></canvas>

<view class="share-template-mask" wx:if="{{showShareTemplates}}" bindtap="closeShareTemplateSelector"></view>
<view class="share-template-panel" wx:if="{{showShareTemplates}}" catchtap="stopShareTemplateTap">
  <view class="share-template-header">
    <text>选择分享版式</text>
    <text class="share-template-close" bindtap="closeShareTemplateSelector">×</text>
  </view>
  <scroll-view class="share-template-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="share-template-options">
      <button class="share-template-option" open-type="share" data-product-share="{{true}}" data-template="single">
        <image class="share-template-preview" src="{{shareImages.single}}" mode="aspectFill"></image>
        <text class="share-template-label">单图模板</text>
      </button>
      <button class="share-template-option" wx:if="{{shareImageCount >= 2}}" open-type="share" data-product-share="{{true}}" data-template="double">
        <image class="share-template-preview" src="{{shareImages.double}}" mode="aspectFill"></image>
        <text class="share-template-label">双图模板</text>
      </button>
      <button class="share-template-option" wx:if="{{shareImageCount >= 3}}" open-type="share" data-product-share="{{true}}" data-template="triple">
        <image class="share-template-preview" src="{{shareImages.triple}}" mode="aspectFill"></image>
        <text class="share-template-label">三联模板</text>
      </button>
    </view>
  </scroll-view>
  <view class="share-template-cancel" bindtap="closeShareTemplateSelector">取消</view>
</view>

<view class="floating-action-bar">
  <block wx:if="{{product.id && !product.offSale && !product.soldOut}}">
    <view class="btn-add-half" bindtap="openSkuPanel" data-action="cart">加入购物车</view>
    <view class="btn-buy-half" bindtap="openSkuPanel" data-action="buy">立即购买</view>
  </block>
  <block wx:else>
    <view class="btn-add-half action-disabled">加入购物车</view>
    <view class="btn-buy-half action-disabled">立即购买</view>
  </block>
</view>
<view class="sku-mask" wx:if="{{showSku}}" catchtap="closeSkuPanel"></view>

<view class="sku-panel {{showSku ? 'show' : ''}}">
  <view class="sku-close" catchtap="closeSkuPanel">×</view>
  <view class="sku-header">
    <view class="sku-image-column">
      <view class="sku-img-wrap">
        <image class="sku-img" src="{{currentSkuImage || product.image}}" mode="aspectFill" catchtap="previewSkuPanelImage"></image>
        <view class="sold-out-overlay" wx:if="{{currentSkuId ? currentSkuSoldOut : product.soldOut}}"><text>售罄</text></view>
      </view>
    </view>
    <view class="sku-main">
      <view class="sku-price" style="color: #d32f2f;">¥ {{currentSkuPrice || product.displayPrice || product.price}}</view>
      <view class="sku-stock sku-stock-low" wx:if="{{bundleSelections.length === 0 && !currentSkuUnlimited && currentSkuStock != null && currentSkuStock <= 3}}">库存：仅剩{{currentSkuStock}}件</view>
      <view class="sku-stock" wx:elif="{{bundleSelections.length === 0 && (isAdmin || isStallManager) && currentSkuStock != null}}">库存：{{currentSkuStockText}}</view>
      <view class="sku-meta-row">
        <view class="sku-choose-tip">已选: {{selectedColor || '颜色'}} / {{selectedSize || '尺码'}}</view>
        <view class="sku-quantity" wx:if="{{bundleSelections.length === 0}}">
          <text class="sku-quantity-label">数量</text>
          <view class="sku-quantity-control">
            <view class="sku-quantity-btn {{quantity <= 1 ? 'disabled' : ''}}" catchtap="skuQuantityMinus">-</view>
            <input class="sku-quantity-input" type="number" value="{{quantity}}" bindinput="skuQuantityInput" bindblur="skuQuantityInputBlur" />
            <view class="sku-quantity-btn {{!currentSkuUnlimited && currentSkuStock !== null && currentSkuStock <= quantity ? 'disabled' : ''}}" catchtap="skuQuantityPlus">+</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- 套装商品颜色/尺码选择 -->
  <scroll-view scroll-y style="max-height: 55vh; padding: 0 16rpx; padding-bottom: 40rpx;" wx:if="{{bundleSelections.length > 0}}">
    <view class="bundle-group-card {{sel.isChecked === false ? 'disabled-card' : ''}}" wx:for="{{bundleSelections}}" wx:key="index" wx:for-item="sel" wx:for-index="bgIdx">
      
      <view class="bundle-card-img-wrap">
        <image class="bundle-card-img" src="{{sel.displayImage || product.coverUrl}}" mode="aspectFill"></image>
        <view class="sold-out-overlay" wx:if="{{sel.imageSoldOut}}"><text>售罄</text></view>
      </view>
      
      <view class="bundle-card-right">
        <view class="bundle-card-header">
          <view class="bundle-card-title">
            <text class="bg-step">{{bgIdx + 1}}</text>
            <text>{{sel.bundleGroupName}}</text>
          </view>
          <view class="bundle-checkbox {{sel.isChecked !== false ? 'checked' : ''}}" bindtap="toggleBundleCheck" data-index="{{bgIdx}}"></view>
        </view>
        
        <view class="bundle-card-specs" wx:if="{{sel.uniqueColors.length > 0}}">
          <text class="spec-label">颜色</text>
          <view class="sku-options minimal">
            <view class="sku-tag minimal {{sel.selectedColor === item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}" wx:for="{{sel.colorOptions}}" wx:key="value" wx:for-item="item" bindtap="selectBundleColor" data-index="{{bgIdx}}" data-color="{{item.value}}">{{item.value}}</view>
          </view>
        </view>
        
        <view class="bundle-card-specs" wx:if="{{sel.uniqueSizes.length > 0}}">
          <text class="spec-label">尺码</text>
          <view class="sku-options minimal">
            <view class="sku-tag minimal {{sel.selectedSize === item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}" wx:for="{{sel.sizeOptions}}" wx:key="value" wx:for-item="item" bindtap="selectBundleSize" data-index="{{bgIdx}}" data-size="{{item.value}}">{{item.value}}</view>
          </view>
        </view>

        <view class="bundle-card-footer" wx:if="{{sel.selectedSku}}">
          <text class="stock-status out" wx:if="{{!sel.selectedSku.unlimitedStock && sel.selectedSku.stock <= 0}}">已售罄</text>
          <text class="stock-status danger" wx:elif="{{!sel.selectedSku.unlimitedStock && sel.selectedSku.stock <= 5}}">🔥 仅剩少量</text>
          <text class="stock-status normal" wx:else>已选定</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 普通商品颜色/尺码选择 -->
  <scroll-view scroll-y style="max-height: 50vh;" wx:else>
    <view class="sku-section" wx:if="{{uniqueColors.length > 0}}">
      <view class="sku-title">颜色</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedColor === item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}" wx:for="{{colorOptions}}" wx:key="value" bindtap="selectColor" data-color="{{item.value}}">{{item.value}}</view>
      </view>
    </view>

    <view class="sku-section" wx:if="{{uniqueSizes.length > 0}}">
      <view class="sku-title">尺码</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedSize === item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}" wx:for="{{sizeOptions}}" wx:key="value" bindtap="selectSize" data-size="{{item.value}}">{{item.value}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 按钮区域 -->
  <block wx:if="{{bundleSelections.length > 0}}">
    <view class="sku-actions" wx:if="{{!bundleAllSelected}}">
      <view class="sku-btn-confirm disabled">请至少完整选择一个子项</view>
    </view>
    <view class="sku-actions" wx:else>
      <view class="sku-btn-cart" bindtap="confirmSkuAction" data-action="cart">加入购物车</view>
      <view class="sku-btn-buy" bindtap="confirmSkuAction" data-action="buy">立即购买</view>
    </view>
  </block>
  <block wx:else>
    <view class="sku-actions" wx:if="{{currentSkuStock <= 0 && currentSkuStock !== null && !currentSkuUnlimited}}">
      <view class="sku-btn-confirm disabled">已售罄</view>
    </view>
    <view class="sku-actions" wx:else>
      <view class="sku-btn-cart" bindtap="confirmSkuAction" data-action="cart">加入购物车</view>
      <view class="sku-btn-buy" bindtap="confirmSkuAction" data-action="buy">立即购买</view>
    </view>
  </block>
</view>

<view class="floating-video-btn" wx:if="{{product.videoUrl}}" bindtap="openVideoOverlay">
  <video id="productFloatingVideo" class="floating-video-thumb" src="{{product.videoUrl}}" autoplay="{{!embedded}}" loop muted show-play-btn="{{false}}" controls="{{false}}" object-fit="cover"></video>
  <!-- 这个播放三角不显示 暂时留着位置 -->
  <view class="play-icon-overlay"></view>
</view>

<view class="video-overlay-mask" wx:if="{{showVideo}}" catchtap="closeVideoOverlay">
  <view class="close-video-btn" catchtap="closeVideoOverlay" style="top: {{statusBarHeight + 10}}px;">×</view>
  <video id="mainFullscreenVideo" class="fullscreen-video" src="{{product.videoUrl}}" autoplay loop controls object-fit="contain" catchtap="doNothing" show-fullscreen-btn="{{false}}"></video>
</view>
