@import "./content.wxss";
:host { display: block; width: 100%; height: 100%; }
.product-detail-host { position: relative; width: 100%; background: #fff; overflow: hidden; }
.product-viewport { position: relative; width: 100%; overflow: hidden; }
.product-scroll-content { will-change: transform; }
.embedded-detail .page-wrapper { padding-bottom: calc(110px + env(safe-area-inset-bottom)); }
.embedded-detail .floating-action-bar { position: absolute; width: calc(100% - 40px); z-index: 20; }
.embedded-detail .sku-mask { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 40; }
.embedded-detail .sku-panel { position: absolute; z-index: 41; max-height: 100%; overflow-y: auto; padding-bottom: calc(20px + env(safe-area-inset-bottom)); }
.embedded-detail .share-template-mask { position: absolute; z-index: 50; }
.embedded-detail .share-template-panel { position: absolute; z-index: 51; max-height: 100%; overflow-y: auto; }
.embedded-detail .share-float { position: absolute; z-index: 30; width: 42px; height: 42px; line-height: 42px; }
.embedded-detail .floating-video-btn { position: absolute; z-index: 21; }
.embedded-detail .video-overlay-mask { position: absolute; z-index: 60; }
.embedded-detail .fullscreen-video { height: 100%; }
.embedded-detail .sku-panel scroll-view { max-height: 32vh !important; }
