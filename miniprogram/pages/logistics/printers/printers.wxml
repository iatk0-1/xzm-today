<!--miniprogram/pages/logistics/printers/printers.wxml-->
<view class="container">
  <view class="header">
    <view class="title">打印员管理</view>
    <view class="subtitle">绑定打印员后可使用微信 PC 打单软件</view>
  </view>

  <!-- 已绑定打印员列表 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">已绑定打印员</text>
      <text class="section-count">{{printers.length}} 人</text>
    </view>
    <view class="printer-list" wx:if="{{printers.length > 0}}">
      <view class="printer-item" wx:for="{{printers}}" wx:key="*this">
        <view class="printer-info">
          <text class="printer-openid">{{item}}</text>
          <text class="printer-status">已绑定</text>
        </view>
        <view class="btn-unbind" catchtap="unbindPrinter" data-openid="{{item}}">解绑</view>
      </view>
    </view>
    <view class="empty-tip" wx:else>
      <text>暂无绑定打印员</text>
    </view>
  </view>

  <!-- 当前用户绑定状态 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">我的绑定状态</text>
    </view>
    <view class="current-user-section">
      <view class="user-info">
        <text class="user-openid">当前 OpenID：{{currentOpenid}}</text>
        <text class="user-status {{isPrinter ? 'bound' : 'unbound'}}">
          {{isPrinter ? '已是打印员' : '还不是打印员'}}
        </text>
      </view>
      <button class="btn-bind-self" bindtap="bindSelf" wx:if="{{!isPrinter}}">
        绑定为打印员
      </button>
      <button class="btn-unbind-self" bindtap="unbindSelf" wx:if="{{isPrinter}}">
        解绑打印员
      </button>
    </view>
  </view>

  <!-- 绑定物流账号提示 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">绑定的物流账号</text>
    </view>
    <view class="account-list" wx:if="{{accounts.length > 0}}">
      <view class="account-item" wx:for="{{accounts}}" wx:key="bizId">
        <view class="account-info">
          <text class="account-name">{{item.deliveryName}}</text>
          <text class="account-biz-id">账号：{{item.bizId}}</text>
        </view>
        <view class="account-quota" wx:if="{{item.quotaNum !== null}}">
          <text class="quota-num">{{item.quotaNum}}</text>
          <text class="quota-unit">张</text>
        </view>
      </view>
    </view>
    <view class="empty-tip" wx:else>
      <text>暂无绑定物流账号</text>
    </view>
    <view class="tips">
      <view class="tip-title">如何绑定物流账号？</view>
      <view class="tip-content">
        1. 登录微信公众平台<br/>
        2. 进入物流助手功能模块<br/>
        3. 在"物流账号管理"中绑定快递月结账号
      </view>
    </view>
  </view>
</view>
