/* miniprogram/pages/logistics/printers/printers.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* 打印员列表 */
.printer-list {
  margin-top: 10rpx;
}

.printer-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.printer-item:last-child {
  border-bottom: none;
}

.printer-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.printer-openid {
  font-size: 26rpx;
  color: #333;
  font-family: monospace;
}

.printer-status {
  font-size: 22rpx;
  color: #52c41a;
}

.btn-unbind {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
}

/* 添加表单 */
.add-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-item {
  width: 100%;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.btn-add {
  height: 80rpx;
  background: #1890ff;
  color: #fff;
  text-align: center;
  line-height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 提示信息 */
.tips {
  margin-top: 30rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.tip-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #666;
  margin-bottom: 10rpx;
}

.tip-content {
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

/* 物流账号列表 */
.account-list {
  margin-top: 10rpx;
}

.account-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.account-item:last-child {
  border-bottom: none;
}

.account-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.account-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.account-biz-id {
  font-size: 22rpx;
  color: #999;
}

.account-quota {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.quota-num {
  font-size: 32rpx;
  color: #faad14;
  font-weight: bold;
}

.quota-unit {
  font-size: 22rpx;
  color: #999;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* 当前用户绑定状态 */
.current-user-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 0;
}

.user-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-openid {
  font-size: 26rpx;
  color: #666;
  font-family: monospace;
}

.user-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.user-status.bound {
  background-color: #e6f7ff;
  color: #1890ff;
}

.user-status.unbound {
  background-color: #f5f5f5;
  color: #999;
}

/* 绑定/解绑按钮 */
.btn-bind-self {
  background-color: #1890ff;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border: none;
}

/* 打单软件账号 */
.printer-account-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.account-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 24rpx;
  color: #999;
}

.field-value-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
}

.field-value {
  font-size: 28rpx;
  color: #333;
  font-family: monospace;
}

.btn-copy {
  font-size: 22rpx;
  color: #1890ff;
  padding: 4rpx 12rpx;
  border: 1rpx solid #1890ff;
  border-radius: 6rpx;
}

.account-tip {
  padding: 16rpx;
  background: #fffbe6;
  border-radius: 8rpx;
  border: 1rpx solid #ffe58f;
}

.account-tip text {
  font-size: 22rpx;
  color: #ad8b00;
  line-height: 1.5;
}

.create-account-area {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  align-items: center;
  padding: 30rpx 0;
}

.empty-desc {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 10rpx;
}

.btn-create-account {
  width: 100%;
  background-color: #1890ff;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  border: none;
}

.btn-unbind-self {
  background-color: #fff;
  color: #ff4d4f;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid #ff4d4f;
}

/* 扫码登录按钮 */
.account-actions {
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.btn-qrcode-login {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 24rpx 0;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.btn-qrcode-login .icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.btn-qrcode-login::after {
  border: none;
}
