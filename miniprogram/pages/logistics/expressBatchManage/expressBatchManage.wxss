/* miniprogram/pages/logistics/expressBatchManage/expressBatchManage.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.header-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.header-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* 快递公司选择器 */
.picker-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
}

.picker-text {
  font-size: 26rpx;
  color: #333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.filter-hint {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

/* 表格 */
.table-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  font-size: 24rpx;
  color: #999;
  font-weight: bold;
}

.table-body {
  max-height: 600rpx;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
}

.table-row.row-checked {
  background-color: #e6f7ff;
}

.col-check {
  width: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.col-order {
  flex: 1;
  min-width: 0;
  padding-right: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.col-waybill {
  flex: 1.2;
  min-width: 0;
  padding-right: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.col-company {
  flex: 0.8;
  min-width: 0;
  padding-right: 6rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.col-action {
  width: 70rpx;
  text-align: center;
  flex-shrink: 0;
}

.order-text {
  font-size: 26rpx;
  color: #666;
  font-family: monospace;
  word-break: break-all;
}

.waybill-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  font-family: monospace;
  word-break: break-all;
}

.copy-mini {
  flex-shrink: 0;
  padding: 3rpx 8rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: #576b95;
  background: #f5f7fa;
  border-radius: 6rpx;
}

.company-text {
  font-size: 24rpx;
  color: #1890ff;
}

.waybill-tag {
  display: inline-block;
  font-size: 18rpx;
  color: #fa8c16;
  background: #fff7e6;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  white-space: nowrap;
}

.btn-delete-row {
  font-size: 22rpx;
  color: #ff4d4f;
  padding: 4rpx 10rpx;
  border: 1rpx solid #ff4d4f;
  border-radius: 6rpx;
}

/* 空状态 */
.empty-section {
  text-align: center;
  padding: 60rpx 30rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 10rpx;
}

.empty-sub-desc {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 6rpx;
}

/* 补充数据源 */
.action-buttons {
  padding: 20rpx 30rpx 30rpx;
}

.action-hint {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-import {
  background-color: #52c41a;
}

.btn-add {
  background-color: #1890ff;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.bottom-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.select-count {
  font-size: 26rpx;
  color: #666;
}

.btn-cancel {
  padding: 16rpx 32rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
}

.btn-cancel[disabled] {
  background-color: #ccc;
  color: #999;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
}

.modal-box {
  position: fixed;
  left: 10%;
  right: 10%;
  top: 30%;
  background: #fff;
  border-radius: 16rpx;
  z-index: 201;
  transform: scale(0.9);
  opacity: 0;
  transition: all 0.2s;
  pointer-events: none;
}

.modal-box.show {
  transform: scale(1);
  opacity: 1;
  pointer-events: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.required {
  color: #ff4d4f;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 30rpx;
}

.btn-modal-cancel {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-modal-confirm {
  flex: 1;
  height: 80rpx;
  background: #1890ff;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
