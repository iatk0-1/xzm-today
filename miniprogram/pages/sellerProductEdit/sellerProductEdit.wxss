page { background: #f6f6f6; }
.page { padding: 24rpx; padding-bottom: 60rpx; }
.section { background: #fff; border-radius: 8rpx; padding: 28rpx; margin-bottom: 20rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #111; margin-bottom: 22rpx; }
.label { font-size: 24rpx; color: #555; margin: 20rpx 0 10rpx; }
.input, .textarea, .price-input { background: #f5f5f5; border-radius: 6rpx; padding: 0 18rpx; font-size: 26rpx; box-sizing: border-box; }
.input { height: 74rpx; }
.textarea { width: 100%; min-height: 130rpx; padding-top: 16rpx; }
.button, .status-button { margin-top: 28rpx; border-radius: 6rpx; background: #111; color: #fff; font-size: 26rpx; }
.button::after, .status-button::after { border: 0; }
.sku { display: flex; padding: 22rpx 0; border-bottom: 1rpx solid #eee; }
.sku-image { width: 116rpx; height: 116rpx; background: #eee; flex-shrink: 0; }
.sku-content { flex: 1; min-width: 0; margin-left: 18rpx; }
.sku-name { font-size: 27rpx; color: #111; font-weight: 600; }
.readonly { font-size: 22rpx; color: #777; margin-top: 8rpx; }
.price-input { height: 64rpx; margin-top: 12rpx; }
.price-input.invalid { border: 2rpx solid #b13a33; }
.status-button { background: #fff; color: #111; border: 1rpx solid #ccc; }
