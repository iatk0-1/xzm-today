/* miniprogram/pages/liveRoomDetail/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 100rpx;
}

/* 场次信息头 */
.session-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 20rpx;
  color: #fff;
}

.session-header.live {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
}

.session-header.ended {
  background: linear-gradient(135deg, #999 0%, #666 100%);
}

.session-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.session-meta {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.session-status {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.session-status.live {
  background-color: rgba(255, 255, 255, 0.9);
  color: #ff6b6b;
}

/* 管理员操作区 */
.admin-actions {
  padding: 20rpx;
  background-color: #fff;
  margin-bottom: 1rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.action-btn.danger {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
}

.action-btn.cart {
  background-color: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
  flex: 1;
  margin-right: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
}

.action-btn.buy {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  flex: 1;
  padding: 16rpx;
  font-size: 26rpx;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 商品列表 */
.product-list {
  padding: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.product-item {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.product-specs {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.product-specs text {
  margin-right: 20rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.stock {
  font-size: 24rpx;
  color: #999;
}

.product-actions {
  display: flex;
  gap: 12rpx;
}

.product-sold-out {
  font-size: 26rpx;
  color: #999;
  padding: 12rpx 0;
}

.product-converted {
  font-size: 26rpx;
  color: #667eea;
  padding: 12rpx 0;
}

/* 管理员已结束提示 */
.admin-ended-hint {
  padding: 20rpx;
  background-color: #fff5e6;
  border-left: 4rpx solid #ff9800;
  margin: 20rpx;
  border-radius: 8rpx;
}

.admin-ended-hint .hint-text {
  font-size: 26rpx;
  color: #ff9800;
}

/* 转换按钮 */
.convert-btn {
  margin-top: 12rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
  display: inline-block;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  width: 600rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* SKU 选择面板 */
.sku-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 998;
  opacity: 0;
  transition: opacity 0.3s;
}

.sku-mask.fade-in {
  opacity: 1;
}

.sku-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.3s;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.sku-panel.slide-up {
  transform: translateY(0);
}

.sku-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: #999;
  z-index: 10;
}

.sku-header {
  display: flex;
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #fff 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.sku-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.sku-main {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.sku-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.sku-stock {
  font-size: 24rpx;
  color: #999;
}

.sku-stock.out-of-stock {
  color: #ff6b6b;
}

.sku-choose-tip {
  font-size: 24rpx;
  color: #999;
}

.sku-scroll-area {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.sku-section {
  margin-bottom: 32rpx;
}

.sku-section:last-child {
  margin-bottom: 0;
}

.sku-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.sku-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku-tag {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.sku-tag.active {
  background-color: #fff;
  border-color: #667eea;
  color: #667eea;
  font-weight: 600;
}

.sku-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.sku-btn-cart {
  flex: 1;
  background: linear-gradient(135deg, #ffa500 0%, #ff8c00 100%);
  color: #fff;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.sku-btn-buy {
  flex: 1;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.sku-btn-confirm {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.sku-btn-confirm.disabled {
  background-color: #f5f5f5;
  color: #999;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
}
