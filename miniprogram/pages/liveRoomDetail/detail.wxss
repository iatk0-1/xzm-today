/* miniprogram/pages/liveRoomDetail/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #fafafa; /* 还原极其清淡的背景色 */
  padding-bottom: 60rpx;
}

/* 完美还原：顶部宽屏卡片与丝滑渐变 */
.banner-wrapper {
  margin: 30rpx 24rpx; /* 修改了左右边距，让卡片更宽，排版更舒展 */
  height: 405rpx;      /* 稍微加高了一点，给底部的按钮留出充足的呼吸感 */
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  background-color: #f5f5f5; /* 避免图片没加载出来时是纯白底 */
}

/* 基础背景图占位 */
.banner-bg {
  position: absolute;
  right: 0;
  top: 0;
  width: 65%;
  height: 100%;
}

/* 底层：高斯模糊氛围层 */
.blur-layer {
  z-index: 1;
  filter: blur(15px); /* 核心：高斯模糊 */
  transform: scale(1.1); /* 稍微放大一点，防止高斯模糊导致边缘出现白边 */
  opacity: 0.7; /* 稍微降低一点透明度，不至于太抢戏 */
}

/* 顶层：等比例高清主图 */
.main-layer {
  z-index: 2;
  /* aspectFit 模式会自动居中并不变形，我们直接显示即可 */
}

.banner-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  /* 渐变遮罩层级提高到 3，完美盖住两层图片 */
  background: linear-gradient(90deg, rgba(255,255,255,1) 40%, rgba(255,255,255,0.85) 55%, rgba(255,255,255,0) 100%);
  z-index: 3;
}

.banner-content {
  position: relative;
  z-index: 4; /* 内容必须在最高层 */
  padding: 36rpx 30rpx;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.status-tag-row {
  margin-bottom: 24rpx;
}

.status-dot-badge {
  display: inline-flex;
  align-items: center;
  background-color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.status-dot-badge .dot {
  color: #ff3b30;
  font-size: 20rpx;
  margin-right: 8rpx;
}

.status-dot-badge .status-text {
  font-size: 24rpx;
  color: #ff3b30; /* 红字 */
  font-weight: 500;
}

.banner-main-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.banner-duration-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

/* 重叠头像处理 */
.viewer-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-group {
  display: flex;
  margin-right: 16rpx;
}

.fake-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  margin-left: -16rpx;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.fake-avatar:first-child { margin-left: 0; }
.z3 { z-index: 3; }
.z2 { z-index: 2; }
.z1 { z-index: 1; }

.viewer-count-text {
  font-size: 24rpx;
  color: #666;
}

/* Banner 底部按钮台 */
.banner-admin-actions {
  display: flex;
  gap: 20rpx;
  margin-top: auto;
}

.banner-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.banner-btn.black-solid {
  background-color: #1a1a1a;
  color: #fff;
}

.banner-btn.white-translucent {
  background-color: rgba(255, 255, 255, 0.95);
  color: #ff3b30;
}

.btn-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}

/* 列表区 */
.product-list-section {
  padding: 0 30rpx;
}

/* 直播已结束提示卡片 */
.ended-notice-card {
  margin: 0 30rpx 10rpx 30rpx;
  padding: 28rpx 30rpx;
  background: linear-gradient(135deg, #fef9f0 0%, #fdf3e0 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  border: 1rpx solid #f5e0c0;
}

.notice-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  background: #e8a840;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notice-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.notice-body {
  flex: 1;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8b6914;
  margin-bottom: 8rpx;
}

.notice-desc {
  font-size: 24rpx;
  color: #a68b5c;
  line-height: 1.6;
}

.notice-highlight {
  color: #e8a840;
  font-weight: 600;
}

/* 搜索栏 - 苹果极简风 */
.search-bar-container {
  margin-top: 10rpx;
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f2f2f7; /* iOS 经典的浅灰底色 */
  border-radius: 20rpx;
  height: 72rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #8e8e93;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  height: 100%;
}

.search-input::placeholder {
  color: #8e8e93;
}

.clear-icon {
  width: 40rpx;
  height: 40rpx;
  background-color: #c7c7cc;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-left: 12rpx;
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 10rpx 0 24rpx 0;
}

.section-main-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-sort-btn {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
}

.sort-icon {
  font-size: 30rpx;
  margin-right: 6rpx;
  position: relative;
  top: -2rpx;
}

/* 商品卡片还原 */
.apple-product-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-left-img-box {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
}

.card-product-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background-color: #f5f5f5;
  object-fit: cover;
}

.product-index-badge {
  position: absolute;
  top: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-top-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
}

.card-right-info-box {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.info-top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.info-product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  flex: 1;
  padding-right: 16rpx;
}

.dots-grid {
  font-size: 24rpx;
  color: #c7c7cc;
  letter-spacing: 2rpx;
}

/* 管理员编辑/删除按钮 */
.info-admin-icons {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.admin-icon-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.edit-btn {
  background-color: #f0f0f0;
  color: #555;
}

.delete-btn {
  background-color: #fff0f0;
  color: #e04040;
}

.info-specs-row {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.info-specs-row .divider {
  margin: 0 12rpx;
  color: #eee;
}

/* 完美还原基线对齐的价格 */
.info-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end; /* 重点：让内容沉底对齐 */
  margin-top: 20rpx;
}

.info-price-display {
  color: #ff3b30;
  display: flex;
  align-items: baseline; /* 重点：¥与数字基线对齐 */
}

.currency-symbol {
  font-size: 22rpx; /* 调小羊角符，完美贴合图二比例 */
  font-weight: 600;
  margin-right: 4rpx;
}

.price-integer {
  font-size: 36rpx; /* 调小数字字号，防止带小数点时太长挤压右侧 */
  font-weight: 700;
}

/* 还原图二的操作按钮 */
.info-actions-wrap {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0; /* 核心护盾：保护整个按钮区绝对不被价格挤压 */
}

.action-btn-cart {
  padding: 0 20rpx;
  height: 56rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  border: 2rpx solid #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap; /* 核心护盾：强制文字和图标必须在同一行 */
  flex-shrink: 0;
}

.cart-icon {
  font-size: 24rpx;
  margin-left: 6rpx;
}

.action-btn-buy {
  padding: 0 26rpx;
  height: 56rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  background-color: #1a1a1a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap; /* 核心护盾：强制不换行 */
  flex-shrink: 0;
}

.action-btn-buy.small { padding: 0 20rpx; }

/* 保持原有通用样式 */
.empty-canvas-state { padding: 120rpx 0; text-align: center; }
.empty-canvas-text { font-size: 28rpx; color: #999; }
.sku-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.4); z-index: 998; opacity: 0; transition: opacity 0.3s; }
.sku-mask.fade-in { opacity: 1; }
.sku-panel { position: fixed; bottom: 0; left: 0; right: 0; background-color: #fff; border-radius: 32rpx 32rpx 0 0; z-index: 999; transform: translateY(100%); transition: transform 0.3s; max-height: 75vh; display: flex; flex-direction: column; }
.sku-panel.slide-up { transform: translateY(0); }
.sku-close { position: absolute; top: 24rpx; right: 24rpx; font-size: 40rpx; color: #999; z-index: 10; width: 60rpx; height: 60rpx; text-align: center; line-height: 60rpx;}
.sku-header { display: flex; padding: 40rpx 32rpx; border-bottom: 1rpx solid #f2f2f7; }
.sku-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; background-color: #f5f5f5; object-fit: cover; }
.sku-main { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 10rpx;}
.sku-price { font-size: 44rpx; font-weight: 700; color: #ff3b30; }
.sku-stock { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.sku-stock.out-of-stock { color: #ff3b30; }
.sku-choose-tip { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.sku-scroll-area { flex: 1; padding: 32rpx; overflow-y: auto; }
.sku-section { margin-bottom: 40rpx; }
.sku-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 20rpx; }
.sku-options { display: flex; flex-wrap: wrap; gap: 20rpx; }
.sku-tag { padding: 16rpx 32rpx; background-color: #f5f5f5; border-radius: 12rpx; font-size: 26rpx; color: #1a1a1a; }
.sku-tag.active { background-color: #1a1a1a; color: #fff; }
.sku-actions { display: flex; gap: 20rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eee; }
.sku-btn-cart { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 40rpx; font-size: 28rpx; font-weight: 600; background-color: #f5f5f5; color: #1a1a1a; }
.sku-btn-buy { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 40rpx; font-size: 28rpx; font-weight: 600; background-color: #1a1a1a; color: #fff; }
.sku-btn-confirm.disabled { background-color: #f5f5f5; color: #999; text-align: center; padding: 24rpx 0; border-radius: 40rpx; font-size: 28rpx; margin: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); }

.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 1000; }
.modal-content { background-color: #fff; border-radius: 24rpx; padding: 40rpx; width: 600rpx; box-sizing: border-box;}
.modal-title { font-size: 34rpx; font-weight: 600; color: #1a1a1a; text-align: center; margin-bottom: 30rpx; }
.modal-hint { font-size: 28rpx; color: #666; text-align: center; margin-bottom: 40rpx; line-height: 1.5; }
.modal-buttons { display: flex; gap: 24rpx; }
.modal-btn { flex: 1; padding: 24rpx; border-radius: 12rpx; font-size: 30rpx; font-weight: 500; text-align: center; border: none;}
.modal-btn.cancel { background-color: #f5f5f5; color: #666; }
.modal-btn.confirm { background-color: #1a1a1a; color: #fff; }