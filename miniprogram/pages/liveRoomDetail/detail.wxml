<view class="live-page-wrapper">

  <view class="banner-wrapper">
    <image class="banner-bg" src="{{products[0].coverUrl || ''}}" mode="aspectFill"></image>
    <view class="banner-mask"></view>

    <view class="banner-content">
      <view class="status-tag-row">
        <view class="status-dot-badge {{session.status}}">
          <text class="dot" wx:if="{{session.status === 'live'}}">●</text>
          <text class="status-text">{{session.status === 'live' ? '直播中' : (session.status === 'ended' ? '已结束' : '待开始')}}</text>
        </view>
      </view>

      <view class="banner-main-title">{{session.status === 'live' ? '正在直播' : '直播回顾'}}</view>
      <view class="banner-duration-text" wx:if="{{isAdmin}}">
        <block wx:if="{{session.status === 'live'}}">已直播 {{session.durationStr || '0分钟'}}</block>
        <block wx:else>直播总长 {{session.durationStr || '0分钟'}}</block>
      </view>

      <view class="viewer-row" wx:if="{{isAdmin}}">
        <view class="avatar-group">
          <view class="fake-avatar z3">👩🏻</view>
          <view class="fake-avatar z2">🧑🏼</view>
          <view class="fake-avatar z1">👧🏻</view>
        </view>
        <text class="viewer-count-text">{{session.viewCount || 0}} 人观看过 ></text>
      </view>

      <view class="banner-admin-actions" wx:if="{{isAdmin && session.status !== 'ended'}}">
        <view class="banner-btn black-solid" catchtap="showProductPublish">
          <text class="btn-icon">＋</text> <text>添加商品</text>
        </view>
        <view class="banner-btn white-translucent" catchtap="endSession" wx:if="{{session.status === 'live'}}">
          <text class="btn-icon danger">⏻</text> <text class="danger-text">结束直播</text>
        </view>
      </view>
    </view>
  </view>

  <view class="ended-notice-card" wx:if="{{isAdmin && session.status === 'ended'}}">
    <view class="notice-icon-wrap">
      <text class="notice-icon">✓</text>
    </view>
    <view class="notice-body">
      <view class="notice-title">直播已结束</view>
      <view class="notice-desc">点击下方商品卡片上的 <text class="notice-highlight">转常规</text> 按钮，将其转为常规商品继续售卖</view>
    </view>
  </view>

  <view class="product-list-section">
    <view class="search-bar-container" wx:if="{{products.length > 0 || searchKeyword}}">
      <view class="search-box">
        <icon class="search-icon" type="search" size="14" color="#999"></icon>
        <input class="search-input" placeholder="搜索商品名称..." value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" />
        <view class="clear-icon" wx:if="{{searchKeyword}}" catchtap="clearSearch">×</view>
      </view>
    </view>

    <view class="section-header-row">
      <view class="section-main-title">本场商品 ({{filteredProducts.length}})</view>
      <view class="section-sort-btn" wx:if="{{isAdmin}}">
        <text class="sort-icon">≡</text> <text>管理排序</text>
      </view>
    </view>

    <view class="apple-product-card" wx:for="{{filteredProducts}}" wx:key="id" wx:for-item="product" bindtap="onProductClick" data-product="{{product}}">
      <view class="card-left-img-box">
        <image src="{{product.coverUrl}}" mode="aspectFill" class="card-product-image" />
        <view class="product-index-badge">{{index + 1}}</view>
      </view>

      <view class="card-right-info-box">
        <view class="info-top-row">
          <view class="info-product-name">{{product.name}}</view>
          <view class="info-admin-icons" wx:if="{{isAdmin && canBuy}}">
            <view class="admin-icon-btn edit-btn" catchtap="editProduct" data-product="{{product}}">
              <text>✎</text>
            </view>
            <view class="admin-icon-btn delete-btn" catchtap="deleteProduct" data-product="{{product}}">
              <text>✕</text>
            </view>
          </view>
          <view class="info-drag-icon" wx:elif="{{isAdmin}}">
            <text class="dots-grid">⋮⋮</text>
          </view>
        </view>

        <view class="info-specs-row" wx:if="{{product.skuMatrix && product.skuMatrix.length > 0}}">
          <text>{{product.skuMatrix[0].color || '默认'}}</text>
          <text class="divider">|</text>
          <text>{{product.skuMatrix[0].size || '均码'}}</text>
        </view>
        <view class="info-specs-row" wx:else>
          <text>默认规格</text>
        </view>

        <view class="info-bottom-row">
          <view class="info-price-display">
            <text class="currency-symbol">¥</text>
            <text class="price-integer">{{product.price || product.retailPrice}}</text>
          </view>

          <view class="info-actions-wrap" wx:if="{{canBuy}}">
            <view class="action-btn-cart" catchtap="openSkuPanel" data-product="{{product}}" data-action="cart">
              <text>加购</text>
              <text class="cart-icon">🛒</text>
            </view>
            <view class="action-btn-buy" catchtap="openSkuPanel" data-product="{{product}}" data-action="buy">
              <text>立即购买</text>
            </view>
          </view>

          <view class="info-ended-wrap" wx:elif="{{session.status === 'ended'}}">
            <block wx:if="{{product.convertedToProductId}}">
              <text class="converted-hint-text">已转常规</text>
            </block>
            <block wx:elif="{{isAdmin}}">
              <view class="action-btn-buy small" catchtap="showConvertModal" data-product="{{product}}">
                <text>转常规</text>
              </view>
            </block>
            <block wx:else>
              <text class="ended-hint-text">已结束</text>
            </block>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-canvas-state" wx:if="{{!filteredProducts.length}}">
      <view class="empty-canvas-text">{{searchKeyword ? '未搜到相关商品' : '本场直播暂无商品'}}</view>
    </view>
  </view>
</view>

<view class="sku-mask {{showSku ? 'fade-in' : ''}}" wx:if="{{showSku}}" catchtap="closeSkuPanel"></view>
<view class="sku-panel {{showSku ? 'slide-up' : ''}}">
  <view class="sku-close" catchtap="closeSkuPanel">×</view>
  <view class="sku-header" wx:if="{{currentProduct}}">
    <image class="sku-img" src="{{currentSkuImage || currentProduct.coverUrl}}" mode="aspectFill"></image>
    <view class="sku-main">
      <view class="sku-price">¥{{currentSkuPrice || currentProduct.retailPrice || currentProduct.displayPrice || '0.00'}}</view>
      <view class="sku-stock {{currentSkuStock === 0 && !currentSkuUnlimited ? 'out-of-stock' : ''}}">库存：{{currentSkuStockText || '请选择规格'}}</view>
      <view class="sku-choose-tip">已选：{{selectedColor || '颜色'}} / {{selectedSize || '尺码'}}</view>
    </view>
  </view>
  <!-- 套装商品子项选择 -->
  <scroll-view scroll-y style="max-height: 50vh;" wx:if="{{bundleSelections.length > 0}}">
    <view class="sku-section" wx:for="{{bundleSelections}}" wx:key="index" wx:for-item="sel">
      <view class="sku-title" style="font-weight:bold;color:#333;">{{sel.bundleGroupName}}</view>
      <view class="sku-options" wx:if="{{sel.uniqueColors.length > 0}}">
        <view class="sku-tag {{sel.selectedColor === item ? 'active' : ''}}" wx:for="{{sel.uniqueColors}}" wx:key="*this" wx:for-item="item" bindtap="selectBundleColor" data-index="{{index}}" data-color="{{item}}">{{item}}</view>
      </view>
      <view class="sku-options" wx:if="{{sel.uniqueSizes.length > 0}}">
        <view class="sku-tag {{sel.selectedSize === item ? 'active' : ''}}" wx:for="{{sel.uniqueSizes}}" wx:key="*this" wx:for-item="item" bindtap="selectBundleSize" data-index="{{index}}" data-size="{{item}}">{{item}}</view>
      </view>
      <view wx:if="{{sel.selectedSku}}" style="font-size:24rpx;color:#999;margin-top:4rpx;">
        已选: {{sel.selectedColor}} / {{sel.selectedSize}}  库存: {{sel.selectedSku.unlimitedStock ? '无限' : sel.selectedSku.stock}}
      </view>
    </view>
  </scroll-view>

  <!-- 普通商品颜色/尺码选择 -->
  <scroll-view scroll-y style="max-height: 50vh;" wx:else>
    <view class="sku-section" wx:if="{{uniqueColors.length > 0}}">
      <view class="sku-title">颜色</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedColor === item ? 'active' : ''}}" wx:for="{{uniqueColors}}" wx:key="*this" bindtap="selectColor" data-color="{{item}}">{{item}}</view>
      </view>
    </view>
    <view class="sku-section" wx:if="{{uniqueSizes.length > 0}}">
      <view class="sku-title">尺码</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedSize === item ? 'active' : ''}}" wx:for="{{uniqueSizes}}" wx:key="*this" bindtap="selectSize" data-size="{{item}}">{{item}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 按钮区域 -->
  <block wx:if="{{bundleSelections.length > 0}}">
    <view class="sku-btn-confirm disabled" wx:if="{{!bundleAllSelected}}">请选择所有子项规格</view>
    <view class="sku-btn-confirm" wx:else bindtap="confirmAddToCart" data-action="{{currentAction || 'cart'}}">
      {{currentAction === 'buy' ? '下一步：立即购买' : '确定加入购物车'}}
    </view>
  </block>
  <block wx:else>
    <view class="sku-btn-confirm disabled" wx:if="{{currentSkuStock === 0 && !currentSkuUnlimited}}">已售罄</view>
    <view class="sku-btn-confirm" wx:if="{{currentSkuStock > 0 || currentSkuUnlimited || currentSkuStock === null}}" bindtap="confirmAddToCart" data-action="cart">加入购物车</view>
    <view class="sku-btn-confirm" wx:if="{{currentSkuStock > 0 || currentSkuUnlimited || currentSkuStock === null}}" bindtap="confirmAddToCart" data-action="buy" style="margin-top:10rpx;">立即购买</view>
  </block>
</view>

<view class="modal-mask" wx:if="{{showConvertModal}}" bindtap="hideConvertModal">
  <view class="modal-content" catchtap="true">
    <view class="modal-title">转换为正常商品</view>
    <view class="modal-hint">将把直播商品"{{convertProduct.name}}"的数据带入商品编辑页面，创建新商品后会自动关联。</view>
    <view class="modal-buttons">
      <button class="modal-btn cancel" bindtap="hideConvertModal">取消</button>
      <button class="modal-btn confirm" bindtap="confirmConvert">去创建</button>
    </view>
  </view>
</view>