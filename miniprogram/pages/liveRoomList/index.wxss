/* miniprogram/pages/liveRoomList/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f7f7f7;
  padding-bottom: 20rpx;
}

.content-container {
  padding: 20rpx 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin: 30rpx 0 20rpx 0;
  display: flex;
  align-items: center;
}

.month-header {
  font-size: 24rpx;
  color: #999;
  margin: 40rpx 0 20rpx 0;
}

/* 统一极简干净的卡片风格 */
.clean-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s ease;
}

.clean-card:active {
  transform: scale(0.98);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-title-area {
  flex: 1;
  padding-right: 20rpx;
}

.clean-date {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.clean-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.clean-time, .clean-meta {
  font-size: 24rpx;
  color: #999;
}

/* 图1风格的线框按钮设计 */
.action-btn {
  font-size: 26rpx;
  color: #ff6b81;
  border: 2rpx solid #ff6b81;
  border-radius: 40rpx;
  padding: 8rpx 32rpx;
  flex-shrink: 0;
}

/* 直播中状态填充实色 */
.action-btn.active {
  background-color: #ff6b81;
  color: #ffffff;
}

/* 商品缩略图 - 强制设置为 3:4 的干净比例 */
.clean-products {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.clean-products .product-thumb {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: #f0f0f0;
  object-fit: cover;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.create-btn {
  padding: 20rpx 60rpx;
  background: #333;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 管理员悬浮按钮 - 极简黑 */
.admin-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: #333;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

/* 弹窗 - 保持极简风格 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 600rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.modal-input {
  border: 2rpx solid #eee;
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.modal-buttons {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  font-weight: 500;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #333;
  color: #fff;
}

.loading-state {
  padding: 40rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}