<!-- miniprogram/pages/adminAfterSaleList/adminAfterSaleList.wxml -->
<view class="page-wrapper">

  <view class="list-toolbar">
  <!-- 顶部 Tab 筛选 -->
  <view class="tab-bar">
    <scroll-view scroll-x class="tab-scroll" scroll-into-view="tab-{{currentTab}}" show-scrollbar="{{false}}">
      <view
        class="tab-item {{currentTab === item ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="*this"
        id="tab-{{item}}"
        bindtap="switchTab"
        data-tab="{{item}}">
        {{item}}
        <view class="tab-dot" wx:if="{{item === '待审核' && stats.pending > 0}}">{{stats.pending}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 筛选工具栏 -->
  <view class="filter-bar">
    <view class="filter-left">
      <view class="type-filter">
        <view
          class="type-item {{!currentType ? 'active' : ''}}"
          bindtap="switchType"
          data-type="all">
          全部
        </view>
        <view
          class="type-item {{currentType === 'refund' ? 'active' : ''}}"
          bindtap="switchType"
          data-type="refund">
          仅退款
        </view>
        <view
          class="type-item {{currentType === 'return_refund' ? 'active' : ''}}"
          bindtap="switchType"
          data-type="return_refund">
          退货退款
        </view>
      </view>
    </view>
    <view class="filter-right">
      <view class="search-icon" bindtap="toggleSearch" aria-role="button" aria-label="搜索订单号"><view class="search-symbol"></view></view>
      <view class="refresh-icon" bindtap="refreshList" aria-role="button" aria-label="刷新售后列表">⟳</view>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-bar" wx:if="{{showSearch}}">
    <view class="search-input-wrapper">
      <input
        class="search-input"
        placeholder="搜索订单号"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="doSearch"/>
      <view class="search-btn" bindtap="doSearch">搜索</view>
    </view>
  </view>

  </view>

  <view class="after-sale-list">
    <view class="after-sale-item" wx:for="{{afterSales}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="item-header"><text class="item-status {{item.status}}">{{item.statusDisplay}}</text><text class="item-type">{{item.typeDisplay}}</text></view>
      <view class="item-order"><view class="order-line"><text>订单 {{item.orderId}}</text><text class="copy-hint" catchtap="copyOrderNo" data-orderno="{{item.orderId}}">复制</text></view><view class="list-more-toggle" catchtap="toggleSaleMeta" data-id="{{item.id}}" aria-role="button" aria-label="展开售后单及订单信息">{{expandedSaleId === item.id ? '⌃' : '⌄'}}</view></view>
      <view class="item-products">
        <block wx:if="{{item.items && item.items.length > 0}}">
          <view class="product-item" wx:for="{{item.items}}" wx:for-item="product" wx:key="id">
            <image class="product-img" src="{{product.productImage}}" mode="aspectFill"></image>
            <view class="product-info">
              <view class="product-name">{{product.productName}}</view>
              <view class="admin-product-article-no" user-select="{{true}}">货号：{{product.articleNo || '未填写'}}</view>
              <view class="product-sku">{{product.skuSpec}} / {{product.skuSize}} · ×{{product.qty}}</view>
              <view class="product-detail">{{product.afterSaleType === 'refund' ? '仅退款' : '退货退款'}}</view>
              <view class="fulfillment-summary {{product.fulfillmentKnown ? '' : 'unknown'}}">{{product.fulfillmentCompactText || product.fulfillmentText}}</view>
              <view class="fulfillment-detail" wx:if="{{product.fulfillmentKnown}}">{{product.fulfillmentStockCompactText || product.fulfillmentStockText}}</view>
            </view>
            <view class="product-refund"><text class="refund-list-label">{{item.status === 'pending' ? '申请退款' : '退款金额'}}</text><text>¥{{product.refundAmount}}</text></view>
          </view>
        </block>
        <view class="no-products" wx:else><text>{{item.itemDisplay}}</text><text>总退款：¥{{item.totalRefundAmount}}</text></view>
      </view>
      <view class="list-more-info" wx:if="{{expandedSaleId === item.id}}"><view>售后单号：{{item.id}}</view><view>订单状态：{{item.orderStatusDisplay}}</view><view class="order-seq-line"><text wx:if="{{item.adminSeqNo}}">序号：{{item.adminSeqNo}}</text><text class="refund-channel-tag" wx:if="{{item.peerOrder}}">同行订单</text><text class="refund-channel-tag" wx:elif="{{item.refundPayment.hasOfflinePayment}}">线下付款订单</text></view><view wx:for="{{item.items}}" wx:for-item="product" wx:key="id"><view>{{product.productName}}：{{product.fulfillmentText}}</view><view>{{product.fulfillmentStockText}}</view><view wx:if="{{product.applicationFulfillmentText}}">{{product.applicationFulfillmentText}}</view></view></view>
      <view class="item-footer"><view class="item-times"><text>申请 {{item.createdAtCompact || item.createdAtDisplay}}</text><text>下单 {{item.orderCreatedAtCompact || item.orderCreatedAtDisplay}}</text></view><view class="item-action"><text class="action-btn" wx:if="{{item.status === 'pending'}}">去处理</text><text class="action-btn" wx:else>查看详情</text></view></view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!isLoading && afterSales.length === 0}}">
    <view class="empty-icon"></view>
    <view class="empty-text">暂无售后记录</view>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{isLoading && afterSales.length > 0}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && afterSales.length > 0}}">
    <text>— 没有更多了 —</text>
  </view>

</view>
