@import "../../styles/adminProductArticleNo.wxss";
@import "../../styles/afterSale.wxss";
.page-wrapper { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.list-toolbar { position: sticky; top: 0; z-index: 10; background: #fff; }
.tab-bar { border-bottom: 1rpx solid #ededed; }
.tab-scroll { width: 100%; white-space: nowrap; }
.tab-item { display: inline-flex; align-items: center; gap: 6rpx; position: relative; margin: 0 22rpx; padding: 24rpx 0; font-size: 28rpx; line-height: 40rpx; color: #888; }
.tab-item:first-child { margin-left: 40rpx; }
.tab-item:last-child { margin-right: 40rpx; }
.tab-item.active { color: #111; font-weight: 600; }
.tab-item.active::after { content: ''; position: absolute; bottom: 12rpx; left: 50%; transform: translateX(-50%); width: 40rpx; height: 1rpx; background: #111; }
.tab-dot { font-size: 22rpx; color: #666; font-weight: 400; }
.filter-bar { padding: 18rpx 40rpx 10rpx; display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.filter-left { flex: 1; min-width: 0; }
.type-filter { display: flex; align-items: center; gap: 28rpx; flex-wrap: wrap; }
.type-item { padding: 8rpx 0; color: #777; font-size: 24rpx; }
.type-item.active { color: #111; font-weight: 500; }
.filter-right { display: flex; align-items: center; gap: 20rpx; flex-shrink: 0; }
.search-icon, .refresh-icon { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 48rpx; font-size: 38rpx; color: #444; }
.search-symbol { position: relative; width: 24rpx; height: 24rpx; border: 2rpx solid #666; border-radius: 50%; margin-right: 8rpx; }
.search-symbol::after { content: ''; position: absolute; right: -9rpx; bottom: -4rpx; height: 2rpx; width: 12rpx; background: #666; transform: rotate(45deg); }
.search-bar { padding: 8rpx 40rpx 28rpx; }
.search-input-wrapper { display: flex; align-items: center; gap: 12rpx; padding: 0 20rpx; background: #f5f5f5; border-radius: 8rpx; }
.search-input { flex: 1; min-width: 0; height: 68rpx; font-size: 26rpx; }
.search-btn { color: #666; font-size: 22rpx; padding: 8rpx; }
.after-sale-list { margin: 8rpx 40rpx 0; border-top: 1rpx solid #ededed; }
.after-sale-item { padding: 28rpx 0; border-bottom: 1rpx solid #ededed; }
.item-header { display: flex; flex-direction: row-reverse; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; }
.item-status { font-size: 24rpx; color: #777; }
.item-status::before { content: ''; display: inline-block; width: 12rpx; height: 12rpx; margin-right: 8rpx; border-radius: 50%; background: #999; }
.item-status.pending { color: #b18747; }
.item-status.pending::before { background: #dfa745; }
.item-status.approved::before, .item-status.received::before, .item-status.refunded::before { background: #64876a; }
.item-status.rejected::before { background: #b56558; }
.item-type { font-size: 26rpx; color: #222; font-weight: 500; }
.item-order { display: flex; align-items: center; gap: 8rpx; margin-bottom: 24rpx; }
.order-meta { min-width: 0; }
.order-line { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: #888; word-break: break-all; }
.copy-hint { font-size: 20rpx; padding: 0 6rpx; }
.list-more-toggle { margin-left: auto; padding: 0 6rpx; font-size: 24rpx; color: #aaa; flex-shrink: 0; }
.item-products { display: flex; flex-direction: column; gap: 20rpx; }
.product-item { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12rpx 20rpx; }
.product-img { width: 140rpx; height: 176rpx; border-radius: 4rpx; background: #f7f7f7; flex-shrink: 0; }
.product-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.product-name { color: #222; font-size: 28rpx; font-weight: 500; line-height: 40rpx; word-break: break-all; }
.product-info .admin-product-article-no { margin-top: 0; font-size: 22rpx; line-height: 32rpx; }
.product-sku { font-size: 22rpx; color: #888; line-height: 32rpx; }
.product-detail { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; font-size: 22rpx; line-height: 32rpx; color: #777; }
.product-type { color: #888; }
.product-refund { width: 100%; display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; font-size: 30rpx; font-weight: 600; color: #111; }
.refund-list-label { font-size: 22rpx; color: #777; font-weight: 400; }
.item-footer { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 12rpx; padding-top: 14rpx; border-top: 1rpx solid #eee; }
.item-times { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; color: #999; font-size: 22rpx; line-height: 32rpx; }
.item-action { flex-shrink: 0; }
.action-btn { display: block; border: 1rpx solid #aaa; border-radius: 6rpx; padding: 10rpx 24rpx; color: #333; font-size: 24rpx; line-height: 32rpx; }
.list-more-info { margin-top: 16rpx; padding: 14rpx; background: #fafafa; color: #999; font-size: 22rpx; line-height: 36rpx; word-break: break-all; }
.order-seq-line { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.no-products { display: flex; justify-content: space-between; gap: 16rpx; font-size: 26rpx; color: #888; }
.empty-state { text-align: center; padding: 120rpx 40rpx; }
.empty-icon { width: 64rpx; height: 72rpx; border: 1rpx solid #ddd; border-radius: 4rpx; margin: 0 auto 24rpx; }
.empty-text, .loading-more, .no-more { color: #aaa; font-size: 24rpx; }
.loading-more { display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 32rpx; }
.no-more { text-align: center; padding: 24rpx; }
