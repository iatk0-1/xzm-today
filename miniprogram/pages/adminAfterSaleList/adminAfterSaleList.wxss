/* miniprogram/pages/adminAfterSaleList/adminAfterSaleList.wxss */

.page-wrapper {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* Tab 栏 */
.tab-bar {
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 28rpx 36rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff4444;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: #ff4444;
  border-radius: 2rpx;
}

.tab-dot {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: #ff4444;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
  margin-left: 8rpx;
}

/* 筛选工具栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #fff;
  margin-bottom: 16rpx;
}

.filter-left {
  flex: 1;
}

.type-filter {
  display: flex;
  gap: 16rpx;
}

.type-item {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
}

.type-item.active {
  background-color: #fff5f5;
  color: #ff4444;
}

.filter-right {
  display: flex;
  gap: 24rpx;
}

.search-icon,
.refresh-icon {
  font-size: 40rpx;
  color: #999;
}

/* 搜索框 */
.search-bar {
  padding: 16rpx 24rpx;
  background-color: #fff;
  margin-bottom: 16rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background-color: transparent;
}

.search-btn {
  padding: 8rpx 24rpx;
  background-color: #ff4444;
  color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
}

/* 售后列表 */
.after-sale-list {
  padding: 0 24rpx;
}

.after-sale-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-id {
  font-size: 26rpx;
  color: #999;
}

.item-status {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  background-color: #f0f0f0;
  color: #666;
}

.item-status.pending {
  background-color: #fff3e0;
  color: #f57c00;
}

.item-status.approved {
  background-color: #e3f2fd;
  color: #1976d2;
}

.item-status.rejected {
  background-color: #ffebee;
  color: #c62828;
}

.item-status.received,
.item-status.refunded {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.item-type {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  background-color: #f0f0f0;
  color: #666;
}

.item-type.refund {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.item-type.return_refund {
  background-color: #fce4ec;
  color: #c2185b;
}

/* 订单号 */
.item-order {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 20rpx;
  padding: 12rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}

.order-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.admin-seq {
  align-self: flex-start;
  font-size: 22rpx;
  color: #576b95;
  background: #eef3fb;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.order-label {
  font-size: 24rpx;
  color: #999;
}

.order-no {
  flex: 1;
  font-size: 26rpx;
  color: #111;
}

.copy-hint {
  font-size: 22rpx;
  color: #ff4444;
}

/* 商品列表 */
.item-products {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.product-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}

.product-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.product-name {
  font-size: 26rpx;
  color: #111;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.product-sku {
  font-size: 22rpx;
  color: #999;
}

.product-detail {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.product-detail text {
  font-size: 24rpx;
  color: #666;
}

.product-type {
  padding: 4rpx 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  font-size: 20rpx;
}

.product-refund {
  font-size: 30rpx;
  color: #ff4444;
  font-weight: 600;
  flex-shrink: 0;
}

.no-products {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}

.no-products text {
  font-size: 26rpx;
  color: #666;
}

/* 底部信息 */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

.item-action {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 32rpx;
  background-color: #ff4444;
  color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.action-btn.view {
  background-color: #f0f0f0;
  color: #666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #f0f0f0;
  border-top-color: #ff4444;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more text {
  font-size: 24rpx;
  color: #ccc;
}
