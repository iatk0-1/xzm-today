.chat-page {
  display: flex; flex-direction: column;
  height: 100vh; width: 100vw; overflow: hidden;
  background: #f0f2f5;
  box-sizing: border-box;
}

.nav-bar {
  display: flex; align-items: center;
  height: 44px; padding: 0 16px;
  background: #fff; border-bottom: 1rpx solid #e5e5e5;
  flex-shrink: 0; z-index: 10;
}
.nav-back { padding-right: 12px; }
.back-icon { font-size: 20px; color: #333; }
.nav-title { font-size: 16px; font-weight: bold; }

/* 消息列表 */
.msg-list {
  flex: 1; overflow-y: auto; overflow-x: hidden;
  padding: 12px; box-sizing: border-box;
}
.msg-list::-webkit-scrollbar { width: 0; }
.msg-loading, .msg-empty { text-align: center; color: #999; font-size: 12px; padding: 20px; }

.msg-item { margin-bottom: 16px; display: flex; flex-direction: column; }
.msg-left { align-items: flex-start; }
.msg-right { align-items: flex-end; }

.msg-bubble {
  max-width: 70%; padding: 10px 14px; border-radius: 8px;
  font-size: 14px; line-height: 1.5; word-break: break-all;
  box-sizing: border-box;
}
.bubble-left { background: #fff; color: #333; }
.bubble-right { background: #4a6cf7; color: #fff; }

.msg-image {
  max-width: 50%; max-height: 160px; border-radius: 6px;
}
.msg-right .msg-image { margin-right: 0; }

.msg-video {
  width: 240px; height: 180px; border-radius: 6px;
}

.msg-product-card {
  display: flex; align-items: center; background: #fff;
  border-radius: 8px; padding: 8px; max-width: 260px;
  border: 1rpx solid #e0e0e0; box-sizing: border-box;
}
.mpc-thumb { width: 48px; height: 48px; border-radius: 4px; }
.mpc-info { flex: 1; margin-left: 8px; overflow: hidden; }
.mpc-title { font-size: 12px; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mpc-price { font-size: 13px; color: #e53935; font-weight: bold; margin-top: 2px; }

.msg-time { font-size: 10px; color: #bbb; margin-top: 4px; }

/* 悬浮商品卡片 — 在输入栏上方 */
.product-float-card {
  display: flex; align-items: center;
  margin: 0 12px 8px 12px; padding: 10px;
  background: #fff; border-radius: 8px;
  box-shadow: 0 -2px 8px rgba(0,0,0,0.06);
  flex-shrink: 0; box-sizing: border-box;
}
.card-close {
  position: absolute; top: 2px; right: 8px;
  font-size: 18px; color: #999;
}
.card-thumb { width: 48px; height: 48px; border-radius: 4px; }
.card-info { flex: 1; margin-left: 10px; overflow: hidden; }
.card-title { font-size: 13px; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-price { font-size: 14px; color: #e53935; font-weight: bold; margin-top: 4px; }
.card-send-btn {
  background: #4a6cf7; color: #fff; font-size: 12px;
  padding: 4px 12px; border-radius: 14px; margin-left: 8px; flex-shrink: 0;
}

/* 底部输入栏 */
.input-bar {
  display: flex; align-items: center;
  padding: 8px 10px; background: #fff;
  border-top: 1rpx solid #e5e5e5;
  flex-shrink: 0; box-sizing: border-box;
  padding-bottom: calc(8px + env(safe-area-inset-bottom));
}
.btn-image {
  width: 32px; height: 32px; line-height: 32px; text-align: center;
  font-size: 20px; color: #666; background: #f5f5f5; border-radius: 16px; margin-right: 8px;
}
.msg-input {
  flex: 1; height: 36px; background: #f5f5f5; border-radius: 18px;
  padding: 0 14px; font-size: 14px; box-sizing: border-box;
}
.btn-send {
  width: 52px; height: 32px; line-height: 32px; text-align: center;
  background: #4a6cf7; color: #fff; font-size: 13px; border-radius: 16px; margin-left: 8px;
}
