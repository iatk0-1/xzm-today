<!-- miniprogram/pages/afterSaleDetail/afterSaleDetail.wxml -->
<view class="page-wrapper" wx:if="{{afterSale}}">

  <!-- 售后状态卡片 -->
  <view class="status-card {{afterSale.status}}">
    <view class="status-badge">{{afterSale.statusDisplay}}</view>
    <view class="status-desc" wx:if="{{afterSale.status === 'cancelled' && afterSale.rejectReason}}">{{afterSale.rejectReason}}</view>
    <view class="refund-amount">¥ {{afterSale.totalRefundAmount}}</view>
    <view class="refund-channel-summary" wx:if="{{afterSale.refundPayment}}">
      <view>线上退款 ¥{{afterSale.refundPayment.onlineAmount}} · 线下退款 ¥{{afterSale.refundPayment.offlineAmount}}</view>
      <view wx:if="{{afterSale.status !== 'pending' && afterSale.refundPayment.hasAdjustedAmounts}}">原申请：线上 ¥{{afterSale.refundPayment.requestedOnlineAmount}} · 线下 ¥{{afterSale.refundPayment.requestedOfflineAmount}}</view>
      <view wx:if="{{afterSale.refundPayment.offlineAmount > 0}}">线下退款请联系客服处理。</view>
      <view wx:if="{{afterSale.refundPayment.historicalEstimate}}">历史申请渠道分摊为参考，实际金额以退款记录为准。</view>
    </view>
    <view class="status-desc">
      <text wx:if="{{afterSale.type === 'refund'}}">仅退款</text>
      <text wx:else>退货退款</text>
      <text> · 共 {{afterSale.totalQty}} 件商品</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section" wx:if="{{afterSale.orderId}}">
    <view class="section-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <view class="info-value-box">
        <text class="info-value">{{afterSale.orderId}}</text>
        <text class="copy-btn" catchtap="copyOrderNo">复制</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{afterSale.orderDetail}}">
    <view class="section-title">关联订单详情</view>
    <view class="info-group">
      <view class="info-row">
        <text class="info-label">订单状态</text>
        <text class="info-value">{{afterSale.orderDetail.statusDisplay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{afterSale.orderDetail.createdAtDisplay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">收货人</text>
        <text class="info-value">{{afterSale.orderDetail.recipientName}} {{afterSale.orderDetail.recipientPhone}}</text>
      </view>
      <view class="info-row info-row-top">
        <text class="info-label">收货地址</text>
        <view class="info-value-box info-value-box-column">
          <text class="info-value info-value-multiline">{{afterSale.orderDetail.recipientAddress}}</text>
          <text class="copy-btn" catchtap="copyRecipientInfo">复制</text>
        </view>
      </view>
    </view>
    <view class="order-items-list">
      <view class="order-item-row" wx:for="{{afterSale.orderDetail.items}}" wx:key="id">
        <image class="item-img" src="{{item.skuImageUrl || item.productImage}}" mode="aspectFill"></image>
        <view class="item-info">
          <view class="item-name">{{item.productName}}</view>
          <view class="item-sku">{{item.productSpec || '图片色'}} / {{item.productSize || '均码'}}</view>
          <view class="item-detail-row">
            <text class="item-qty">×{{item.qty}}</text>
            <text class="item-type" wx:if="{{item.afterSaleStatusDisplay}}">{{item.afterSaleStatusDisplay}}</text>
          </view>
        </view>
        <view class="item-refund">¥ {{item.salePriceDisplay}}</view>
      </view>
    </view>
    <view class="amount-group">
      <view class="info-row">
        <text class="info-label">商品总价</text>
        <text class="info-value">¥ {{afterSale.orderDetail.totalPriceDisplay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">实付款</text>
        <text class="info-value amount-strong">¥ {{afterSale.orderDetail.payAmountDisplay}}</text>
      </view>
    </view>
  </view>

  <!-- 商品信息列表 -->
  <view class="section">
    <view class="section-title">商品清单</view>
    <view class="items-list">
      <view class="item-row" wx:for="{{afterSale.items}}" wx:key="id">
        <image class="item-img" src="{{item.displayImage}}" mode="aspectFill"></image>
        <view class="item-info">
          <view class="item-name">{{item.productName}}</view>
          <view class="item-sku">{{item.skuSpec}} / {{item.skuSize}}</view>
          <view class="item-detail-row">
            <text class="item-qty">×{{item.applicationQty}}</text>
            <text class="item-type">{{item.applicationType === 'refund' ? '仅退款' : '退货退款'}}</text>
          </view>
        </view>
        <view class="item-refund">¥ {{item.applicationRefundAmount}}</view>
      </view>
    </view>
  </view>

  <!-- 退货物流信息（仅退货退款显示） -->
  <view class="section" wx:if="{{afterSale.type === 'return_refund'}}">
    <view class="return-logistics-header">
      <view class="section-title return-logistics-title">退货物流</view>
      <view class="return-logistics-action" wx:if="{{afterSale.canModifyReturnShipping}}" bindtap="shipReturnGoods">
        {{afterSale.returnExpressNo ? '修改' : '新增'}}
      </view>
    </view>
    <view class="logistics-info" wx:if="{{afterSale.returnExpressNo}}">
      <view class="logistics-row">
        <text class="logistics-label">快递公司</text>
        <text class="logistics-value">{{afterSale.returnExpressName}}</text>
      </view>
      <view class="logistics-row">
        <text class="logistics-label">快递单号</text>
        <text class="logistics-value">{{afterSale.returnExpressNo}}</text>
        <text class="copy-btn" bindtap="copyExpressNo">复制</text>
      </view>
      <view class="logistics-row" wx:if="{{afterSale.returnShippedAt}}">
        <text class="logistics-label">发货时间</text>
        <text class="logistics-value">{{afterSale.returnShippedAtDisplay}}</text>
      </view>
    </view>
    <view class="no-logistics" wx:if="{{!afterSale.returnExpressNo}}">
      <text>还未填写退货物流信息</text>
    </view>
  </view>

  <!-- 售后原因 -->
  <view class="section">
    <view class="section-title">售后原因</view>
    <view class="reason-content">{{afterSale.reason || '未填写'}}</view>
  </view>

  <!-- 凭证图片 -->
  <view class="section" wx:if="{{afterSale.evidenceUrls && afterSale.evidenceUrls.length > 0}}">
    <view class="section-title">凭证图片</view>
    <view class="evidence-images">
      <image
        class="evidence-img"
        wx:for="{{afterSale.evidenceUrls.split(',') }}"
        wx:key="*this"
        src="{{item}}"
        mode="aspectFill"
        bindtap="previewImage"
        data-index="{{index}}"></image>
    </view>
  </view>

  <!-- 售后进度时间轴 -->
  <view class="section">
    <view class="section-title">售后进度</view>
    <view class="timeline">
      <view class="timeline-item" wx:for="{{timeline}}" wx:key="index">
        <view class="timeline-node {{index === timeline.length - 1 ? 'last' : ''}}">
          <view class="timeline-dot"></view>
          <view class="timeline-line" wx:if="{{index < timeline.length - 1}}"></view>
        </view>
        <view class="timeline-content">
          <view class="timeline-status">{{item.status}}</view>
          <view class="timeline-time">{{item.time}}</view>
          <view class="timeline-desc">{{item.description}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="action-bar" wx:if="{{afterSale.status === 'pending'}}">
    <view class="action-btn-group">
      <view class="btn-ghost" bindtap="cancelAfterSale">撤销申请</view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 退货物流表单：先选快递公司，再填单号，一次提交 -->
  <view class="return-shipping-mask" wx:if="{{showReturnShippingModal}}" bindtap="closeReturnShippingModal" catchtouchmove="stopReturnShippingEvent">
    <view class="return-shipping-dialog" catchtap="stopReturnShippingEvent">
      <view class="return-shipping-title">{{afterSale.returnExpressNo ? '修改退货物流' : '填写退货物流'}}</view>
      <view class="return-shipping-form">
        <view class="return-shipping-row return-express-row">
          <text class="return-shipping-label">快递公司</text>
          <view id="return-express-select" class="return-shipping-field return-express-select {{!returnExpressCode ? 'placeholder' : ''}}" bindtap="toggleReturnExpressOptions">
            <text>{{returnExpressName || '请选择快递公司'}}</text>
            <text class="return-express-arrow">{{showReturnExpressOptions ? '⌃' : '⌄'}}</text>
          </view>
          <scroll-view class="return-express-options" wx:if="{{showReturnExpressOptions}}" scroll-y="true">
            <view class="return-express-option {{returnExpressCode === item.code ? 'selected' : ''}}" wx:for="{{returnExpressOptions}}" wx:key="code" data-code="{{item.code}}" bindtap="selectReturnExpress">
              <text>{{item.name}}</text>
              <text wx:if="{{returnExpressCode === item.code}}">✓</text>
            </view>
          </scroll-view>
        </view>
        <view class="return-shipping-row">
          <text class="return-shipping-label">快递单号</text>
          <input id="return-express-no" class="return-shipping-field return-express-input" placeholder="请输入快递单号" placeholder-class="return-input-placeholder" value="{{returnExpressNo}}" maxlength="100" disabled="{{isSubmittingReturnShipping}}" bindinput="onReturnExpressNoInput" bindfocus="onReturnExpressNoFocus" />
        </view>
        <view class="return-shipping-error" wx:if="{{returnShippingError}}">{{returnShippingError}}</view>
      </view>
      <view class="return-shipping-actions">
        <button class="return-shipping-button cancel" bindtap="closeReturnShippingModal" disabled="{{isSubmittingReturnShipping}}">取消</button>
        <button id="return-shipping-submit" class="return-shipping-button submit" bindtap="submitReturnShipping" loading="{{isSubmittingReturnShipping}}" disabled="{{isSubmittingReturnShipping}}">{{isSubmittingReturnShipping ? '提交中' : '提交'}}</button>
      </view>
    </view>
  </view>
</view>
