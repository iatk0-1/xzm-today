<view class="page-wrapper buyer-detail-page" wx:if="{{afterSale}}">
  <view class="status-card {{afterSale.status}}">
    <view class="status-badge">{{afterSale.status === 'approved' ? '审核通过' : afterSale.statusDisplay}}</view>
    <view class="status-hint" wx:if="{{afterSale.statusHint}}">{{afterSale.statusHint}}</view>
    <view class="status-hint" wx:if="{{afterSale.status === 'cancelled' && afterSale.rejectReason}}">{{afterSale.rejectReason}}</view>
    <view class="refund-caption">{{afterSale.refundAmountLabel}}</view>
    <view class="refund-amount">¥{{afterSale.displayRefundAmount}}</view>
    <view class="status-meta">{{afterSale.typeDisplay}} · 共 {{afterSale.totalQty}} 件商品</view>
    <view class="status-adjustment" wx:if="{{afterSale.hasAdjustedTotal}}">原申请 ¥{{afterSale.applicationRefundAmount}} · {{afterSale.applicationTotalQty}} 件</view>

    <view class="refund-channel-summary" wx:if="{{afterSale.showRefundBreakdown}}">
      <view class="channel-amounts">
        <view class="channel-row"><text>线上退款</text><text>¥{{afterSale.refundPayment.onlineAmount}}</text></view>
        <view class="channel-row" wx:if="{{afterSale.showOfflineRefund}}"><text>线下退款</text><text>¥{{afterSale.refundPayment.offlineAmount}}</text></view>
      </view>
      <view class="channel-note" wx:if="{{afterSale.status !== 'pending' && afterSale.refundPayment.hasAdjustedAmounts}}">原申请：线上 ¥{{afterSale.refundPayment.requestedOnlineAmount}}<text wx:if="{{afterSale.showOfflineRefund}}"> · 线下 ¥{{afterSale.refundPayment.requestedOfflineAmount}}</text></view>
      <view class="channel-note" wx:if="{{afterSale.showOfflineRefund && afterSale.refundPayment.offlineAmount > 0}}">线下退款请联系客服处理。</view>
      <view class="channel-note" wx:if="{{afterSale.refundPayment.historicalEstimate}}">历史申请渠道分摊为参考，实际金额以退款记录为准。</view>
    </view>
  </view>
<view class="section return-logistics-section" wx:if="{{afterSale.type === 'return_refund' && (afterSale.status !== 'pending' || afterSale.returnExpressNo)}}">
    <view class="return-logistics-header">
      <view><view class="section-title return-logistics-title">退货物流</view><view class="section-note" wx:if="{{afterSale.canModifyReturnShipping && !afterSale.returnExpressNo}}">寄回商品后，请填写快递公司及单号</view></view>
      <view class="return-logistics-action" wx:if="{{afterSale.canModifyReturnShipping}}" bindtap="shipReturnGoods">
        {{afterSale.returnExpressNo ? '修改物流' : '填写退货物流'}}
      </view>
    </view>
    <view class="logistics-info" wx:if="{{afterSale.returnExpressNo}}">
      <view class="logistics-row">
        <text class="logistics-label">快递公司</text>
        <text class="logistics-value">{{afterSale.returnExpressName}}</text>
      </view>
      <view class="logistics-row">
        <text class="logistics-label">快递单号</text>
        <text class="logistics-value">{{afterSale.returnExpressNo}}</text>
        <text class="copy-btn" bindtap="copyExpressNo">复制</text>
      </view>
      <view class="logistics-row" wx:if="{{afterSale.returnShippedAt}}">
        <text class="logistics-label">发货时间</text>
        <text class="logistics-value">{{afterSale.returnShippedAtDisplay}}</text>
      </view>
    </view>
    <view class="no-logistics" wx:if="{{!afterSale.returnExpressNo && !afterSale.canModifyReturnShipping}}">
      <text>还未填写退货物流信息</text>
    </view>
  </view>
<view class="section">
    <view class="section-title">售后商品</view>
    <view class="items-list">
      <view class="item-row" wx:for="{{afterSale.items}}" wx:key="id">
        <image class="item-img" src="{{item.displayImage}}" mode="aspectFill"></image>
        <view class="item-info">
          <view class="item-name">{{item.productName}}</view>
          <view class="item-sku">{{item.skuSpec}} / {{item.skuSize}}</view>
          <view class="item-detail-row">
            <text>{{item.applicationType === 'refund' ? '仅退款' : '退货退款'}} · ×{{item.applicationQty}}</text>
          </view>
        </view>
        <view class="item-refund">¥ {{item.applicationRefundAmount}}</view>
      </view>
    </view>
  </view>
<view class="section">
    <view class="section-title">售后进度</view>
    <view class="timeline">
      <view class="timeline-item" wx:for="{{timelineView}}" wx:key="index">
        <view class="timeline-node {{item.waiting ? 'waiting' : (index === 0 ? 'current' : '')}}">
          <view class="timeline-dot"></view>
          <view class="timeline-line" wx:if="{{index < timelineView.length - 1}}"></view>
        </view>
        <view class="timeline-content">
          <view class="timeline-status">{{item.status}}</view>
          <view class="timeline-time" wx:if="{{item.time && item.time !== '-'}}">{{item.time}}</view>
          <view class="timeline-desc" wx:if="{{item.description}}">{{item.description}}</view>
        </view>
      </view>
    </view>
  </view>
  <view class="section application-section">
    <view class="section-title">申请信息</view>
    <view class="application-row"><text class="application-label">售后原因</text><text class="application-value">{{afterSale.reasonTitle}}</text></view>
    <view class="application-row" wx:if="{{afterSale.reasonDescription}}"><text class="application-label">补充说明</text><text class="application-value">{{afterSale.reasonDescription}}</text></view>
    <view class="application-row" wx:if="{{afterSale.evidenceImages.length}}"><text class="application-label">凭证图片</text><view class="evidence-images"><image class="evidence-img" wx:for="{{afterSale.evidenceImages}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}"></image></view></view>
  </view>
  <view class="section related-order-section" wx:if="{{afterSale.orderId || afterSale.orderDetail}}"><view class="section-title">关联订单</view><view class="related-order-card"><view class="order-disclosure" bindtap="toggleOrderDetail" aria-role="button" aria-expanded="{{showOrderDetail}}"><view class="related-order-number"><text>订单号 {{afterSale.orderId}}</text><text class="copy-btn" catchtap="copyOrderNo">复制</text></view><text class="disclosure-arrow">{{showOrderDetail ? '⌃' : '⌄'}}</text></view><view class="section-note" wx:if="{{!showOrderDetail}}">展开查看商品、收货信息及实付款</view></view><view class="order-expanded" wx:if="{{showOrderDetail}}">
    <view class="info-group">
      <view class="info-row">
        <text class="info-label">订单状态</text>
        <text class="info-value">{{afterSale.orderDetail.statusDisplay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{afterSale.orderDetail.createdAtDisplay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">收货人</text>
        <text class="info-value">{{afterSale.orderDetail.recipientName}} {{afterSale.orderDetail.recipientPhone}}</text>
      </view>
      <view class="info-row info-row-top">
        <text class="info-label">收货地址</text>
        <view class="info-value-box info-value-box-column">
          <text class="info-value info-value-multiline">{{afterSale.orderDetail.recipientAddress}}</text>
          <text class="copy-btn" catchtap="copyRecipientInfo">复制</text>
        </view>
      </view>
    </view>
    <view class="order-items-list">
      <view class="order-item-row" wx:for="{{afterSale.orderDetail.items}}" wx:key="id">
        <image class="item-img" src="{{item.skuImageUrl || item.productImage}}" mode="aspectFill"></image>
        <view class="item-info">
          <view class="item-name">{{item.productName}}</view>
          <view class="item-sku">{{item.productSpec || '图片色'}} / {{item.productSize || '均码'}}</view>
          <view class="item-detail-row">
            <text class="item-qty">×{{item.qty}}</text>
            <text class="item-type" wx:if="{{item.afterSaleStatusDisplay}}">{{item.afterSaleStatusDisplay}}</text>
          </view>
        </view>
        <view class="related-order-prices">
          <text class="related-order-original-price" wx:if="{{item.showOriginalPrice}}">原价：￥{{item.originalUnitPrice}}</text>
          <text class="item-refund">{{item.displayUnitPrice != null ? '￥' + item.displayUnitPrice : '--'}}</text>
        </view>
      </view>
    </view>
    <view class="amount-group">
      <view class="info-row">
        <text class="info-label">商品总价</text>
        <text class="info-value">¥ {{afterSale.orderDetail.totalPriceDisplay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">实付款</text>
        <text class="info-value amount-strong">¥ {{afterSale.orderDetail.payAmountDisplay}}</text>
      </view>
    </view>
    </view><view class="application-row secondary-meta" wx:if="{{showOrderDetail}}"><text class="application-label">售后单号</text><text class="application-value">{{afterSale.id}}</text></view><view class="application-row secondary-meta" wx:if="{{showOrderDetail && afterSale.createdAtDisplay}}"><text class="application-label">申请时间</text><text class="application-value">{{afterSale.createdAtDisplay}}</text></view></view>
  <!-- 底部操作按钮 -->
  <view class="action-bar" wx:if="{{afterSale.status === 'pending'}}">
    <view class="action-btn-group">
      <view class="btn-ghost" bindtap="cancelAfterSale">撤销申请</view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 退货物流表单：先选快递公司，再填单号，一次提交 -->
  <view class="return-shipping-mask" wx:if="{{showReturnShippingModal}}" bindtap="closeReturnShippingModal" catchtouchmove="stopReturnShippingEvent">
    <view class="return-shipping-dialog" catchtap="stopReturnShippingEvent">
      <view class="sheet-handle"></view>
      <view class="return-shipping-title"><text>{{afterSale.returnExpressNo ? '修改退货物流' : '填写退货物流'}}</text><text class="sheet-close" bindtap="closeReturnShippingModal" aria-role="button" aria-label="关闭退货物流">×</text></view>
      <view class="return-shipping-form">
        <view class="return-shipping-row return-express-row">
          <text class="return-shipping-label">快递公司</text>
          <view id="return-express-select" class="return-shipping-field return-express-select {{!returnExpressCode ? 'placeholder' : ''}}" bindtap="toggleReturnExpressOptions">
            <text>{{returnExpressName || '请选择快递公司'}}</text>
            <text class="return-express-arrow">{{showReturnExpressOptions ? '⌃' : '⌄'}}</text>
          </view>

        </view>
          <scroll-view class="return-express-options" wx:if="{{showReturnExpressOptions}}" scroll-y="true">
            <view class="return-express-option {{returnExpressCode === item.code ? 'selected' : ''}}" wx:for="{{returnExpressOptions}}" wx:key="code" data-code="{{item.code}}" bindtap="selectReturnExpress">
              <text>{{item.name}}</text>
              <text wx:if="{{returnExpressCode === item.code}}">✓</text>
            </view>
          </scroll-view>
        <view class="return-shipping-row">
          <text class="return-shipping-label">快递单号</text>
          <input id="return-express-no" class="return-shipping-field return-express-input" placeholder="请输入快递单号" placeholder-class="return-input-placeholder" value="{{returnExpressNo}}" maxlength="100" disabled="{{isSubmittingReturnShipping}}" bindinput="onReturnExpressNoInput" bindfocus="onReturnExpressNoFocus" />
        </view>
        <view class="shipping-form-tip">请核对物流信息后提交</view>
        <view class="return-shipping-error" wx:if="{{returnShippingError}}">{{returnShippingError}}</view>
      </view>
      <view class="return-shipping-actions">
        <button class="return-shipping-button cancel" bindtap="closeReturnShippingModal" disabled="{{isSubmittingReturnShipping}}">取消</button>
        <button id="return-shipping-submit" class="return-shipping-button submit" bindtap="submitReturnShipping" loading="{{isSubmittingReturnShipping}}" disabled="{{isSubmittingReturnShipping}}">{{isSubmittingReturnShipping ? '提交中' : '提交'}}</button>
      </view>
    </view>
  </view>
</view>
