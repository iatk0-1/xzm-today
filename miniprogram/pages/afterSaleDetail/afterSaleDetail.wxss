/* miniprogram/pages/afterSaleDetail/afterSaleDetail.wxss */

.page-wrapper {
  padding-bottom: 120rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4444 100%);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.status-badge {
  padding: 8rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fff;
}

.status-badge.refunded {
  background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);
}

.status-badge.rejected {
  background: linear-gradient(135deg, #9e9e9e 0%, #757575 100%);
}

.refund-amount {
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
}

.status-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 通用区块 */
.section {
  background-color: #fff;
  margin-bottom: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 24rpx;
}

/* 商品列表 */
.items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.item-name {
  font-size: 26rpx;
  color: #111;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.item-sku {
  font-size: 22rpx;
  color: #999;
}

.item-detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-qty {
  font-size: 24rpx;
  color: #666;
}

.item-type {
  padding: 4rpx 12rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  font-size: 22rpx;
  color: #666;
}

.item-refund {
  font-size: 32rpx;
  color: #ff4444;
  font-weight: 600;
  margin-left: 16rpx;
}

/* 物流信息 */
.logistics-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.logistics-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logistics-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
}

.logistics-value {
  flex: 1;
  font-size: 28rpx;
  color: #111;
}

.copy-btn {
  padding: 8rpx 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.no-logistics {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 0;
}

/* 原因内容 */
.reason-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 凭证图片 */
.evidence-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.evidence-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

/* 时间轴 */
.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  position: relative;
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  background-color: #ff4444;
  border-radius: 50%;
  z-index: 1;
}

.timeline-node.last .timeline-dot {
  background-color: #ddd;
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  background-color: #f0f0f0;
  margin-top: 8rpx;
}

.timeline-content {
  flex: 1;
  padding-bottom: 32rpx;
}

.timeline-status {
  font-size: 28rpx;
  color: #111;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.timeline-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 加载状态 */
.loading-state {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 1000;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #ff4444;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}
