@import "../../styles/afterSale.wxss";
.return-shipping-title { border-bottom: 1rpx solid #ededed; padding-bottom: 28rpx; }
.return-shipping-form { padding: 12rpx 36rpx 28rpx; }
.return-shipping-row { display: flex; align-items: center; gap: 24rpx; min-height: 88rpx; border-bottom: 1rpx solid #ededed; padding: 16rpx 0; }
.return-shipping-label { width: 144rpx; font-size: 26rpx; color: #444; flex-shrink: 0; }
.return-shipping-field { flex: 1; min-width: 0; height: 64rpx; box-sizing: border-box; padding: 0 16rpx; font-size: 26rpx; color: #333; border-radius: 6rpx; background: #f7f7f7; }
.return-express-select { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; background: #fff; padding-right: 0; }
.return-express-arrow { color: #999; }
.return-express-select.placeholder, .return-input-placeholder { color: #999; }
.return-express-options { height: 240rpx; border: 1rpx solid #eee; border-radius: 4rpx; }
.return-express-option { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 20rpx; font-size: 26rpx; color: #777; }
.return-express-option.selected { background: #f7f7f7; color: #111; }
.shipping-form-tip { margin-top: 28rpx; font-size: 24rpx; color: #999; line-height: 36rpx; }
.return-shipping-error { margin-top: 16rpx; }
.return-shipping-actions { padding-top: 28rpx; }
