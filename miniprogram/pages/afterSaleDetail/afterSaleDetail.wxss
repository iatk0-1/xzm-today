/* miniprogram/pages/afterSaleDetail/afterSaleDetail.wxss */

.page-wrapper {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4444 100%);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.status-badge {
  padding: 8rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fff;
}

.status-card.pending {
  background: #fff3e0;
}

.status-card.pending .status-badge,
.status-card.pending .refund-amount,
.status-card.pending .status-desc,
.status-card.pending .refund-channel-summary {
  color: #a65a00;
}

.status-card.approved,
.status-card.refunded {
  background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);
}

.status-card.rejected {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4444 100%);
}

.refund-amount {
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
}

.status-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 通用区块 */
.section {
  background-color: #fff;
  margin-bottom: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 24rpx;
}

.return-logistics-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.return-logistics-title {
  margin-bottom: 0;
}

.return-logistics-action {
  flex-shrink: 0;
  min-width: 64rpx;
  margin-left: 24rpx;
  color: #ff4444;
  font-size: 26rpx;
  line-height: 44rpx;
  text-align: right;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-row-top {
  align-items: flex-start;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #111;
}

.info-value-box {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.info-value-box .info-value {
  word-break: break-all;
  text-align: right;
}

.info-value-box-column {
  flex-direction: column;
  align-items: flex-end;
}

.info-value-multiline {
  white-space: pre-wrap;
}

.info-group,
.amount-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.order-item-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.amount-group {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.amount-strong {
  font-weight: 600;
  color: #111;
}

/* 商品列表 */
.items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.item-name {
  font-size: 26rpx;
  color: #111;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.item-sku {
  font-size: 22rpx;
  color: #999;
}

.item-detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-qty {
  font-size: 24rpx;
  color: #666;
}

.item-type {
  padding: 4rpx 12rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  font-size: 22rpx;
  color: #666;
}

.item-refund {
  font-size: 32rpx;
  color: #ff4444;
  font-weight: 600;
  margin-left: 16rpx;
}

/* 物流信息 */
.logistics-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.logistics-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logistics-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
}

.logistics-value {
  flex: 1;
  font-size: 28rpx;
  color: #111;
}

.copy-btn {
  padding: 8rpx 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.no-logistics {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 0;
}

/* 原因内容 */
.reason-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 凭证图片 */
.evidence-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.evidence-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

/* 时间轴 */
.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  position: relative;
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  background-color: #ff4444;
  border-radius: 50%;
  z-index: 1;
}

.timeline-node.last .timeline-dot {
  background-color: #ddd;
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  background-color: #f0f0f0;
  margin-top: 8rpx;
}

.timeline-content {
  flex: 1;
  padding-bottom: 32rpx;
}

.timeline-status {
  font-size: 28rpx;
  color: #111;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.timeline-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 与管理员审核栏保持一致，滚动页面时仍可撤销。 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.action-btn-group {
  display: flex;
  justify-content: flex-end;
}

.btn-ghost {
  padding: 24rpx 48rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 加载状态 */
.loading-state {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 1000;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #ff4444;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 退货物流自定义弹窗 */
.return-shipping-mask {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1100;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 18vh 32rpx 0;
  box-sizing: border-box;
}

.return-shipping-dialog {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
}

.return-shipping-title {
  padding: 32rpx 24rpx 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.return-shipping-form {
  padding: 0 28rpx 28rpx;
}

.return-shipping-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.return-shipping-label {
  flex-shrink: 0;
  width: 112rpx;
  font-size: 26rpx;
  color: #333;
}

.return-shipping-field {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #111;
}

.return-express-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.return-express-select.placeholder,
.return-input-placeholder {
  color: #999;
}

.return-express-arrow {
  margin-left: 12rpx;
  color: #999;
}

.return-express-row {
  position: relative;
  z-index: 2;
}

.return-express-options {
  position: absolute;
  left: 128rpx;
  right: 0;
  top: 88rpx;
  width: auto;
  height: 360rpx;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.15);
}

.return-express-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333;
}

.return-express-option.selected {
  background: #fff1f1;
  color: #ff4444;
}

.return-shipping-error {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #e53935;
}

.return-shipping-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 28rpx 28rpx;
}

.return-shipping-button {
  flex: 1;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 84rpx;
}

.return-shipping-button::after {
  border: none;
}

.return-shipping-button.cancel {
  background: #f5f5f5;
  color: #666;
}

.return-shipping-button.submit {
  background: #ff4444;
  color: #fff;
}

.return-shipping-button[disabled] {
  opacity: 0.6;
}

.refund-channel-summary { padding: 18rpx 20rpx; font-size: 24rpx; line-height: 1.8; background: #f5f7fa; border-radius: 10rpx; color: #333; }
.refund-channel-tip { margin-top: 10rpx; color: #777; font-size: 22rpx; line-height: 1.6; }
.refund-channel-error { color: #b23a2e; }
.refund-channel-tag { display: inline-block; padding: 4rpx 12rpx; margin: 8rpx 0; color: #576b95; background: #edf2fa; border-radius: 6rpx; font-size: 22rpx; }

.status-card .refund-channel-summary {
  background: transparent;
  color: #fff;
  padding: 0;
  text-align: center;
}
