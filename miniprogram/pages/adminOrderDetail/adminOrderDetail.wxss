page { background-color: #f2f2f2; }
.admin-detail-wrapper { padding: 16rpx; padding-bottom: 60rpx; }
.loading { text-align: center; padding: 200rpx 0; color: #999; font-size: 28rpx; }

/* === 统一卡片 === */
.info-card, .logistics-card, .after-sale-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx;
}
.section-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 16rpx; }

/* === 状态头 === */
.status-header {
  background: #fff; border-radius: 16rpx; padding: 32rpx 24rpx; margin-bottom: 16rpx; text-align: center;
}
.status-title { font-size: 36rpx; font-weight: 600; color: #1a1a1a; }
.status-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }

/* === 收件地址 === */
.address-card { display: flex; align-items: flex-start; gap: 16rpx; }
.location-icon { font-size: 36rpx; }
.address-content { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.user-row { display: flex; gap: 16rpx; align-items: center; }
.name { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.phone { font-size: 26rpx; color: #666; }
.detail-row { font-size: 26rpx; color: #666; line-height: 1.5; }

/* === 商品列表 === */
.shop-title { font-size: 26rpx; font-weight: 600; color: #666; margin-bottom: 16rpx; }
.goods-item { display: flex; gap: 20rpx; padding-bottom: 16rpx; margin-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0; }
.goods-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.goods-img { width: 120rpx; height: 120rpx; border-radius: 8rpx; background: #f5f5f5; }
.goods-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.goods-title { font-size: 26rpx; color: #1a1a1a; }
.goods-sku { font-size: 22rpx; color: #999; }
.goods-bundle { margin-top: 4rpx; }
.bundle-sub { display: flex; align-items: center; padding: 2rpx 0; }
.bundle-sub-name { font-size: 22rpx; color: #666; margin-right: 6rpx; }
.bundle-sub-spec { font-size: 22rpx; color: #999; }
.bundle-sub-count { font-size: 22rpx; color: #999; }
.goods-price-row { display: flex; justify-content: space-between; align-items: center; margin-top: 6rpx; }
.price { font-size: 28rpx; font-weight: 600; font-family: inherit; }
.count { font-size: 24rpx; color: #999; }

/* 商品备注 */
.goods-remark { display: flex; align-items: flex-start; gap: 8rpx; margin-top: 8rpx; }
.remark-tag { font-size: 20rpx; color: #666; background-color: #f0f0f0; padding: 2rpx 10rpx; border-radius: 6rpx; flex-shrink: 0; }
.remark-text { font-size: 22rpx; color: #888; line-height: 1.5; word-break: break-all; }

.money-breakdown { margin-top: 16rpx; display: flex; flex-direction: column; gap: 8rpx; }
.money-row { display: flex; justify-content: space-between; align-items: center; }
.money-label { font-size: 24rpx; color: #999; }
.money-val { font-size: 24rpx; color: #333; }
.money-row.total { padding-top: 10rpx; border-top: 1rpx solid #f0f0f0; }
.money-val.final { font-size: 30rpx; font-weight: 600; }

/* === 订单信息 === */
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 0; }
.info-label { font-size: 24rpx; color: #999; }
.info-val { font-size: 24rpx; color: #333; font-family: inherit; }
.info-val-box { display: flex; align-items: center; gap: 12rpx; }
.btn-copy { padding: 4rpx 16rpx; font-size: 22rpx; color: #666; background: #f5f5f5; border-radius: 6rpx; }

/* === 物流 === */
.shipment-list { display: flex; flex-direction: column; gap: 16rpx; }
.shipment-item { padding: 20rpx; background: #fafafa; border-radius: 12rpx; }
.shipment-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.shipment-index { font-size: 26rpx; font-weight: 600; color: #1a1a1a; }
.shipment-time { font-size: 22rpx; color: #999; }
.shipment-info { margin-bottom: 12rpx; }
.shipment-items { margin-top: 12rpx; }
.shipment-goods { display: flex; gap: 16rpx; padding: 10rpx 0; }
.goods-qty { font-size: 22rpx; color: #999; }

.waybill-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btn-preview, .btn-cancel-waybill { flex: 1; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 8rpx; font-size: 26rpx; padding: 0; }
.btn-preview { background: #f5f5f5; color: #666; }
.btn-cancel-waybill { background: #1a1a1a; color: #fff; }

.logistics-trace { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #eee; }
.trace-title { font-size: 24rpx; font-weight: 600; color: #666; margin-bottom: 12rpx; }
.trace-list { display: flex; flex-direction: column; gap: 12rpx; }
.trace-item { display: flex; gap: 16rpx; align-items: flex-start; }
.trace-time { min-width: 280rpx; flex-shrink: 0; font-size: 22rpx; color: #999; white-space: nowrap; line-height: 1.6; }
.trace-content { flex: 1; font-size: 24rpx; color: #333; line-height: 1.6; word-break: break-all; }

/* === 售后 === */
.after-sale-list { display: flex; flex-direction: column; gap: 12rpx; }
.after-sale-item { padding: 20rpx; background: #fafafa; border-radius: 8rpx; }
.after-sale-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.after-sale-type { font-size: 26rpx; font-weight: 600; color: #1a1a1a; }
.after-sale-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 4rpx; }
.after-sale-info { display: flex; gap: 20rpx; margin-bottom: 8rpx; }
.after-sale-qty, .after-sale-amount { font-size: 24rpx; color: #666; }
.after-sale-reason { font-size: 24rpx; color: #666; margin-bottom: 8rpx; }
.after-sale-time { font-size: 22rpx; color: #999; }
