<view class="admin-detail-wrapper" wx:if="{{!isLoading && order}}">
  <view class="unbind-pending-banner" wx:if="{{pendingShipmentUnbind}}">
    <view class="unbind-preview-title">有发货解绑等待确认</view>
    <view>原请求 {{pendingShipmentUnbind.requestId}}</view>
    <view>请保留原请求核查，避免重新办理另一笔解绑。</view>
    <view class="unbind-pending-actions">
      <button size="mini" bindtap="retryShipmentUnbind" disabled="{{unbindSaving}}">重试原解绑</button>
      <button size="mini" bindtap="reviewShipmentUnbindWaybill" disabled="{{unbindSaving}}">核查面单后续办</button>
    </view>
  </view>
  <view class="status-header">
    <view class="status-title">{{order.statusDisplay}}</view>
    <view class="peer-order-tag" wx:if="{{order.peerOrder}}">同行订单 · 不参与佣金</view>
    <button class="btn-admin-refund" wx:if="{{order.status === 'pending'}}" bindtap="openPricePanel">修改价格</button>
    <view class="status-desc" wx:if="{{order.status === 'pending'}}">待支付</view>
    <view class="status-desc" wx:if="{{order.status === 'stocking'}}">备货中</view>
    <view class="status-desc" wx:if="{{order.status === 'paid'}}">待发货</view>
    <view class="status-desc" wx:if="{{order.status === 'partial_shipped'}}">部分已发货</view>
    <view class="status-desc" wx:if="{{order.status === 'shipped'}}">已发货</view>
    <view class="status-desc" wx:if="{{order.status === 'completed'}}">交易完成</view>
    <button
      class="btn-admin-refund"
      wx:if="{{order.status === 'stocking' || order.status === 'paid' || order.status === 'partial_shipped' || order.status === 'shipped' || order.status === 'completed'}}"
      bindtap="openRefundPanel">
      主动退款
    </button>
  </view>

  <view class="info-card address-card" wx:if="{{order.recipientName}}">
    <view class="location-icon">📍</view>
    <view class="address-content">
      <view class="user-row">
        <text class="name copyable-text" user-select="{{true}}">{{order.recipientName}}</text>
        <text class="phone copyable-text" user-select="{{true}}">{{order.recipientPhone}}</text>
      </view>
      <view class="detail-row"><text class="copyable-text" user-select="{{true}}">{{order.recipientAddress}}</text></view>
      <view class="address-actions">
        <view class="contact-buyer-btn" bindtap="openRecipientEditor" wx:if="{{order.status === 'pending' || order.status === 'stocking' || order.status === 'paid'}}">修改收件信息</view>
        <view class="copy-recipient-btn" catchtap="copyRecipientInfo">复制收货信息</view>
      </view>
    </view>
  </view>

  <view class="info-card goods-card">
    <view class="shop-title">订单商品</view>
    <view class="goods-item" wx:for="{{order.items}}" wx:key="id" wx:for-index="itemIndex" bindtap="goToProduct" bindtouchstart="onOrderTouchStart" bindtouchmove="onOrderTouchMove" bindtouchend="onOrderTouchEnd" bindtouchcancel="onOrderTouchCancel" data-product-id="{{item.productId}}">
      <image class="goods-img" src="{{item.skuImageUrl || item.productImage}}" mode="aspectFill"></image>
      <view class="goods-info">
        <view class="goods-title"><text class="copyable-text" user-select="{{true}}">{{item.productName}}</text></view>
        <view class="goods-bundle" wx:if="{{item.bundleConfig && item.bundleConfig.length > 0}}">
          <view class="bundle-sub" wx:for="{{item.bundleConfig}}" wx:key="skuId" wx:for-item="sub">
            <text class="bundle-sub-name" user-select="{{true}}">{{sub.bundleGroupName}}:</text>
            <text class="bundle-sub-spec" user-select="{{true}}">{{sub.color}} / {{sub.size}} x {{sub.count}}</text>
          </view>
        </view>
        <view class="goods-sku" wx:else><text user-select="{{true}}">{{item.productSpec || '默认规格'}} / {{item.productSize || '均码'}}</text></view>
        <view class="after-sale-tag" wx:if="{{item.afterSaleSummary && item.afterSaleSummary.hasAfterSale}}">
          {{item.afterSaleSummary.statusText}} {{item.afterSaleSummary.totalQty}}/{{item.totalOrderQty}}
          <text wx:if="{{item.afterSaleSummary.shipmentBlockedQty > 0}}"> · 可发 {{item.afterSaleSummary.canShipQty}}</text>
        </view>
        <view class="goods-price-row">
          <text class="price">¥ {{item.salePrice}}</text>
          <text class="count">x {{item.qty}}</text>
        </view>
        <view class="goods-sku" wx:if="{{order.status === 'stocking' || order.status === 'paid' || order.status === 'partial_shipped'}}">
          已配现货 {{item.stockQty || 0}} · 在途覆盖 {{item.transitQty || 0}} · 待报 {{item.pendingQty || 0}} · 售后冻结 {{item.frozenQty || 0}}
        </view>
        <view class="goods-remark" wx:if="{{item.remark}}">
          <text class="remark-tag">备注</text>
          <text class="remark-text copyable-text" user-select="{{true}}">{{item.remark}}</text>
        </view>
        <view class="goods-remark admin-remark-row" catchtap="openAdminRemarkEditor" data-index="{{itemIndex}}">
          <text class="remark-tag admin-remark-tag">管理员备注</text>
          <text class="remark-text admin-remark-text">{{item.adminRemark || '点击添加'}}</text>
        </view>
      </view>
    </view>

    <view class="money-breakdown">
      <view class="money-row">
        <text class="money-label">商品总价</text>
        <text class="money-val">¥ {{order.goodsAmount}}</text>
      </view>
      <view class="money-row">
        <text class="money-label">运费{{order.shippingRefundStatus === 'success' ? '(已退款)' : ''}}</text>
        <text class="money-val">¥ {{order.shippingFee}}</text>
      </view>
      <view class="money-row total">
        <text class="money-label">{{order.status === 'pending' ? '线上待付' : '线上实付'}}</text>
        <text class="money-val final">¥ {{order.payAmount}}</text>
      </view>
      <view class="money-row" wx:if="{{order.peerOrder || order.priceRevision > 0}}"><text class="money-label">线下已收</text><text class="money-val">¥ {{order.offlinePaidAmount}}</text></view>
      <view class="money-row" wx:if="{{order.peerOrder || order.priceRevision > 0}}"><text class="money-label">成交总额</text><text class="money-val final">¥ {{order.settlementTotalDisplay}}</text></view>
      <button size="mini" wx:if="{{order.shippingRefundStatus === 'failed'}}" bindtap="retryShippingRefund">重试运费退款</button>
    </view>
  </view>

  <view class="info-card pricing-details" wx:if="{{pricing && pricing.revision > 0}}">
    <view class="section-title">实际成交分摊</view>
    <view class="price-item-line" wx:for="{{pricing.items}}" wx:key="orderItemId">
      <text>{{item.productName || '商品'}} × {{item.qty}}</text><text>¥ {{item.settlementAmount}}</text>
    </view>
    <view class="pricing-hint">按成本占比分摊商品成交额，运费单独计入订单。</view>
    <view class="price-history" wx:for="{{pricing.history}}" wx:key="revision">
      <view>第 {{item.revision}} 次改价 · {{item.timeDisplay}}</view>
      <view>线上 ¥{{item.beforeOnlineAmount}} → ¥{{item.onlineAmount}}；线下 ¥{{item.beforeOfflineAmount}} → ¥{{item.offlineAmount}}</view>
      <view>运费 ¥{{item.beforeShippingFee}} → ¥{{item.shippingFee}}</view>
      <view>原因：{{item.reason}} · 操作人 {{item.operatorId}}</view>
    </view>
  </view>
  <view class="info-card" wx:if="{{refundPayments.length}}">
    <view class="section-title">退款收款渠道明细</view>
    <view class="price-history" wx:for="{{refundPayments}}" wx:key="outRefundNo">
      <view>线上 ¥{{item.onlineAmount}} · 线下 ¥{{item.offlineAmount}}</view>
      <view>线上状态：{{item.onlineStatus === 'SUCCESS' ? '已退款' : '处理中或待核对'}}</view>
    </view>
    <view class="pricing-hint">线下退款自行处理；线上退款成功后，系统按整笔退款完成。</view>
  </view>

  <view class="info-card order-info-card">
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <view class="info-val-box">
        <text class="info-val">{{order.outTradeNo || order.id}}</text>
        <view class="btn-copy" bindtap="copyOrderSn">复制</view>
      </view>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-val">{{order.createdAtDisplay}}</text>
    </view>
  </view>

  <view class="info-card logistics-card" wx:if="{{shipments && shipments.length > 0}}">
    <view class="section-title">物流信息</view>
    <view class="shipment-list">
      <view class="shipment-item" wx:for="{{shipments}}" wx:key="id" wx:for-index="shipmentIndex">
        <view class="shipment-header">
          <text class="shipment-index">发货单 {{shipmentIndex + 1}}</text>
          <text class="shipment-time" wx:if="{{item.shippedAtDisplay}}">{{item.shippedAtDisplay}}</text>
        </view>

        <view class="shipment-info">
          <view class="info-row">
            <text class="label">快递公司</text>
            <text class="value">{{item.expressName}}</text>
          </view>
          <view class="info-row">
            <text class="label">快递单号</text>
            <view class="value-box">
              <text class="value">{{item.expressNo}}</text>
              <text class="btn-copy" catchtap="copyExpressNo" data-express-no="{{item.expressNo}}">复制</text>
            </view>
          </view>
        </view>

        <view class="shipment-items">
          <view class="shipment-goods" wx:for="{{item.items}}" wx:for-item="goodsItem" wx:key="id">
            <image class="goods-img" src="{{goodsItem.skuImageUrl || goodsItem.productImage}}" mode="aspectFill"></image>
            <view class="goods-info">
              <view class="goods-title"><text class="copyable-text" user-select="{{true}}">{{goodsItem.productName || '商品'}}</text></view>
              <view class="goods-sku"><text user-select="{{true}}">{{goodsItem.spec || ''}}{{goodsItem.size ? ' / ' + goodsItem.size : ''}}</text></view>
              <view class="goods-qty">x {{goodsItem.shipQty}}</view>
            </view>
          </view>
        </view>

        <view class="waybill-actions" wx:if="{{(order.status === 'paid' || order.status === 'shipped' || order.status === 'partial_shipped') && item.expressNo}}">
          <button class="btn-preview" bindtap="previewWaybill" data-url="{{item.pdfShowUrl}}" wx:if="{{item.pdfShowUrl}}">预览面单</button>
          <button class="btn-partial-unbind" bindtap="openPartialUnbindPanel" data-shipment-index="{{shipmentIndex}}" disabled="{{unbindSaving}}">解绑本单商品</button>
          <button class="btn-cancel-waybill" bindtap="cancelWaybill" data-shipment-id="{{item.id}}" disabled="{{unbindLoading || unbindSaving}}">解绑整个包裹</button>
        </view>

        <view class="logistics-trace" wx:if="{{logisticsTraceMap[item.id] && logisticsTraceMap[item.id].nodes && logisticsTraceMap[item.id].nodes.length > 0}}">
          <view class="trace-header">
            <text class="trace-title">物流轨迹</text>
            <text class="trace-toggle" wx:if="{{logisticsTraceMap[item.id].nodes.length > 1}}" catchtap="toggleShipmentTrace" data-id="{{item.id}}">{{logisticsTraceMap[item.id].expanded ? '收缩' : '展开'}}</text>
          </view>
          <view class="trace-list">
            <view class="trace-item" wx:for="{{logisticsTraceMap[item.id].visibleNodes}}" wx:for-item="node" wx:key="index">
              <text class="trace-time">{{node.timeDisplay}}</text>
              <text class="trace-content">{{node.description}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="info-card after-sale-card" wx:if="{{afterSaleRecords && afterSaleRecords.length > 0}}">
    <view class="section-title">售后记录</view>
    <view class="after-sale-list">
      <view class="after-sale-item" wx:for="{{afterSaleRecords}}" wx:key="id" bindtap="viewAfterSaleDetail" data-id="{{item.id}}">
        <view class="after-sale-header">
          <text class="after-sale-type">{{item.typeDisplay}}</text>
          <text class="after-sale-status status-{{item.status}}">{{item.statusDisplay}}</text>
        </view>
        <view class="after-sale-info">
          <text class="after-sale-qty">数量：{{item.qty}}</text>
          <text class="after-sale-amount">退款：¥ {{item.refundAmount}}</text>
        </view>
        <view class="after-sale-reason" wx:if="{{item.reason}}">{{item.reason}}</view>
        <view class="after-sale-time">{{item.createdAt}}</view>
      </view>
    </view>
  </view>
</view>

<view class="loading" wx:if="{{isLoading}}">
  <text>加载中...</text>
</view>

<view class="panel-mask" wx:if="{{showRefundPanel}}" catchtap="closeRefundPanel"></view>
<view class="bottom-panel" wx:if="{{showRefundPanel}}">
  <view class="panel-header">
    <text class="panel-title">主动退款</text>
    <text class="panel-close" bindtap="closeRefundPanel">关闭</text>
  </view>
  <view class="refund-summary" wx:if="{{refundPreview}}">
    <text>订单可退：¥ {{refundPreview.availableRefundAmount}}</text>
  </view>
  <scroll-view class="panel-body" scroll-y>
    <view class="refund-row" wx:for="{{refundItems}}" wx:for-item="refundItem" wx:for-index="refundIndex" wx:key="orderItemId">
      <view class="refund-main">
        <text class="refund-title">{{refundItem.productName}}</text>
        <text class="refund-sub">{{refundItem.productSpec}} / {{refundItem.productSize}}</text>
        <text class="refund-limit">可退 {{refundItem.availableQty}} 件，¥ {{refundItem.availableRefundAmount}}</text>
      </view>
      <view class="refund-inputs">
        <view class="refund-qty-stepper {{refundItem.disabled ? 'disabled' : ''}}">
          <view
            class="refund-qty-btn {{refundItem.selectedQty <= 0 ? 'disabled' : ''}}"
            data-index="{{refundIndex}}"
            catchtap="decreaseRefundQty">-</view>
          <view class="refund-qty-value">{{refundItem.selectedQty}}</view>
          <view
            class="refund-qty-btn {{refundItem.selectedQty >= refundItem.availableQty ? 'disabled' : ''}}"
            data-index="{{refundIndex}}"
            catchtap="increaseRefundQty">+</view>
        </view>
        <input class="panel-input" type="digit" disabled="{{refundItem.disabled}}" placeholder="金额" value="{{refundItem.inputAmount}}" data-index="{{refundIndex}}" bindinput="onRefundAmountInput" />
      </view>
    </view>
    <view class="panel-field">
      <text class="panel-label">原因</text>
      <input class="panel-text-input" value="{{refundReason}}" bindinput="onRefundReasonInput" />
    </view>
    <view class="panel-field">
      <text class="panel-label">备注</text>
      <input class="panel-text-input" placeholder="可选" value="{{refundNote}}" bindinput="onRefundNoteInput" />
    </view>

    <view class="purchase-return-choice">退款成功释放客户现货/在途占用，实物不增加。供应商供货继续保留；确认取消未到货部分请到库存报单记录单独办理。</view>
  </scroll-view>
  <view class="panel-actions">
    <button class="panel-btn secondary" bindtap="closeRefundPanel">取消</button>
    <button class="panel-btn danger" bindtap="submitAdminRefund">确认退款</button>
  </view>
</view>

<view class="panel-mask" wx:if="{{adminRemarkPanel}}" catchtap="closeAdminRemarkEditor"></view>
<view class="bottom-panel admin-remark-panel" wx:if="{{adminRemarkPanel}}">
  <view class="panel-header"><text class="panel-title">管理员备注</text><text class="panel-close" bindtap="closeAdminRemarkEditor">关闭</text></view>
  <view class="panel-body admin-remark-body">
    <textarea class="panel-text-input admin-remark-input" maxlength="500" placeholder="请输入管理员备注" value="{{adminRemarkValue}}" bindinput="onAdminRemarkInput" cursor-spacing="24" show-confirm-bar="false"></textarea>
  </view>
  <view class="panel-actions admin-remark-actions"><button class="panel-btn secondary" bindtap="closeAdminRemarkEditor">取消</button><button class="panel-btn danger" bindtap="saveAdminRemark">保存</button></view>
</view>

<view class="panel-mask" wx:if="{{showPartialUnbindPanel}}" catchtap="closePartialUnbindPanel"></view>
<view class="bottom-panel" wx:if="{{showPartialUnbindPanel}}">
  <view class="panel-header">
    <text class="panel-title">解绑当前订单商品</text>
    <text class="panel-close" bindtap="closePartialUnbindPanel">关闭</text>
  </view>
  <scroll-view class="panel-body" scroll-y>
    <view class="unbind-preview-tip">只处理本订单所选数量，保留同包其他订单。已有退货退款售后的商品请通过售后验收处理。</view>
    <view class="refund-row" wx:for="{{partialUnbindItems}}" wx:for-item="unbindItem" wx:for-index="unbindIndex" wx:key="orderItemId">
      <view class="refund-main">
        <text class="refund-title">{{unbindItem.productName}}</text>
        <text class="refund-sub">{{unbindItem.spec}}</text>
        <text class="refund-limit">包裹内 {{unbindItem.shipQty}} 件</text>
      </view>
      <view class="refund-inputs single">
        <input class="panel-input" type="number" placeholder="解绑数量" value="{{unbindItem.unbindQty}}" data-index="{{unbindIndex}}" bindinput="onPartialUnbindQtyInput" />
      </view>
    </view>
  </scroll-view>
  <view class="panel-actions">
    <button class="panel-btn secondary" bindtap="closePartialUnbindPanel">取消</button>
    <button class="panel-btn danger" bindtap="submitPartialUnbind" disabled="{{unbindSaving}}" loading="{{unbindSaving}}">确认所选商品解绑</button>
  </view>
</view>

<view class="panel-mask" wx:if="{{showUnbindPreview}}" catchtap="closeUnbindPreview"></view>
<view class="bottom-panel unbind-preview-panel" wx:if="{{showUnbindPreview && unbindPreview}}">
  <view class="panel-header">
    <text class="panel-title">核对整个包裹解绑范围</text>
    <text class="panel-close" bindtap="closeUnbindPreview">关闭</text>
  </view>
  <scroll-view class="panel-body" scroll-y>
    <view class="unbind-preview-content">
    <view class="unbind-preview-title">{{unbindPreview.orders.length}} 笔订单 · {{unbindPreview.totalQty}} 件商品</view>
    <view class="unbind-preview-waybill" user-select="{{true}}">运单 {{unbindPreview.expressNo}}</view>
    <view class="unbind-preview-tip">以下订单商品会一并解绑，并按实际扣库来源返还库存。仅取消电子面单不能返库存，必须先确认实物状态。</view>
    <view class="unbind-preview-tip" wx:if="{{unbindPreview.orders.length > 1}}">这是合单包裹，操作范围包含其他订单；只处理当前订单时，请关闭后选择“解绑本单商品”。</view>
    <view class="unbind-preview-tip" wx:if="{{unbindPreview.waybillNeedsReview}}">该历史面单需要核实来源，若无法自动确认，请先核查原物流平台的面单状态。</view>
    <view class="unbind-preview-order" wx:for="{{unbindPreview.orders}}" wx:key="orderId" wx:for-item="affectedOrder">
      <view class="unbind-preview-order-head"><text>{{affectedOrder.current ? '当前订单' : '关联订单'}} · {{affectedOrder.statusText}}</text><text wx:if="{{affectedOrder.adminSeqNo}}">序号 {{affectedOrder.adminSeqNo}}</text></view>
      <view class="unbind-preview-order-no" user-select="{{true}}">{{affectedOrder.orderNo}}</view>
      <view class="unbind-preview-goods" wx:for="{{affectedOrder.items}}" wx:key="orderItemId" wx:for-item="goods">
        <image src="{{goods.productImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
        <view class="unbind-preview-goods-info"><view user-select="{{true}}">{{goods.productName}}</view><view class="unbind-preview-spec">{{goods.spec}} {{goods.size}}</view><view>本包数量 × {{goods.qty}}</view></view>
      </view>
    </view>
    <checkbox-group bindchange="onUnbindStockConfirmed">
      <label class="unbind-stock-confirm"><checkbox value="confirmed" checked="{{unbindStockConfirmed}}" disabled="{{unbindSaving}}" color="#d93026" /><text>我已确认上述全部商品尚未实际出库，或已经全部实际回仓。</text></label>
    </checkbox-group>
    </view>
  </scroll-view>
  <view class="panel-actions">
    <button class="panel-btn secondary" bindtap="closeUnbindPreview" disabled="{{unbindSaving}}">取消</button>
    <button class="panel-btn danger" bindtap="confirmFullUnbind" disabled="{{!unbindStockConfirmed || unbindSaving || unbindPreview.totalQty <= 0}}" loading="{{unbindSaving}}">解绑整包 {{unbindPreview.totalQty}} 件</button>
  </view>
</view>

<view class="panel-mask" wx:if="{{showPricePanel}}" catchtap="closePricePanel"></view>
<view class="bottom-panel price-panel" wx:if="{{showPricePanel}}">
  <view class="panel-title">修改订单价格</view>
  <scroll-view scroll-y="{{true}}" class="price-panel-scroll">
    <view class="price-form-row"><text>同行订单（不计佣金）</text><switch checked="{{priceDraft.peerOrder}}" disabled="{{pricing.peerOrder || priceSaving}}" bindchange="onPeerOrderChange" /></view>
    <view class="price-form-row"><text>线上应付（含运费）</text><input type="digit" value="{{priceDraft.onlineAmount}}" data-field="onlineAmount" bindinput="onPriceInput" disabled="{{priceSaving}}" /></view>
    <view class="price-form-row"><text>线下实收（元）</text><input type="digit" value="{{priceDraft.offlineAmount}}" data-field="offlineAmount" bindinput="onPriceInput" disabled="{{priceSaving}}" /></view>
    <view class="price-form-row"><text>运费（元）</text><input type="digit" value="{{priceDraft.shippingFee}}" data-field="shippingFee" bindinput="onPriceInput" disabled="{{priceSaving}}" /><button size="mini" bindtap="waivePriceShipping" disabled="{{priceSaving}}">免运费</button></view>
    <block wx:if="{{priceDraft.offlineAmount > 0}}">
      <view class="price-form-row"><text>线下收款方式</text><input placeholder="如微信转账、现金" maxlength="100" value="{{priceDraft.offlineMethod}}" data-field="offlineMethod" bindinput="onPriceInput" disabled="{{priceSaving}}" /></view>
      <view class="price-form-row"><text>收款备注</text><input placeholder="选填" maxlength="500" value="{{priceDraft.offlineNote}}" data-field="offlineNote" bindinput="onPriceInput" disabled="{{priceSaving}}" /></view>
      <view class="price-form-row"><text>已核实线下款到账</text><switch checked="{{priceDraft.offlineConfirmed}}" bindchange="onOfflineConfirmedChange" disabled="{{priceSaving}}" /></view>
    </block>
    <view class="price-form-row"><text>改价原因</text><input placeholder="必填，最多500字" maxlength="500" value="{{priceDraft.reason}}" data-field="reason" bindinput="onPriceInput" disabled="{{priceSaving}}" /></view>
    <view class="price-totals">
      <view>商品成本总额：¥ {{pricing.costAmount}}{{pricing.costComplete ? '' : '（成本未补齐）'}}</view>
      <view>商品成交额：¥ {{pricePreview.goods}}</view>
      <view>成交总额：¥ {{pricePreview.total}}</view>
    </view>
    <view class="pricing-hint">成交总额＝线上应付＋线下实收；扣除运费后不能低于商品成本。修改运费会同步调整线上应付，线下实收不自动改动。线上应付最低0.01元，运费可设为0。</view>
    <view class="price-error" wx:if="{{pricePreview.error}}">{{pricePreview.error}}</view>
  </scroll-view>
  <view class="panel-actions"><button bindtap="closePricePanel" disabled="{{priceSaving}}">取消</button><button type="primary" bindtap="savePrice" loading="{{priceSaving}}" disabled="{{priceSaving || !pricePreview.valid}}">确认改价</button></view>
</view>
