page { height: 100vh; overflow: hidden; background: #f7f7f7; color: #222; }
.page-scroll { height: 100vh; width: 100%; }
.page { padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.title { font-size: 38rpx; font-weight: 600; margin-bottom: 16rpx; }
.hint { color: #777; font-size: 25rpx; line-height: 1.7; margin: 16rpx 0 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin: 24rpx 0; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.row button { margin: 0; flex-shrink: 0; }
.province { font-size: 30rpx; font-weight: 600; overflow-wrap: anywhere; }
.status { color: #777; font-size: 24rpx; margin-top: 18rpx; }
.active { color: #18794e; }
.label { font-size: 26rpx; margin: 22rpx 0 12rpx; }
.input { background: #f7f7f7; border: 1rpx solid #eee; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; }
.rule-summary { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; padding-top: 22rpx; font-size: 25rpx; color: #555; }
.actions { display: flex; gap: 20rpx; justify-content: flex-end; margin-top: 24rpx; }
.actions button { margin: 0; }
.add { background: #fff; text-align: center; border: 1rpx dashed #bbb; border-radius: 12rpx; padding: 26rpx; }
.error { background: #fff0f0; color: #b42318; font-size: 26rpx; line-height: 1.7; padding: 22rpx; border-radius: 10rpx; }
button { margin-top: 20rpx; font-size: 28rpx; }
button.primary { background: #222; color: #fff; }
.editor-card { padding: 24rpx; }
.name-row { display: flex; align-items: center; gap: 20rpx; }
.name-label { flex-shrink: 0; font-size: 26rpx; font-weight: 600; }
.name-input { flex: 1; min-width: 0; padding: 14rpx 16rpx; }
.rule-columns, .rule-row { display: flex; align-items: center; gap: 12rpx; }
.rule-columns { margin-top: 24rpx; padding: 16rpx 0; color: #777; font-size: 23rpx; }
.rule-row { position: absolute; width: 100%; height: 48px; box-sizing: border-box; padding: 6px 0; border-top: 1rpx solid #f1f1f1; background: #fff; }
.rule-row.dragging { z-index: 10; background: #f8fafc; box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15); }
.rule-scroll { width: 100%; }
.rule-area { width: 100%; }
.drag-handle { flex: 0 0 30rpx; width: 30rpx; height: 100%; display: flex; align-items: center; justify-content: center; color: #999; font-size: 28rpx; }
.sort-hint { color: #999; font-size: 22rpx; margin-top: 16rpx; }
.province-cell { flex: 1.25; min-width: 0; }
.value-cell { flex: 1; min-width: 0; }
.province-select { display: flex; align-items: center; gap: 6rpx; height: 36px; }
.province-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; }
.province-arrow { flex-shrink: 0; color: #999; font-size: 22rpx; }
.rule-input { box-sizing: border-box; height: 36px; padding: 12rpx; font-size: 25rpx; }
.remove-cell { flex: 0 0 44rpx; width: 44rpx; }
button.remove-rule { margin: 0; padding: 0; height: 36px; line-height: 36px; background: transparent; color: #999; font-size: 38rpx; border-radius: 0; }
button.remove-rule::after { border: none; }
.province-actions { display: flex; align-items: stretch; gap: 16rpx; margin-top: 16rpx; }
.add-province { flex: 1; min-width: 0; }
.editor-card .add { padding: 20rpx 12rpx; font-size: 26rpx; line-height: 1.5; }
button.complete-provinces { flex-shrink: 0; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 24rpx; border: 1rpx solid #ddd; border-radius: 12rpx; background: #f7f7f7; font-size: 26rpx; line-height: 1.5; }
button.complete-provinces::after { border: none; }
.empty-rules { text-align: center; margin: 12rpx 0 20rpx; }
