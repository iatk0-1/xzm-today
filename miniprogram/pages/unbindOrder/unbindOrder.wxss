/* miniprogram/pages/unbindOrder/unbindOrder.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding: 20rpx;
}

/* 发货单信息 */
.shipment-info {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.info-detail {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  font-size: 26rpx;
  color: #666;
}

.copy-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.copy-btn {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: #576b95;
  background: #f5f7fa;
  border-radius: 6rpx;
}

/* 订单列表标题 */
.orders-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #eee;
  margin-bottom: 20rpx;
}

.order-id {
  font-size: 26rpx;
  color: #666;
  font-family: -apple-system, sans-serif;
}

.order-id-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background-color: #1890ff;
  color: #fff;
}

.order-status.stocking,
.order-status.paid {
  background-color: #1890ff;
}

.order-status.shipped {
  background-color: #52c41a;
}

/* 商品列表 */
.goods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
}

.goods-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.goods-qty {
  font-size: 24rpx;
  color: #666;
}

.goods-shipped-tag {
  position: absolute;
  top: 0;
  right: 0;
  background-color: rgba(82, 196, 26, 0.9);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 8rpx 0 8rpx;
}

/* 解绑区域 */
.unbind-section {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  padding-top: 20rpx;
  border-top: 1px dashed #eee;
}

.unbind-hint {
  font-size: 24rpx;
  color: #999;
}

.btn-unbind {
  background-color: #ff4d4f;
  color: #fff;
  font-size: 26rpx;
  padding: 15rpx 0;
  border-radius: 8rpx;
  border: none;
}

.btn-unbind::after {
  border: none;
}

.cannot-unbind {
  padding-top: 20rpx;
  border-top: 1px dashed #eee;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
