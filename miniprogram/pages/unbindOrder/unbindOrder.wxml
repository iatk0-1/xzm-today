<!-- miniprogram/pages/unbindOrder/unbindOrder.wxml -->
<view class="container">
  <!-- 发货单信息 -->
  <view class="shipment-info">
    <view class="info-title">发货单 #{{shipmentId}}</view>
    <view class="info-detail">
      <text>快递公司：{{expressCode}}</text>
      <view class="copy-line" wx:if="{{expressNo}}">
        <text>运单号：{{expressNo}}</text>
        <text class="copy-btn" catchtap="copyExpressNo">复制</text>
      </view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="orders-title">关联订单（{{orders.length}}）</view>

  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="id" wx:for-item="order" wx:for-index="index">
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-id-box">
          <view class="order-id">订单号：{{order.outTradeNo}}</view>
          <text class="copy-btn" catchtap="copyOrderNo" data-order-no="{{order.outTradeNo}}">复制</text>
        </view>
        <view class="order-status {{order.status}}">{{order.status === 'paid' ? '待发货' : (order.status === 'shipped' ? '已发货' : order.status)}}</view>
      </view>

      <!-- 商品信息 -->
      <view class="goods-list">
        <view class="goods-item" wx:for="{{order.items}}" wx:key="orderItemId" wx:for-item="item" wx:for-index="itemIndex">
          <image class="goods-img" src="{{item.skuImageUrl || item.productImage}}" mode="aspectFill"></image>
          <view class="goods-info">
            <view class="goods-name">{{item.productName}}</view>
            <view class="goods-spec">{{item.productSpec}} / {{item.productSize}}</view>
            <view class="goods-qty">数量：{{item.qty}} | 已发：{{item.shippedQty || 0}}</view>
          </view>
          <!-- 已发货商品标记 -->
          <view class="goods-shipped-tag" wx:if="{{item.shippedQty > 0}}">
            <text>已发货</text>
          </view>
        </view>
      </view>

      <!-- 解绑按钮 -->
      <view class="unbind-section" wx:if="{{order.status === 'paid'}}">
        <view class="unbind-hint">该订单未发货，可以解绑</view>
        <button class="btn-unbind" catchtap="unbindOrder" data-order-id="{{order.id}}">解绑此订单</button>
      </view>
      <view class="cannot-unbind" wx:else>
        <text>该订单已有已发货商品，无法解绑</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text>暂无关联订单</text>
  </view>
</view>
