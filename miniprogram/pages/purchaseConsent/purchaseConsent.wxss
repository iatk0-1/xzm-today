page { height: 100%; background: #f5f5f5; }
.consent-page { height: 100vh; box-sizing: border-box; padding: 120rpx 28rpx 72rpx; padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, .48); }
.consent-dialog { width: 100%; max-height: 100%; display: flex; flex-direction: column; background: #fff; border-radius: 28rpx; padding: 36rpx 28rpx 28rpx; box-sizing: border-box; overflow: hidden; }
.consent-title { text-align: center; font-size: 36rpx; font-weight: 700; color: #191919; }
.consent-subtitle { margin: 14rpx 0 24rpx; text-align: center; font-size: 24rpx; color: #777; }
.consent-scroll { height: 55vh; min-height: 0; flex-shrink: 1; background: #fafafa; border-radius: 12rpx; }
.consent-content { display: block; padding: 24rpx; white-space: pre-wrap; word-break: break-all; font-size: 27rpx; line-height: 1.8; color: #333; }
.consent-end { text-align: center; padding: 8rpx 0 28rpx; font-size: 23rpx; color: #999; }
.consent-status { padding: 22rpx 4rpx; font-size: 24rpx; color: #b45309; text-align: center; flex-shrink: 0; }
.consent-button { margin: 0; width: 100%; flex-shrink: 0; border-radius: 44rpx; background: #191919; color: #fff; font-size: 28rpx; font-weight: 700; }
.consent-button[disabled] { color: #999; background: #ededed; }
.consent-button::after { border: none; }
