<view class="page">
  <view class="header">合作商户</view>
  <view class="merchant-list" wx:if="{{merchants.length}}">
    <view class="merchant-row" wx:for="{{merchants}}" wx:key="merchantId"
      data-id="{{item.merchantId}}" bindtap="handleMerchant">
      <view>
        <view class="merchant-name">{{item.merchantName}}</view>
        <view class="status {{item.partnershipStatus}}">{{item.statusLabel}}</view>
      </view>
      <view class="actions" wx:if="{{item.canEnter}}">
        <button class="small-button" data-id="{{item.merchantId}}" catchtap="openCatalog">选品</button>
        <button class="small-button primary" data-id="{{item.merchantId}}" catchtap="openProducts">我的商品</button>
        <button class="small-button" data-id="{{item.merchantId}}" catchtap="openIncome">收益</button>
      </view>
      <text class="action" wx:else>{{item.canApply ? '申请合作' : '查看状态'}}</text>
    </view>
  </view>
  <view class="empty" wx:else>{{loading ? '加载中' : '暂无可合作商户'}}</view>
</view>
