<view class="container">
  <view class="filter-sticky">
    <view class="filter-bar">
      <view class="filter-tabs">
        <view class="tab-item {{status === 'ordered' ? 'active' : ''}}" bindtap="setStatus" data-status="ordered">已报</view>
        <view class="tab-item {{status === 'cancelled' ? 'active' : ''}}" bindtap="setStatus" data-status="cancelled">已撤</view>
        <view class="tab-item {{status === 'all' ? 'active' : ''}}" bindtap="setStatus" data-status="all">全部</view>
      </view>
      <view class="sku-filter">
        <input class="sku-input" placeholder="搜索商品名称" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="search" />
        <button class="sku-search-btn" bindtap="search">搜索</button>
      </view>
      <view class="date-filter">
        <view class="date-picker" bindtap="showDateRangeSelector">
          <text wx:if="{{!dateRange.startDate && !dateRange.endDate}}">选择时间范围</text>
          <text wx:else>{{dateRange.startDate || '开始'}} - {{dateRange.endDate || '结束'}}</text>
        </view>
        <view class="clear-date" wx:if="{{dateRange.startDate || dateRange.endDate}}" bindtap="clearDateRange">×</view>
      </view>
    </view>
  </view>

  <scroll-view class="batch-scroll" scroll-y="true" enable-flex="true" enhanced="true"
    refresher-enabled="true" refresher-triggered="{{refreshing}}"
    refresher-background="#f6f7f9" bindrefresherrefresh="onListPullDownRefresh"
    bindscrolltolower="onListScrollToLower" lower-threshold="200">
  <view class="batch-list">
    <view class="batch-card" wx:for="{{batchList}}" wx:key="id">
      <view class="batch-header" bindtap="toggleBatch" data-id="{{item.id}}">
        <view class="batch-info">
          <view class="batch-title">报单批次 #{{item.batchNo}}</view>
          <view class="batch-meta">{{item.displayTime}} · {{item.itemCount}} 款商品 · 共 {{item.totalQty}} 件</view>
          <view class="batch-meta" wx:if="{{status === 'all'}}">已报 {{item.orderedCount}} 款 · 已撤 {{item.cancelledCount}} 款</view>
        </view>
        <view class="batch-arrow {{item.expanded ? 'expanded' : ''}}">⌄</view>
      </view>

      <view class="batch-content" wx:if="{{item.expanded}}">
        <view class="action-bar" wx:if="{{status !== 'cancelled' && item.orderedCount > 0 && item.detailList.length > 0}}">
          <view class="select-all" bindtap="toggleSelectAll" data-batch-id="{{item.id}}">
            <view class="checkbox {{item.allSelected ? 'checked' : ''}}"><text wx:if="{{item.allSelected}}">✓</text></view>
            <text>全选已报</text>
          </view>
          <view class="selected-info {{item.selectedCount === 0 ? 'empty' : ''}}">
            <text>{{item.selectedCount > 0 ? '已选 ' + item.selectedCount + ' 个报单' : '未选择报单'}}</text>
          </view>
          <button class="btn-batch-cancel" bindtap="batchCancel" data-batch-id="{{item.id}}" disabled="{{item.selectedCount === 0}}">撤销{{item.selectedCount > 0 ? ' ' + item.selectedCount : ''}}</button>
        </view>

        <view class="order-item {{detail.selected ? 'selected' : ''}}" wx:for="{{item.detailList}}" wx:for-item="detail" wx:for-index="detailIndex" wx:key="id">
          <view class="item-checkbox" wx:if="{{detail.status === 'ordered'}}">
            <view class="checkbox {{detail.selected ? 'checked' : ''}}" bindtap="toggleSelect" data-batch-id="{{item.id}}" data-index="{{detailIndex}}"><text wx:if="{{detail.selected}}">✓</text></view>
          </view>
          <image class="order-image" src="{{detail.imageUrl ? detail.imageUrl : detail.defaultImageUrl}}" mode="aspectFill" lazy-load="true" binderror="onImageError" data-batch-id="{{item.id}}" data-index="{{detailIndex}}" />
          <view class="order-info">
            <view class="order-main">
              <view class="order-name">{{detail.productName}}</view>
              <view class="order-status {{detail.status}}">{{detail.status === 'ordered' ? '已报单' : '已撤销'}}</view>
            </view>
            <view class="order-sku">{{detail.spec || '默认规格'}} · {{detail.size || '均码'}}</view>
            <view class="order-meta">
              <view class="meta-chip">原报 {{detail.qty}}</view>
              <view class="meta-chip" wx:if="{{detail.invalidQty > 0}}">退款作废 {{detail.invalidQty}}</view>
              <view class="meta-chip" wx:if="{{detail.invalidQty > 0}}">有效 {{detail.qty - detail.invalidQty}}</view>
            </view>
          </view>
          <view class="order-action" wx:if="{{detail.status === 'ordered'}}">
            <view class="btn-cancel" bindtap="cancelOrder" data-id="{{detail.id}}">撤销</view>
          </view>
        </view>
        <view class="detail-state" wx:if="{{item.detailLoading}}">明细加载中...</view>
        <view class="detail-state" wx:elif="{{item.detailList.length === 0}}">暂无商品明细</view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{batchList.length === 0 && !loading}}">暂无报单批次</view>
    <view class="loading-state {{batchList.length > 0 ? 'loading-more' : ''}}" wx:if="{{loading}}">加载中...</view>
  </view>
  </scroll-view>
  <view class="modal" wx:if="{{showDateModal}}">
    <view class="modal-mask" bindtap="closeDateModal"></view>
    <view class="modal-content">
      <view class="modal-title">选择时间范围</view>
      <view class="quick-options">
        <view class="quick-option {{draftDateRange.quickSelect === '1day' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="1day">最近 1 天</view>
        <view class="quick-option {{draftDateRange.quickSelect === '7days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="7days">最近 7 天</view>
        <view class="quick-option {{draftDateRange.quickSelect === '30days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="30days">最近 30 天</view>
        <view class="quick-option {{draftDateRange.quickSelect === 'month' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="month">本月</view>
      </view>
      <view class="custom-section">
        <view class="custom-title">自定义时间</view>
        <picker mode="date" value="{{draftDateRange.startDate}}" end="{{draftDateRange.endDate || today}}" bindchange="onStartDateChange">
          <view class="date-picker-input">开始日期：{{draftDateRange.startDate || '选择'}}</view>
        </picker>
        <picker mode="date" value="{{draftDateRange.endDate}}" start="{{draftDateRange.startDate}}" end="{{today}}" bindchange="onEndDateChange">
          <view class="date-picker-input">结束日期：{{draftDateRange.endDate || '选择'}}</view>
        </picker>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeDateModal">取消</button>
        <button class="modal-confirm" bindtap="confirmDateRange">确定</button>
      </view>
    </view>
  </view>
</view>
