<!-- miniprogram/pages/purchaseOrders/purchaseOrders.wxml -->
<view class="container">
  <!-- 顶部筛选栏 -->
  <view class="filter-bar">
    <view class="filter-tabs">
      <view class="tab-item {{status === 'ordered' ? 'active' : ''}}" bindtap="setStatus" data-status="ordered">
        已报
      </view>
      <view class="tab-item {{status === 'cancelled' ? 'active' : ''}}" bindtap="setStatus" data-status="cancelled">
        已撤
      </view>
      <view class="tab-item {{status === 'all' ? 'active' : ''}}" bindtap="setStatus" data-status="all">
        全部
      </view>
    </view>

    <!-- 商品筛选 -->
    <view class="sku-filter">
      <input class="sku-input" placeholder="搜索商品名称/SKU" value="{{keyword}}" bindinput="onKeywordInput" />
      <button class="sku-search-btn" bindtap="search">搜索</button>
    </view>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar" wx:if="{{status === 'ordered'}}">
    <view class="select-all" bindtap="toggleSelectAll">
      <view class="checkbox {{allSelected ? 'checked' : ''}}">
        <text wx:if="{{allSelected}}">✓</text>
      </view>
      <text>全选</text>
    </view>
    <view class="selected-info {{selectedCount === 0 ? 'empty' : ''}}">
      <text wx:if="{{selectedCount > 0}}">已选 {{selectedCount}} 个报单</text>
      <text wx:else>未选择报单</text>
    </view>
    <button class="btn-batch-cancel" bindtap="batchCancel" disabled="{{selectedCount === 0}}">
      <text wx:if="{{selectedCount > 0}}">撤销 {{selectedCount}}</text>
      <text wx:else>撤销</text>
    </button>
  </view>

  <!-- 报单列表 -->
  <view class="order-list">
    <view class="order-item {{item.selected ? 'selected' : ''}}" wx:for="{{displayList}}" wx:key="id">
      <view class="item-checkbox" wx:if="{{status === 'ordered'}}">
        <view class="checkbox {{item.selected ? 'checked' : ''}}" bindtap="toggleSelect" data-index="{{index}}">
          <text wx:if="{{item.selected}}">✓</text>
        </view>
      </view>
      <image class="order-image" src="{{item.imageUrl ? item.imageUrl : (item.defaultImageUrl || '/images/default-goods-image.png')}}" mode="aspectFill" lazy-load="true" binderror="onImageError" data-index="{{index}}" />
      <view class="order-info">
        <view class="order-main">
          <view class="order-name">{{item.productName}}</view>
          <view class="order-status {{item.status}}">
            {{item.status === 'ordered' ? '已报单' : '已撤销'}}
          </view>
        </view>
        <view class="order-sku">{{item.spec || '默认规格'}} · {{item.size || '均码'}}</view>
        <view class="order-meta">
          <view class="meta-chip">数量 {{item.qty}}</view>
          <view class="meta-time">{{item.createdAt}}</view>
        </view>
      </view>
      <view class="order-action" wx:if="{{item.status === 'ordered'}}">
        <view class="btn-cancel" bindtap="cancelOrder" data-id="{{item.id}}" data-index="{{index}}">撤销</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{displayList.length === 0 && !loading}}">
      <text>暂无报单记录</text>
    </view>

    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>
