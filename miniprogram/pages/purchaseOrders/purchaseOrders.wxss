/* miniprogram/pages/purchaseOrders/purchaseOrders.wxss */
page {
  background: #f6f7f9;
  height: 100vh;
  overflow: hidden;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  padding: 16rpx 16rpx 0;
  box-sizing: border-box;
}

/* 筛选区在列表滚动容器外，拉动列表时保持在顶部。 */
.filter-sticky {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

/* 顶部筛选栏 */
.filter-bar {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  width: 100%;
}

.filter-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.tab-item {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  background: #f2f4f7;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.tab-item.active {
  background: #1f2933;
  color: #fff;
  font-weight: 600;
}

/* SKU 筛选 */
.sku-filter {
  display: flex;
  gap: 10rpx;
}

.sku-input {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  background: #f6f7f9;
  border-radius: 10rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.sku-search-btn {
  width: 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  background: #1f2933;
  color: #fff;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0;
  box-sizing: border-box;
}

.sku-search-btn::after,
.btn-batch-cancel::after {
  border: none;
}

.date-filter {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.view-toggle {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 16rpx;
  margin: 0;
  border-radius: 10rpx;
  background: #1f2933;
  color: #fff;
  font-size: 22rpx;
}

.view-toggle::after, .view-all-btn::after, .sku-record-close::after { border: none; }
.relation-filter-section { margin-bottom: 12rpx; }
.relation-filter-row { display: flex; align-items: center; min-height: 60rpx; }
.relation-filter-label { width: 64rpx; flex-shrink: 0; font-size: 24rpx; font-weight: 600; color: #333; }
.relation-filter-fixed { flex-shrink: 0; margin-right: 12rpx; }
.relation-filter-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.relation-filter-options { display: inline-flex; align-items: center; gap: 12rpx; padding: 6rpx 2rpx; }
.relation-filter-tag { flex-shrink: 0; padding: 8rpx 22rpx; background: #f2f4f7; color: #666; font-size: 24rpx; line-height: 32rpx; border-radius: 10rpx; }
.relation-filter-tag.active { color: #1f2933; font-weight: 700; box-shadow: inset 0 -4rpx 0 #1f2933; }
.sku-summary-card { display: flex; align-items: center; gap: 16rpx; padding: 20rpx; margin-bottom: 14rpx; background: #fff; border-radius: 12rpx; }

.date-picker {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f6f7f9;
  border-radius: 10rpx;
  color: #666;
  font-size: 22rpx;
}

.clear-date {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f0f0f0;
  border-radius: 50%;
  color: #999;
  font-size: 28rpx;
}

.modal { position: fixed; inset: 0; z-index: 1000; }
.modal-mask { position: absolute; inset: 0; background: rgba(0, 0, 0, .45); }
.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}
.modal-title { padding: 28rpx; border-bottom: 1rpx solid #f0f0f0; text-align: center; font-size: 30rpx; font-weight: 600; }
.quick-options { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 16rpx; border-bottom: 1rpx solid #f0f0f0; }
.quick-option {
  flex: 1 1 calc(50% - 6rpx);
  height: 64rpx;
  box-sizing: border-box;
  background: #f5f5f5;
  border-radius: 8rpx;
  color: #666;
  text-align: center;
  line-height: 64rpx;
  font-size: 24rpx;
}
.quick-option.selected { background: #1f2933; color: #fff; }
.custom-section { padding: 24rpx 16rpx; }
.custom-title { margin-bottom: 16rpx; color: #999; font-size: 24rpx; }
.date-picker-input {
  height: 64rpx;
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  color: #333;
  font-size: 26rpx;
}
.modal-footer { display: flex; border-top: 1rpx solid #f0f0f0; }
.sku-record-modal { width: 710rpx; height: 82vh; max-height: 82vh; }
.sku-record-subtitle { padding: 12rpx 20rpx; font-size: 23rpx; color: #59636f; line-height: 32rpx; border-bottom: 1rpx solid #eee; }
.sku-record-scroll { flex: 1; height: 0; min-height: 0; box-sizing: border-box; padding: 14rpx; }
.related-batch { border: 1rpx solid #e9edf2; border-radius: 12rpx; margin-bottom: 14rpx; overflow: hidden; }
.related-batch-header { display: flex; align-items: center; gap: 8rpx; padding: 18rpx 14rpx; }
.related-batch .batch-title { font-size: 25rpx; overflow-wrap: break-word; }
.related-arrow { color: #7b8490; padding: 4rpx; }
.related-batch-content { border-top: 1rpx solid #eee; padding: 12rpx; background: #fafbfc; }
.related-detail-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-bottom: 12rpx; font-size: 23rpx; color: #59636f; }
.view-all-btn { flex-shrink: 0; margin: 0; padding: 0 16rpx; height: 54rpx; line-height: 54rpx; border-radius: 8rpx; font-size: 22rpx; color: #1677c8; background: #eaf4ff; }
.related-all-items { border-top: 1rpx dashed #d9dee7; padding-top: 12rpx; }
.related-all-title { padding: 8rpx 0 14rpx; color: #59636f; font-size: 22rpx; }
.related-batch .order-item { padding: 12rpx; gap: 10rpx; margin-bottom: 10rpx; }
.related-batch .order-image { width: 76rpx; height: 76rpx; }
.sku-record-close { flex-shrink: 0; margin: 0; border-radius: 0; height: 76rpx; line-height: 76rpx; background: #f2f4f7; color: #333; font-size: 26rpx; }
.retry-state { color: #1677c8; }
.modal-cancel, .modal-confirm { flex: 1; height: 88rpx; padding: 0; border: 0; border-radius: 0; line-height: 88rpx; font-size: 28rpx; }
.modal-cancel { background: #f5f5f5; color: #666; border-right: 1rpx solid #f0f0f0; }
.modal-confirm { background: #1f2933; color: #fff; }

.batch-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.batch-list {
  width: 100%;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.batch-card {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
}

.batch-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 20rpx;
}

.batch-info { flex: 1; min-width: 0; }
.batch-title { color: #1f2933; font-size: 28rpx; font-weight: 600; }
.batch-meta { color: #7b8490; font-size: 22rpx; margin-top: 8rpx; }
.batch-arrow { color: #8a929d; font-size: 34rpx; margin-left: 20rpx; transform: rotate(0deg); }
.batch-arrow.expanded { transform: rotate(180deg); }
.batch-content { padding: 0 14rpx 14rpx; border-top: 1rpx solid #eef1f5; }
.batch-content .action-bar { background: #f6f7f9; margin-top: 14rpx; }
.batch-content .order-item { margin-bottom: 10rpx; }
.detail-state { text-align: center; color: #999; font-size: 24rpx; padding: 36rpx 0; }

/* 操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 14rpx;
  gap: 12rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 86rpx;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #1f2933;
  flex-shrink: 0;
}

.selected-info {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.selected-info text {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-info.empty text {
  color: #a1a8b3;
}

.btn-batch-cancel {
  width: 132rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  background: #d9534f;
  color: #fff;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}

.btn-batch-cancel[disabled] {
  background: #c9ced6;
  color: #fff;
}

/* 报单列表 */
.order-list {
  width: 100%;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border: 1rpx solid #eef1f5;
  border-radius: 12rpx;
  gap: 14rpx;
  position: relative;
  box-sizing: border-box;
}

.order-item.selected {
  border-color: #8ec5ff;
  background: #f7fbff;
}

.item-checkbox {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #1890ff;
  border-color: #1890ff;
}

.order-image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.order-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.order-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2933;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.order-sku {
  font-size: 22rpx;
  color: #7b8490;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex-wrap: wrap;
}

.batch-cost,
.order-cost {
  font-size: 22rpx;
  line-height: 32rpx;
  color: #1677c8;
  word-break: break-all;
}

.batch-cost {
  margin-top: 6rpx;
}

.order-cost {
  display: flex;
  flex-wrap: wrap;
  column-gap: 16rpx;
}

.missing-cost {
  color: #8a929d;
}

.meta-chip {
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  background: #f4f6f8;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #3d4652;
  box-sizing: border-box;
}

.meta-time {
  font-size: 20rpx;
  color: #8a929d;
  line-height: 36rpx;
}

.order-status {
  flex-shrink: 0;
  height: 34rpx;
  line-height: 34rpx;
  font-size: 20rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.order-status.ordered {
  background: #e6f7ff;
  color: #1890ff;
}

.order-status.cancelled {
  background: #f5f5f5;
  color: #999;
}

.order-action {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.btn-cancel {
  width: 76rpx !important;
  min-width: 76rpx !important;
  max-width: 76rpx !important;
  height: 46rpx;
  line-height: 46rpx;
  background: #fff5f5;
  color: #d9534f;
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 0;
  border: 1rpx solid #d9534f;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

/* 空状态和加载状态 */
.empty-state, .loading-state {
  padding: 80rpx 0;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

.loading-state.loading-more {
  padding: 24rpx 0;
  background: transparent;
}

/* 商品视角的追加数量独立于历史原报数量；勾选列覆盖卡片全高。 */
.sku-summary-card { position: relative; padding-left: 62rpx; gap: 12rpx; }
.sku-summary-card.purchase-selected { background: #f7fbff; box-shadow: inset 0 0 0 1rpx #8ec5ff; }
.purchase-checkbox-column { position: absolute; top: 0; bottom: 0; left: 0; width: 62rpx; display: flex; justify-content: center; align-items: center; }
.purchase-disabled { background: #eee; border-color: #ddd; }
.sku-summary-card > .order-image { width: 80rpx; height: 80rpx; }
.purchase-card-body { flex: 1; min-width: 0; }
.purchase-card-name { width: 100%; margin-bottom: 6rpx; }
.purchase-card-details { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.purchase-card-controls { flex: 0 0 224rpx; width: 224rpx; display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; font-size: 22rpx; }
.purchase-card-controls .order-cost { justify-content: flex-end; text-align: right; }
.purchase-qty-label { color: #8a929d; font-size: 22rpx; line-height: 30rpx; }
.purchase-qty-editor { display: flex; align-items: center; gap: 6rpx; width: 224rpx; }
.purchase-qty-adjust { flex: 0 0 60rpx; width: 60rpx; min-width: 60rpx; height: 64rpx; line-height: 60rpx; padding: 0; margin: 0; border: 1px solid #d9dee7; border-radius: 6rpx; background: #f7f8fa; color: #344054; font-size: 28rpx; box-sizing: border-box; }
.purchase-qty-adjust::after, .purchase-submit-btn::after { border: none; }
.purchase-qty-frame { width: 92rpx; flex: 0 0 92rpx; height: 64rpx; padding: 2rpx 0; border: 1px solid #b8c4d3; border-radius: 6rpx; box-sizing: border-box; }
.purchase-qty-input { display: block; width: 100%; height: 100%; padding: 0 4rpx; border: none; margin: 0; background: transparent; color: #1677c8; font-size: 24rpx; text-align: center; font-weight: 700; box-sizing: border-box; }
.purchase-submit-btn { width: 132rpx; flex-shrink: 0; margin: 0; padding: 0; height: 58rpx; line-height: 58rpx; background: #1f2933; color: #fff; border-radius: 10rpx; font-size: 24rpx; }
.purchase-submit-btn[disabled] { background: #c9ced6; color: #fff; }
.purchase-modal { width: 710rpx; max-height: 80vh; }
.purchase-preview-list { flex: 0 1 auto; height: 500rpx; min-height: 0; max-height: 500rpx; padding: 10rpx 16rpx; box-sizing: border-box; }
.purchase-preview-item { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.purchase-preview-image { width: 86rpx; height: 86rpx; flex-shrink: 0; border-radius: 8rpx; }
.purchase-summary { padding: 16rpx 22rpx; font-size: 24rpx; line-height: 34rpx; color: #666; border-top: 1rpx solid #eee; background: #f9f9f9; }
.purchase-modal > .modal-title, .purchase-modal > .purchase-summary, .purchase-modal > .modal-footer { flex-shrink: 0; }
