/* miniprogram/pages/purchaseOrders/purchaseOrders.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 顶部筛选栏 */
.filter-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.filter-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 36rpx;
}

.tab-item.active {
  background: #000;
  color: #fff;
  font-weight: bold;
}

/* SKU 筛选 */
.sku-filter {
  display: flex;
  gap: 16rpx;
}

.sku-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.sku-search-btn {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #000;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0;
}

/* 操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  gap: 20rpx;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.selected-info {
  font-size: 24rpx;
  color: #666;
  flex: 1;
}

.btn-batch-cancel {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #f44336;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0;
  flex-shrink: 0;
}

.btn-batch-cancel[disabled] {
  background: #ccc;
}

/* 报单列表 */
.order-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  width: 100%;
}

.order-item {
  display: flex;
  padding: 30rpx;s
  border-bottom: 1rpx solid #f0f0f0;
  gap: 20rpx;
  position: relative;
}

.order-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.item-checkbox {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
}

.checkbox.checked {
  background: #1890ff;
  border-color: #1890ff;
}

.order-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.order-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.order-sku {
  font-size: 22rpx;
  color: #666;
}

.order-detail {
  display: flex;
  justify-content: flex-start;
  gap: 20rpx;
}

.qty, .time {
  font-size: 20rpx;
  color: #999;
}

.order-status {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.order-status.ordered {
  background: #e6f7ff;
  color: #1890ff;
}

.order-status.cancelled {
  background: #f5f5f5;
  color: #999;
}

.order-action {
  display: flex;
  align-items: center;
}

.btn-cancel {
  width: 80rpx !important;
  min-width: 80rpx !important;
  max-width: 80rpx !important;
  height: 48rpx;
  line-height: 48rpx;
  background: #fff5f5;
  color: #f44336;
  font-size: 20rpx;
  border-radius: 24rpx;
  padding: 0;
  border: 1rpx solid #f44336;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

/* 空状态和加载状态 */
.empty-state, .loading-state {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
