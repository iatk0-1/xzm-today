/* miniprogram/pages/purchaseOrders/purchaseOrders.wxss */
page {
  background: #f6f7f9;
}

.container {
  padding: 16rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 顶部筛选栏 */
.filter-bar {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  width: 100%;
}

.filter-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.tab-item {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  background: #f2f4f7;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.tab-item.active {
  background: #1f2933;
  color: #fff;
  font-weight: 600;
}

/* SKU 筛选 */
.sku-filter {
  display: flex;
  gap: 10rpx;
}

.sku-input {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  background: #f6f7f9;
  border-radius: 10rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.sku-search-btn {
  width: 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  background: #1f2933;
  color: #fff;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0;
  box-sizing: border-box;
}

.sku-search-btn::after,
.btn-batch-cancel::after {
  border: none;
}

/* 操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 14rpx;
  gap: 12rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 86rpx;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #1f2933;
  flex-shrink: 0;
}

.selected-info {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.selected-info text {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-info.empty text {
  color: #a1a8b3;
}

.btn-batch-cancel {
  width: 132rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  background: #d9534f;
  color: #fff;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}

.btn-batch-cancel[disabled] {
  background: #c9ced6;
  color: #fff;
}

/* 报单列表 */
.order-list {
  width: 100%;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border: 1rpx solid #eef1f5;
  border-radius: 12rpx;
  gap: 14rpx;
  position: relative;
  box-sizing: border-box;
}

.order-item.selected {
  border-color: #8ec5ff;
  background: #f7fbff;
}

.item-checkbox {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #1890ff;
  border-color: #1890ff;
}

.order-image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.order-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.order-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2933;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.order-sku {
  font-size: 22rpx;
  color: #7b8490;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex-wrap: wrap;
}

.meta-chip {
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  background: #f4f6f8;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #3d4652;
  box-sizing: border-box;
}

.meta-time {
  font-size: 20rpx;
  color: #8a929d;
  line-height: 36rpx;
}

.order-status {
  flex-shrink: 0;
  height: 34rpx;
  line-height: 34rpx;
  font-size: 20rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.order-status.ordered {
  background: #e6f7ff;
  color: #1890ff;
}

.order-status.cancelled {
  background: #f5f5f5;
  color: #999;
}

.order-action {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.btn-cancel {
  width: 76rpx !important;
  min-width: 76rpx !important;
  max-width: 76rpx !important;
  height: 46rpx;
  line-height: 46rpx;
  background: #fff5f5;
  color: #d9534f;
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 0;
  border: 1rpx solid #d9534f;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

/* 空状态和加载状态 */
.empty-state, .loading-state {
  padding: 80rpx 0;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}
