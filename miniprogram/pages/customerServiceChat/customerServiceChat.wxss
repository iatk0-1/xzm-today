.chat-page { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; background: #f0f2f5; }
.nav-bar { display: flex; align-items: center; height: 44px; padding: 0 16px; background: #fff; border-bottom: 1rpx solid #e5e5e5; flex-shrink: 0; }
.nav-back { font-size: 22px; padding-right: 14px; }
.nav-title { font-size: 16px; font-weight: bold; }
.close-link { margin-left: auto; padding: 7px 10px; border: 1rpx solid #e6e6e6; border-radius: 6px; font-size: 12px; color: #555; flex-shrink: 0; }
.customer-info { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: #fff; font-size: 13px; }
.customer-avatar { width: 40px; height: 40px; border-radius: 20px; background: #ddd; flex-shrink: 0; }
.customer-summary { min-width: 0; flex: 1; }.customer-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.customer-phone { margin-top: 4px; color: #888; font-size: 11px; }
.msg-list { flex: 1; overflow-y: auto; padding: 12px; box-sizing: border-box; }
.msg-empty { text-align: center; color: #999; font-size: 12px; padding: 20px; }
.load-earlier { text-align: center; color: #677bc3; font-size: 12px; padding: 10px; }
.msg-item { margin-bottom: 16px; display: flex; flex-direction: column; }
.msg-left { align-items: flex-start; }.msg-right { align-items: flex-end; }
.msg-bubble { max-width: 75%; padding: 10px 14px; border-radius: 8px; font-size: 14px; line-height: 1.5; word-break: break-all; }
.bubble-left { background: #fff; color: #333; }.bubble-right { background: #4a6cf7; color: #fff; }
.msg-image-wrap { width: 180px; min-height: 90px; }.msg-image { width: 180px; border-radius: 6px; }.msg-image-fallback { width: 180px; height: 90px; display: flex; align-items: center; justify-content: center; border-radius: 6px; background: #e7eaf0; color: #667084; font-size: 11px; }.msg-video { width: 220px; height: 160px; border-radius: 6px; }.voice-bubble { min-width: 100px; }
.mini-card { width: 220px; padding: 14px; background: #fff; border-radius: 8px; font-size: 14px; line-height: 1.5; }.card-link { display: block; margin-top: 8px; font-size: 12px; color: #5267cb; }
.mini-thumb { width: 100%; height: 110px; border-radius: 5px; margin-bottom: 6px; background: #eee; }
.mini-thumb-fallback { height: 110px; margin-bottom: 6px; border-radius: 5px; background: #f0f2f5; color: #999; font-size: 12px; display: flex; align-items: center; justify-content: center; }
.msg-meta { margin-top: 4px; font-size: 10px; color: #999; }.retry-btn { margin-top: 4px; font-size: 12px; color: #d84242; }
.msg-error { max-width: 78%; margin-top: 4px; color: #d84242; font-size: 11px; line-height: 1.4; word-break: break-all; }
.quota-bar { padding: 8px 12px; background: #fff8ec; color: #a16c22; font-size: 11px; border-top: 1rpx solid #f4e7d0; }
.input-bar { display: flex; align-items: center; padding: 8px 10px calc(8px + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e5e5e5; flex-shrink: 0; }
.input-bar.tools-open { padding-bottom: 8px; }
.msg-input { flex: 1; height: 36px; background: #f5f5f5; border-radius: 18px; padding: 0 14px; font-size: 14px; }
.btn-send, .claim-btn { padding: 7px 16px; margin-left: 8px; background: #4a6cf7; color: #fff; border-radius: 16px; font-size: 13px; }
.btn-emoji { width: 30px; height: 30px; margin-left: 8px; flex-shrink: 0; text-align: center; line-height: 30px; color: #687286; font-size: 25px; }.btn-emoji.selected { color: #4a6cf7; }
.emoji-panel { height: 190px; background: #f7f8fa; border-top: 1rpx solid #e5e5e5; flex-shrink: 0; }.emoji-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; padding: 10px; }.emoji-item { min-width: 0; height: 54px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 8px; background: #fff; }.emoji-glyph { font-size: 22px; line-height: 28px; }.emoji-name { max-width: 100%; color: #777; font-size: 9px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.emoji-hint { padding: 4px 12px 12px; color: #9aa1ab; font-size: 10px; }
.action-bar { justify-content: center; color: #999; font-size: 12px; }.claim-btn { margin: 0; background: #1a1a1a; }
.btn-more { width: 28px; height: 28px; margin-right: 8px; text-align: center; line-height: 26px; border: 1rpx solid #b9bec8; border-radius: 50%; color: #656d7b; font-size: 24px; flex-shrink: 0; }
.disabled { opacity: .5; }.tools-panel { display: flex; flex-wrap: wrap; gap: 18px 24px; padding: 18px 18px calc(18px + env(safe-area-inset-bottom)); background: #f7f8fa; flex-shrink: 0; border-top: 1rpx solid #e5e5e5; }
.tool { display: flex; flex-direction: column; align-items: center; width: 62px; font-size: 11px; color: #737b88; gap: 6px; }.tool-icon { width: 48px; height: 48px; line-height: 48px; text-align: center; font-size: 25px; background: #fff; color: #566379; border-radius: 12px; }
.card-description { color: #888; font-size: 12px; margin-top: 5px; }
.card-reply { margin-top: 6px; font-size: 12px; color: #5267cb; }
.composer-mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 100; display: flex; align-items: flex-end; }
.composer { width: 100%; background: #fff; border-radius: 18px 18px 0 0; padding: 20px 20px calc(20px + env(safe-area-inset-bottom)); box-sizing: border-box; }.composer-heading { display: flex; justify-content: space-between; align-items: center; font-size: 17px; font-weight: 600; margin-bottom: 16px; }.composer-close { font-size: 26px; font-weight: normal; color: #888; padding: 0 4px; }
.composer-fields { height: 55vh; }.field-label { color: #555; font-size: 13px; margin: 14px 0 8px; }.composer-input { height: 42px; border-radius: 8px; padding: 0 12px; background: #f5f6f8; font-size: 14px; }
.kind-tabs { display: flex; gap: 10px; }.kind-tab { flex: 1; text-align: center; padding: 10px; border-radius: 8px; background: #f5f6f8; font-size: 13px; color: #777; }.kind-tab.selected { background: #edf1ff; color: #4a6cf7; }.composer-hint { color: #999; font-size: 11px; margin-top: 7px; }
.cover-picker { width: 156px; height: 100px; border-radius: 8px; background: #f5f6f8; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #777; overflow: hidden; }.cover-picker image { width: 100%; height: 100%; }
.composer-send { margin-top: 18px; padding: 12px; text-align: center; border-radius: 24px; background: #4a6cf7; color: #fff; font-size: 15px; }
.tools-hint { width: 100%; color: #9aa1ab; font-size: 10px; line-height: 1.5; }
