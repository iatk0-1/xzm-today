<page-meta page-style="{{dragKey ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="page">
  <view class="title">首页导航栏</view>
  <view class="description">“首页”固定显示在首页第一位。下方三个筛选项可长按左侧图标拖动排序，开关控制显示或隐藏，调整后自动保存，首页和搜索页同步调整。</view>
  <view class="loading" wx:if="{{loading}}">正在加载导航配置...</view>
  <view class="card" wx:if="{{tabs.length}}">
    <movable-area class="navigation-area" style="height: {{listHeight}}px;">
    <movable-view class="row {{dragKey === item.key ? 'dragging' : ''}}" wx:for="{{tabs}}" wx:key="key"
      x="{{0}}" y="{{item.y}}" direction="vertical" disabled="{{true}}" animation="{{dragKey !== item.key}}">
      <view class="drag-handle" data-key="{{item.key}}" catchlongpress="onDragStart"
        catchtouchmove="onDragTouchMove" catchtouchend="onDragEnd" catchtouchcancel="cancelDrag">☰</view>
      <view class="info">
        <view class="label">{{item.label}}</view>
        <view class="state">{{item.visible ? '显示' : '隐藏'}}</view>
      </view>
      <switch checked="{{item.visible}}" color="#111111" disabled="{{loading || saving || dragKey}}" data-key="{{item.key}}" bindchange="toggle" />
    </movable-view>
    </movable-area>
  </view>
  <view class="save-state {{saving ? 'saving' : ''}}" wx:if="{{tabs.length}}">{{saving ? '正在保存...' : dragKey ? '松手自动保存' : saved ? '已自动保存' : '调整后自动保存'}}</view>
  <view class="hint" wx:if="{{tabs.length}}">打开首页默认进入“首页”商品列表；搜索页默认选中下方排在最前的显示项。</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button wx:if="{{!tabs.length && !loading}}" bindtap="load">重新加载</button>
</view>
