page { background: #f6f6f6; color: #1a1a1a; }
.page { padding: 36rpx 24rpx 60rpx; }
.title { font-size: 38rpx; font-weight: 600; margin-bottom: 18rpx; }
.description, .hint { font-size: 26rpx; line-height: 1.7; color: #777; }
.card { background: #fff; border-radius: 24rpx; margin-top: 30rpx; }
.navigation-area { width: 100%; }
.row { position: absolute; left: 0; width: 100%; height: 96px; display: flex; align-items: center; padding: 0 24rpx; box-sizing: border-box; background: #fff; border-bottom: 1rpx solid #eee; }
.table-header { display: flex; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #eee; color: #777; font-size: 22rpx; }
.name-heading { flex: 1; min-width: 0; }
.visibility-column { width: 210rpx; flex-shrink: 0; display: flex; justify-content: center; align-items: center; }
.visibility-column switch { transform: scale(.8); }
.row:last-child { border-bottom: none; border-radius: 0 0 24rpx 24rpx; }
.row.dragging { z-index: 10; border-radius: 16rpx; box-shadow: 0 8rpx 28rpx rgba(31, 41, 51, .18); }
.drag-handle { display: flex; align-items: center; width: 28px; height: 100%; flex-shrink: 0; color: #9aa3ac; font-size: 20px; }
.info { flex: 1; min-width: 0; padding-right: 12rpx; }
.row switch { flex-shrink: 0; }
.label { font-size: 32rpx; font-weight: 600; }
.save-state { color: #888; font-size: 24rpx; text-align: right; margin: 18rpx 4rpx 0; }
.save-state.saving { color: #c56a00; }
.hint { margin: 24rpx 4rpx; }
.error { color: #c43c3c; font-size: 26rpx; line-height: 1.6; margin: 24rpx 0; }
.loading { padding: 50rpx 0; text-align: center; color: #888; }
