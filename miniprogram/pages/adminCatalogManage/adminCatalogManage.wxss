/* 页面高度写死成视口高度，整页不再跟着列表滚，顶部栏才能真正待在顶上 */
page { height: 100vh; background: #f4f6f8; }
.page { height: 100%; display: flex; flex-direction: column; overflow: hidden; }
.top-bar { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; background: #fff; flex-shrink: 0; }
.type-tabs { display: flex; width: 280rpx; height: 64rpx; padding: 4rpx; background: #eef1f4; border-radius: 8rpx; box-sizing: border-box; }
.type-tab { flex: 1; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #69737d; border-radius: 6rpx; }
.type-tab.active { color: #fff; background: #1f2933; font-weight: 600; }
.sort-state { font-size: 22rpx; color: #8a949e; }
.sort-state.dirty { color: #c56a00; }
/* flex-shrink: 0：列表再长也不许把顶部这两条挤扁 */
.add-row { display: flex; gap: 16rpx; padding: 20rpx 24rpx; background: #fff; border-top: 1rpx solid #edf0f2; flex-shrink: 0; }
.name-input { flex: 1; height: 72rpx; padding: 0 20rpx; background: #f4f6f8; border-radius: 8rpx; font-size: 26rpx; box-sizing: border-box; }
.add-btn { width: 120rpx; height: 72rpx; line-height: 72rpx; text-align: center; color: #fff; background: #1f2933; border-radius: 8rpx; font-size: 26rpx; }
/* min-height: 0 是让滚动区老老实实占满剩余高度、不再被内容撑开的关键 */
.list-scroll { flex: 1; min-height: 0; padding: 16rpx 20rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.group-area { width: 100%; }
.group-row { position: absolute; left: 0; width: 100%; height: 96px; overflow: hidden; background: #fff; border-bottom: 1px solid #edf0f2; box-sizing: border-box; }
.group-row:first-child { border-radius: 8rpx 8rpx 0 0; }
.group-row.dragging { z-index: 10; box-shadow: 0 8rpx 28rpx rgba(31, 41, 51, 0.18); }
.row-delete { position: absolute; top: 0; right: 0; z-index: 1; display: flex; align-items: center; justify-content: center; width: 72px; height: 100%; color: #fff; font-size: 14px; background: #c83e35; }
.row-content { position: relative; z-index: 2; display: flex; align-items: center; height: 100%; padding: 0 14px; background: #fff; box-sizing: border-box; }
.row-content.snapping { transition: transform 0.2s ease-out; }
.drag-handle { width: 28px; color: #9aa3ac; font-size: 20px; line-height: 1; letter-spacing: 0; flex-shrink: 0; }
.group-main { flex: 1; min-width: 0; padding-right: 8px; }
.group-name-row { display: flex; align-items: center; gap: 8px; }
.group-name { flex: 1; min-width: 0; color: #1f2933; font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rename-btn { flex-shrink: 0; color: #486780; font-size: 12px; padding: 4px 0; }
.group-meta { margin-top: 3px; color: #7b858f; font-size: 11px; white-space: nowrap; overflow: hidden; }
.auto-hidden { margin-left: 8px; color: #b44b3e; }
.manual-hidden { margin-left: 8px; color: #7b858f; }
.preview-row { display: flex; align-items: center; gap: 6px; margin-top: 5px; height: 30px; }
.preview-thumb { width: 30px; height: 30px; border-radius: 4px; background: #f4f6f8; flex-shrink: 0; }
.preview-empty { color: #b3bcc4; font-size: 11px; }
.switch-cell { flex-shrink: 0; }
.visibility-switch { transform: scale(0.78); }
.loading, .empty { padding: 180rpx 0; color: #929ba4; font-size: 26rpx; text-align: center; }
.rename-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(0, 0, 0, 0.45); box-sizing: border-box; }
.rename-dialog { width: 100%; max-width: 600rpx; padding: 36rpx; border-radius: 16rpx; background: #fff; box-sizing: border-box; }
.rename-title { color: #1f2933; font-size: 30rpx; font-weight: 600; }
.rename-input { height: 80rpx; margin-top: 28rpx; padding: 0 20rpx; border-radius: 8rpx; background: #f4f6f8; font-size: 28rpx; box-sizing: border-box; }
.rename-actions { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 32rpx; }
.rename-cancel, .rename-save { min-width: 120rpx; padding: 14rpx 20rpx; border-radius: 8rpx; text-align: center; font-size: 26rpx; box-sizing: border-box; }
.rename-cancel { color: #68737d; background: #f4f6f8; }
.rename-save { color: #fff; background: #1f2933; }
