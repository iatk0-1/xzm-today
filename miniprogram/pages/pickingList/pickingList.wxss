/* miniprogram/pages/pickingList/pickingList.wxss */
page {
  background: #f6f7f9;
}

.container {
  padding: 16rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.back-to-top {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 900;
  width: 184rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0;
  background: #1f2933;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .18);
}

/* 顶部导航栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 16rpx;
  gap: 16rpx;
}

.header-main {
  min-width: 0;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2933;
  line-height: 44rpx;
}

.header-subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a929d;
  line-height: 30rpx;
}

.btn-history {
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  font-size: 24rpx;
  color: #1f2933;
  background: #fff;
  border-radius: 10rpx;
  border: none;
  flex-shrink: 0;
  box-sizing: border-box;
}

.btn-history::after,
.sku-search-btn::after,
.btn-order::after,
.qty-adjust::after,
.btn-cancel::after,
.btn-confirm::after {
  border: none;
}

/* 顶部筛选栏 */
.filter-bar {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  width: 100%;
}

.filter-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.tab-item {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  background: #f2f4f7;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.tab-item.active {
  background: #1f2933;
  color: #fff;
  font-weight: 600;
}

/* 档口和标签筛选 */
.relation-filter-section {
  margin-bottom: 14rpx;
}

.relation-filter-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
}

.relation-filter-label {
  width: 64rpx;
  flex-shrink: 0;
  color: #333;
  font-size: 24rpx;
  font-weight: 600;
}

.relation-filter-fixed {
  flex-shrink: 0;
  margin-right: 12rpx;
}

.relation-filter-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.relation-filter-options {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 2rpx;
}

.relation-filter-tag {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  background: #f2f4f7;
  color: #666;
  font-size: 24rpx;
  line-height: 32rpx;
  border-radius: 12rpx;
}

.relation-filter-tag.active {
  background: #f2f4f7;
  color: #1f2933;
  font-weight: 800;
  box-shadow: inset 0 -4rpx 0 #1f2933;
}

/* SKU 筛选 */
.sku-filter {
  display: flex;
  gap: 10rpx;
}

.sku-input {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  background: #f6f7f9;
  border-radius: 10rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.sku-search-btn {
  width: 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  background: #1f2933;
  color: #fff;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0;
  box-sizing: border-box;
}

/* 操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 14rpx;
  gap: 12rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 86rpx;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #1f2933;
  flex-shrink: 0;
}

.selected-info {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.selected-info.empty text {
  color: #a1a8b3;
}

.selected-info text {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-order {
  width: 144rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  background: #1f2933;
  color: #fff;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}

.btn-order[disabled] {
  background: #c9ced6;
  color: #fff;
}

/* 推荐列表 */
.recommend-list {
  width: 100%;
}

.recommend-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border: 1rpx solid #eef1f5;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.recommend-item.selected {
  border-color: #8ec5ff;
  background: #f7fbff;
}

.item-checkbox {
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #1890ff;
  border-color: #1890ff;
}

.item-content {
  flex: 1;
  display: flex;
  gap: 14rpx;
  min-width: 0;
}

.item-image {
  width: 108rpx;
  height: 108rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2933;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-sku {
  font-size: 22rpx;
  color: #7b8490;
  line-height: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommend-item.has-refund .item-name,
.recommend-item.has-refund .item-sku {
  padding-right: 94rpx;
  box-sizing: border-box;
}

.item-stats {
  width: 100%;
  min-width: 0;
  overflow: hidden;
  margin-top: 4rpx;
  white-space: nowrap;
}

.item-stats-row {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  white-space: nowrap;
}

.stat {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 6rpx;
  height: 38rpx;
  padding: 0 12rpx;
  background: #f4f6f8;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.stat-label {
  font-size: 20rpx;
  color: #8a929d;
}

.stat-value {
  font-size: 22rpx;
  font-weight: 600;
  color: #3d4652;
}

.stat.recommend {
  background: #eaf4ff;
}

.stat.recommend .stat-label,
.stat.recommend .stat-value {
  color: #1677c8;
}
.item-refund-btn { position: absolute; top: 16rpx; right: 16rpx; z-index: 1; display: flex; align-items: center; justify-content: center; width: 84rpx; height: 46rpx; border: 1rpx solid #d93026; border-radius: 8rpx; background: #fff; color: #d93026; font-size: 21rpx; box-sizing: border-box; }

/* 空状态和加载状态 */
.empty-state, .loading-state {
  padding: 80rpx 0;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.42);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.modal-order {
  width: 700rpx;
}

.modal-title {
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2933;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-list {
  flex: 1;
  padding: 10rpx 16rpx;
  max-height: 500rpx;
  box-sizing: border-box;
}

.order-item {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 14rpx;
}

.order-item:last-child {
  border-bottom: none;
}

.order-item-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.order-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.order-item-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2933;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-item-sku {
  font-size: 22rpx;
  color: #7b8490;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-item-qty {
  font-size: 22rpx;
  color: #999;
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}
.refund-modal { width: 700rpx; max-height: 82vh; }
.refund-modal-subtitle { padding: 14rpx 24rpx; color: #59636f; font-size: 23rpx; border-bottom: 1rpx solid #eee; }
.refund-order-list { flex: 1; min-height: 0; max-height: 60vh; padding: 14rpx 18rpx; box-sizing: border-box; }
.refund-loading { padding: 70rpx 0; text-align: center; color: #89929d; font-size: 24rpx; }
.refund-order-card { margin-bottom: 12rpx; padding: 18rpx; border: 1rpx solid #e9edf2; border-radius: 12rpx; }
.refund-order-head { display: flex; justify-content: space-between; gap: 12rpx; font-size: 23rpx; color: #283442; }
.refund-order-no { min-width: 0; word-break: break-all; }
.refund-order-status { flex-shrink: 0; color: #d93026; }
.refund-order-time, .refund-order-recipient { margin-top: 8rpx; color: #7b8490; font-size: 21rpx; }
.refund-order-goods { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; padding: 12rpx 0; border-top: 1rpx solid #f2f3f5; }
.refund-order-goods image { width: 72rpx; height: 72rpx; flex-shrink: 0; border-radius: 6rpx; }
.refund-order-goods-info { display: flex; flex-direction: column; gap: 5rpx; min-width: 0; font-size: 22rpx; color: #333; }
.refund-order-goods-info text:last-child { color: #7b8490; font-size: 20rpx; }
.refund-order-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 10rpx; color: #5e6874; font-size: 21rpx; }
.refund-order-btn { margin: 0; width: 100rpx; height: 52rpx; line-height: 50rpx; padding: 0; color: #d93026; background: #fff; border: 1rpx solid #d93026; border-radius: 7rpx; font-size: 22rpx; }
.refund-modal-footer { display: flex; gap: 14rpx; padding: 16rpx 20rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eee; }
.refund-modal-footer button { flex: 1; margin: 0; height: 68rpx; line-height: 68rpx; font-size: 24rpx; }
.btn-all-refund { background: #d93026; color: #fff; }

.qty-label {
  flex-shrink: 0;
}

.qty-editor {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 204rpx;
  flex: 0 0 204rpx;
  min-width: 204rpx;
}

.qty-adjust {
  width: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  flex: 0 0 48rpx;
  height: 44rpx;
  line-height: 40rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d9dee7;
  border-radius: 6rpx;
  background: #f7f8fa;
  color: #344054;
  font-size: 28rpx;
  box-sizing: border-box;
}

.qty-input {
  width: 92rpx;
  min-width: 92rpx;
  max-width: 92rpx;
  flex: 0 0 92rpx;
  height: 44rpx;
  padding: 0 8rpx;
  border: 1rpx solid #b8c4d3;
  border-radius: 6rpx;
  color: #1677c8;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.qty-highlight {
  color: #1890ff;
  font-weight: 700;
  font-size: 24rpx;
}

.order-summary {
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #f9f9f9;
  font-size: 24rpx;
  color: #666;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  font-size: 26rpx;
  border-radius: 0;
  padding: 0;
  border: none;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.btn-confirm {
  background: #1f2933;
  color: #fff;
}
.refund-return-choice { flex-basis: 100%; font-size: 22rpx; }
.refund-modal-footer { flex-wrap: wrap; }
