<!-- miniprogram/pages/pickingList/pickingList.wxml -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header-bar">
    <view class="header-main">
      <view class="header-title">拣货单推荐</view>
      <view class="header-subtitle">按 SKU 数量汇总生成报单数量</view>
    </view>
    <button class="btn-history" bindtap="goToOrders">报单记录</button>
  </view>

  <!-- 顶部筛选栏 -->
  <view class="filter-bar">
    <view class="filter-tabs">
      <view class="tab-item {{filterStatus === 'pending' ? 'active' : ''}}" bindtap="setFilter" data-status="pending">
        待报
      </view>
      <view class="tab-item {{filterStatus === 'ordered' ? 'active' : ''}}" bindtap="setFilter" data-status="ordered">
        已报
      </view>
      <view class="tab-item {{filterStatus === 'all' ? 'active' : ''}}" bindtap="setFilter" data-status="all">
        全部
      </view>
    </view>

    <!-- 档口和标签筛选 -->
    <view class="relation-filter-section">
      <view class="relation-filter-row">
        <text class="relation-filter-label">档口</text>
        <view class="relation-filter-fixed relation-filter-tag {{selectedStall === '' ? 'active' : ''}}" bindtap="selectStall" data-stall="all">全部</view>
        <scroll-view class="relation-filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="relation-filter-options">
            <view class="relation-filter-tag {{selectedStall === item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="relation-filter-row">
        <text class="relation-filter-label">标签</text>
        <view class="relation-filter-fixed relation-filter-tag {{selectedTag === '' ? 'active' : ''}}" bindtap="selectTag" data-tag="all">全部</view>
        <scroll-view class="relation-filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="relation-filter-options">
            <view class="relation-filter-tag {{selectedTag === item.id ? 'active' : ''}}" wx:for="{{tagList}}" wx:key="id" bindtap="selectTag" data-tag="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
    
    <!-- SKU 筛选 -->
    <view class="sku-filter">
      <input class="sku-input" placeholder="搜索 SKU/商品" value="{{skuKeyword}}" bindinput="onSkuKeywordInput" />
      <button class="sku-search-btn" bindtap="searchSku">搜索</button>
    </view>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar" wx:if="{{filterStatus === 'pending'}}">
    <view class="select-all" bindtap="toggleSelectAll">
      <view class="checkbox {{allSelected ? 'checked' : ''}}">
        <text wx:if="{{allSelected}}">✓</text>
      </view>
      <text>全选</text>
    </view>
    <view class="selected-info {{selectedCount === 0 ? 'empty' : ''}}">
      <text wx:if="{{selectedCount > 0}}">已选 {{selectedCount}} 个 SKU，共 {{totalQty}} 件</text>
      <text wx:else>未选择商品</text>
    </view>
    <button class="btn-order" bindtap="createPurchaseOrder" disabled="{{selectedCount === 0}}">去报单</button>
  </view>

  <!-- 推荐列表 -->
  <view class="recommend-list">
    <view class="recommend-item {{item.selected ? 'selected' : ''}} {{filterStatus === 'pending' && item.recommendQty > 0 ? 'has-refund' : ''}}" wx:for="{{recommendList}}" wx:key="skuId" bindtap="goToRelatedOrders" data-index="{{index}}">
      <view class="item-checkbox" wx:if="{{filterStatus === 'pending' && item.recommendQty > 0}}">
        <view class="checkbox {{item.selected ? 'checked' : ''}}" catchtap="toggleSelect" data-index="{{index}}">
          <text wx:if="{{item.selected}}">✓</text>
        </view>
      </view>
      <view class="item-content">
        <image 
          class="item-image" 
          src="{{item.imageUrl ? item.imageUrl : (item.defaultImageUrl || '/images/default-goods-image.png')}}" 
          mode="aspectFill" 
          lazy-load="true"
          binderror="onImageError"
          catchtap="previewProductImage"
          data-index="{{index}}"
        />
        <view class="item-info">
          <view class="item-name">{{item.productName}}</view>
          <view class="item-sku">{{item.spec || '默认规格'}} · {{item.size || '均码'}}</view>
          <scroll-view class="item-stats" scroll-x="true" show-scrollbar="{{false}}">
            <view class="item-stats-row">
              <view class="stat recommend">
                <text class="stat-label">待报</text>
                <text class="stat-value">{{item.recommendQty}}</text>
              </view>
              <view class="stat ordered-stat">
                <text class="stat-label ordered-label">已报</text>
                <text class="stat-value ordered-value">{{item.orderedQty}}</text>
              </view>
              <view class="stat total-stat">
                <text class="stat-label">全部</text>
                <text class="stat-value">{{item.allQty}}</text>
              </view>
              <view class="stat pending-stat">
                <text class="stat-label pending-label">未发</text>
                <text class="stat-value pending-value">{{item.pendingShipQty}}</text>
              </view>
              <view class="stat shipped-stat">
                <text class="stat-label shipped-label">已发</text>
                <text class="stat-value shipped-value">{{item.shippedQty}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="item-refund-btn" wx:if="{{filterStatus === 'pending' && item.recommendQty > 0}}" catchtap="openRefundModal" data-index="{{index}}">退款</view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{recommendList.length === 0 && !loading}}">
      <text>{{filterStatus === 'pending' ? '暂无待报单商品' : (filterStatus === 'ordered' ? '暂无已报单商品' : '暂无数据')}}</text>
    </view>

    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="loading-state" wx:if="{{recommendList.length > 0 && !loading && !hasMore}}">
      <text>没有更多了</text>
    </view>
  </view>

  <button class="back-to-top" bindtap="backToTop">回到顶部</button>

  <view class="modal" wx:if="{{showRefundModal}}">
    <view class="modal-mask" bindtap="closeRefundModal"></view>
    <view class="modal-content refund-modal">
      <view class="modal-title">待报商品退款</view>
      <view class="refund-modal-subtitle">{{refundSku.productName}} · {{refundSku.spec || '默认规格'}} / {{refundSku.size || '均码'}}</view>
      <scroll-view class="refund-order-list" scroll-y>
        <view class="refund-loading" wx:if="{{refundLoading}}">关联订单加载中...</view>
        <view class="refund-loading" wx:elif="{{refundOrders.length === 0}}">暂无可退的关联订单</view>
        <view class="refund-order-card" wx:for="{{refundOrders}}" wx:key="id">
          <view class="refund-order-head">
            <view class="refund-order-no">订单号：{{item.order.outTradeNo || item.order.id}}</view>
            <text class="refund-order-status">{{item.order.statusDisplay}}</text>
          </view>
          <view class="refund-order-time">{{item.order.createdAt}}</view>
          <view class="refund-order-recipient" wx:if="{{item.order.recipientName}}">{{item.order.recipientName}} {{item.order.recipientPhone}}</view>
          <view class="refund-order-goods" wx:for="{{item.relatedGoods}}" wx:for-item="goods" wx:key="orderItemId">
            <image src="{{goods.productImage || refundSku.imageUrl || refundSku.defaultImageUrl}}" mode="aspectFill" />
            <view class="refund-order-goods-info">
              <text>{{goods.productName || refundSku.productName}}</text>
              <text>{{goods.productSpec || refundSku.spec}} / {{goods.productSize || refundSku.size}} · 待报 {{goods.pendingQty}} 件</text>
            </view>
          </view>
          <view class="refund-order-bottom">
            <text>该商品待报 {{item.pendingQty}} 件 · 实付款 ¥{{item.order.payAmount}}</text>
            <button class="refund-order-btn" catchtap="refundRelatedOrder" data-index="{{index}}" disabled="{{refundBusy}}">退款</button>
          </view>
        </view>
      </scroll-view>
      <view class="refund-modal-footer">
        <button class="btn-cancel" bindtap="closeRefundModal" disabled="{{refundBusy}}">关闭</button>
        <button class="btn-all-refund" bindtap="refundAllPending" disabled="{{refundBusy || refundLoading || refundOrders.length === 0}}">全部退款</button>
      </view>
    </view>
  </view>

  <!-- 报单详情弹窗 -->
  <view class="modal" wx:if="{{showOrderModal}}">
    <view class="modal-mask" bindtap="hideOrderModal"></view>
    <view class="modal-content modal-order">
      <view class="modal-title">确认报单数量</view>
      <scroll-view class="order-list" scroll-y>
        <view class="order-item" wx:for="{{orderPreviewList}}" wx:key="skuId">
          <image class="order-item-image" src="{{item.imageUrl ? item.imageUrl : item.defaultImageUrl}}" mode="aspectFill" />
          <view class="order-item-info">
            <view class="order-item-name">{{item.productName}}</view>
            <view class="order-item-sku">{{item.spec}} {{item.size}}</view>
            <view class="order-item-qty">
              <text class="qty-label">报单数量</text>
              <view class="qty-editor">
                <button class="qty-adjust" bindtap="adjustOrderQty" data-index="{{index}}" data-delta="-1">−</button>
                <input
                  class="qty-input"
                  type="number"
                  value="{{item.qty}}"
                  bindinput="onOrderQtyInput"
                  bindblur="normalizeOrderQty"
                  data-index="{{index}}"
                />
                <button class="qty-adjust" bindtap="adjustOrderQty" data-index="{{index}}" data-delta="1">+</button>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="order-summary">
        <text>共 {{selectedCount}} 个 SKU，总计 {{totalQty}} 件</text>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="hideOrderModal">取消</button>
        <button class="btn-confirm" bindtap="confirmOrder">确认报单</button>
      </view>
    </view>
  </view>
</view>
