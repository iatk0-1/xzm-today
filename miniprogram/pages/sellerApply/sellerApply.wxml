<view class="page">
  <view class="section-title">合作商户</view>
  <view class="merchant-list">
    <view class="merchant-row {{selectedMerchant.merchantId == item.merchantId ? 'selected' : ''}}"
      wx:for="{{merchants}}" wx:key="merchantId" data-id="{{item.merchantId}}" bindtap="selectMerchant">
      <text>{{item.merchantName}}</text>
      <text class="status">{{item.partnershipStatus || '未申请'}}</text>
    </view>
  </view>

  <view class="form" wx:if="{{selectedMerchant}}">
    <view class="field-label">店铺名称</view>
    <input class="input" maxlength="128" value="{{shopName}}" bindinput="onShopNameInput" />
    <view class="field-label">联系电话</view>
    <input class="input" type="number" maxlength="20" value="{{contactPhone}}" bindinput="onPhoneInput" />
    <button class="submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交申请</button>
  </view>
</view>
