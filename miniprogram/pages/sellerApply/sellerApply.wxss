page { background: #f6f6f6; }
.page { padding: 28rpx 24rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #111; margin-bottom: 18rpx; }
.merchant-list, .form { background: #fff; border-radius: 8rpx; padding: 0 28rpx; }
.merchant-row { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #eee; color: #333; font-size: 28rpx; }
.merchant-row.selected { color: #111; font-weight: 700; }
.status { font-size: 23rpx; color: #777; }
.form { margin-top: 24rpx; padding-top: 28rpx; padding-bottom: 28rpx; }
.field-label { font-size: 25rpx; color: #555; margin: 20rpx 0 12rpx; }
.input { height: 78rpx; background: #f5f5f5; border-radius: 6rpx; padding: 0 20rpx; font-size: 28rpx; }
.submit { margin-top: 36rpx; background: #111; color: #fff; border-radius: 6rpx; font-size: 28rpx; }
.submit::after { border: 0; }
