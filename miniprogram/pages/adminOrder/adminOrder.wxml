<!-- 备份原文件 -->
<!-- 原 adminOrder.wxml 已备份为 adminOrder.wxml.bak -->

<!-- 新的基于产品维度的发货页面 -->
<view class="container">
  <!-- 筛选与发货操作区随页面滚动 -->
  <view class="admin-order-header">
    <view class="search-section">
      <view class="search-dismiss-mask" wx:if="{{searchActive}}" bindtap="onSearchConfirm"></view>
      <view class="search-box">
        <view class="search-input-wrapper">
          <input class="search-input" placeholder="搜索商品名称" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearchConfirm" focus="{{searchFocus}}" />
          <button class="search-btn" bindtap="onSearchConfirm">搜索</button>
        </view>
        <scroll-view class="search-dropdown" wx:if="{{searchKeyword && (searchDropdown.length > 0 || searchLoading)}}" style="height: {{searchDropdown.length >= 4 ? 600 : searchDropdown.length * 150 + (searchLoading ? 60 : 0)}}rpx" scroll-y="true" bindscrolltolower="loadMoreSearchProducts" lower-threshold="80">
          <view class="dropdown-item {{product.isSelected ? 'selected' : ''}}" wx:for="{{searchDropdown}}" wx:key="id" wx:for-item="product" bindtap="onDropdownItemClick" data-product="{{product}}">
            <view class="selected-badge" wx:if="{{product.isSelected}}">已添加</view>
            <image class="dropdown-image" src="{{product.coverUrl || '/images/default-goods-image.png'}}" mode="aspectFill" />
            <view class="dropdown-info">
              <text class="dropdown-name">{{product.name}}</text>
              <text class="dropdown-sku-count">{{product.skuCount}}个 SKU</text>
            </view>
          </view>
          <view class="dropdown-loading" wx:if="{{searchLoading}}">加载中...</view>
        </scroll-view>
      </view>

      <!-- 档口和标签筛选：两个条件可同时选择，和商品/SKU按 AND 关系查询 -->
      <view class="filter-section">
        <view class="filter-row">
          <text class="filter-label">档口</text>
          <view class="filter-fixed-option filter-tag {{selectedStall === '' ? 'active' : ''}}" bindtap="selectStall" data-stall="all">全部</view>
          <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
            <view class="filter-options">
              <view class="filter-tag {{selectedStall === item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}">{{item.name}}</view>
            </view>
          </scroll-view>
        </view>
        <view class="filter-row">
          <text class="filter-label">标签</text>
          <view class="filter-fixed-option filter-tag {{selectedTag === '' ? 'active' : ''}}" bindtap="selectTag" data-tag="all">全部</view>
          <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
            <view class="filter-options">
              <view class="filter-tag {{selectedTag === item.id ? 'active' : ''}}" wx:for="{{tagList}}" wx:key="id" bindtap="selectTag" data-tag="{{item.id}}">{{item.name}}</view>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="date-filter">
        <view class="date-picker" bindtap="showDateRangeSelector">
          <text wx:if="{{!dateRange.startDate && !dateRange.endDate}}">选择下单时间范围</text>
          <text wx:else>{{dateRange.startDate || '开始'}} - {{dateRange.endDate || '结束'}}</text>
        </view>
        <view class="clear-date" wx:if="{{dateRange.startDate || dateRange.endDate}}" bindtap="clearDateRange">×</view>
      </view>

      <!-- 已选商品 -->
      <view class="selected-products" wx:if="{{selectedProducts.length > 0}}">
        <view class="selected-title">已选商品</view>
        <view class="selected-list">
          <view class="selected-tag" wx:for="{{selectedProducts}}" wx:key="id" bindtap="openSkuSelector" data-product="{{item}}">
            {{item.name}}
            <text class="tag-count" wx:if="{{item.skuCount > 0}}">({{item.skuCount}}个 SKU)</text>
            <view class="remove-btn" catchtap="removeProduct" data-id="{{item.id}}">×</view>
          </view>
        </view>
        <button class="clear-all" wx:if="{{selectedProducts.length > 0}}" bindtap="clearSelected">清空</button>
      </view>
    </view>

    <!-- 工具栏：上排物流与全选，下排发货操作 -->
    <view class="toolbar">
      <view class="toolbar-row toolbar-info-row">
        <picker class="logistics-picker" range="{{logisticsAccounts}}" range-key="deliveryName" value="{{logisticsIndex}}" bindchange="onLogisticsChange">
          <view class="picker-value">{{logisticsAccounts[logisticsIndex] ? logisticsAccounts[logisticsIndex].deliveryName : '选择物流'}} ▾</view>
        </picker>
        <text class="quota-info" wx:if="{{logisticsAccounts[logisticsIndex]}}">余 {{logisticsAccounts[logisticsIndex].quotaNum}}</text>
        <view class="toolbar-spacer"></view>
        <view class="checkbox-all {{allSelected ? 'checked' : ''}}" bindtap="toggleSelectAll">
          <text wx:if="{{allSelected}}">✓</text>
        </view>
        <text class="select-all-text" bindtap="toggleSelectAll">{{selectingAll ? '正在加载全部...' : '全选'}}</text>
      </view>
      <view class="toolbar-row toolbar-action-row">
        <button class="failed-ship-btn" bindtap="openFailedWaybills">失败列表</button>
        <button class="batch-ship-btn" bindtap="openPendingShipList" disabled="{{pendingShipItems.length === 0 || !logisticsAccounts[logisticsIndex]}}">
          批量发货（{{pendingOrderCount}} 单）
        </button>
        <view class="toolbar-history-entry" bindtap="openRecentBatchTasks">历史任务</view>
      </view>
    </view>
  </view>

  <view class="active-batch-banner" wx:if="{{activeBatchTask}}" bindtap="openBatchProgress">
    <view><text class="active-batch-title">后台发货 · {{activeBatchTask.statusText}}</text>
      <view class="batch-progress-meta">已处理 {{activeBatchTask.summary.completed}}/{{activeBatchTask.summary.total}} 个包裹，可离开页面</view>
    </view>
    <text class="copy-link">查看进度 ›</text>
  </view>

  <!-- 创建面单失败历史：沿用待发货列表的订单与商品卡片，加入后继续原批量发货流程。 -->
  <view class="pending-modal" wx:if="{{showFailedWaybills}}">
    <view class="pending-modal-mask" bindtap="closeFailedWaybills" catchtouchmove="stopPendingShipEvent"></view>
    <view class="pending-modal-content">
      <view class="pending-modal-header">
        <view class="pending-modal-title"><text>失败列表</text><text class="pending-modal-count">仅创建面单失败</text></view>
        <text class="pending-modal-close" bindtap="closeFailedWaybills">关闭</text>
      </view>
      <scroll-view class="pending-modal-list" scroll-y="true" enable-flex="true" bindscrolltolower="loadFailedWaybills">
        <view class="pending-order-group" wx:for="{{failedWaybillGroups}}" wx:key="groupId" wx:for-item="failure" wx:for-index="failureIndex">
          <view class="failed-waybill-head">
            <text>失败时间 {{failure.failedAtText}}</text>
            <text class="batch-progress-reason">原因：{{failure.reason || '创建面单失败'}}</text>
          </view>
          <view wx:for="{{failure.orders}}" wx:key="orderId" wx:for-item="order">
            <view class="order-header pending-order-header">
              <view class="order-summary" bindtap="goToOrderDetail" bindtouchstart="onOrderTouchStart" bindtouchmove="onOrderTouchMove" bindtouchend="onOrderTouchEnd" bindtouchcancel="onOrderTouchCancel" data-order-id="{{order.orderId}}">
                <text class="summary-chip" wx:if="{{order.adminSeqNo}}">序号 {{order.adminSeqNo}}</text>
                <view class="summary-row">
                  <view class="summary-main">
                    <text class="summary-label">订单号</text>
                    <view class="order-number">
                      <text class="order-no">{{order.orderNo}}</text>
                      <text class="copy-link summary-action" catchtap="copyOrderNo" data-order-no="{{order.orderNo}}">复制</text>
                    </view>
                  </view>
                </view>
                <text class="order-date">{{order.createdAt}}</text>
                <view class="summary-row recipient-row">
                  <view class="summary-main recipient-main"><text class="summary-label">收件人</text><text class="recipient-name" user-select="{{true}}">{{order.recipientName}}</text><text class="recipient-phone" user-select="{{true}}">{{order.recipientPhone}}</text></view>
                  <text class="copy-link summary-action" catchtap="copyRecipientInfo" data-name="{{order.recipientName}}" data-phone="{{order.recipientPhone}}" data-address="{{order.recipientAddress}}">复制</text>
                </view>
                <text class="recipient-address" user-select="{{true}}">{{order.recipientAddress}}</text>
              </view>
            </view>
            <view class="order-items pending-order-items">
              <view class="order-item pending-order-item" bindtap="goToOrderDetail" bindtouchstart="onOrderTouchStart" bindtouchmove="onOrderTouchMove" bindtouchend="onOrderTouchEnd" bindtouchcancel="onOrderTouchCancel" data-order-id="{{order.orderId}}" wx:for="{{order.items}}" wx:key="uniqueKey" wx:for-item="item">
                <image class="item-image" src="{{item.productImage || item.skuImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
                <view class="item-info">
                  <view class="item-name"><text user-select="{{true}}">{{item.productName}}</text></view>
                  <view class="item-sku"><text user-select="{{true}}">{{item.skuSpec}} {{item.skuSize}}</text></view>
                  <view class="item-qty">总数：{{item.totalQty}}  已发：{{item.shippedQty}}  未发：{{item.unshippedQty}}</view>
                  <view class="item-after-sale admin-remark-line" catchtap="editAdminRemark" data-item="{{item}}">管理员备注：{{item.adminRemark || '点击添加'}}</view>
                  <view class="item-after-sale" wx:if="{{item.afterSaleQty > 0}}">{{item.afterSaleStatusText || '售后'}} {{item.afterSaleQty}} 件</view>
                  <view class="failed-unavailable" wx:if="{{!item.canShip}}">当前无可发数量</view>
                </view>
              </view>
            </view>
          </view>
          <view class="pending-actions"><button class="failed-add-btn" bindtap="addFailedWaybillsToPending" data-group-index="{{failureIndex}}">加入待发货列表</button></view>
        </view>
        <view class="failed-list-empty" wx:if="{{!failedWaybillLoading && failedWaybillGroups.length === 0}}">暂无创建面单失败记录</view>
        <view class="failed-list-empty" wx:if="{{failedWaybillLoading}}">加载中...</view>
      </scroll-view>
      <view class="pending-modal-footer"><button class="batch-ship-btn failed-all-btn" bindtap="addFailedWaybillsToPending" disabled="{{failedWaybillGroups.length === 0}}">将已加载订单加入待发货列表</button></view>
    </view>
  </view>

  <!-- 待发货列表弹窗 -->
  <view class="pending-modal" wx:if="{{showPendingShipList}}">
    <view class="pending-modal-mask" bindtap="closePendingShipList" catchtouchmove="stopPendingShipEvent"></view>
    <view class="pending-modal-content">
      <view class="pending-modal-header">
        <view class="pending-modal-title">
          <text>待发货列表</text>
          <text class="pending-modal-count">{{pendingOrderCount}} 个订单，{{pendingItemCount}} 项商品</text>
        </view>
        <text class="pending-modal-close" bindtap="closePendingShipList">关闭</text>
      </view>

      <scroll-view class="pending-modal-list" scroll-y="true" enable-flex="true">
        <view class="pending-order-group" wx:for="{{pendingOrderGroups}}" wx:key="orderId" wx:for-item="group">
          <view class="order-header pending-order-header">
            <view class="order-summary" bindtap="goToOrderDetail" bindtouchstart="onOrderTouchStart" bindtouchmove="onOrderTouchMove" bindtouchend="onOrderTouchEnd" bindtouchcancel="onOrderTouchCancel" data-order-id="{{group.orderId}}">
              <text class="summary-chip" wx:if="{{group.adminSeqNo}}">序号 {{group.adminSeqNo}}</text>
              <view class="summary-row">
                <view class="summary-main">
                  <text class="summary-label">订单号</text>
                  <view class="order-number">
                    <text class="order-no">{{group.orderNo}}</text>
                    <text class="copy-link summary-action" catchtap="copyOrderNo" data-order-no="{{group.orderNo}}">复制</text>
                  </view>
                </view>
              </view>
              <text class="order-date">{{group.createdAt}}</text>
              <view class="summary-row recipient-row">
                <view class="summary-main recipient-main">
                  <text class="summary-label">收件人</text>
                  <text class="recipient-name" user-select="{{true}}">{{group.recipientName}}</text>
                  <text class="recipient-phone" user-select="{{true}}">{{group.recipientPhone}}</text>
                </view>
                <text class="copy-link summary-action" catchtap="copyRecipientInfo" data-name="{{group.recipientName}}" data-phone="{{group.recipientPhone}}" data-address="{{group.recipientAddress}}">复制</text>
              </view>
              <text class="recipient-address" user-select="{{true}}">{{group.recipientAddress}}</text>
            </view>
          </view>

          <view class="order-items pending-order-items">
            <view class="order-item pending-order-item" bindtap="goToOrderDetail" bindtouchstart="onOrderTouchStart" bindtouchmove="onOrderTouchMove" bindtouchend="onOrderTouchEnd" bindtouchcancel="onOrderTouchCancel" data-order-id="{{group.orderId}}" wx:for="{{group.items}}" wx:key="uniqueKey" wx:for-item="item">
              <image class="item-image" src="{{item.productImage || item.skuImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
              <view class="item-info">
                <view class="item-name"><text user-select="{{true}}">{{item.productName}}</text></view>
                <view class="item-sku"><text user-select="{{true}}">{{item.skuSpec}} {{item.skuSize}}</text></view>
                <view class="item-qty">总数：{{item.totalQty}}  已发：{{item.shippedQty}}  未发：{{item.unshippedQty}}</view>
                <view class="item-after-sale admin-remark-line" catchtap="editAdminRemark" data-item="{{item}}">管理员备注：{{item.adminRemark || '点击添加'}}</view>
                <view class="item-after-sale" wx:if="{{item.afterSaleQty > 0}}">
                  <text>{{item.afterSaleStatusText || '售后'}} {{item.afterSaleQty}} 件</text>
                  <text>可发 {{item.unshippedQty}}</text>
                </view>
              </view>
              <view class="pending-item-actions" catchtap="stopPendingShipEvent">
                <view class="stepper">
                  <view class="stepper-btn {{item.shipQty <= 0 ? 'disabled' : ''}}" bindtap="onPendingShipDecrease" data-pending-index="{{item.pendingIndex}}">−</view>
                  <input class="stepper-input" type="number" value="{{item.shipQty}}" bindinput="onPendingShipQtyInput" data-pending-index="{{item.pendingIndex}}" />
                  <view class="stepper-btn" bindtap="onPendingShipIncrease" data-pending-index="{{item.pendingIndex}}">+</view>
                </view>
                <text class="pending-remove" bindtap="removePendingShipItem" data-pending-index="{{item.pendingIndex}}">删除</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="pending-modal-footer">
        <view class="pending-logistics-row">
          <picker class="pending-logistics-picker" range="{{logisticsAccounts}}" range-key="deliveryName" value="{{logisticsIndex}}" bindchange="onLogisticsChange">
            <view class="pending-picker-value">{{logisticsAccounts[logisticsIndex] ? logisticsAccounts[logisticsIndex].deliveryName : '选择快递'}}</view>
          </picker>
          <text class="pending-quota" wx:if="{{logisticsAccounts[logisticsIndex]}}">剩余面单 {{logisticsAccounts[logisticsIndex].quotaNum}}</text>
        </view>
        <view class="pending-footer-actions">
          <text class="pending-clear" bindtap="clearPendingShipItems">清空列表</text>
          <button class="batch-ship-btn pending-batch-ship-btn" bindtap="batchShip" disabled="{{pendingShipItems.length === 0 || !logisticsAccounts[logisticsIndex]}}">
            批量发货（{{pendingOrderCount}} 单）
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单列表随页面一起滚动 -->
  <view class="order-list-container">
    <view class="after-sale-alert" wx:if="{{blockedAfterSaleCount > 0}}">
      有 {{blockedAfterSaleCount}} 个待发货订单因售后暂无可发商品，已从可发列表中隐藏
    </view>

    <!-- 订单列表 -->
    <view class="order-list">
    <view class="order-group" wx:for="{{orderGroups}}" wx:key="orderId" wx:for-item="group" wx:for-index="index">
      <view class="order-header selectable-order-header">
        <view class="selection-column order-selection-column" catchtap="toggleGroupSelect" data-index="{{index}}">
          <view class="order-checkbox {{group.selected ? 'checked' : ''}}">
            <text wx:if="{{group.selected}}">✓</text>
          </view>
        </view>
        <view class="order-summary" bindtap="goToOrderDetail" bindtouchstart="onOrderTouchStart" bindtouchmove="onOrderTouchMove" bindtouchend="onOrderTouchEnd" bindtouchcancel="onOrderTouchCancel" data-order-id="{{group.orderId}}">
          <text class="summary-chip" wx:if="{{group.adminSeqNo}}">序号 {{group.adminSeqNo}}</text>
          <view class="summary-row">
            <view class="summary-main">
              <text class="summary-label">订单号</text>
              <view class="order-number">
                <text class="order-no">{{group.orderNo}}</text>
                <text class="copy-link summary-action" catchtap="copyOrderNo" data-order-no="{{group.orderNo}}">复制</text>
              </view>
            </view>
          </view>
          <text class="order-date">{{group.createdAt}}</text>
          <view class="summary-row recipient-row">
            <view class="summary-main recipient-main">
              <text class="summary-label">收件人</text>
              <text class="recipient-name" user-select="{{true}}">{{group.recipientName}}</text>
              <text class="recipient-phone" user-select="{{true}}">{{group.recipientPhone}}</text>
            </view>
            <text class="copy-link summary-action" catchtap="copyRecipientInfo" data-name="{{group.recipientName}}" data-phone="{{group.recipientPhone}}" data-address="{{group.recipientAddress}}">复制</text>
          </view>
          <text class="recipient-address" user-select="{{true}}">{{group.recipientAddress}}</text>
        </view>
      </view>

      <view class="order-items selectable-order-items">
        <view class="order-item selectable-order-item" bindtap="goToOrderDetail" bindtouchstart="onOrderTouchStart" bindtouchmove="onOrderTouchMove" bindtouchend="onOrderTouchEnd" bindtouchcancel="onOrderTouchCancel" data-order-id="{{group.orderId}}" wx:for="{{group.items}}" wx:key="uniqueKey" wx:for-item="item" wx:for-index="itemIndex">
          <!-- 售后占用后无可发数量：不可选、灰色 -->
          <block wx:if="{{!item.canShip}}">
            <view class="selection-column item-selection-column" catchtap="stopPendingShipEvent">
              <view class="item-checkbox disabled"></view>
            </view>
            <image class="item-image refunded" src="{{item.productImage || item.skuImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
            <view class="item-info">
              <view class="item-name"><text user-select="{{true}}">{{item.productName}}</text></view>
              <view class="item-sku"><text user-select="{{true}}">{{item.skuSpec}} {{item.skuSize}}</text> <text class="refund-tag">{{item.afterSaleStatusText || '售后'}}</text></view>
              <view class="item-qty">售后 {{item.afterSaleQty || 0}} 件，暂无可发数量</view>
            </view>
          </block>
          <!-- 正常商品：可选、可编辑数量 -->
          <block wx:else>
            <view class="selection-column item-selection-column" catchtap="toggleItemSelect" data-group-index="{{index}}" data-item-index="{{itemIndex}}">
              <view class="item-checkbox {{item.selected ? 'checked' : ''}}">
                <text wx:if="{{item.selected}}">✓</text>
              </view>
            </view>
            <image class="item-image" src="{{item.productImage || item.skuImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
            <view class="item-info">
              <view class="item-name"><text user-select="{{true}}">{{item.productName}}</text></view>
              <view class="item-sku"><text user-select="{{true}}">{{item.skuSpec}} {{item.skuSize}}</text></view>
              <view class="item-qty">
                总数：{{item.totalQty}}  已发：{{item.shippedQty}}  未发：{{item.unshippedQty}}
              </view>
              <view class="item-after-sale admin-remark-line" catchtap="editAdminRemark" data-item="{{item}}">管理员备注：{{item.adminRemark || '点击添加'}}</view>
              <view class="item-after-sale" wx:if="{{item.afterSaleQty > 0}}">
                <text>{{item.afterSaleStatusText || '售后'}} {{item.afterSaleQty}} 件</text>
                <text>可发 {{item.unshippedQty}}</text>
              </view>
            </view>
            <view class="item-ship-qty" catchtap="stopPendingShipEvent">
              <view class="stepper">
                <view class="stepper-btn {{item.shipQty <= 0 ? 'disabled' : ''}}" bindtap="onDecrease" data-group-index="{{index}}" data-item-index="{{itemIndex}}">−</view>
                <input class="stepper-input" type="number" value="{{item.shipQty}}" bindinput="onShipQtyInput" data-group-index="{{index}}" data-item-index="{{itemIndex}}" />
                <view class="stepper-btn" bindtap="onIncrease" data-group-index="{{index}}" data-item-index="{{itemIndex}}">+</view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orderGroups.length === 0 && !loading}}">
      <text wx:if="{{searchKeyword}}">未找到相关商品</text>
      <text wx:else>暂无未发货订单</text>
    </view>
    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="page-loading" wx:if="{{loadingMore || selectingAll}}">{{selectingAll ? '正在加载剩余订单...' : '正在加载更多...'}}</view>
    <view class="page-loading" wx:elif="{{hasMore && !loading}}" bindtap="loadMorePendingItems">继续加载更多订单</view>
    <view class="page-loading" wx:elif="{{!hasMore && orderGroups.length > 0}}">已加载全部订单</view>
    </view>
  </view>

  <button class="back-to-top" bindtap="backToTop">回到顶部</button>

  <view class="modal" wx:if="{{showDateModal}}">
    <view class="modal-mask" bindtap="closeDateModal"></view>
    <view class="modal-content">
      <view class="modal-title">选择下单时间范围</view>
      <view class="quick-options">
        <view class="quick-option {{editingDateRange.quickSelect === '1day' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="1day">最近 1 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === '7days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="7days">最近 7 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === '30days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="30days">最近 30 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === 'month' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="month">本月</view>
      </view>
      <view class="custom-section">
        <view class="custom-title">自定义时间</view>
        <picker mode="date" value="{{editingDateRange.startDate}}" end="{{editingDateRange.endDate || today}}" bindchange="onStartDateChange">
          <view class="date-picker-input">开始日期：{{editingDateRange.startDate || '选择'}}</view>
        </picker>
        <picker mode="date" value="{{editingDateRange.endDate}}" start="{{editingDateRange.startDate}}" end="{{today}}" bindchange="onEndDateChange">
          <view class="date-picker-input">结束日期：{{editingDateRange.endDate || '选择'}}</view>
        </picker>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeDateModal">取消</button>
        <button class="modal-confirm" bindtap="confirmDateRange">确定</button>
      </view>
    </view>
  </view>

  <!-- SKU 选择器弹窗 -->
  <view class="modal" wx:if="{{showSkuModal}}">
    <view class="modal-mask" bindtap="closeSkuModal"></view>
    <view class="modal-content">
      <view class="modal-title">{{selectedProduct.name}} - 选择 SKU</view>
      <scroll-view class="sku-list" scroll-y>
        <view class="sku-item {{item.selected ? 'selected' : ''}}" wx:for="{{selectedProduct.skus}}" wx:key="id" wx:for-item="item" bindtap="toggleSkuSelect" data-sku-id="{{item.id}}">
          <view class="sku-checkbox {{item.selected ? 'checked' : ''}}">
            <text wx:if="{{item.selected}}">✓</text>
          </view>
          <view class="sku-info">
            <text class="sku-name">{{item.spec}} {{item.size}}</text>
            <text class="sku-stock" wx:if="{{item.stock !== undefined}}">库存：{{item.stock}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeSkuModal">取消</button>
        <button class="modal-confirm" bindtap="confirmSkuSelection">确定</button>
      </view>
    </view>
  </view>

  <!-- 发货预览弹窗 -->
  <view class="modal" wx:if="{{showPreviewModal}}">
    <view class="modal-mask" bindtap="closePreviewModal"></view>
    <view class="modal-content modal-large">
      <view class="modal-title">发货预览</view>
      <scroll-view class="preview-list" scroll-y>
        <view class="preview-group" wx:for="{{previewGroups}}" wx:key="index" wx:for-index="index" wx:for-item="group">
          <view class="preview-title">包裹 {{index + 1}} (共 {{group.totalItems}} 件)</view>
          <view class="preview-recipient">
            <view class="preview-recipient-head">
              <text user-select="{{true}}">{{group.recipientName}} {{group.recipientPhone}}</text>
              <text class="copy-link" catchtap="copyRecipientInfo" data-name="{{group.recipientName}}" data-phone="{{group.recipientPhone}}" data-address="{{group.recipientAddress}}">复制</text>
            </view>
            <text user-select="{{true}}">{{group.recipientAddress}}</text>
          </view>
          <view class="preview-items">
            <view class="preview-item" wx:for="{{group.items}}" wx:key="uniqueKey" wx:for-item="item">
              <text user-select="{{true}}">{{item.productName}}</text> <text user-select="{{true}}">{{item.skuSpec}} {{item.skuSize}}</text> <text>× {{item.shipQty}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="preview-summary">
        <text>预计生成 {{previewGroups.length}} 个电子面单</text>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closePreviewModal">取消</button>
        <button class="modal-confirm" bindtap="confirmBatchShip" disabled="{{!canShip || batchSubmitting}}" loading="{{batchSubmitting}}">{{batchSubmitting ? '正在提交' : '确认后台发货'}}</button>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showRecentBatchTasks}}">
    <view class="modal-mask" bindtap="closeRecentBatchTasks"></view>
    <view class="modal-content modal-large task-modal">
      <view class="task-modal-header"><text class="task-modal-title">发货任务</text><text class="copy-link" bindtap="refreshBatchTaskHistory">刷新</text></view>
      <view class="task-filter-tabs">
        <text class="task-filter {{historyFilter === 'all' ? 'active' : ''}}" bindtap="changeBatchHistoryFilter" data-filter="all">全部</text>
        <text class="task-filter {{historyFilter === 'running' ? 'active' : ''}}" bindtap="changeBatchHistoryFilter" data-filter="running">处理中</text>
        <text class="task-filter {{historyFilter === 'issues' ? 'active' : ''}}" bindtap="changeBatchHistoryFilter" data-filter="issues">有异常</text>
      </view>
      <scroll-view class="task-scroll" scroll-y bindscrolltolower="loadMoreBatchTaskHistory" lower-threshold="100">
        <view class="task-history-card" wx:for="{{recentBatchTasks}}" wx:key="id" wx:for-item="task" wx:for-index="index" bindtap="selectRecentBatchTask" data-index="{{index}}">
          <view class="task-card-top"><text class="task-card-time">{{task.createdAtText}}</text><text class="task-status {{task.isRunning ? 'running' : ''}}">{{task.statusText}}</text></view>
          <view class="task-card-count">{{task.summary.total}} 个包裹 · {{task.summary.orders}} 笔订单 · {{task.summary.quantity}} 件商品</view>
          <view class="task-progress-track"><view class="task-progress-fill" style="width: {{task.progressPercent}}%"></view></view>
          <view class="task-card-results"><text>已处理 {{task.summary.completed}}/{{task.summary.total}}</text><text>已发货 {{task.summary.success}}</text><text class="task-issue" wx:if="{{task.summary.failed > 0}}">异常 {{task.summary.failed}}</text></view>
          <view class="batch-progress-meta" wx:if="{{task.summary.wechatPending > 0}}">其中 {{task.summary.wechatPending}} 个已发货包裹待同步微信</view>
          <view class="batch-progress-meta" wx:if="{{task.startedAtText}}">开始 {{task.startedAtText}}</view>
          <view class="batch-progress-meta" wx:if="{{task.finishedAtText}}">结束 {{task.finishedAtText}}</view>
          <view class="task-card-bottom"><text class="task-id">任务 {{task.id}}</text><text class="copy-link">查看详情 ›</text></view>
        </view>
        <view class="task-empty" wx:if="{{!historyLoading && !historyError && recentBatchTasks.length === 0}}">{{historyFilter === 'all' ? '暂无发货任务' : '暂无符合条件的任务'}}</view>
        <view class="task-load-more" wx:if="{{historyError}}" bindtap="loadMoreBatchTaskHistory">{{historyError}} · 点击重试</view>
        <view class="task-load-more" wx:elif="{{historyLoading}}">正在加载...</view>
        <view class="task-load-more" wx:elif="{{historyHasMore}}" bindtap="loadMoreBatchTaskHistory">加载更多</view>
        <view class="task-load-more" wx:elif="{{recentBatchTasks.length}}">已加载全部任务</view>
      </scroll-view>
      <view class="task-loading-hint" wx:if="{{batchDetailLoading}}">正在打开任务详情...</view>
      <view class="modal-footer"><button class="modal-cancel" bindtap="closeRecentBatchTasks">关闭</button></view>
    </view>
  </view>

  <view class="modal" wx:if="{{showBatchProgress && batchProgress}}">
    <view class="modal-mask" bindtap="closeBatchProgress"></view>
    <view class="modal-content modal-large task-modal">
      <view class="task-modal-header"><text user-select="{{true}}" class="task-modal-title">{{viewingBatchHistory ? '任务详情' : '发货进度'}}</text><text user-select="{{true}}" class="task-status {{batchTask.isRunning ? 'running' : ''}}">{{batchTask.statusText}}</text></view>
      <view class="task-detail-overview">
        <view class="task-id"><text user-select="{{true}}">任务 {{batchTask.id}}</text></view>
        <view class="batch-progress-meta"><text user-select="{{true}}">创建 {{batchTask.createdAtText}}</text></view>
        <view class="batch-progress-meta" wx:if="{{batchTask.confirmedAtText}}"><text user-select="{{true}}">提交 {{batchTask.confirmedAtText}}</text></view>
        <view class="batch-progress-meta" wx:if="{{batchTask.startedAtText}}"><text user-select="{{true}}">开始 {{batchTask.startedAtText}}</text></view>
        <view class="batch-progress-meta" wx:if="{{batchTask.finishedAtText}}"><text user-select="{{true}}">结束 {{batchTask.finishedAtText}}</text></view>
        <view class="task-card-count"><text user-select="{{true}}">{{batchProgress.total}} 个包裹 · {{batchProgress.orders}} 笔订单 · {{batchProgress.quantity}} 件商品</text></view>
        <view class="task-progress-track"><view class="task-progress-fill" style="width: {{batchTask.progressPercent}}%"></view></view>
        <view class="task-card-results"><text user-select="{{true}}">已处理 {{batchProgress.completed}}/{{batchProgress.total}}</text><text user-select="{{true}}">已发货 {{batchProgress.success}}</text><text user-select="{{true}}" class="task-issue" wx:if="{{batchProgress.failed}}">异常 {{batchProgress.failed}}</text></view>
        <view class="batch-progress-meta" wx:if="{{batchProgress.wechatPending > 0}}"><text user-select="{{true}}">{{batchProgress.wechatPending}} 个包裹已发货，微信同步未完成</text></view>
        <view class="task-background-tip" wx:if="{{batchTask.isRunning && batchTask.executionMode === 'BACKGROUND'}}"><text user-select="{{true}}">后台持续处理中，离开页面不影响发货</text></view>
        <view class="task-background-tip" wx:elif="{{batchTask.status === 'DRAFT'}}"><text user-select="{{true}}">此任务尚未提交，不会自动发货</text></view>
        <view class="task-background-tip" wx:elif="{{batchTask.status === 'LEGACY_PAUSED'}}"><text user-select="{{true}}">旧任务尚有未执行包裹，核对后可交后台继续</text></view>
        <view class="task-query-error" wx:if="{{batchQueryError}}"><text user-select="{{true}}">{{batchQueryError}}</text><text class="copy-link" catchtap="runBatchTask">刷新</text></view>
      </view>
      <scroll-view class="task-scroll" scroll-y>
        <view class="task-package-card" wx:for="{{batchProgress.groups}}" wx:key="id" wx:for-item="group">
          <view class="task-package-toggle">
            <view class="task-card-top"><text user-select="{{true}}" class="batch-progress-head">包裹 {{group.sequenceNo + 1}} · {{group.totalQty}} 件</text><text class="copy-link" catchtap="toggleBatchPackage" data-group-id="{{group.id}}">{{group.expanded ? '收起 ∧' : '展开详情 ∨'}}</text></view>
            <view class="batch-progress-status"><text user-select="{{true}}">{{group.statusText}}{{group.stageText ? ' · ' + group.stageText : ''}}</text></view>
            <view class="batch-progress-meta"><text user-select="{{true}}">{{group.orders.length}} 笔订单</text></view>
          </view>
          <view class="task-package-recipient">
            <view><text user-select="{{true}}">{{group.recipientName}} {{group.recipientPhone}}</text></view>
            <view class="task-package-address"><text user-select="{{true}}">{{group.recipientAddress}}</text></view>
          </view>
          <view class="task-waybill" wx:if="{{group.expressNo}}">
            <text user-select="{{true}}">{{group.expressName}} {{group.expressNo}}</text><text class="copy-link" catchtap="copyBatchExpressNo" data-express-no="{{group.expressNo}}">复制</text>
          </view>
          <view wx:if="{{group.expanded}}">
            <view class="batch-progress-meta" wx:if="{{group.shipmentId}}"><text user-select="{{true}}">发货单 {{group.shipmentId}}</text></view>
            <view class="batch-progress-meta" wx:if="{{group.startedAtText}}"><text user-select="{{true}}">开始 {{group.startedAtText}}</text></view>
            <view class="batch-progress-meta" wx:if="{{group.finishedAtText}}"><text user-select="{{true}}">结束 {{group.finishedAtText}}</text></view>
          </view>
          <view class="task-issue" wx:if="{{group.shipmentDeleted}}"><text user-select="{{true}}">该发货单已解绑，此处保留历史运单记录</text></view>
          <view class="batch-progress-reason" wx:if="{{group.reason}}"><text user-select="{{true}}">{{group.reason}}</text></view>
          <view class="task-logistics-trace" wx:if="{{group.shipmentId && group.expressNo && !group.shipmentDeleted}}">
            <view class="task-trace-header"><text user-select="{{true}}" class="task-trace-title">物流轨迹</text><text class="copy-link" wx:if="{{batchTraceMap[group.shipmentId].nodes.length > 1}}" catchtap="toggleBatchShipmentTrace" data-shipment-id="{{group.shipmentId}}">{{batchTraceMap[group.shipmentId].expanded ? '收缩' : '展开'}}</text></view>
            <view class="task-trace-empty" wx:if="{{!batchTraceMap[group.shipmentId] || batchTraceMap[group.shipmentId].loading}}"><text user-select="{{true}}">正在加载物流...</text></view>
            <view class="task-trace-empty" wx:elif="{{batchTraceMap[group.shipmentId].error}}"><text user-select="{{true}}">{{batchTraceMap[group.shipmentId].error}}</text><text class="copy-link" catchtap="retryBatchShipmentTrace" data-shipment-id="{{group.shipmentId}}">重试</text></view>
            <view class="task-trace-list" wx:elif="{{batchTraceMap[group.shipmentId].nodes.length}}">
              <view class="task-trace-node" wx:for="{{batchTraceMap[group.shipmentId].visibleNodes}}" wx:for-item="node" wx:key="index"><text user-select="{{true}}" class="task-trace-content">{{node.description}}</text><text user-select="{{true}}" class="task-trace-time">{{node.timeDisplay}}</text></view>
            </view>
            <view class="task-trace-empty" wx:else><text user-select="{{true}}">暂无物流轨迹</text></view>
          </view>
          <view wx:if="{{group.expanded}}">
            <view class="task-order-card" wx:for="{{group.orders}}" wx:key="orderId" wx:for-item="order">
              <view class="task-order-head">
                <view class="task-order-number"><text user-select="{{true}}" class="summary-chip" wx:if="{{order.adminSeqNo}}">序号 {{order.adminSeqNo}}</text><text user-select="{{true}}">订单 {{order.orderNo}}</text><text class="copy-link" catchtap="copyOrderNo" data-order-no="{{order.orderNo}}">复制</text></view>
              </view>
              <view class="batch-progress-meta" wx:if="{{order.createdAtText}}"><text user-select="{{true}}">下单 {{order.createdAtText}}</text></view>
              <view class="task-product" wx:for="{{order.items}}" wx:key="orderItemId" wx:for-item="item" bindtap="goToOrderDetail" bindtouchstart="onOrderTouchStart" bindtouchmove="onOrderTouchMove" bindtouchend="onOrderTouchEnd" bindtouchcancel="onOrderTouchCancel" data-order-id="{{order.orderId}}">
                <image class="task-product-image" src="{{item.productImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
                <view class="task-product-content"><view class="task-product-name"><text user-select="{{true}}">{{item.productName}}</text></view><view class="batch-progress-meta"><text user-select="{{true}}">{{item.skuSpec}} {{item.skuSize}}</text></view><view class="task-product-qty"><text user-select="{{true}}">本批数量 × {{item.shipQty}}</text></view></view>
              </view>
              <view class="task-product task-product-missing" wx:if="{{order.items.length === 0}}" bindtap="goToOrderDetail" bindtouchstart="onOrderTouchStart" bindtouchmove="onOrderTouchMove" bindtouchend="onOrderTouchEnd" bindtouchcancel="onOrderTouchCancel" data-order-id="{{order.orderId}}"><text user-select="{{true}}">历史商品快照未记录，点击此处进入订单</text></view>
            </view>
          </view>
          <button class="batch-review-btn" wx:if="{{group.canReview}}" bindtap="reviewBatchGroup" data-group-id="{{group.id}}">人工核查后解除占用</button>
          <button class="batch-review-btn" wx:if="{{group.canReviewWechat}}" bindtap="reviewBatchWechat" data-group-id="{{group.id}}">核查微信上报结果</button>
        </view>
      </scroll-view>
      <view class="task-pagination" wx:if="{{batchGroupPages > 1}}"><button size="mini" disabled="{{batchGroupPage <= 1}}" bindtap="changeBatchGroupPage" data-step="-1">上一页</button><text user-select="{{true}}">包裹 {{batchGroupPage}}/{{batchGroupPages}} 页</text><button size="mini" disabled="{{batchGroupPage >= batchGroupPages}}" bindtap="changeBatchGroupPage" data-step="1">下一页</button></view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeBatchProgress">{{viewingBatchHistory ? '返回列表' : '收起进度'}}</button>
        <button class="modal-confirm" wx:if="{{batchTask.canOperate !== false && (batchTask.status === 'DRAFT' || batchTask.status === 'LEGACY_PAUSED')}}" bindtap="continueLegacyBatchTask" disabled="{{batchSubmitting}}">确认继续发货</button>
        <button class="modal-confirm" wx:elif="{{batchProgress.canRetry}}" bindtap="retryBatchFailedGroups" disabled="{{batchSubmitting}}" loading="{{batchSubmitting}}">重试失败包裹</button>
        <button class="modal-confirm" wx:elif="{{batchProgress.completed === batchProgress.total && !viewingBatchHistory}}" bindtap="finishBatchTask">完成并收起</button>
      </view>
    </view>
  </view>
</view>
