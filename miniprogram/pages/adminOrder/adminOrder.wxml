<!-- 备份原文件 -->
<!-- 原 adminOrder.wxml 已备份为 adminOrder.wxml.bak -->

<!-- 新的基于产品维度的发货页面 -->
<view class="container">
  <!-- 筛选与发货操作区随页面滚动 -->
  <view class="admin-order-header">
    <view class="search-section">
      <view class="search-box">
        <view class="search-input-wrapper">
          <input class="search-input" placeholder="搜索商品名称" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearchConfirm" focus="{{searchFocus}}" />
          <button class="search-btn" bindtap="onSearchConfirm">搜索</button>
        </view>
        <scroll-view class="search-dropdown" wx:if="{{searchKeyword && (searchDropdown.length > 0 || searchLoading)}}" style="height: {{searchDropdown.length >= 4 ? 600 : searchDropdown.length * 150 + (searchLoading ? 60 : 0)}}rpx" scroll-y="true" bindscrolltolower="loadMoreSearchProducts" lower-threshold="80">
          <view class="dropdown-item {{product.isSelected ? 'selected' : ''}}" wx:for="{{searchDropdown}}" wx:key="id" wx:for-item="product" bindtap="onDropdownItemClick" data-product="{{product}}">
            <view class="selected-badge" wx:if="{{product.isSelected}}">已添加</view>
            <image class="dropdown-image" src="{{product.coverUrl || '/images/default-goods-image.png'}}" mode="aspectFill" />
            <view class="dropdown-info">
              <text class="dropdown-name">{{product.name}}</text>
              <text class="dropdown-sku-count">{{product.skuCount}}个 SKU</text>
            </view>
          </view>
          <view class="dropdown-loading" wx:if="{{searchLoading}}">加载中...</view>
        </scroll-view>
      </view>

      <!-- 档口和标签筛选：两个条件可同时选择，和商品/SKU按 AND 关系查询 -->
      <view class="filter-section">
        <view class="filter-row">
          <text class="filter-label">档口</text>
          <view class="filter-fixed-option filter-tag {{selectedStall === '' ? 'active' : ''}}" bindtap="selectStall" data-stall="all">全部</view>
          <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
            <view class="filter-options">
              <view class="filter-tag {{selectedStall === item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}">{{item.name}}</view>
            </view>
          </scroll-view>
        </view>
        <view class="filter-row">
          <text class="filter-label">标签</text>
          <view class="filter-fixed-option filter-tag {{selectedTag === '' ? 'active' : ''}}" bindtap="selectTag" data-tag="all">全部</view>
          <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
            <view class="filter-options">
              <view class="filter-tag {{selectedTag === item.id ? 'active' : ''}}" wx:for="{{tagList}}" wx:key="id" bindtap="selectTag" data-tag="{{item.id}}">{{item.name}}</view>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="date-filter">
        <view class="date-picker" bindtap="showDateRangeSelector">
          <text wx:if="{{!dateRange.startDate && !dateRange.endDate}}">选择下单时间范围</text>
          <text wx:else>{{dateRange.startDate || '开始'}} - {{dateRange.endDate || '结束'}}</text>
        </view>
        <view class="clear-date" wx:if="{{dateRange.startDate || dateRange.endDate}}" bindtap="clearDateRange">×</view>
      </view>

      <!-- 已选商品 -->
      <view class="selected-products" wx:if="{{selectedProducts.length > 0}}">
        <view class="selected-title">已选商品</view>
        <view class="selected-list">
          <view class="selected-tag" wx:for="{{selectedProducts}}" wx:key="id" bindtap="openSkuSelector" data-product="{{item}}">
            {{item.name}}
            <text class="tag-count" wx:if="{{item.skuCount > 0}}">({{item.skuCount}}个 SKU)</text>
            <text class="remove-btn" catchtap="removeProduct" data-id="{{item.id}}">×</text>
          </view>
        </view>
        <button class="clear-all" wx:if="{{selectedProducts.length > 0}}" bindtap="clearSelected">清空</button>
      </view>
    </view>

    <!-- 工具栏：物流 + 全选 + 批量发货 -->
    <view class="toolbar">
      <picker class="logistics-picker" range="{{logisticsAccounts}}" range-key="deliveryName" value="{{logisticsIndex}}" bindchange="onLogisticsChange">
        <view class="picker-value">{{logisticsAccounts[logisticsIndex] ? logisticsAccounts[logisticsIndex].deliveryName : '选择物流'}} ▾</view>
      </picker>
      <text class="quota-info" wx:if="{{logisticsAccounts[logisticsIndex]}}">余 {{logisticsAccounts[logisticsIndex].quotaNum}}</text>
      <view class="toolbar-spacer"></view>
      <view class="checkbox-all {{allSelected ? 'checked' : ''}}" bindtap="toggleSelectAll">
        <text wx:if="{{allSelected}}">✓</text>
      </view>
      <text class="select-all-text" bindtap="toggleSelectAll">{{selectingAll ? '正在加载全部...' : '全选'}}</text>
      <button class="batch-ship-btn" bindtap="openPendingShipList" disabled="{{pendingShipItems.length === 0 || !logisticsAccounts[logisticsIndex]}}">
        批量发货（{{pendingOrderCount}} 单）
      </button>
      <text class="batch-progress-entry" wx:if="{{batchProgress}}" bindtap="openBatchProgress">查看发货进度 {{batchProgress.completed}}/{{batchProgress.total}}</text>
      <text class="batch-progress-entry" bindtap="openRecentBatchTasks">历史发货任务</text>
    </view>
  </view>

  <!-- 待发货列表弹窗 -->
  <view class="pending-modal" wx:if="{{showPendingShipList}}">
    <view class="pending-modal-mask" bindtap="closePendingShipList" catchtouchmove="stopPendingShipEvent"></view>
    <view class="pending-modal-content">
      <view class="pending-modal-header">
        <view class="pending-modal-title">
          <text>待发货列表</text>
          <text class="pending-modal-count">{{pendingOrderCount}} 个订单，{{pendingItemCount}} 项商品</text>
        </view>
        <text class="pending-modal-close" bindtap="closePendingShipList">关闭</text>
      </view>

      <scroll-view class="pending-modal-list" scroll-y="true" enable-flex="true">
        <view class="pending-order-group" wx:for="{{pendingOrderGroups}}" wx:key="orderId" wx:for-item="group">
          <view class="order-header pending-order-header">
            <view class="order-summary">
              <text class="summary-chip" wx:if="{{group.adminSeqNo}}">序号 {{group.adminSeqNo}}</text>
              <view class="summary-row">
                <view class="summary-main">
                  <text class="summary-label">订单号</text>
                  <text class="order-no">{{group.orderNo}}</text>
                </view>
                <text class="copy-link summary-action" catchtap="copyOrderNo" data-order-no="{{group.orderNo}}">复制</text>
                <text class="copy-link summary-action" catchtap="goToOrderDetail" data-order-id="{{group.orderId}}">查看详情</text>
              </view>
              <text class="order-date">{{group.createdAt}}</text>
              <view class="summary-row recipient-row">
                <view class="summary-main recipient-main">
                  <text class="summary-label">收件人</text>
                  <text class="recipient-name">{{group.recipientName}}</text>
                  <text class="recipient-phone">{{group.recipientPhone}}</text>
                </view>
                <text class="copy-link summary-action" catchtap="copyRecipientInfo" data-name="{{group.recipientName}}" data-phone="{{group.recipientPhone}}" data-address="{{group.recipientAddress}}">复制</text>
              </view>
              <text class="recipient-address">{{group.recipientAddress}}</text>
            </view>
          </view>

          <view class="order-items pending-order-items">
            <view class="order-item pending-order-item" wx:for="{{group.items}}" wx:key="uniqueKey" wx:for-item="item">
              <image class="item-image" src="{{item.productImage || item.skuImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
              <view class="item-info">
                <view class="item-name">{{item.productName}}</view>
                <view class="item-sku">{{item.skuSpec}} {{item.skuSize}}</view>
                <view class="item-qty">总数：{{item.totalQty}}  已发：{{item.shippedQty}}  未发：{{item.unshippedQty}}</view>
                <view class="item-after-sale admin-remark-line" bindtap="editAdminRemark" data-item="{{item}}">管理员备注：{{item.adminRemark || '点击添加'}}</view>
                <view class="item-after-sale" wx:if="{{item.afterSaleQty > 0}}">
                  <text>{{item.afterSaleStatusText || '售后'}} {{item.afterSaleQty}} 件</text>
                  <text>可发 {{item.unshippedQty}}</text>
                </view>
              </view>
              <view class="pending-item-actions">
                <view class="stepper">
                  <view class="stepper-btn {{item.shipQty <= 0 ? 'disabled' : ''}}" bindtap="onPendingShipDecrease" data-pending-index="{{item.pendingIndex}}">−</view>
                  <input class="stepper-input" type="number" value="{{item.shipQty}}" bindinput="onPendingShipQtyInput" data-pending-index="{{item.pendingIndex}}" />
                  <view class="stepper-btn" bindtap="onPendingShipIncrease" data-pending-index="{{item.pendingIndex}}">+</view>
                </view>
                <text class="pending-remove" bindtap="removePendingShipItem" data-pending-index="{{item.pendingIndex}}">删除</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="pending-modal-footer">
        <view class="pending-logistics-row">
          <picker class="pending-logistics-picker" range="{{logisticsAccounts}}" range-key="deliveryName" value="{{logisticsIndex}}" bindchange="onLogisticsChange">
            <view class="pending-picker-value">{{logisticsAccounts[logisticsIndex] ? logisticsAccounts[logisticsIndex].deliveryName : '选择快递'}}</view>
          </picker>
          <text class="pending-quota" wx:if="{{logisticsAccounts[logisticsIndex]}}">剩余面单 {{logisticsAccounts[logisticsIndex].quotaNum}}</text>
        </view>
        <view class="pending-footer-actions">
          <text class="pending-clear" bindtap="clearPendingShipItems">清空列表</text>
          <button class="batch-ship-btn pending-batch-ship-btn" bindtap="batchShip" disabled="{{pendingShipItems.length === 0 || !logisticsAccounts[logisticsIndex]}}">
            批量发货（{{pendingOrderCount}} 单）
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单列表随页面一起滚动 -->
  <view class="order-list-container">
    <view class="after-sale-alert" wx:if="{{blockedAfterSaleCount > 0}}">
      有 {{blockedAfterSaleCount}} 个待发货订单因售后暂无可发商品，已从可发列表中隐藏
    </view>

    <!-- 订单列表 -->
    <view class="order-list">
    <view class="order-group" wx:for="{{orderGroups}}" wx:key="orderId" wx:for-item="group" wx:for-index="index">
      <view class="order-header">
        <view class="order-checkbox {{group.selected ? 'checked' : ''}}" bindtap="toggleGroupSelect" data-index="{{index}}">
          <text wx:if="{{group.selected}}">✓</text>
        </view>
        <view class="order-summary">
          <text class="summary-chip" wx:if="{{group.adminSeqNo}}">序号 {{group.adminSeqNo}}</text>
          <view class="summary-row">
            <view class="summary-main">
              <text class="summary-label">订单号</text>
              <text class="order-no">{{group.orderNo}}</text>
            </view>
            <text class="copy-link summary-action" catchtap="copyOrderNo" data-order-no="{{group.orderNo}}">复制</text>
            <text class="copy-link summary-action" catchtap="goToOrderDetail" data-order-id="{{group.orderId}}">查看详情</text>
          </view>
          <text class="order-date">{{group.createdAt}}</text>
          <view class="summary-row recipient-row">
            <view class="summary-main recipient-main">
              <text class="summary-label">收件人</text>
              <text class="recipient-name">{{group.recipientName}}</text>
              <text class="recipient-phone">{{group.recipientPhone}}</text>
            </view>
            <text class="copy-link summary-action" catchtap="copyRecipientInfo" data-name="{{group.recipientName}}" data-phone="{{group.recipientPhone}}" data-address="{{group.recipientAddress}}">复制</text>
          </view>
          <text class="recipient-address">{{group.recipientAddress}}</text>
        </view>
      </view>

      <view class="order-items">
        <view class="order-item" wx:for="{{group.items}}" wx:key="uniqueKey" wx:for-item="item" wx:for-index="itemIndex">
          <!-- 售后占用后无可发数量：不可选、灰色 -->
          <block wx:if="{{!item.canShip}}">
            <view class="item-checkbox disabled"></view>
            <image class="item-image refunded" src="{{item.productImage || item.skuImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
            <view class="item-info">
              <view class="item-name">{{item.productName}}</view>
              <view class="item-sku">{{item.skuSpec}} {{item.skuSize}} <text class="refund-tag">{{item.afterSaleStatusText || '售后'}}</text></view>
              <view class="item-qty">售后 {{item.afterSaleQty || 0}} 件，暂无可发数量</view>
            </view>
          </block>
          <!-- 正常商品：可选、可编辑数量 -->
          <block wx:else>
            <view class="item-checkbox {{item.selected ? 'checked' : ''}}" bindtap="toggleItemSelect" data-group-index="{{index}}" data-item-index="{{itemIndex}}">
              <text wx:if="{{item.selected}}">✓</text>
            </view>
            <image class="item-image" src="{{item.productImage || item.skuImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
            <view class="item-info">
              <view class="item-name">{{item.productName}}</view>
              <view class="item-sku">{{item.skuSpec}} {{item.skuSize}}</view>
              <view class="item-qty">
                总数：{{item.totalQty}}  已发：{{item.shippedQty}}  未发：{{item.unshippedQty}}
              </view>
              <view class="item-after-sale admin-remark-line" bindtap="editAdminRemark" data-item="{{item}}">管理员备注：{{item.adminRemark || '点击添加'}}</view>
              <view class="item-after-sale" wx:if="{{item.afterSaleQty > 0}}">
                <text>{{item.afterSaleStatusText || '售后'}} {{item.afterSaleQty}} 件</text>
                <text>可发 {{item.unshippedQty}}</text>
              </view>
            </view>
            <view class="item-ship-qty">
              <view class="stepper">
                <view class="stepper-btn {{item.shipQty <= 0 ? 'disabled' : ''}}" bindtap="onDecrease" data-group-index="{{index}}" data-item-index="{{itemIndex}}">−</view>
                <input class="stepper-input" type="number" value="{{item.shipQty}}" bindinput="onShipQtyInput" data-group-index="{{index}}" data-item-index="{{itemIndex}}" />
                <view class="stepper-btn" bindtap="onIncrease" data-group-index="{{index}}" data-item-index="{{itemIndex}}">+</view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orderGroups.length === 0 && !loading}}">
      <text wx:if="{{searchKeyword}}">未找到相关商品</text>
      <text wx:else>暂无未发货订单</text>
    </view>
    
    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="page-loading" wx:if="{{loadingMore || selectingAll}}">{{selectingAll ? '正在加载剩余订单...' : '正在加载更多...'}}</view>
    <view class="page-loading" wx:elif="{{hasMore && !loading}}" bindtap="loadMorePendingItems">继续加载更多订单</view>
    <view class="page-loading" wx:elif="{{!hasMore && orderGroups.length > 0}}">已加载全部订单</view>
    </view>
  </view>

  <button class="back-to-top" bindtap="backToTop">回到顶部</button>

  <view class="modal" wx:if="{{showDateModal}}">
    <view class="modal-mask" bindtap="closeDateModal"></view>
    <view class="modal-content">
      <view class="modal-title">选择下单时间范围</view>
      <view class="quick-options">
        <view class="quick-option {{editingDateRange.quickSelect === '1day' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="1day">最近 1 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === '7days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="7days">最近 7 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === '30days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="30days">最近 30 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === 'month' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="month">本月</view>
      </view>
      <view class="custom-section">
        <view class="custom-title">自定义时间</view>
        <picker mode="date" value="{{editingDateRange.startDate}}" end="{{editingDateRange.endDate || today}}" bindchange="onStartDateChange">
          <view class="date-picker-input">开始日期：{{editingDateRange.startDate || '选择'}}</view>
        </picker>
        <picker mode="date" value="{{editingDateRange.endDate}}" start="{{editingDateRange.startDate}}" end="{{today}}" bindchange="onEndDateChange">
          <view class="date-picker-input">结束日期：{{editingDateRange.endDate || '选择'}}</view>
        </picker>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeDateModal">取消</button>
        <button class="modal-confirm" bindtap="confirmDateRange">确定</button>
      </view>
    </view>
  </view>

  <!-- SKU 选择器弹窗 -->
  <view class="modal" wx:if="{{showSkuModal}}">
    <view class="modal-mask" bindtap="closeSkuModal"></view>
    <view class="modal-content">
      <view class="modal-title">{{selectedProduct.name}} - 选择 SKU</view>
      <scroll-view class="sku-list" scroll-y>
        <view class="sku-item {{item.selected ? 'selected' : ''}}" wx:for="{{selectedProduct.skus}}" wx:key="id" wx:for-item="item" bindtap="toggleSkuSelect" data-sku-id="{{item.id}}">
          <view class="sku-checkbox {{item.selected ? 'checked' : ''}}">
            <text wx:if="{{item.selected}}">✓</text>
          </view>
          <view class="sku-info">
            <text class="sku-name">{{item.spec}} {{item.size}}</text>
            <text class="sku-stock" wx:if="{{item.stock !== undefined}}">库存：{{item.stock}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeSkuModal">取消</button>
        <button class="modal-confirm" bindtap="confirmSkuSelection">确定</button>
      </view>
    </view>
  </view>

  <!-- 发货预览弹窗 -->
  <view class="modal" wx:if="{{showPreviewModal}}">
    <view class="modal-mask" bindtap="closePreviewModal"></view>
    <view class="modal-content modal-large">
      <view class="modal-title">发货预览</view>
      <scroll-view class="preview-list" scroll-y>
        <view class="preview-group" wx:for="{{previewGroups}}" wx:key="index" wx:for-index="index" wx:for-item="group">
          <view class="preview-title">包裹 {{index + 1}} (共 {{group.totalItems}} 件)</view>
          <view class="preview-recipient">
            <view class="preview-recipient-head">
              <text>{{group.recipientName}} {{group.recipientPhone}}</text>
              <text class="copy-link" catchtap="copyRecipientInfo" data-name="{{group.recipientName}}" data-phone="{{group.recipientPhone}}" data-address="{{group.recipientAddress}}">复制</text>
            </view>
            <text>{{group.recipientAddress}}</text>
          </view>
          <view class="preview-items">
            <view class="preview-item" wx:for="{{group.items}}" wx:key="uniqueKey" wx:for-item="item">
              <text>{{item.productName}} {{item.skuSpec}} {{item.skuSize}} × {{item.shipQty}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="preview-summary">
        <text>预计生成 {{previewGroups.length}} 个电子面单</text>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closePreviewModal">取消</button>
        <button class="modal-confirm" bindtap="confirmBatchShip" disabled="{{!canShip}}">确认发货</button>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showRecentBatchTasks}}">
    <view class="modal-mask" bindtap="closeRecentBatchTasks"></view>
    <view class="modal-content modal-large">
      <view class="modal-title">历史发货任务</view>
      <scroll-view class="preview-list" scroll-y>
        <view class="batch-progress-group" wx:for="{{recentBatchTasks}}" wx:key="id" wx:for-item="task" wx:for-index="index" bindtap="selectRecentBatchTask" data-index="{{index}}">
          <view class="batch-progress-head">任务 {{task.id}}</view>
          <view class="batch-progress-meta">{{task.groups.length}} 个发货组 · 点击查看进度</view>
        </view>
      </scroll-view>
      <view class="modal-footer"><button class="modal-cancel" bindtap="closeRecentBatchTasks">关闭</button></view>
    </view>
  </view>

  <view class="modal" wx:if="{{showBatchProgress && batchProgress}}">
    <view class="modal-mask" bindtap="closeBatchProgress"></view>
    <view class="modal-content modal-large">
      <view class="modal-title">批量发货进度 {{batchProgress.completed}}/{{batchProgress.total}}</view>
      <view class="batch-progress-summary">成功 {{batchProgress.success}} 组，需处理 {{batchProgress.failed}} 组</view>
      <scroll-view class="preview-list" scroll-y>
        <view class="batch-progress-group" wx:for="{{batchProgress.groups}}" wx:key="id" wx:for-item="group">
          <view class="batch-progress-head">{{group.sequenceNo + 1}}. {{group.recipientName}} {{group.recipientPhone}}</view>
          <view class="batch-progress-meta">订单 {{group.orderText}}</view>
          <view class="batch-progress-status">{{group.statusText}} · {{group.stageText}}</view>
          <view class="batch-progress-reason" wx:if="{{group.reason}}">原因：{{group.reason}}</view>
          <button class="batch-review-btn" wx:if="{{group.canReview}}" bindtap="reviewBatchGroup" data-group-id="{{group.id}}">人工核查后解除占用</button>
          <button class="batch-review-btn" wx:if="{{group.canReviewWechat}}" bindtap="reviewBatchWechat" data-group-id="{{group.id}}">核查微信上报结果</button>
          <button class="batch-review-btn" wx:if="{{group.canRetryWechat}}" bindtap="retryBatchWechat" data-group-id="{{group.id}}">只重试微信上报</button>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeBatchProgress">关闭</button>
        <button class="modal-confirm" wx:if="{{batchProgress.canRetry}}" bindtap="retryBatchFailedGroups">重试失败组</button>
        <button class="modal-confirm" wx:if="{{batchProgress.completed === batchProgress.total}}" bindtap="finishBatchTask">结束任务（保留异常）</button>
      </view>
    </view>
  </view>
</view>
