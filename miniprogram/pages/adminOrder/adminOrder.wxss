page {
  background-color: #f0f0f0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.admin-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100vh;
}

/* 顶部 Tab */
.tabs-bar {
  display: flex;
  background-color: #ffffff;
  padding: 0 10rpx;
  flex-shrink: 0;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #888;
  padding: 30rpx 0;
  position: relative;
  transition: color 0.2s ease;
}
.tab-item.active {
  font-weight: bold;
  color: #000000;
}
.active-line {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #ffffff;
  border-radius: 4rpx;
}

/* 选择模式工具栏 */
.select-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #e6f7ff;
  padding: 20rpx 30rpx;
  border-bottom: 1px solid #bae7ff;
  flex-shrink: 0;
}
.toolbar-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  overflow: hidden;
}
.selected-count {
  font-size: 26rpx;
  color: #1890ff;
  font-weight: bold;
  white-space: nowrap;
}
.merge-hint {
  font-size: 24rpx;
  color: #52c41a;
  white-space: nowrap;
}
.merge-error {
  font-size: 24rpx;
  color: #ff4d4f;
  white-space: nowrap;
}
.toolbar-right {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}
.btn-merge {
  background-color: #1890ff;
  color: white;
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  border-radius: 20rpx;
  height: auto;
  line-height: 1.5;
}
.btn-merge[disabled] {
  background-color: #ccc;
}
.btn-cancel {
  background-color: #fff;
  color: #666;
  border: 1px solid #ddd;
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  border-radius: 20rpx;
  height: auto;
  line-height: 1.5;
}

/* 订单滚动区域 */
.order-scroll-area {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* 滚动区域内容 */
.scroll-content {
  padding: 20rpx;
}

.empty-state {
  padding: 100px 0;
  text-align: center;
  color: #999;
  font-size: 14px;
}

/* 管理员卡片 */
.admin-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  display: flex;
  position: relative;
  transition: all 0.2s ease;
}

/* 选择模式下的卡片样式 */
.admin-card.select-mode {
  background-color: #ffffff;
}
.admin-card.select-mode .card-content {
  opacity: 1;
  pointer-events: none;
}
.admin-card.select-mode.selecting .card-content {
  opacity: 1;
}

/* 选择框样式 */
.order-checkbox {
  padding: 30rpx 20rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
  min-height: 80rpx;
  z-index: 10;
  position: relative;
}
.order-checkbox:active {
  background-color: #e6f7ff;
  border-radius: 8rpx;
}
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  position: relative;
  pointer-events: none;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: transparent;
}
.checkbox.checked {
  background-color: #1890ff;
  border-color: #1890ff;
}
.check-icon {
  color: white;
  font-weight: bold;
  font-size: 28rpx;
  line-height: 1;
}

.card-content {
  flex: 1;
}

.card-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 20rpx;
  gap: 15rpx;
  flex-shrink: 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px dashed #eee;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}
.order-id {
  font-size: 22rpx;
  color: #999;
  font-family: "Times New Roman", Times, serif;
}
.order-status {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}
.order-status.urgent {
  color: #d32f2f;
}

/* 客户信息区（突出显示） */
.buyer-info {
  background: #fafafa;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.buyer-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #111;
  margin-bottom: 8rpx;
}
.buyer-phone {
  font-size: 26rpx;
  color: #666;
  font-weight: normal;
  margin-left: 10rpx;
  font-family: -apple-system, sans-serif;
}
.buyer-addr {
  font-size: 24rpx;
  color: #444;
  line-height: 1.4;
}
.copy-tip {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 20rpx;
  color: #1890ff;
  border: 1px solid #1890ff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 商品微缩预览 */
.goods-preview {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  overflow-x: auto;
}
.goods-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 15rpx;
  background: #eee;
  flex-shrink: 0;
  position: relative;
}
.goods-img-wrapper {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
}
.goods-img-wrapper .goods-img {
  width: 100%;
  height: 100%;
}
.goods-count {
  font-size: 24rpx;
  color: #999;
  margin-left: auto;
}

/* 已发货商品灰色遮罩 */
.goods-shipped-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(128, 128, 128, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
  border-radius: 8rpx;
}
.shipped-text {
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

/* 底部操作 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #f5f5f5;
  padding-top: 24rpx;
}
.money {
  font-size: 28rpx;
  font-weight: bold;
  color: #111;
  font-family: "Times New Roman", Times, serif;
}
.ship-info {
  font-size: 24rpx;
  color: #666;
  font-family: -apple-system, sans-serif;
}
.action-btn {
  background: #111;
  color: #fff;
  padding: 0 40rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  white-space: nowrap;
}
.action-btn.primary {
  background: #1890ff;
}
.action-btn-unbind {
  background: #ff4d4f;
  color: #fff;
  padding: 0 40rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  white-space: nowrap;
  margin-top: 15rpx;
}
.action-btn-outline {
  background: transparent;
  color: #1890ff;
  border: 1rpx solid #1890ff;
  padding: 0 40rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  white-space: nowrap;
  margin-top: 15rpx;
}
.shipped-info {
  font-size: 24rpx;
  color: #52c41a;
  font-family: -apple-system, sans-serif;
}

/* 底部选择模式切换按钮 */
.bottom-toolbar {
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  border-top: 1px solid #eee;
  flex-shrink: 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.btn-select-mode {
  background-color: #111;
  color: white;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 30rpx;
  height: auto;
  line-height: 1.5;
  width: 100%;
}
