page { background-color: #f2f2f2; }
.item-image.refunded { opacity: 0.4; }
.refund-tag { color: #e74c3c; font-size: 22rpx; margin-left: 8rpx; }
.item-checkbox.disabled { background: #ddd; }
.container {
  min-height: 100vh;
  padding: 16rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.admin-order-header { width: 100%; min-width: 0; box-sizing: border-box; }
.search-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; width: 100%; max-width: 100%; box-sizing: border-box; }
.search-dismiss-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 950; }
.search-box { position: relative; z-index: 951; }
.search-input-wrapper { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.search-input { flex: 1; height: 72rpx; background: #f5f5f5; border-radius: 8rpx; padding: 0 24rpx; font-size: 28rpx; }
.search-btn { width: 140rpx; height: 72rpx; line-height: 72rpx; background: #1a1a1a; color: #fff; font-size: 28rpx; border-radius: 8rpx; padding: 0; }

/* 档口/标签筛选，与首页保持同样的横向标签交互 */
.filter-section { margin-top: 8rpx; }
.filter-row { display: flex; align-items: center; min-height: 64rpx; }
.filter-label { width: 64rpx; flex-shrink: 0; color: #333; font-size: 24rpx; font-weight: 600; }
.filter-fixed-option { flex-shrink: 0; margin-right: 12rpx; }
.filter-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.filter-options { display: inline-flex; align-items: center; gap: 12rpx; padding: 6rpx 2rpx; }
.filter-tag { flex-shrink: 0; padding: 10rpx 24rpx; background: #f5f5f5; color: #666; font-size: 24rpx; line-height: 32rpx; border-radius: 12rpx; }
.filter-tag.active { background: #f5f5f5; color: #1a1a1a; font-weight: 800; box-shadow: inset 0 -4rpx 0 #1a1a1a; }

.date-filter { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.date-picker { flex: 1; height: 64rpx; background: #f5f5f5; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #666; }
.clear-date { width: 40rpx; height: 40rpx; background: #f0f0f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #999; }

.search-dropdown {
  position: absolute; top: 100rpx; left: 0; right: 0; background: #fff;
  border-radius: 12rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.08); z-index: 100;
}
.dropdown-item { display: flex; align-items: center; padding: 20rpx; border-bottom: 1rpx solid #f5f5f5; gap: 16rpx; position: relative; }
.dropdown-item.selected { background: #f9f9f9; }
.dropdown-item.selected .dropdown-name { color: #999; }
.dropdown-item:last-child { border-bottom: none; }
.selected-badge {
  position: absolute; top: 20rpx; right: 20rpx; background: #1a1a1a; color: #fff;
  font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 8rpx;
}
.dropdown-image { width: 100rpx; height: 100rpx; border-radius: 8rpx; background: #f5f5f5; flex-shrink: 0; }
.dropdown-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.dropdown-name { font-size: 28rpx; font-weight: 600; color: #333; }
.dropdown-sku-count { font-size: 22rpx; color: #999; }
.dropdown-loading { padding: 20rpx; text-align: center; font-size: 24rpx; color: #999; }

.selected-products { margin-top: 16rpx; }
.selected-title { font-size: 24rpx; color: #666; margin-bottom: 10rpx; }
.selected-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.selected-tag { background: #f5f5f5; padding: 0 0 0 20rpx; min-height: 64rpx; border-radius: 8rpx; font-size: 24rpx; display: flex; align-items: center; gap: 8rpx; }
.tag-count { color: #999; font-size: 20rpx; }
.remove-btn { width: 64rpx; min-height: 64rpx; align-self: stretch; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #d32f2f; font-size: 40rpx; line-height: 1; margin-left: 6rpx; }
.clear-all { margin-top: 12rpx; font-size: 24rpx; color: #666; background: #f0f0f0; border: none; border-radius: 8rpx; padding: 0 24rpx; height: 64rpx; line-height: 64rpx; }
.clear-all::after { border: none; }

.pending-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; overflow: hidden; }
.pending-modal-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, .48); }
.pending-modal-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88vh;
  max-height: 88vh;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.pending-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.pending-modal-title { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; font-size: 30rpx; font-weight: 600; color: #333; }
.pending-modal-count { font-size: 22rpx; font-weight: 400; color: #999; }
.pending-modal-close { flex-shrink: 0; color: #576b95; font-size: 24rpx; }
.pending-modal-list {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.pending-order-group { border-bottom: 1rpx solid #f0f0f0; }
.pending-order-group:last-child { border-bottom: none; }
.pending-order-header { padding: 20rpx 0; background: #fafafa; }
.pending-order-items { padding: 8rpx 0 16rpx; }
.pending-order-item { padding: 16rpx 0; }
.pending-item { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.pending-item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.pending-order-no, .pending-product-name { font-size: 24rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pending-product-name { font-weight: 600; }
.pending-item-sku, .pending-recipient { font-size: 20rpx; color: #888; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pending-item-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; flex-shrink: 0; }
.pending-remove, .pending-clear { color: #d32f2f; font-size: 22rpx; }
.pending-actions { display: flex; justify-content: flex-end; padding: 16rpx 0; }
.pending-clear { color: #999; }
.pending-modal-footer {
  padding: 16rpx 24rpx 24rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
  flex-shrink: 0;
}
.pending-logistics-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; }
.pending-logistics-picker { flex: 1; min-width: 0; height: 68rpx; background: #f5f5f5; border-radius: 8rpx; display: flex; align-items: center; padding: 0 20rpx; box-sizing: border-box; }
.pending-picker-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26rpx; color: #333; }
.pending-quota { flex-shrink: 0; font-size: 22rpx; color: #777; }
.pending-footer-actions { display: flex; align-items: center; gap: 16rpx; }
.pending-footer-actions .pending-clear { flex-shrink: 0; font-size: 24rpx; }
.pending-batch-ship-btn { flex: 1; }

/* 发货工具栏固定两行，窄屏也不让按钮自行换行。 */
.toolbar {
  background: #fff; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 16rpx;
  display: flex; flex-direction: column; gap: 12rpx;
  width: 100%; max-width: 100%; box-sizing: border-box;
}
.toolbar-row { display: flex; align-items: center; gap: 12rpx; width: 100%; min-width: 0; box-sizing: border-box; }
.toolbar-action-row .failed-ship-btn,
.toolbar-action-row .batch-ship-btn,
.toolbar-action-row .toolbar-history-entry {
  flex: 1 1 0; width: 0; min-width: 0; margin: 0; box-sizing: border-box;
  text-align: center; white-space: nowrap;
}
.toolbar-action-row .batch-ship-btn { padding: 0 4rpx; font-size: 24rpx; }
.toolbar-action-row .failed-ship-btn { padding: 0 4rpx; }
.toolbar-history-entry {
  height: 64rpx; line-height: 64rpx; color: #1769aa; font-size: 24rpx;
}
.after-sale-alert {
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  background: #fff7e6;
  color: #ad6800;
  border: 1rpx solid #ffe0a3;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.logistics-picker {
  height: 64rpx; background: #f5f5f5; border-radius: 8rpx; padding: 0 20rpx;
  display: flex; align-items: center; font-size: 26rpx; flex-shrink: 0;
}
.quota-info { font-size: 22rpx; color: #999; flex-shrink: 0; }
.toolbar-spacer { flex: 1; min-width: 8rpx; }

.checkbox-all, .order-checkbox, .item-checkbox, .sku-checkbox {
  width: 36rpx; height: 36rpx; border: 2rpx solid #ccc; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #fff; flex-shrink: 0;
}
.checkbox-all.checked, .order-checkbox.checked, .item-checkbox.checked, .sku-checkbox.checked { background: #1a1a1a; border-color: #1a1a1a; }

.select-all-text { font-size: 26rpx; flex-shrink: 0; }

.batch-ship-btn { height: 64rpx; line-height: 64rpx; background: #1a1a1a; color: #fff; font-size: 26rpx; border-radius: 8rpx; padding: 0 28rpx; flex-shrink: 0; }
.batch-ship-btn[disabled] { background: #ccc; }
.failed-ship-btn { height: 64rpx; line-height: 64rpx; margin: 0; padding: 0 18rpx; flex-shrink: 0; border: 1rpx solid #d32f2f; border-radius: 8rpx; background: #fff; color: #d32f2f; font-size: 24rpx; }
.failed-waybill-head { display: flex; flex-direction: column; gap: 8rpx; padding: 18rpx 0; font-size: 22rpx; color: #888; }
.failed-waybill-head .batch-progress-reason { color: #d32f2f; line-height: 1.5; overflow-wrap: anywhere; }
.failed-unavailable { color: #999; font-size: 22rpx; }
.failed-add-btn { margin: 0; background: #f5f5f5; color: #333; font-size: 24rpx; }
.failed-all-btn { width: 100%; margin: 0; }
.failed-list-empty { padding: 30rpx 0; text-align: center; color: #999; font-size: 24rpx; }

.order-list-container { width: 100%; box-sizing: border-box; }
.order-list { background: transparent; border-radius: 0; overflow: visible; width: 100%; max-width: 100%; padding-bottom: 16rpx; box-sizing: border-box; }
.back-to-top {
  position: fixed; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); z-index: 900;
  width: 184rpx; height: 72rpx; line-height: 72rpx; margin: 0; padding: 0;
  background: #1a1a1a; color: #fff; border-radius: 36rpx; font-size: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .18);
}
.order-group { background: #fff; border-radius: 16rpx; overflow: hidden; margin-bottom: 16rpx; width: 100%; max-width: 100%; box-sizing: border-box; }
.order-group:last-child { margin-bottom: 0; }
.order-header { display: flex; align-items: flex-start; padding: 20rpx; background: #fafafa; gap: 16rpx; width: 100%; max-width: 100%; box-sizing: border-box; }
.order-summary { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.summary-row { display: flex; align-items: flex-start; gap: 12rpx; min-width: 0; }
.summary-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.summary-label { flex-shrink: 0; font-size: 22rpx; color: #999; }
.summary-chip { align-self: flex-start; flex-shrink: 0; font-size: 22rpx; color: #576b95; background: #eef3fb; padding: 2rpx 10rpx; border-radius: 6rpx; max-width: 100%; box-sizing: border-box; }
.summary-action { align-self: flex-start; }
.order-no { font-size: 26rpx; font-weight: 600; min-width: 0; word-break: break-all; }
.order-number { display: inline-flex; align-items: center; gap: 8rpx; min-width: 0; }
.order-date { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.recipient-row { margin-top: 4rpx; }
.recipient-main { row-gap: 4rpx; }
.recipient-name { font-size: 24rpx; color: #333; }
.recipient-phone { font-size: 24rpx; color: #666; }
.recipient-address { font-size: 22rpx; color: #888; line-height: 1.5; word-break: break-all; }
.copy-link { flex-shrink: 0; padding: 4rpx 12rpx; font-size: 22rpx; line-height: 1.3; color: #576b95; background: #f5f7fa; border-radius: 6rpx; }

.order-items { padding: 16rpx 20rpx; width: 100%; max-width: 100%; box-sizing: border-box; }
.order-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; gap: 16rpx; width: 100%; max-width: 100%; box-sizing: border-box; }
.order-item:last-child { border-bottom: none; }
/* 左侧选中列覆盖对应订单信息或商品行的完整高度。 */
.selectable-order-header { position: relative; padding-left: 76rpx; }
.selection-column {
  position: absolute; left: 0; top: 0; bottom: 0; width: 76rpx;
  padding-left: 20rpx; padding-right: 16rpx; box-sizing: border-box;
  display: flex; justify-content: center;
}
.order-selection-column { align-items: flex-start; padding-top: 20rpx; }
.selectable-order-items { padding: 0; }
.selectable-order-item { position: relative; padding: 16rpx 20rpx 16rpx 76rpx; }
.selectable-order-item:first-child { padding-top: 32rpx; }
.selectable-order-item:last-child { padding-bottom: 32rpx; }
.item-selection-column { align-items: center; }
.selectable-order-item:first-child .item-selection-column { padding-top: 16rpx; }
.selectable-order-item:last-child .item-selection-column { padding-bottom: 16rpx; }
.item-image { width: 110rpx; height: 110rpx; border-radius: 8rpx; background: #f5f5f5; flex-shrink: 0; }
.item-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.item-name { font-size: 26rpx; font-weight: 600; }
.item-sku { font-size: 22rpx; color: #666; }
.item-qty { font-size: 20rpx; color: #999; }
.item-after-sale {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}
.admin-remark-line {
  font-size: 26rpx;
  font-weight: 400;
  color: #333;
}
.item-after-sale text {
  font-size: 20rpx;
  color: #d84315;
  background: #fff3e0;
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
}

.item-ship-qty { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; }
.stepper { display: flex; align-items: center; }
.stepper-btn { width: 48rpx; height: 48rpx; background: #f5f5f5; border-radius: 6rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #333; }
.stepper-btn.disabled { color: #ccc; }
.stepper-input { width: 80rpx; height: 48rpx; background: #fff; border: 1rpx solid #e0e0e0; border-radius: 0; text-align: center; font-size: 28rpx; }

.empty-state, .loading-state { padding: 180rpx 0; text-align: center; color: #999; font-size: 26rpx; }
.page-loading { padding: 32rpx 0 56rpx; text-align: center; color: #999; font-size: 24rpx; }

/* 弹窗 */
.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; }
.modal-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); }
.modal-content { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 600rpx; max-height: 70vh; background: #fff; border-radius: 16rpx; overflow: hidden; display: flex; flex-direction: column; }
.modal-large { width: 700rpx; }
.modal-title { padding: 28rpx; font-size: 30rpx; font-weight: 600; text-align: center; border-bottom: 1rpx solid #f0f0f0; }
.quick-options { display: flex; padding: 16rpx; gap: 12rpx; border-bottom: 1rpx solid #f0f0f0; }
.quick-option { flex: 1; height: 64rpx; line-height: 64rpx; text-align: center; background: #f5f5f5; border-radius: 8rpx; font-size: 24rpx; color: #666; }
.quick-option.selected { background: #1a1a1a; color: #fff; }
.custom-section { padding: 24rpx 16rpx; }
.custom-title { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }
.date-picker-input { height: 64rpx; background: #f5f5f5; border-radius: 8rpx; padding: 0 24rpx; display: flex; align-items: center; font-size: 26rpx; color: #333; margin-bottom: 12rpx; }

.sku-list, .preview-list { flex: 1; padding: 16rpx; overflow-y: auto; }
.sku-item { display: flex; align-items: center; padding: 20rpx 16rpx; border-bottom: 1rpx solid #f5f5f5; gap: 16rpx; }
.sku-item.selected { background: #f9f9f9; }
.sku-item.selected .sku-name { color: #1a1a1a; font-weight: 600; }
.sku-info { flex: 1; font-size: 26rpx; }

.preview-group { margin-bottom: 24rpx; }
.preview-title { font-size: 26rpx; font-weight: 600; margin-bottom: 12rpx; color: #333; }
.preview-recipient { font-size: 24rpx; color: #666; margin-bottom: 10rpx; display: flex; flex-direction: column; gap: 6rpx; }
.preview-recipient-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.preview-items { background: #f7f7f7; border-radius: 8rpx; padding: 12rpx 16rpx; }
.preview-item { font-size: 24rpx; color: #333; padding: 6rpx 0; border-bottom: 1rpx solid #eee; }
.preview-item:last-child { border-bottom: none; }
.preview-summary { padding: 16rpx; background: #fafafa; border-top: 1rpx solid #f0f0f0; font-size: 24rpx; color: #666; text-align: center; }

.modal-footer { display: flex; border-top: 1rpx solid #f0f0f0; }
.modal-cancel, .modal-confirm { flex: 1; height: 88rpx; line-height: 88rpx; font-size: 28rpx; border-radius: 0; padding: 0; border: none; }
.modal-cancel { background: #f5f5f5; color: #666; border-right: 1rpx solid #f0f0f0; }
.modal-confirm { background: #1a1a1a; color: #fff; }
.modal-confirm[disabled] { background: #ccc; }
.batch-progress-entry { display: block; padding: 12rpx; color: #1769aa; font-size: 24rpx; }
.batch-progress-summary { padding: 18rpx 24rpx; font-size: 25rpx; background: #f7f7f7; }
.batch-progress-group { border-bottom: 1rpx solid #eee; padding: 18rpx 10rpx; font-size: 24rpx; }
.batch-progress-head { font-weight: 600; }
.batch-progress-meta, .batch-progress-status { color: #666; margin-top: 7rpx; }
.batch-progress-reason { color: #b3261e; margin-top: 8rpx; white-space: normal; }
.batch-review-btn { margin-top: 12rpx; font-size: 22rpx; background: #fff5e9; color: #9b5d00; }

/* 后台发货与历史任务 */
.active-batch-banner { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 24rpx; margin: 16rpx 20rpx; border: 1rpx solid #c9dfd6; background: #f0f8f4; border-radius: 14rpx; }
.active-batch-title { font-size: 27rpx; font-weight: 600; color: #27634d; }
.task-modal { height: 84vh; max-height: 84vh; }
.task-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 25rpx 26rpx; border-bottom: 1rpx solid #eee; gap: 18rpx; flex-shrink: 0; }
.task-modal-title { font-size: 31rpx; font-weight: 600; }
.task-filter-tabs { display: flex; gap: 12rpx; padding: 18rpx 24rpx; flex-shrink: 0; }
.task-filter { font-size: 25rpx; padding: 12rpx 28rpx; border-radius: 28rpx; color: #666; background: #f3f4f5; }
.task-filter.active { color: #fff; background: #232b28; }
.task-scroll { flex: 1; min-height: 0; height: 0; width: 100%; background: #f6f7f8; }
.task-history-card, .task-package-card { margin: 18rpx; padding: 24rpx; border-radius: 14rpx; background: #fff; font-size: 25rpx; overflow-wrap: anywhere; }
.task-card-top, .task-card-bottom { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; }
.task-card-time { font-size: 26rpx; font-weight: 600; }
.task-status { font-size: 22rpx; color: #686d6a; background: #f1f2f3; padding: 6rpx 12rpx; border-radius: 7rpx; flex-shrink: 0; }
.task-status.running { color: #28624c; background: #e8f4ec; }
.task-card-count { font-size: 25rpx; margin-top: 18rpx; color: #414843; }
.task-progress-track { height: 8rpx; background: #edf0ee; border-radius: 6rpx; overflow: hidden; margin: 18rpx 0 14rpx; }
.task-progress-fill { height: 100%; background: #398462; border-radius: 6rpx; }
.task-card-results { display: flex; flex-wrap: wrap; gap: 16rpx; font-size: 23rpx; color: #566159; }
.task-issue { color: #ad4933; font-size: 23rpx; margin-top: 8rpx; }
.task-card-bottom { padding-top: 17rpx; margin-top: 18rpx; border-top: 1rpx solid #f0f1f2; }
.task-id { color: #8b918c; font-size: 21rpx; overflow-wrap: anywhere; }
.task-empty { text-align: center; color: #999; font-size: 26rpx; padding: 100rpx 20rpx; }
.task-load-more, .task-loading-hint { text-align: center; color: #818981; font-size: 24rpx; padding: 24rpx; }
.task-detail-overview { padding: 18rpx 24rpx; border-bottom: 1rpx solid #eee; flex-shrink: 0; }
.task-detail-overview .batch-progress-meta { font-size: 22rpx; }
.task-background-tip { font-size: 23rpx; margin-top: 14rpx; color: #28624c; }
.task-query-error { color: #a45325; background: #fff4e6; padding: 12rpx; font-size: 24rpx; margin-top: 12rpx; }
.task-package-toggle { padding-bottom: 8rpx; }
.task-package-recipient { margin-top: 14rpx; color: #3c443f; }
.task-package-address { margin: 12rpx 0; line-height: 1.5; color: #686f6a; }
.task-waybill { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; padding: 14rpx 0; color: #434e46; border-top: 1rpx solid #f1f2f3; }
.task-waybill > text:first-child { flex: 1; min-width: 0; }
.task-order-card { border-top: 1rpx solid #ecefed; margin-top: 20rpx; padding-top: 18rpx; }
.task-order-head { display: flex; flex-direction: column; gap: 12rpx; font-size: 23rpx; }
.task-order-number { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; }
.task-order-number .copy-link { flex-shrink: 0; }
.task-logistics-trace { margin-top: 12rpx; padding-top: 16rpx; border-top: 1rpx solid #eee; }
.task-trace-header { display: flex; align-items: center; gap: 20rpx; margin-bottom: 12rpx; }
.task-trace-title { font-size: 24rpx; font-weight: 600; color: #666; }
.task-trace-list { display: flex; flex-direction: column; gap: 18rpx; }
.task-trace-node { display: flex; flex-direction: column; gap: 6rpx; border-left: 3rpx solid #dbe5df; padding-left: 16rpx; }
.task-trace-content { font-size: 24rpx; color: #333; line-height: 1.6; word-break: break-all; }
.task-trace-time { font-size: 22rpx; color: #999; line-height: 1.6; }
.task-trace-empty { font-size: 23rpx; color: #888; line-height: 1.6; }
.task-trace-empty .copy-link, .task-query-error .copy-link { margin-left: 16rpx; }
.task-product-missing { color: #747d77; font-size: 23rpx; }
.task-product { display: flex; gap: 16rpx; padding: 18rpx 0 4rpx; }
.task-product-image { width: 96rpx; height: 110rpx; border-radius: 8rpx; flex-shrink: 0; background: #f4f4f4; }
.task-product-content { flex: 1; min-width: 0; }
.task-product-name { font-size: 25rpx; line-height: 1.5; }
.task-product-qty { font-size: 24rpx; color: #303d33; margin-top: 10rpx; }
.task-pagination { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 12rpx 16rpx; border-top: 1rpx solid #eee; font-size: 23rpx; flex-shrink: 0; }
.task-pagination button { margin: 0; font-size: 23rpx; }
.task-modal .modal-footer { flex-shrink: 0; }
