page{background:#f7f7f7;color:#222}.quick-checkout{padding:36rpx 28rpx 190rpx}.title{font-size:42rpx;font-weight:600;margin:12rpx 0 34rpx}.card{background:white;border-radius:20rpx;padding:30rpx;margin-bottom:24rpx}.address{position:relative;line-height:1.7;padding-right:65rpx;font-size:26rpx}.recipient{font-size:30rpx;font-weight:500;margin-bottom:12rpx}.arrow{position:absolute;right:28rpx;top:40rpx;font-size:42rpx;color:#aaa}.empty-address{padding:25rpx 0}.product{display:flex;gap:26rpx}.product>image{width:170rpx;height:210rpx;border-radius:12rpx;flex-shrink:0}.name{font-size:30rpx;line-height:1.5;margin:8rpx 0 20rpx}.muted{font-size:25rpx;color:#888;margin:12rpx 0}.images{white-space:nowrap;margin-top:22rpx;height:120rpx}.images image{width:100rpx;height:120rpx;margin-right:12rpx;border-radius:8rpx}.fee{display:flex;justify-content:space-between;font-size:28rpx}.shipping-error{color:#b34d35;font-size:25rpx;padding:12rpx}.footer{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:space-between;font-size:26rpx;gap:18rpx}.footer button{background:#222;color:white;font-size:27rpx;margin:0;min-width:250rpx}.footer button[disabled]{background:#ddd;color:#999}.state{padding:100rpx 25rpx;text-align:center;color:#777;line-height:1.8}.state button{margin-top:30rpx;font-size:28rpx}
