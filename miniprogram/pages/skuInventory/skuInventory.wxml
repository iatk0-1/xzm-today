<view class="container">
  <view class="filter-bar">
    <view class="filter-tabs">
      <view wx:for="{{inventoryTabs}}" wx:key="id" class="inventory-tab {{inventoryTab === item.id ? 'active' : ''}}" data-tab="{{item.id}}" bindtap="changeInventoryTab">{{item.name}}</view>
    </view>
    <view class="relation-filter-section">
      <view class="relation-filter-row">
        <text class="relation-filter-label">档口</text>
        <view class="relation-filter-fixed relation-filter-tag {{selectedStall === '' ? 'active' : ''}}" bindtap="selectStall" data-stall="all">全部</view>
        <scroll-view class="relation-filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="relation-filter-options">
            <view class="relation-filter-tag {{selectedStall === item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="relation-filter-row">
        <text class="relation-filter-label">标签</text>
        <view class="relation-filter-fixed relation-filter-tag {{selectedTag === '' ? 'active' : ''}}" bindtap="selectTag" data-tag="all">全部</view>
        <scroll-view class="relation-filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="relation-filter-options">
            <view class="relation-filter-tag {{selectedTag === item.id ? 'active' : ''}}" wx:for="{{tagList}}" wx:key="id" bindtap="selectTag" data-tag="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
    <view class="search-bar">
      <input class="search-input" placeholder="搜索商品名称" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="search" />
      <button class="search-btn" bindtap="search">搜索</button>
    </view>
  </view>
  <button class="stock-shipping-btn" bindtap="openShippingModal">按照库存发货</button>
  <view class="product-list">
    <view class="product-item" wx:for="{{productList}}" wx:key="id" bindtap="selectProduct" data-item="{{item}}">
      <image class="product-image" src="{{item.coverUrl || '/images/default-goods-image.png'}}" mode="aspectFill" />
      <view class="product-info">
        <view class="product-name">{{item.name}}</view>
        <view class="sku-summary" wx:for="{{item.skus}}" wx:for-item="sku" wx:key="id">
          <view class="sku-title">{{sku.spec}} {{sku.size}}</view>
          <view class="quantity-line">
            <text>实存 {{sku.availableQty}}</text><text>可发 {{sku.shippableQty}}</text>
            <text class="{{sku.shortageQty > 0 ? 'shortage-text' : ''}}">欠货 {{sku.shortageQty}}</text>
            <text class="{{sku.abnormalQty > 0 ? 'abnormal-text' : ''}}">异常 {{sku.abnormalQty}}</text>
          </view>
          <view class="muted">报单 {{sku.reportedQty}} · 已到货 {{sku.receivedQty}}<text wx:if="{{sku.reservedQty}}"> · 发货占用 {{sku.reservedQty}}</text></view>
        </view>
        <text class="no-sku" wx:if="{{!item.skus.length}}">暂无 SKU 信息</text>
      </view>
      <view class="product-action" wx:if="{{item.skus.length}}">
        <view class="edit-icon" catchtap="operateSku" data-product="{{item}}" data-sku="{{item.skus[0]}}">✏️</view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!productList.length && !loading}}">暂无符合条件的商品</view>
    <view class="loading-state" wx:if="{{loading}}">加载中...</view>
  </view>

  <view class="modal" wx:if="{{showSkuModal}}">
    <view class="modal-mask" bindtap="hideSkuModal"></view>
    <view class="modal-content">
      <view class="modal-title">仓库库存管理</view>
      <scroll-view class="warehouse-body" scroll-y>
        <view class="product-name">{{selectedProduct.name}}</view>
        <view class="sku-options">
          <view wx:for="{{selectedProduct.skus}}" wx:key="id" class="sku-option {{selectedSku.id === item.id ? 'active' : ''}}" data-index="{{index}}" bindtap="selectSku">{{item.spec}} {{item.size}}</view>
        </view>
        <view class="inventory-summary">
          <text>实际库存 {{currentQty}}</text><text>可发 {{selectedSku.shippableQty}}</text>
          <text class="shortage-text">欠货 {{selectedSku.shortageQty}}</text>
          <text class="abnormal-text">异常 {{selectedSku.abnormalQty}}</text>
        </view>
        <view class="muted">欠货按报单待到货数量统计；现货可发货，不自动抵扣欠货。</view>
        <view class="tabs">
          <view class="tab-item {{activeTab === 'operate' ? 'active' : ''}}" data-tab="operate" bindtap="switchTab">操作</view>
          <view class="tab-item {{activeTab === 'reports' ? 'active' : ''}}" data-tab="reports" bindtap="switchTab">报单记录</view>
          <view class="tab-item {{activeTab === 'ledger' ? 'active' : ''}}" data-tab="ledger" bindtap="switchTab">入库与流水</view>
        </view>
        <view wx:if="{{detailLoading}}" class="muted">加载明细中...</view>
        <view class="operate-form" wx:if="{{activeTab === 'operate'}}">
          <view class="radio-group">
            <view class="radio-item {{operateType === 'normal' ? 'active' : ''}}" data-type="normal" bindtap="setOperateType">正常到货</view>
            <view class="radio-item {{operateType === 'history' ? 'active' : ''}}" data-type="history" bindtap="setOperateType">历史入库</view>
          </view>
          <view class="radio-group">
            <view class="radio-item {{operateType === 'stocktake' ? 'active' : ''}}" data-type="stocktake" bindtap="setOperateType">盘点调整</view>
            <view class="radio-item {{operateType === 'abnormal' ? 'active' : ''}}" data-type="abnormal" bindtap="setOperateType">异常处理</view>
          </view>
          <view wx:if="{{operateType === 'normal'}}" class="operation-tip">按报单时间自动抵扣欠货，超出报单的部分记为异常库存。</view>
          <view wx:if="{{operateType === 'history'}}" class="operation-tip">历史遗留实物入库，可用于发货，不抵欠货、不产生超收异常。</view>
          <block wx:if="{{operateType === 'stocktake'}}">
            <view class="radio-group">
              <view class="radio-item {{stocktakeDirection === 'gain' ? 'active' : ''}}" data-value="gain" bindtap="setStocktakeDirection">盘盈</view>
              <view class="radio-item {{stocktakeDirection === 'loss' ? 'active' : ''}}" data-value="loss" bindtap="setStocktakeDirection">盘亏</view>
            </view>
            <view class="operation-tip" wx:if="{{stocktakeDirection === 'gain'}}">盘盈数量先记为异常库存，等待人工处理。</view>
            <view wx:if="{{stocktakeDirection === 'loss'}}">
              <view class="form-label">减少哪类库存</view>
              <view class="radio-group">
                <view class="radio-item {{stocktakeCategory === 'normal' ? 'active' : ''}}" data-value="normal" bindtap="setStocktakeCategory">正常库存</view>
                <view class="radio-item {{stocktakeCategory === 'abnormal' ? 'active' : ''}}" data-value="abnormal" bindtap="setStocktakeCategory">异常库存</view>
              </view>
            </view>
          </block>
          <block wx:if="{{operateType === 'abnormal'}}">
            <view class="radio-group">
              <view class="radio-item {{abnormalAction === 'keep' ? 'active' : ''}}" data-value="keep" bindtap="setAbnormalAction">保留补报</view>
              <view class="radio-item {{abnormalAction === 'exchange' ? 'active' : ''}}" data-value="exchange" bindtap="setAbnormalAction">换货出库</view>
              <view class="radio-item {{abnormalAction === 'return' ? 'active' : ''}}" data-value="return" bindtap="setAbnormalAction">退货出库</view>
            </view>
            <view class="operation-tip">待处理 {{selectedSku.abnormalQty}} 件。保留自动补报并转为可发库存；退换货只记录出库用途。</view>
          </block>
          <view class="form-item"><text class="form-label">本次数量</text><input class="form-input" type="number" value="{{inputQty}}" bindinput="onQtyInput" placeholder="请输入正整数数量" disabled="{{saving}}" /></view>
          <view class="form-item"><text class="form-label">{{operateType === 'stocktake' ? '调整原因（必填）' : '备注'}}</text><input class="form-input" value="{{note}}" bindinput="onNoteInput" placeholder="{{operateType === 'stocktake' ? '填写盘点差异原因' : '可选'}}" disabled="{{saving}}" /></view>
        </view>
        <view wx:if="{{activeTab === 'reports'}}">
          <view wx:for="{{reportList}}" wx:key="purchaseOrderId" class="record-card">
            <view>报单 {{item.batchNo || item.purchaseOrderId}}</view>
            <view class="quantity-line"><text>报单 {{item.reportedQty}}</text><text>到货 {{item.receivedQty}}</text><text class="shortage-text">欠货 {{item.shortageQty}}</text></view>
            <view class="muted" wx:if="{{item.note}}">{{item.note}}</view>
          </view>
          <view class="muted" wx:if="{{!reportList.length && !detailLoading}}">暂无报单记录</view>
        </view>
        <view wx:if="{{activeTab === 'ledger'}}">
          <view class="record-section-title">入库记录及报单抵扣</view>
          <view wx:for="{{receiptList}}" wx:key="id" class="record-card {{item.revoked ? 'revoked' : ''}}">
            <view>{{item.sourceText}} · {{item.qty}} 件 <text wx:if="{{item.revoked}}">（已撤销）</text></view>
            <view class="muted">{{item.timeText}} {{item.note}}</view>
            <view wx:for="{{item.allocations}}" wx:for-item="allocation" wx:key="purchaseOrderId" class="allocation-line">对应报单 {{allocation.batchNo || allocation.purchaseOrderId}} · {{allocation.qty}} 件</view>
            <button wx:if="{{item.canRevoke}}" class="receipt-revoke" data-item="{{item}}" bindtap="revokeLedger" disabled="{{saving}}">撤销本次入库</button>
          </view>
          <view class="record-section-title">库存变动流水</view>
          <view wx:for="{{ledgerList}}" wx:key="id" class="record-card">
            <view>{{item.changeTypeText}} · {{item.changeQty > 0 ? '+' : ''}}{{item.changeQty}} 件</view>
            <view class="muted">{{item.beforeQty}} → {{item.afterQty}} · {{item.timeText}}</view>
            <view class="muted">{{item.note}}</view>
          </view>
          <view class="muted" wx:if="{{!receiptList.length && !ledgerList.length && !detailLoading}}">暂无库存记录</view>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="hideSkuModal" disabled="{{saving}}">关闭</button>
        <button class="btn-confirm" bindtap="confirmOperate" wx:if="{{activeTab === 'operate'}}" loading="{{saving}}" disabled="{{saving || detailLoading}}">确认操作</button>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showShippingModal}}">
    <view class="modal-mask" bindtap="closeShippingModal"></view>
    <view class="modal-content">
      <view class="modal-title">按现有库存发货</view>
      <scroll-view class="warehouse-body" scroll-y>
        <view class="operation-tip">默认选中全部可发规格。异常库存及其他任务占用的库存不参与发货，订单按下单时间从早到晚匹配。</view>
        <view wx:if="{{shippingLoading}}" class="muted">加载可发库存中...</view>
        <view wx:for="{{shippingProducts}}" wx:key="id" wx:for-item="product" wx:for-index="productIndex" class="record-card">
          <view class="product-name">{{product.name}}</view>
          <view wx:for="{{product.skus}}" wx:key="id" wx:for-item="sku" wx:for-index="skuIndex" class="shipping-sku">
            <view class="shipping-choice" data-product-index="{{productIndex}}" data-sku-index="{{skuIndex}}" bindtap="toggleShippingSku">
              <checkbox checked="{{sku.selected}}" disabled="{{matching}}" /><text>{{sku.spec}} {{sku.size}}</text>
            </view>
            <view class="muted">可发 {{sku.shippableQty}} 件</view>
            <input class="shipping-qty" type="number" value="{{sku.shipQty}}" data-product-index="{{productIndex}}" data-sku-index="{{skuIndex}}" bindinput="onShippingQtyInput" disabled="{{matching}}" />
          </view>
        </view>
        <view wx:if="{{!shippingProducts.length && !shippingLoading}}" class="empty-state">暂无可发库存</view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeShippingModal" disabled="{{matching}}">取消</button>
        <button class="btn-confirm" bindtap="goToStockShipping" loading="{{matching}}" disabled="{{matching || shippingLoading || !shippingProducts.length}}">去发货</button>
      </view>
    </view>
  </view>
</view>
