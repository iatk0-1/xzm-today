<view class="container">
  <view wx:if="{{quantityRetryPending}}" class="operation-pending" bindtap="retryQuantityOperation">上次数量操作结果待确认，点此沿用原请求重试</view>
  <view wx:if="{{unbindReviewAvailable}}" class="operation-pending" bindtap="confirmPendingUnbindWaybill">面单取消响应丢失？在物流平台核实取消后，点此登记依据并续办原解绑</view>
  <view class="filter-bar">
    <view class="filter-tabs">
      <view wx:for="{{inventoryTabs}}" wx:key="id" class="inventory-tab {{inventoryTab === item.id ? 'active' : ''}}" data-tab="{{item.id}}" bindtap="changeInventoryTab">{{item.name}}</view>
    </view>
    <view class="relation-filter-section">
      <view class="relation-filter-row">
        <text class="relation-filter-label">档口</text>
        <view class="relation-filter-fixed relation-filter-tag {{selectedStall === '' ? 'active' : ''}}" bindtap="selectStall" data-stall="all">全部</view>
        <scroll-view class="relation-filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="relation-filter-options">
            <view class="relation-filter-tag {{selectedStall === item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="relation-filter-row">
        <text class="relation-filter-label">标签</text>
        <view class="relation-filter-fixed relation-filter-tag {{selectedTag === '' ? 'active' : ''}}" bindtap="selectTag" data-tag="all">全部</view>
        <scroll-view class="relation-filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="relation-filter-options">
            <view class="relation-filter-tag {{selectedTag === item.id ? 'active' : ''}}" wx:for="{{tagList}}" wx:key="id" bindtap="selectTag" data-tag="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
    <view class="date-filter">
      <view class="date-picker" bindtap="showDateRangeSelector">
        <text wx:if="{{!dateRange.startDate && !dateRange.endDate}}">选择上架时间范围</text>
        <text wx:else>上架：{{dateRange.startDate || '开始'}} - {{dateRange.endDate || '结束'}}</text>
      </view>
      <view class="clear-date" wx:if="{{dateRange.startDate || dateRange.endDate}}" bindtap="clearDateRange">×</view>
    </view>
    <view class="search-bar">
      <input class="search-input" placeholder="搜索商品名称" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="search" />
      <button class="search-btn" bindtap="search">搜索</button>
    </view>
  </view>
  <view class="inventory-action-bar">
    <view class="select-all" bindtap="toggleSelectAll">
      <view class="inventory-checkbox {{allSelected ? 'checked' : ''}}"><text wx:if="{{allSelected}}">✓</text></view>
      <text>全选</text>
    </view>
    <button class="batch-receive-btn" bindtap="openBatchReceiveModal" disabled="{{!pendingReceiveItems.length && !batchRetryPending}}">{{batchRetryPending ? '入库待确认' : '批量入库'}}</button>
    <button class="stock-shipping-btn" bindtap="openShippingModal">按照库存发货</button>
  </view>
  <view class="selection-summary" wx:if="{{selectedCount || pendingReceiveItems.length}}">已选 {{selectedCount}} 个商品 · 待入库 {{pendingReceiveProductCount}} 个商品，{{pendingReceiveItems.length}} 个规格，共 {{pendingReceiveTotal}} 件（切换筛选保留）</view>
  <view class="product-list">
    <view class="product-item {{item.selected ? 'selected' : ''}}" wx:for="{{productList}}" wx:key="id">
      <view class="product-select" catchtap="toggleProductSelection" data-id="{{item.id}}">
        <view class="inventory-checkbox {{item.selected ? 'checked' : ''}} {{!item.skus.length || batchReceiveSaving || batchRetryPending ? 'disabled' : ''}}"><text wx:if="{{item.selected}}">✓</text></view>
      </view>
      <view class="product-media">
        <image class="product-image" src="{{item.coverUrl || '/images/default-goods-image.png'}}" mode="aspectFill" />
        <view class="card-total-editor" wx:if="{{item.skus.length}}" catchtap="stopCardTap">
          <button class="card-qty-adjust" catchtap="adjustCardReceiveQty" data-product-id="{{item.id}}" data-delta="-1" disabled="{{batchReceiveSaving || batchRetryPending}}">−</button>
          <button class="card-qty-adjust" catchtap="adjustCardReceiveQty" data-product-id="{{item.id}}" data-delta="1" disabled="{{batchReceiveSaving || batchRetryPending}}">+</button>
        </view>
      </view>
      <view class="product-info">
        <view class="product-name">{{item.name}}</view>
        <view class="sku-summary" wx:for="{{item.skus}}" wx:for-item="sku" wx:key="id">
          <view class="sku-heading">
            <view class="sku-title">{{sku.spec}} {{sku.size}}</view>
            <view class="card-sku-editor" catchtap="stopCardTap">
              <button class="card-qty-adjust" catchtap="adjustCardReceiveQty" data-product-id="{{item.id}}" data-sku-id="{{sku.id}}" data-delta="-1" disabled="{{batchReceiveSaving || batchRetryPending || !sku.receiveQty}}">−</button>
              <input class="card-qty-input" type="number" value="{{sku.receiveQty}}" bindinput="onCardReceiveQtyInput" bindblur="normalizeCardReceiveQty" data-product-id="{{item.id}}" data-sku-id="{{sku.id}}" disabled="{{batchReceiveSaving || batchRetryPending}}" />
              <button class="card-qty-adjust" catchtap="adjustCardReceiveQty" data-product-id="{{item.id}}" data-sku-id="{{sku.id}}" data-delta="1" disabled="{{batchReceiveSaving || batchRetryPending}}">+</button>
            </view>
          </view>
          <view class="quantity-line">
            <text>实存 {{sku.availableQty}}</text><text>订单可发 {{sku.readyToShipQty}}</text>
            <text class="{{sku.shortageQty > 0 ? 'shortage-text' : ''}}">报单待到货 {{sku.shortageQty}}</text>
            <text class="{{sku.abnormalQty > 0 ? 'abnormal-text' : ''}}">异常 {{sku.abnormalQty}}</text>
          </view>
          <view class="muted">空闲现货 {{sku.freeStockQty}} · 订单已配 {{sku.orderAllocatedQty}} · 待报 {{sku.customerMissingQty}} · 富余在途 {{sku.surplusTransitQty}}</view>
          <view class="muted" wx:if="{{sku.frozenDemandQty}}">未发售后冻结 {{sku.frozenDemandQty}} · 冻结现货 {{sku.frozenStockQty}}</view>
          <view class="muted">报单 {{sku.reportedQty}} · 已到货 {{sku.receivedQty}}<text wx:if="{{sku.reservedQty}}"> · 发货占用 {{sku.reservedQty}}</text></view>
        </view>
        <text class="no-sku" wx:if="{{!item.skus.length}}">暂无 SKU 信息</text>
      </view>
      <view class="product-action" wx:if="{{item.skus.length}}">
        <view class="edit-icon" catchtap="operateSku" data-product="{{item}}" data-sku="{{item.skus[0]}}">✏️</view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!productList.length && !loading}}">暂无符合条件的商品</view>
    <view class="loading-state" wx:if="{{loading}}">加载中...</view>
  </view>

  <view class="modal" wx:if="{{showBatchReceiveModal}}">
    <view class="modal-mask" bindtap="closeBatchReceiveModal"></view>
    <view class="modal-content batch-receive-modal">
      <view class="modal-title">确认入库数量</view>
      <view class="batch-source-tabs">
        <view class="inventory-tab {{batchReceiveSource === 'normal' ? 'active' : ''}}" data-source="normal" bindtap="changeBatchReceiveSource">报单入库</view>
        <view class="inventory-tab {{batchReceiveSource === 'history' ? 'active' : ''}}" data-source="history" bindtap="changeBatchReceiveSource">历史入库</view>
      </view>
      <view class="batch-receive-tip">{{batchReceiveSource === 'normal' ? '自动核销报单待到货，超出报单的数量计入异常库存。' : '录入历史遗留库存，不核销报单待到货，不产生超收异常。'}} 数量为0的规格不入库。</view>
      <view class="batch-pending-tip" wx:if="{{batchRetryPending && !batchReceiveSaving}}">上次入库结果待确认，请重试原批次，确认期间不能修改数量和来源。</view>
      <scroll-view class="batch-receive-list" scroll-y="true">
        <view class="batch-receive-row" wx:for="{{batchReceiveItems}}" wx:key="skuId">
          <image class="batch-item-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="batch-item-info">
            <view class="batch-item-name">{{item.productName}}</view>
            <view class="batch-item-sku">{{item.spec || '默认规格'}} {{item.size}}</view>
            <view class="batch-item-sku" wx:if="{{batchReceiveSource === 'normal'}}">报单待到货 {{item.shortageQty}} 件</view>
          </view>
          <view class="batch-qty-editor">
            <button class="batch-qty-adjust" bindtap="adjustBatchReceiveQty" data-index="{{index}}" data-delta="-1" disabled="{{batchReceiveSaving || batchRetryPending || item.qty <= 0}}">−</button>
            <input class="batch-qty-input" type="number" value="{{item.qty}}" bindinput="onBatchReceiveQtyInput" bindblur="normalizeBatchReceiveQty" data-index="{{index}}" disabled="{{batchReceiveSaving || batchRetryPending}}" />
            <button class="batch-qty-adjust" bindtap="adjustBatchReceiveQty" data-index="{{index}}" data-delta="1" disabled="{{batchReceiveSaving || batchRetryPending}}">+</button>
          </view>
        </view>
      </scroll-view>
      <view class="batch-receive-summary">本次入库 {{batchReceiveSkuCount}} 个 SKU，总计 {{batchReceiveTotal}} 件</view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeBatchReceiveModal" disabled="{{batchReceiveSaving}}">{{batchRetryPending ? '稍后确认' : '取消'}}</button>
        <button class="btn-confirm" bindtap="confirmBatchReceive" loading="{{batchReceiveSaving}}" disabled="{{batchReceiveSaving || !batchReceiveTotal}}">{{batchRetryPending ? '确认入库结果' : '确认入库'}}</button>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showDateModal}}">
    <view class="modal-mask" bindtap="closeDateModal"></view>
    <view class="modal-content listing-date-modal">
      <view class="modal-title">选择上架时间范围</view>
      <view class="quick-options">
        <view class="quick-option {{editingDateRange.quickSelect === '1day' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="1day">最近 1 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === '7days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="7days">最近 7 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === '30days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="30days">最近 30 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === 'month' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="month">本月</view>
      </view>
      <view class="custom-section">
        <view class="custom-title">自定义时间</view>
        <picker mode="date" value="{{editingDateRange.startDate}}" end="{{editingDateRange.endDate || today}}" bindchange="onStartDateChange">
          <view class="date-picker-input">开始日期：{{editingDateRange.startDate || '选择'}}</view>
        </picker>
        <picker mode="date" value="{{editingDateRange.endDate}}" start="{{editingDateRange.startDate}}" end="{{today}}" bindchange="onEndDateChange">
          <view class="date-picker-input">结束日期：{{editingDateRange.endDate || '选择'}}</view>
        </picker>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeDateModal">取消</button>
        <button class="btn-confirm" bindtap="confirmDateRange">确定</button>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showShippingModal}}">
    <view class="modal-mask" bindtap="closeShippingModal"></view>
    <view class="modal-content">
      <view class="modal-title">按现有库存发货</view>
      <scroll-view class="warehouse-body" scroll-y>
        <view class="operation-tip">默认选中全部可发规格。异常库存及其他任务占用的库存不参与发货，订单按下单时间从早到晚匹配。</view>
        <view wx:if="{{shippingLoading}}" class="muted">加载可发库存中...</view>
        <view wx:for="{{shippingProducts}}" wx:key="id" wx:for-item="product" wx:for-index="productIndex" class="record-card">
          <view class="product-name">{{product.name}}</view>
          <view wx:for="{{product.skus}}" wx:key="id" wx:for-item="sku" wx:for-index="skuIndex" class="shipping-sku">
            <view class="shipping-choice" data-product-index="{{productIndex}}" data-sku-index="{{skuIndex}}" bindtap="toggleShippingSku">
              <checkbox checked="{{sku.selected}}" disabled="{{matching}}" /><text>{{sku.spec}} {{sku.size}}</text>
            </view>
            <view class="muted">订单可发 {{sku.readyToShipQty}} 件</view>
            <input class="shipping-qty" type="number" value="{{sku.shipQty}}" data-product-index="{{productIndex}}" data-sku-index="{{skuIndex}}" bindinput="onShippingQtyInput" disabled="{{matching}}" />
          </view>
        </view>
        <view wx:if="{{!shippingProducts.length && !shippingLoading}}" class="empty-state">暂无可发库存</view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeShippingModal" disabled="{{matching}}">取消</button>
        <button class="btn-confirm" bindtap="goToStockShipping" loading="{{matching}}" disabled="{{matching || shippingLoading || !shippingProducts.length}}">去发货</button>
      </view>
    </view>
  </view>
</view>
