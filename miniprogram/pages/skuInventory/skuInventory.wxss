@import "../../styles/adminProductArticleNo.wxss";
/* 仓库库存：实物、报单欠货和异常分别展示。 */
page { background: #f6f7f9; }
.container { width: 100%; min-width: 0; align-items: stretch; padding: 0 16rpx 48rpx; box-sizing: border-box; }
/* 筛选、搜索和库存操作一起吸顶，内容高度变化时自动为列表留出位置。 */
.inventory-toolbar { position: sticky; top: 0; z-index: 100; flex-shrink: 0; padding-top: 16rpx; background: #f6f7f9; }
.filter-bar { background: #fff; border-radius: 12rpx; padding: 16rpx; margin-bottom: 14rpx; box-sizing: border-box; width: 100%; }
.filter-tabs { display: flex; gap: 10rpx; margin-bottom: 14rpx; }
.inventory-tab { flex: 1; height: 56rpx; line-height: 56rpx; text-align: center; font-size: 24rpx; color: #666; background: #f2f4f7; border-radius: 10rpx; box-sizing: border-box; }
.inventory-tab.active { background: #1f2933; color: #fff; font-weight: 600; }
.relation-filter-section { margin-bottom: 14rpx; }
.relation-filter-row { display: flex; align-items: center; min-height: 64rpx; }
.relation-filter-label { width: 64rpx; flex-shrink: 0; color: #333; font-size: 24rpx; font-weight: 600; }
.relation-filter-fixed { flex-shrink: 0; margin-right: 12rpx; }
.relation-filter-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.relation-filter-options { display: inline-flex; align-items: center; gap: 12rpx; padding: 6rpx 2rpx; }
.relation-filter-tag { flex-shrink: 0; padding: 10rpx 24rpx; background: #f2f4f7; color: #666; font-size: 24rpx; line-height: 32rpx; border-radius: 12rpx; }
.relation-filter-tag.active { background: #f2f4f7; color: #1f2933; font-weight: 800; box-shadow: inset 0 -4rpx 0 #1f2933; }
.search-bar { display: flex; gap: 10rpx; }
.search-input { flex: 1; min-width: 0; height: 58rpx; background: #f6f7f9; border-radius: 10rpx; padding: 0 18rpx; font-size: 24rpx; box-sizing: border-box; }
.search-bar > .search-btn { width: 112rpx; min-width: 0; flex: 0 0 112rpx; height: 58rpx; line-height: 58rpx; margin: 0; background: #1f2933; color: #fff; font-size: 24rpx; border-radius: 10rpx; padding: 0; box-sizing: border-box; }
.search-btn::after, .stock-shipping-btn::after { border: none; }
.inventory-action-bar { width: 100%; min-width: 0; box-sizing: border-box; display: flex; align-items: center; gap: 16rpx; padding: 14rpx 16rpx; margin-bottom: 14rpx; border-radius: 12rpx; background: #fff; }
.select-all { display: flex; align-items: center; gap: 10rpx; font-size: 24rpx; color: #1f2933; flex-shrink: 0; }
.inventory-checkbox { width: 34rpx; height: 34rpx; border: 2rpx solid #cbd2dc; border-radius: 6rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; flex-shrink: 0; color: #fff; font-size: 24rpx; }
.inventory-checkbox.checked { background: #1f2933; border-color: #1f2933; }
.inventory-checkbox.disabled { opacity: .4; }
.inventory-action-buttons { display: flex; flex-direction: column; gap: 12rpx; flex: 0 0 200rpx; width: 200rpx; height: 128rpx; }
.inventory-action-buttons > .batch-receive-btn, .inventory-action-buttons > .stock-shipping-btn { flex: 0 0 58rpx; width: 100%; min-width: 0; box-sizing: border-box; height: 58rpx; line-height: 58rpx; padding: 0; color: #fff; font-size: 24rpx; border-radius: 10rpx; margin: 0; white-space: nowrap; }
.batch-receive-btn { background: #1f2933; }
.batch-receive-btn[disabled] { color: #a1a8b3; background: #f2f4f7; }
.batch-receive-btn::after, .batch-qty-adjust::after { border: none; }
.stock-shipping-btn { background: #1f2933; }
/* 汇总占用按钮左侧的固定空位，数据显隐和文字换行都不改变工具栏高度。 */
.selection-summary { flex: 1; width: 0; min-width: 0; height: 128rpx; display: flex; flex-direction: column; color: #667085; font-size: 22rpx; line-height: 32rpx; }
.selection-summary-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.selection-summary-content { min-height: 100%; display: flex; align-items: center; word-break: normal; overflow-wrap: anywhere; }
.selection-summary-content.is-empty { visibility: hidden; }
.selection-summary-tip { flex: 0 0 32rpx; margin-top: 8rpx; white-space: nowrap; }
.product-select { flex: 0 0 58rpx; align-self: stretch; display: flex; align-items: flex-start; justify-content: center; padding: 30rpx 0 24rpx; box-sizing: border-box; }
.product-item.selected { background: #f5f7fa; }
.product-list { background: #fff; border-radius: 16rpx; overflow: hidden; }
.product-item { display: flex; padding: 0 12rpx 0 0; border-bottom: 1rpx solid #eee; gap: 12rpx; align-items: flex-start; }
.product-media { flex: 0 0 120rpx; width: 120rpx; min-width: 0; max-width: 120rpx; padding: 24rpx 0; box-sizing: border-box; }
.product-image { width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; background: #f5f5f5; }
.product-media > .sku-expand-btn { width: 120rpx; min-width: 0; height: 52rpx; line-height: 52rpx; margin: 14rpx 0 0; padding: 0; border-radius: 8rpx; background: #f2f4f7; color: #344054; font-size: 22rpx; box-sizing: border-box; }
.sku-expand-btn::after { border: none; }
.sku-expand-btn:active { background: #e4e7ec; }
.product-info { flex: 1; min-width: 0; padding: 24rpx 0; }
.product-name { font-size: 28rpx; font-weight: bold; color: #222; overflow-wrap: anywhere; }
.sku-summary { margin-top: 16rpx; background: #f7f7f7; border-radius: 10rpx; padding: 12rpx; }
.sku-title { font-size: 30rpx; font-weight: 600; color: #444; }
.quantity-line { display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; font-size: 24rpx; margin: 10rpx 0; }
.shortage-text { color: #be6a00; }
.abnormal-text { color: #c53929; }
.muted, .no-sku { color: #777; font-size: 22rpx; line-height: 1.6; }
.product-action { flex-shrink: 0; margin-top: 24rpx; display: flex; align-items: center; }
.edit-icon { font-size: 32rpx; width: 32rpx; height: 32rpx; line-height: 32rpx; flex-shrink: 0; padding: 0; margin: 0; }
.edit-icon:active { opacity: .7; transform: scale(.9); }
.empty-state, .loading-state { padding: 72rpx 0; color: #999; font-size: 26rpx; text-align: center; }
.modal { position: fixed; inset: 0; z-index: 1000; }
.modal-mask { position: absolute; inset: 0; background: rgba(0,0,0,.5); }
.modal-content { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 700rpx; max-height: 86vh; background: #fff; border-radius: 16rpx; overflow: hidden; display: flex; flex-direction: column; }
.modal-title { padding: 26rpx; font-size: 30rpx; font-weight: bold; text-align: center; border-bottom: 1rpx solid #eee; }
.warehouse-body { height: 65vh; padding: 24rpx; box-sizing: border-box; }
.operation-tip { font-size: 23rpx; color: #666; line-height: 1.7; background: #f7f7f7; padding: 16rpx; border-radius: 10rpx; }
.record-card { padding: 20rpx 0; font-size: 25rpx; border-bottom: 1rpx solid #eee; }
.shipping-sku { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; padding: 16rpx 0; }
.shipping-choice { display: flex; align-items: center; flex: 1; min-width: 200rpx; }
.shipping-qty { width: 96rpx; height: 60rpx; background: #f5f5f5; border-radius: 8rpx; text-align: center; }
.modal-footer { display: flex; border-top: 1rpx solid #eee; flex-shrink: 0; }
.btn-cancel, .btn-confirm { flex: 1; height: 88rpx; line-height: 88rpx; font-size: 28rpx; border-radius: 0; padding: 0; border: none; }
.btn-cancel { background: #f5f5f5; color: #555; }
.btn-confirm { background: #111; color: #fff; }
.batch-receive-modal { max-height: 82vh; }
.batch-source-tabs { display: flex; gap: 10rpx; padding: 18rpx 20rpx 0; flex-shrink: 0; }
.batch-receive-tip, .batch-pending-tip { padding: 12rpx 20rpx; color: #7b8490; font-size: 22rpx; line-height: 1.6; flex-shrink: 0; }
.batch-pending-tip { color: #b96500; background: #fff8eb; }
.batch-receive-list { height: 48vh; min-height: 0; padding: 0 16rpx; box-sizing: border-box; }
.batch-receive-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f0f0f0; gap: 14rpx; }
.batch-receive-row:last-child { border-bottom: none; }
.batch-item-image { width: 80rpx; height: 80rpx; border-radius: 8rpx; background: #f5f5f5; flex-shrink: 0; }
.batch-item-info { flex: 1; min-width: 0; }
.batch-item-name { color: #1f2933; font-size: 24rpx; font-weight: 600; line-height: 32rpx; word-break: break-all; }
.batch-item-sku { color: #7b8490; font-size: 22rpx; line-height: 30rpx; word-break: break-all; }
.batch-qty-editor { display: flex; align-items: center; gap: 8rpx; width: 204rpx; flex: 0 0 204rpx; }
.batch-qty-adjust { width: 48rpx; min-width: 48rpx; flex: 0 0 48rpx; height: 44rpx; line-height: 40rpx; margin: 0; padding: 0; border: 1rpx solid #d9dee7; border-radius: 6rpx; background: #f7f8fa; color: #344054; font-size: 28rpx; box-sizing: border-box; }
.batch-qty-input { width: 92rpx; min-width: 92rpx; flex: 0 0 92rpx; height: 44rpx; padding: 0 8rpx; border: 1rpx solid #b8c4d3; border-radius: 6rpx; color: #1677c8; font-size: 24rpx; font-weight: 700; text-align: center; box-sizing: border-box; }
.batch-receive-summary { padding: 16rpx 24rpx; background: #f9f9f9; color: #666; font-size: 24rpx; border-top: 1rpx solid #f0f0f0; flex-shrink: 0; }

/* 上架日期选择沿用订单管理页的交互。 */
.date-filter { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.date-picker { flex: 1; min-height: 64rpx; background: #f2f4f7; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #666; }
.clear-date { width: 40rpx; height: 40rpx; background: #f2f4f7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #666; }
.listing-date-modal .quick-options { display: flex; padding: 16rpx; gap: 12rpx; }
.listing-date-modal .quick-option { flex: 1; padding: 16rpx 0; text-align: center; background: #f2f4f7; border-radius: 8rpx; font-size: 24rpx; color: #666; }
.listing-date-modal .quick-option.selected { background: #1f2933; color: #fff; }
.listing-date-modal .custom-section { padding: 16rpx 24rpx; }
.listing-date-modal .custom-title { font-size: 26rpx; color: #333; margin-bottom: 16rpx; }
.listing-date-modal .date-picker-input { min-height: 64rpx; background: #f2f4f7; border-radius: 8rpx; padding: 0 24rpx; display: flex; align-items: center; font-size: 26rpx; color: #333; margin-bottom: 12rpx; }

/* 卡片数量：图片下方只显示总控加减，每个规格单独显示数量。 */
.card-total-editor { display: flex; justify-content: space-between; margin-top: 12rpx; }
.sku-heading { display: flex; align-items: center; justify-content: space-between; min-height: 56rpx; gap: 12rpx; }
.sku-heading .sku-title { flex: 1; min-width: 0; min-height: 56rpx; line-height: 40rpx; display: flex; align-items: center; overflow-wrap: anywhere; }
.card-sku-editor { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; height: 56rpx; }
.card-total-editor > .card-qty-adjust, .card-sku-editor > .card-qty-adjust { flex: 0 0 44rpx; width: 44rpx; min-width: 44rpx; max-width: 44rpx; height: 44rpx; line-height: 40rpx; padding: 0; margin: 0; border: 1rpx solid #d9dee7; border-radius: 6rpx; background: #fff; color: #344054; font-size: 28rpx; box-sizing: border-box; }
.card-sku-editor > .card-qty-adjust { flex: 0 0 56rpx; width: 56rpx; min-width: 56rpx; max-width: 56rpx; height: 56rpx; line-height: 52rpx; font-size: 34rpx; }
.card-qty-adjust::after { border: none; }
.card-qty-adjust[disabled] { color: #a1a8b3; background: #f2f4f7; }
.card-qty-input { flex: 0 0 80rpx; width: 80rpx; min-width: 80rpx; max-width: 80rpx; height: 56rpx; line-height: 56rpx; padding: 0 4rpx; border: 1rpx solid #b8c4d3; border-radius: 6rpx; color: #1677c8; font-size: 28rpx; text-align: center; box-sizing: border-box; }

.operation-pending { padding: 20rpx; margin: 16rpx; background: #fff2d6; color: #875d16; border-radius: 12rpx; font-size: 24rpx; line-height: 1.6; }
