/* 仓库库存：实物、报单欠货和异常分别展示。 */
.container { padding: 24rpx; padding-bottom: 48rpx; }
.inventory-tabs { display: flex; margin-bottom: 24rpx; border-bottom: 1rpx solid #eee; }
.inventory-tab { flex: 1; text-align: center; padding: 22rpx 0; font-size: 28rpx; color: #666; border-bottom: 4rpx solid transparent; }
.inventory-tab.active { color: #000; font-weight: bold; border-bottom-color: #000; }
.search-bar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.search-input { flex: 1; min-width: 0; height: 72rpx; background: #f5f5f5; border-radius: 36rpx; padding: 0 24rpx; font-size: 28rpx; }
.search-btn { width: 120rpx; height: 72rpx; line-height: 72rpx; background: #000; color: #fff; font-size: 26rpx; border-radius: 36rpx; padding: 0; }
.stock-shipping-btn { background: #111; color: #fff; font-size: 28rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
.product-list { background: #fff; border-radius: 16rpx; overflow: hidden; }
.product-item { display: flex; padding: 24rpx 12rpx; border-bottom: 1rpx solid #eee; gap: 18rpx; align-items: flex-start; }
.product-image { width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; background: #f5f5f5; }
.product-info { flex: 1; min-width: 0; }
.product-name { font-size: 28rpx; font-weight: bold; color: #222; overflow-wrap: anywhere; }
.sku-summary { margin-top: 16rpx; background: #f7f7f7; border-radius: 10rpx; padding: 12rpx; }
.sku-title { font-size: 24rpx; color: #444; }
.quantity-line { display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; font-size: 24rpx; margin: 10rpx 0; }
.shortage-text { color: #be6a00; }
.abnormal-text { color: #c53929; }
.muted, .no-sku { color: #777; font-size: 22rpx; line-height: 1.6; }
.product-action { display: flex; align-items: center; }
.edit-icon { font-size: 32rpx; margin-left: 20rpx; flex-shrink: 0; cursor: pointer; padding: 10rpx; }
.edit-icon:active { opacity: .7; transform: scale(.9); }
.empty-state, .loading-state { padding: 72rpx 0; color: #999; font-size: 26rpx; text-align: center; }
.modal { position: fixed; inset: 0; z-index: 1000; }
.modal-mask { position: absolute; inset: 0; background: rgba(0,0,0,.5); }
.modal-content { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 700rpx; max-height: 86vh; background: #fff; border-radius: 16rpx; overflow: hidden; display: flex; flex-direction: column; }
.modal-title { padding: 26rpx; font-size: 30rpx; font-weight: bold; text-align: center; border-bottom: 1rpx solid #eee; }
.warehouse-body { height: 65vh; padding: 24rpx; box-sizing: border-box; }
.sku-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0; }
.sku-option { padding: 12rpx 18rpx; border: 2rpx solid #eee; border-radius: 24rpx; font-size: 24rpx; color: #555; }
.sku-option.active { border-color: #111; color: #111; background: #f5f5f5; }
.inventory-summary { display: flex; flex-wrap: wrap; gap: 16rpx; font-size: 26rpx; padding: 18rpx 0; }
.tabs { display: flex; border-bottom: 1rpx solid #eee; margin: 18rpx 0; }
.tab-item { flex: 1; text-align: center; padding: 20rpx 4rpx; font-size: 25rpx; color: #666; border-bottom: 4rpx solid transparent; }
.tab-item.active { color: #000; border-bottom-color: #000; font-weight: bold; }
.operate-form { display: flex; flex-direction: column; gap: 20rpx; padding-bottom: 24rpx; }
.radio-group { display: flex; gap: 12rpx; }
.radio-item { flex: 1; padding: 18rpx 4rpx; background: #f5f5f5; color: #555; text-align: center; border-radius: 28rpx; font-size: 24rpx; }
.radio-item.active { background: #111; color: #fff; }
.operation-tip { font-size: 23rpx; color: #666; line-height: 1.7; background: #f7f7f7; padding: 16rpx; border-radius: 10rpx; }
.form-item { display: flex; flex-direction: column; gap: 12rpx; }
.form-label { font-size: 26rpx; color: #333; }
.form-input { height: 72rpx; background: #f5f5f5; border-radius: 20rpx; padding: 0 24rpx; font-size: 26rpx; }
.record-card { padding: 20rpx 0; font-size: 25rpx; border-bottom: 1rpx solid #eee; }
.record-card.revoked { opacity: .5; }
.record-section-title { font-size: 26rpx; font-weight: bold; margin: 22rpx 0 8rpx; }
.allocation-line { font-size: 22rpx; color: #555; padding: 8rpx 0; overflow-wrap: anywhere; }
.receipt-revoke { margin: 12rpx 0 0; font-size: 22rpx; color: #bb352b; background: #fff4f2; }
.shipping-sku { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; padding: 16rpx 0; }
.shipping-choice { display: flex; align-items: center; flex: 1; min-width: 200rpx; }
.shipping-qty { width: 96rpx; height: 60rpx; background: #f5f5f5; border-radius: 8rpx; text-align: center; }
.modal-footer { display: flex; border-top: 1rpx solid #eee; flex-shrink: 0; }
.btn-cancel, .btn-confirm { flex: 1; height: 88rpx; line-height: 88rpx; font-size: 28rpx; border-radius: 0; padding: 0; border: none; }
.btn-cancel { background: #f5f5f5; color: #555; }
.btn-confirm { background: #111; color: #fff; }
