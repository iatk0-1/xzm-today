/* miniprogram/pages/skuInventory/skuInventory.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #000;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0;
}

/* 商品列表 */
.product-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.product-item {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.product-skus {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.no-sku {
  font-size: 24rpx;
  color: #999;
}

.sku-tag {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.sku-qty {
  font-weight: bold;
}

.sku-qty.out {
  color: #f44336;
}

.sku-qty.low {
  color: #ff9800;
}

.sku-qty.normal {
  color: #4caf50;
}

.product-action {
  display: flex;
  align-items: center;
}

.btn-operate {
  width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: #000;
  color: #fff;
  font-size: 24rpx;
  border-radius: 28rpx;
  padding: 0;
  border: none;
}

/* 空状态和加载状态 */
.empty-state, .loading-state {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 700rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-title {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-body {
  padding: 30rpx;
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* SKU 选择器 */
.sku-selector {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.selector-label {
  font-size: 26rpx;
  color: #666;
}

.sku-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  max-height: 200rpx;
  overflow-y: auto;
}

.sku-option {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sku-option.active {
  background: #e6f7ff;
  color: #1890ff;
  border-color: #1890ff;
}

.sku-qty-badge {
  font-size: 20rpx;
  color: #999;
  background: #fff;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

/* SKU 信息 */
.sku-info {
  display: flex;
  gap: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sku-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.sku-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sku-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.sku-spec {
  font-size: 24rpx;
  color: #666;
}

.sku-current-qty {
  font-size: 24rpx;
  color: #999;
  margin-top: auto;
}

.qty-value {
  font-weight: bold;
  font-size: 28rpx;
}

.qty-value.out {
  color: #f44336;
}

.qty-value.low {
  color: #ff9800;
}

.qty-value.normal {
  color: #4caf50;
}

/* 选项卡 */
.tabs {
  display: flex;
  gap: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  padding: 16rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: #000;
  font-weight: bold;
  border-bottom-color: #000;
}

/* 录入记录列表 */
.ledger-list {
  flex: 1;
  overflow-y: auto;
}

.ledger-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.ledger-item.revoked {
  opacity: 0.6;
  background: #f9f9f9;
}

.ledger-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
  gap: 12rpx;
}

.ledger-type {
  font-size: 28rpx;
  font-weight: bold;
}

.ledger-type.positive {
  color: #4caf50;
}

.ledger-type.negative {
  color: #f44336;
}

.ledger-time {
  font-size: 22rpx;
  color: #ccc;
}

.ledger-status {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.ledger-body {
  margin-bottom: 10rpx;
}

.ledger-reason {
  font-size: 26rpx;
  color: #333;
  display: block;
}

.ledger-note {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 5rpx;
}

.ledger-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

.btn-revoke {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 100rpx;
  height: 50rpx;
  line-height: 50rpx;
  background: #fff;
  color: #f44336;
  font-size: 22rpx;
  border-radius: 25rpx;
  padding: 0;
  border: 1rpx solid #f44336;
}

/* 操作表单 */
.operate-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
}

.radio-group {
  display: flex;
  gap: 20rpx;
}

.radio-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #666;
}

.radio-item.active {
  background: #000;
  color: #fff;
}

.form-input {
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

/* 弹窗底部按钮 */
.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 0;
  padding: 0;
  border: none;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.btn-confirm {
  background: #000;
  color: #fff;
}
