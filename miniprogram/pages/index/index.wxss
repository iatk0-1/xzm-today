/* ==================
   全局基础设定
================== */
page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 统一的按钮点击轻微缩放动画 */
.btn-hover, .nav-cart-right:active, .tab-item:active {
  opacity: 0.7;
  transform: scale(0.98);
  transition: all 0.2s ease;
}

/* ==================
   大厂级自定义导航栏
================== */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px); /* 磨砂玻璃效果 */
  z-index: 1000;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}

.nav-top-row {
  display: flex;
  align-items: center;
  padding-left: 30rpx;
  /* 右侧留出绝对死区，绝不覆盖微信官方的胶囊按钮 */
  padding-right: 190rpx; 
}

.nav-top-row .logo {
  font-size: 34rpx;
  font-weight: 800;
  margin-right: 30rpx;
  white-space: nowrap;
}

.search-box {
  flex: 1;
  height: 100%;
  background-color: #f5f5f5;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  color: #999;
  font-size: 26rpx;
}

.search-placeholder {
  margin-left: 10rpx;
}

/* ==================
   第二行：小红书高级排版
================== */
.nav-bottom-row {
  display: flex;
  justify-content: space-between; 
  align-items: center;
  padding: 10rpx 40rpx 20rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.nav-tabs-left {
  display: flex;
  align-items: center;
  gap: 40rpx; 
}

.nav-tabs-left .tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 未选中状态 */
.nav-tabs-left .tab-item text {
  /* 🚀 核心修复：锁死字号和行高，不要让 active 状态改变大小 */
  font-size: 32rpx; 
  line-height: 44rpx; 
  color: #999;
  transition: color 0.2s ease;
}

/* 选中状态：大字重磅 */
.nav-tabs-left .tab-item.active text {
  font-weight: bold;
  color: #1a1a1a;
  /* 绝对不要在这里写 font-size: xxxrpx */
}

/* 底部动效小黑条 */
.nav-tabs-left .tab-item .line {
  width: 32rpx;
  height: 6rpx;
  background-color: #1a1a1a;
  border-radius: 4rpx;
  margin-top: 6rpx;
  transform: scaleX(0); /* 默认缩小消失 */
  opacity: 0;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.nav-tabs-left .tab-item.active .line {
  transform: scaleX(1); /* 选中时弹出 */
  opacity: 1;
}

/* 购物车胶囊 */
.nav-cart-right {
  font-size: 24rpx;
  color: #333;
  background-color: #f5f5f5;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-weight: bold;
  white-space: nowrap;
  transition: all 0.2s;
}

/* ==================
   档口下拉面板 (Stall Panel)
================== */
.stall-mask {
  position: fixed;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(0, 0, 0, 0.4);
  z-index: 998; /* 在导航栏下方一层 */
  opacity: 0;
  pointer-events: none;
}

.stall-mask.fade-in {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.3s ease;
}

.stall-panel {
  position: fixed;
  left: 0;
  width: 100%;
  background: #ffffff;
  z-index: 999;
  padding: 30rpx 40rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx; /* 下部圆角 */
  box-sizing: border-box;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.05);
  transform: translateY(-100%); /* 默认收起 */
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.stall-panel.slide-down {
  transform: translateY(0); /* 滑下 */
}

.stall-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stall-tag {
  padding: 16rpx 36rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 100rpx;
  transition: all 0.2s;
}

.stall-tag.active {
  background-color: #1a1a1a;
  color: #ffffff;
  font-weight: bold;
}

/* ==================
   瀑布流商品卡片
================== */
.waterfall-container {
  column-count: 2; /* CSS3 多列布局实现瀑布流 */
  column-gap: 20rpx;
  padding: 20rpx 20rpx 0 20rpx;
  box-sizing: border-box;
  width: 100%;
}

.product-item {
  break-inside: avoid; /* 防止卡片被硬生生切成两截 */
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.product-img {
  width: 100%;
  display: block;
}

.product-info {
  padding: 20rpx;
}

.product-title {
  font-size: 26rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a1a;
}

.btn-add-cart {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-cart-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.8;
}

/* ==================
   底部 TabBar
================== */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  z-index: 100;
  border-top: 1rpx solid rgba(0,0,0,0.04);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

.bottom-tab-bar .active {
  color: #1a1a1a;
  font-weight: 800;
}

.admin-portal { flex: 1; }

.red-plus-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: #1a1a1a; 
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 300;
  transform: translateY(-16rpx); /* 向上凸起一点 */
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}

/* ==================
   底部 SKU (选规格) 弹窗
================== */
.sku-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
}

.sku-mask.fade-in {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.3s ease;
}

.sku-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  padding: 40rpx;
  box-sizing: border-box;
  transform: translateY(100%);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.sku-panel.slide-up {
  transform: translateY(0);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.sku-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 46rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sku-header {
  display: flex;
  margin-bottom: 40rpx;
}

.sku-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 30rpx;
  background-color: #f5f5f5;
  border: 1rpx solid #eee;
}

.sku-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sku-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.sku-stock {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.out-of-stock {
  color: #d32f2f; /* 没货标红 */
}

.sku-choose-tip {
  font-size: 24rpx;
  color: #333;
  background-color: #f8f8f8;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  display: inline-block;
  align-self: flex-start;
}

.sku-scroll-area {
  max-height: 55vh;
  margin-bottom: 30rpx;
}

.sku-title {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.sku-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.sku-tag {
  padding: 12rpx 36rpx;
  background-color: #f5f5f5;
  color: #333;
  border-radius: 100rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.sku-tag.active {
  background-color: #1a1a1a; /* 选中纯黑 */
  color: #ffffff;
  font-weight: 600;
}

.sku-btn-confirm {
  width: 100%;
  height: 90rpx;
  background-color: #1a1a1a;
  color: #ffffff;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.15);
}

.sku-btn-confirm.disabled {
  background-color: #e0e0e0 !important;
  color: #999 !important;
  box-shadow: none;
}

/* ==================
   新增：SKU 面板双按钮样式
================== */
.sku-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx; /* 两个按钮中间的间隙 */
  width: 100%;
}

.sku-btn-cart {
  flex: 1;
  height: 90rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  background-color: #f5f5f5; /* 浅灰底色，代表次要操作 */
  color: #1a1a1a;
  transition: all 0.2s;
}

.sku-btn-buy {
  flex: 1;
  height: 90rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  background-color: #1a1a1a; /* 纯黑底色，吸引视觉焦点促单 */
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s;
}

.sku-btn-cart:active, .sku-btn-buy:active {
  transform: scale(0.96);
  opacity: 0.9;
}

