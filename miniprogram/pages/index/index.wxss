/* ==================
   全局基础设定
================== */
page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 统一的按钮点击轻微缩放动画 */
.btn-hover, .nav-cart-right:active, .tab-item:active {
  opacity: 0.7;
  transform: scale(0.98);
  transition: all 0.2s ease;
}

/* ==================
   大厂级自定义导航栏
================== */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px); /* 磨砂玻璃效果 */
  z-index: 1000;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}

.nav-top-row {
  display: flex;
  align-items: center;
  padding-left: 30rpx;
  /* 右侧留出绝对死区，绝不覆盖微信官方的胶囊按钮 */
  padding-right: 190rpx; 
}

.nav-top-row .logo {
  font-size: 34rpx;
  font-weight: 800;
  margin-right: 30rpx;
  white-space: nowrap;
}

.search-box {
  flex: 1;
  height: 100%;
  background-color: #f5f5f5;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  color: #999;
  font-size: 26rpx;
}

.search-placeholder {
  margin-left: 10rpx;
}

/* ==================
   第二行：小红书高级排版
================== */
.nav-bottom-row {
  display: flex;
  justify-content: space-between; 
  align-items: center;
  padding: 10rpx 40rpx 10rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.nav-tabs-left {
  display: flex;
  align-items: center;
  gap: 40rpx; 
}

.nav-tabs-left .tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 未选中状态 */
.nav-tabs-left .tab-item text {
  /* 🚀 核心修复：锁死字号和行高，不要让 active 状态改变大小 */
  font-size: 32rpx; 
  line-height: 44rpx; 
  color: #999;
  transition: color 0.2s ease;
}

/* 选中状态：大字重磅 */
.nav-tabs-left .tab-item.active text {
  font-weight: bold;
  color: #1a1a1a;
  /* 绝对不要在这里写 font-size: xxxrpx */
}

/* 底部动效小黑条 */
.nav-tabs-left .tab-item .line {
  width: 40rpx;
  height: 1rpx;
  background-color: #1a1a1a;
  border-radius: 4rpx;
  margin-top: 0rpx;
  transform: scaleX(0); /* 默认缩小消失 */
  opacity: 0;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.nav-tabs-left .tab-item.active .line {
  transform: scaleX(1); /* 选中时弹出 */
  opacity: 1;
}

/* 购物车胶囊 */
.nav-cart-right {
  font-size: 24rpx;
  color: #333;
  background-color: #f5f5f5;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-weight: bold;
  white-space: nowrap;
  transition: all 0.2s;
}

/* 直播入口 */
.nav-live-entry {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-weight: bold;
  white-space: nowrap;
  margin-right: 16rpx;
  transition: all 0.2s;
}

/* ==================
   左固定右滑动导航栏 & 高级展开面板
================== */
.sub-nav-bar {
  position: fixed;
  left: 0;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  z-index: 998; 
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
  display: flex;
  align-items: center;
  height: 88rpx; /* 固定高度，非常关键 */
}

/* 左侧全部开关 */
.btn-all-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx 0 30rpx;
  height: 100%;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex-shrink: 0;
}

.icon-menu {
  font-size: 32rpx;
  margin-left: 8rpx;
  font-weight: 300;
  color: #666;
}

/* 高级分割线 */
.sub-nav-divider {
  width: 2rpx;
  height: 32rpx;
  background-color: #eee;
  flex-shrink: 0;
}

/* 右侧滑动区 */
.sub-nav-scroll {
  flex: 1;
  white-space: nowrap;
  height: 100%;
}

.sub-nav-container {
  display: inline-flex;
  align-items: center;
  padding: 0 20rpx;
  gap: 16rpx;
  height: 100%;
}

.sub-tag {
  padding: 10rpx 26rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 12rpx; 
  flex-shrink: 0;
  transition: all 0.2s;
}

.sub-tag.active {
  background-color: #f5f5f5; 
  color: #1a1a1a;
  font-weight: 800; 
}

.sub-tag-placeholder {
  width: 40rpx;
  flex-shrink: 0;
}

/* ================== 下拉展开面板样式 ================== */
.all-panel-mask {
  position: fixed;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(0, 0, 0, 0.4);
  z-index: 996;
  opacity: 0;
  pointer-events: none;
}

.all-panel-mask.fade-in {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.3s ease;
}

.all-panel-content {
  position: fixed;
  left: 0;
  width: 100%;
  background: #ffffff;
  z-index: 997;
  padding: 0 0 40rpx 0;
  box-sizing: border-box;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.05);
  transform: translateY(-100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.all-panel-content.slide-down {
  transform: translateY(0);
}

.panel-top-action {
  padding: 30rpx 40rpx 10rpx;
}

.panel-scroll-area {
  max-height: 55vh;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.group-section {
  margin-bottom: 30rpx;
}

.group-title {
  font-size: 24rpx;
  color: #999;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.all-panel-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.all-panel-tag {
  padding: 16rpx 36rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.all-panel-tag.active {
  background-color: #747373;
  color: #ffffff;
  font-weight: bold;
}

/* 当有子导航时，给瀑布流增加顶部间距，避免商品被挡住 */
.waterfall-container.has-sub-nav {
  padding-top: 100rpx; 
}

/* ==================
   瀑布流商品卡片 - 使用 Flexbox 实现正确的分页加载
================== */
.waterfall-container {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 20rpx 0 20rpx;
  box-sizing: border-box;
  width: 100%;
}

.waterfall-column {
  display: flex;
  flex-direction: column;
  width: calc(50% - 10rpx);  /* 两列，减去间隙 */
  padding-right: 10rpx;
  box-sizing: border-box;
}

.waterfall-column:last-child {
  padding-right: 0;
  padding-left: 10rpx;
}

.product-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.product-img {
  width: 100%;
  display: block;
}

.product-info {
  padding: 20rpx;
}

.product-title {
  font-size: 26rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a1a;
}

.btn-add-cart {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-cart-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.8;
}

/* ==================
   底部 TabBar
================== */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  z-index: 100;
  border-top: 1rpx solid rgba(0,0,0,0.04);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

.bottom-tab-bar .active {
  color: #1a1a1a;
  font-weight: 800;
}

.admin-portal { flex: 1; }

.red-plus-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: #1a1a1a; 
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 300;
  transform: translateY(-16rpx); /* 向上凸起一点 */
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}

/* ==================
   底部 SKU (选规格) 弹窗
================== */
.sku-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
}

.sku-mask.fade-in {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.3s ease;
}

.sku-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  padding: 40rpx;
  box-sizing: border-box;
  transform: translateY(100%);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.sku-panel.slide-up {
  transform: translateY(0);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.sku-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 46rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sku-header {
  display: flex;
  margin-bottom: 40rpx;
}

.sku-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 30rpx;
  background-color: #f5f5f5;
  border: 1rpx solid #eee;
}

.sku-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sku-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.sku-stock {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.out-of-stock {
  color: #d32f2f; /* 没货标红 */
}

.sku-choose-tip {
  font-size: 24rpx;
  color: #333;
  background-color: #f8f8f8;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  display: inline-block;
  align-self: flex-start;
}

.sku-scroll-area {
  max-height: 55vh;
  margin-bottom: 30rpx;
}

.sku-title {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.sku-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.sku-tag {
  padding: 12rpx 36rpx;
  background-color: #f5f5f5;
  color: #333;
  border-radius: 100rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.sku-tag.active {
  background-color: #1a1a1a; /* 选中纯黑 */
  color: #ffffff;
  font-weight: 600;
}

.sku-btn-confirm {
  width: 100%;
  height: 90rpx;
  background-color: #1a1a1a;
  color: #ffffff;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.15);
}

.sku-btn-confirm.disabled {
  background-color: #e0e0e0 !important;
  color: #999 !important;
  box-shadow: none;
}

/* 套装子项卡片 */
.bundle-group-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.bundle-group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.bg-step {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #f2f2f2;
  color: #999;
  font-size: 20rpx;
  font-weight: 600;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.bundle-group-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: block;
  letter-spacing: 1rpx;
}
.bundle-group-colors, .bundle-group-sizes {
  margin-bottom: 8rpx;
}
.bundle-group-selected {
  font-size: 22rpx;
  color: #666;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
  display: flex;
  align-items: center;
}
.bg-check {
  color: #07c160;
  font-weight: 700;
  margin-right: 6rpx;
}

/* ==================
   新增：SKU 面板双按钮样式
================== */
.sku-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx; /* 两个按钮中间的间隙 */
  width: 100%;
}

.sku-btn-cart {
  flex: 1;
  height: 90rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  background-color: #f5f5f5; /* 浅灰底色，代表次要操作 */
  color: #1a1a1a;
  transition: all 0.2s;
}

.sku-btn-buy {
  flex: 1;
  height: 90rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  background-color: #1a1a1a; /* 纯黑底色，吸引视觉焦点促单 */
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s;
}

.sku-btn-cart:active, .sku-btn-buy:active {
  transform: scale(0.96);
  opacity: 0.9;
}

