@import "../../styles/productSkuPanel.wxss";

/* ==================全局基础设定================== */
page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 统一的按钮点击轻微缩放动画 */
.btn-hover, .nav-cart-right:active, .tab-item:active {
  opacity: 0.7;
  transform: scale(0.98);
  transition: all 0.2s ease;
}

/* ==================
   大厂级自定义导航栏
================== */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px); /* 磨砂玻璃效果 */
  z-index: 1000;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}

.nav-top-row {
  display: flex;
  align-items: center;
  padding-left: 30rpx;
  /* 右侧留出绝对死区，绝不覆盖微信官方的胶囊按钮 */
  padding-right: 190rpx; 
}

.nav-top-row .logo {
  font-size: 34rpx;
  font-weight: 800;
  margin-right: 30rpx;
  white-space: nowrap;
}

.search-box {
  flex: 1;
  height: 100%;
  background-color: #f5f5f5;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  color: #999;
  font-size: 26rpx;
}

.search-placeholder {
  margin-left: 10rpx;
}

/* ==================
   第二行：小红书高级排版
================== */
.nav-bottom-row {
  display: flex;
  justify-content: space-between; 
  align-items: center;
  padding: 10rpx 40rpx 10rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.nav-tabs-left {
  display: flex;
  align-items: center;
  gap: 40rpx; 
}

.nav-tabs-left .tab-item {
  position: relative;
  flex: none;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  white-space: nowrap;
}

/* 未选中状态 */
.nav-tabs-left .tab-item text {
  /* 🚀 核心修复：锁死字号和行高，不要让 active 状态改变大小 */
  font-size: 32rpx; 
  line-height: 44rpx; 
  color: #999;
  transition: color 0.2s ease;
}

/* 选中状态：大字重磅 */
.nav-tabs-left .tab-item.active text {
  font-weight: bold;
  color: #1a1a1a;
  /* 绝对不要在这里写 font-size: xxxrpx */
}

/* 底部动效小黑条 */
.nav-tabs-left .tab-item .line {
  width: 40rpx;
  height: 1rpx;
  background-color: #1a1a1a;
  border-radius: 4rpx;
  margin-top: 0rpx;
  transform: scaleX(0); /* 默认缩小消失 */
  opacity: 0;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.nav-tabs-left .tab-item.active .line {
  transform: scaleX(1); /* 选中时弹出 */
  opacity: 1;
}

/* 购物车胶囊 */
.nav-cart-right {
  font-size: 24rpx;
  color: #333;
  background-color: #f5f5f5;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-weight: bold;
  white-space: nowrap;
  transition: all 0.2s;
}

/* 直播入口 */
.nav-live-entry {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-weight: bold;
  white-space: nowrap;
  margin-right: 16rpx;
  transition: all 0.2s;
}

/* ==================
   左固定右滑动导航栏 & 高级展开面板
================== */
.sub-nav-bar {
  position: fixed;
  left: 0;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  z-index: 998; 
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
  display: flex;
  align-items: center;
  height: 88rpx; /* 固定高度，非常关键 */
}

/* 左侧全部按钮 */
.btn-all-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 17rpx 0 30rpx;
  height: 100%;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.btn-all-switch.active {
  color: #1a1a1a;
  font-weight: 700;
}

.stall-menu-switch {
  width: 64rpx;
  height: 100%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stall-menu-arrow {
  width: 16rpx;
  height: 16rpx;
  box-sizing: border-box;
  border-right: 3rpx solid #666;
  border-bottom: 3rpx solid #666;
  transform: translate(-4rpx, -4rpx) rotate(45deg);
  transition: transform 0.2s ease;
}

.stall-menu-arrow.expanded {
  transform: translate(-4rpx, 4rpx) rotate(225deg);
}


/* 右侧滑动区 */
.sub-nav-scroll {
  flex: 1;
  width: 0;
  min-width: 0;
  white-space: nowrap;
  height: 100%;
}

.sub-nav-container {
  display: inline-flex;
  align-items: center;
  padding: 0 48rpx 0 7rpx;
  gap: 16rpx;
  height: 100%;
}

.sub-tag {
  padding: 10rpx;
  color: #666;
  font-size: 26rpx;
  flex-shrink: 0;
  transition: color 0.2s, background-color 0.2s;
}

.sub-tag.active {
  color: #1a1a1a;
  font-weight: 700;
}

.sub-tag-placeholder {
  width: 40rpx;
  flex-shrink: 0;
}

.list-loading {
  padding: 32rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

/* ================== 下拉展开面板样式 ================== */
.all-panel-mask {
  position: fixed;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(0, 0, 0, 0.4);
  z-index: 996;
  opacity: 0;
  pointer-events: none;
}

.all-panel-mask.fade-in {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.3s ease;
}

.all-panel-content {
  position: fixed;
  left: 0;
  width: 100%;
  background: #ffffff;
  z-index: 997;
  padding: 30rpx 0 40rpx;
  box-sizing: border-box;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.05);
  transform: translateY(-100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.all-panel-content.slide-down {
  transform: translateY(0);
}

.panel-top-action {
  padding: 30rpx 40rpx 10rpx;
}

.panel-scroll-area {
  max-height: 55vh;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.group-section {
  margin-bottom: 30rpx;
}

.group-title {
  font-size: 24rpx;
  color: #999;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.all-panel-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.all-panel-tag {
  padding: 10rpx 26rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  color: #666;
  font-size: 26rpx;
  transition: all 0.2s;
}

.all-panel-tag.active {
  background-color: #747373;
  color: #fff;
  font-weight: 700;
}

/* ==================
   瀑布流商品卡片 - 使用 Flexbox 实现正确的分页加载
================== */
/* 列表滚动区：高度由 js 按窗口尺寸算，上边距让开常驻档口筛选。 */
.list-scroll {
  width: 100%;
  box-sizing: border-box;
}

.waterfall-container {
  display: flex;
  flex-wrap: wrap;
  /* 底部留出固定底栏的高度，商品才不会被挡住 */
  padding: 20rpx 20rpx calc(120rpx + env(safe-area-inset-bottom)) 20rpx;
  box-sizing: border-box;
  width: 100%;
}

.waterfall-column {
  display: flex;
  flex-direction: column;
  /* 由 flex 平分可用宽度，避免列宽和内边距叠加后右侧留白 */
  flex: 1;
  min-width: 0;
  width: auto;
  padding-right: 0;
  box-sizing: border-box;
}

.waterfall-column:last-child {
  margin-left: 20rpx;
}

.product-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.product-img {
  width: 100%;
  display: block;
}

.product-image-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.sold-out-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(28, 28, 28, 0.58);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  pointer-events: none;
  z-index: 2;
}

.product-info {
  padding: 20rpx;
}

.product-title {
  font-size: 26rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a1a;
  white-space: nowrap;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
  gap: 4rpx 12rpx;
  margin-right: 8rpx;
}


.btn-add-cart {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-cart-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.8;
}

/* ==================   底部 TabBar================== */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  z-index: 100;
  border-top: 1rpx solid rgba(0,0,0,0.04);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}
.customer-service-tab {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
}
.customer-service-tab::after { display: none; }

.bottom-tab-bar .active {
  color: #1a1a1a;
  font-weight: 800;
}

.admin-portal { flex: 1; }

.red-plus-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: #1a1a1a; 
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 300;
  transform: translateY(-16rpx); /* 向上凸起一点 */
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}

/* ==================
   底部 SKU (选规格) 弹窗
================== */
/* 只在可滚动标签区域右端渐隐，不遮挡全部按钮和展开箭头。 */
.stall-scroll-frame {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 100%;
  overflow: hidden;
}

.stall-scroll-frame .sub-nav-scroll {
  width: 100%;
}

.stall-edge-fade {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 48rpx;
  z-index: 1;
  pointer-events: none;
}

.stall-edge-fade-right {
  right: 0;
  background: linear-gradient(
    to left,
    #fff 0%,
    #fff 6%,
    rgba(255, 255, 255, 0.96) 14%,
    rgba(255, 255, 255, 0.88) 24%,
    rgba(255, 255, 255, 0.76) 36%,
    rgba(255, 255, 255, 0.6) 48%,
    rgba(255, 255, 255, 0.42) 60%,
    rgba(255, 255, 255, 0.26) 71%,
    rgba(255, 255, 255, 0.13) 81%,
    rgba(255, 255, 255, 0.05) 90%,
    rgba(255, 255, 255, 0.015) 96%,
    rgba(255, 255, 255, 0) 100%
  );
}

.sub-nav-divider {
  width: 2rpx;
  height: 32rpx;
  background-color: #eee;
  flex-shrink: 0;
}

/* 按选中态预留文字空间，切换字号和字重时不挤动相邻标签。 */
.stall-label {
  position: relative;
  display: block;
  height: 40rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.stall-label-sizing {
  display: block;
  visibility: hidden;
  font-size: 27rpx;
  font-weight: 700;
  pointer-events: none;
}

/* 固定父级字号和40rpx高度，在view容器中心缩放，避免text基线影响定位。 */
.stall-label-text {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
  transform: scale(1);
  transform-origin: 50% 50%;
}

.btn-all-switch.active .stall-label-text,
.sub-tag.active .stall-label-text {
  /* 27 / 26，视觉大小等同于 27rpx，布局和基线仍按 26rpx 保持。 */
  transform: scale(1.0384615385);
}
