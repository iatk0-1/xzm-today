<page-meta page-style="{{showAllPanel || homeDragId || showHomeProductPicker ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="container" style="padding-top: {{totalNavHeight}}px;">

  <view class="custom-nav-bar" style="padding-top: {{navTop}}px;">

    <view class="nav-top-row" style="height: {{navHeight}}px;">
      <view class="logo">现在买</view>
      <view class="search-box" bindtap="goToSearch">
        <icon class="search-icon" type="search" size="14" color="#999"></icon>
        <text class="search-placeholder">搜索心仪款式 / 找同款</text>
      </view>
    </view>

    <view class="nav-bottom-row">
      <view class="nav-tabs-left">
        <view wx:for="{{mainTabs}}" wx:key="key" class="tab-item {{currentMainTab === item.label ? 'active' : ''}}" bindtap="handleMainTabChange" data-tab="{{item.label}}">
          <text>{{item.label}}</text>
          <view class="line"></view>
        </view>

        <!-- 功能暂时不开放：分类和直播标签暂时隐藏 -->
      </view>

    
      <view class="nav-actions">
        <view wx:if="{{canManageHome && currentMainTab === '首页'}}" class="nav-home-edit {{homeSaving || homeEditorLoading ? 'disabled' : ''}}" bindtap="toggleHomeEditor">{{homeEditorLoading ? '加载中' : homeEditing ? '取消' : '编辑'}}</view>
        <view class="nav-cart-right" wx:if="{{canCart}}" bindtap="goToCart"><text>购物车</text></view>
      </view>
    </view>
  </view>

  <!-- 档口筛选常驻：全部清除筛选，右侧菜单展开完整档口列表。 -->
  <view wx:if="{{currentMainTab !== '首页'}}" class="sub-nav-bar" style="top: {{totalNavHeight}}px;">
    
    <view class="btn-all-switch {{!selectedStall ? 'active' : ''}}" bindtap="selectStall" data-stall="all"><view class="stall-label"><text class="stall-label-sizing" aria-hidden="true">全部</text><view class="stall-label-text"><text>全部</text></view></view></view>
    

    <!-- 右侧滑动：纯净列表（不再有重复的全部） -->
    <view class="sub-nav-divider"></view>
    <view class="stall-scroll-frame">
      <scroll-view class="sub-nav-scroll" scroll-x="true" scroll-left="{{stallScrollLeft}}" scroll-with-animation>
        <view class="sub-nav-container">
          <view id="stall-{{item.id}}" class="sub-tag {{selectedStall == item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}" data-name="{{item.name}}"><view class="stall-label"><text class="stall-label-sizing" aria-hidden="true">{{item.name}}</text><view class="stall-label-text"><text>{{item.name}}</text></view></view></view>
        </view>
      </scroll-view>
      <view class="stall-edge-fade stall-edge-fade-right" aria-hidden="true"></view>
    </view>
    <view class="stall-menu-switch {{showAllPanel ? 'active' : ''}}" bindtap="toggleAllPanel" aria-label="{{showAllPanel ? '收起全部档口' : '展开全部档口'}}">
      <view class="stall-menu-arrow {{showAllPanel ? 'expanded' : ''}}"></view>
    </view>
  </view>

  <view wx:if="{{homeEditing}}" class="sub-nav-bar home-editor-toolbar {{homeSaving ? 'busy' : ''}}" style="top: {{totalNavHeight}}px;">
    <view class="home-toolbar-button" bindtap="selectAllHomeProducts">{{homeAllSelected ? '取消全选' : '全选'}}<text wx:if="{{homeSelectedCount}}">({{homeSelectedCount}})</text></view>
    <view class="home-toolbar-button" bindtap="openHomeProductPicker">新增商品</view>
    <view class="home-toolbar-button {{!homeSelectedCount ? 'disabled' : ''}}" bindtap="removeHomeProducts">移除商品</view>
    <view class="home-toolbar-button home-toolbar-save" bindtap="saveHomeProducts">{{homeSaving ? '保存中' : '保存'}}</view>
  </view>

  <!-- ================== 新增：展开时的高级大面板 (A-Z版) ================== -->
  <view class="all-panel-mask {{showAllPanel ? 'fade-in' : ''}}" wx:if="{{showAllPanel}}" catchtap="closeAllPanel" catchtouchmove="stopPanelTouchMove" style="top: {{totalNavHeight}}px; margin-top: 88rpx;"></view>
  
  <view class="all-panel-content {{showAllPanel ? 'slide-down' : ''}}" wx:if="{{showAllPanel}}" catchtouchmove="stopPanelTouchMove" style="top: {{totalNavHeight}}px; margin-top: 88rpx;">
    
    <!-- A-Z 分组面板只展示具体档口。 -->
      <scroll-view scroll-y class="panel-scroll-area" catchtouchmove="stopPanelTouchMove">
        <view class="group-section" wx:for="{{groupedStalls}}" wx:key="letter">
          <view class="group-title">{{item.letter}}</view> <!-- A, B, C... 标题 -->
          <view class="all-panel-grid">
            <view class="all-panel-tag {{selectedStall == stall.id ? 'active' : ''}}" wx:for="{{item.list}}" wx:for-item="stall" wx:key="id" bindtap="selectStall" data-stall="{{stall.id}}" data-name="{{stall.name}}">{{stall.name}}</view>
          </view>
        </view>
      </scroll-view>
  </view>

  <!-- 商品瀑布流：整块作为滚动容器，释放时触发下拉刷新（指示器落在导航栏下沿，不会被顶栏盖住） -->
  <scroll-view
    wx:if="{{!homeEditing}}"
    class="list-scroll"
    scroll-y="{{!showAllPanel}}"
    style="height: {{listHeight}}px; margin-top: {{listTop}}px;"
    refresher-enabled="{{!showAllPanel}}"
    refresher-triggered="{{refreshing}}"
    refresher-threshold="60"
    refresher-background="#f6f6f6"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onReachBottom"
    lower-threshold="50"
  >
    <view wx:if="{{loadError}}" style="padding:24rpx;color:#b42318;text-align:center" bindtap="retryProducts">{{loadError}} · 点击重试</view>
    <view class="list-loading" wx:if="{{loading && !productList.length}}">加载中...</view>
    <view class="home-empty" wx:if="{{currentMainTab === '首页' && !loading && !loadError && !productList.length}}">暂无首页商品<text wx:if="{{canManageHome}}">，点击右上方“编辑”添加</text></view>
    <view class="waterfall-container">
      <!-- 左列 -->
      <view class="waterfall-column">
        <view class="product-item" wx:for="{{leftColumn}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
          <view class="product-image-wrap">
            <image class="product-img" src="{{item.coverUrl || item.image}}" mode="widthFix" lazy-load="true"></image>
            <view class="product-card-tag product-card-promotion" wx:if="{{item.cardTags.length && item.cardTags[0].type !== 'READY_STOCK'}}"><text class="product-card-tag-label">{{item.cardTags[0].label}}</text></view>
            <view class="sold-out-overlay" wx:if="{{item.soldOut}}"><text>售罄</text></view>
          </view>
          <view class="product-info">
            <view class="product-title"><block wx:for="{{item.cardTags}}" wx:for-item="tag" wx:key="type"><view class="product-card-tag" wx:if="{{tag.type === 'READY_STOCK'}}"><text class="product-card-tag-label">{{tag.label}}</text></view></block><text>{{item.name || item.title}}</text></view>
            <view class="product-bottom">
              <view class="product-price-row">
                <view class="product-price">¥{{item.retailPrice || item.displayPrice}}</view>
              </view>
              <view class="btn-add-cart" catchtap="openSkuPanel" data-product="{{item}}">
                <image class="add-cart-icon" src="/images/add-cart.png" mode="aspectFit"></image>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 右列 -->
      <view class="waterfall-column">
        <view class="product-item" wx:for="{{rightColumn}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
          <view class="product-image-wrap">
            <image class="product-img" src="{{item.coverUrl || item.image}}" mode="widthFix" lazy-load="true"></image>
            <view class="product-card-tag product-card-promotion" wx:if="{{item.cardTags.length && item.cardTags[0].type !== 'READY_STOCK'}}"><text class="product-card-tag-label">{{item.cardTags[0].label}}</text></view>
            <view class="sold-out-overlay" wx:if="{{item.soldOut}}"><text>售罄</text></view>
          </view>
          <view class="product-info">
            <view class="product-title"><block wx:for="{{item.cardTags}}" wx:for-item="tag" wx:key="type"><view class="product-card-tag" wx:if="{{tag.type === 'READY_STOCK'}}"><text class="product-card-tag-label">{{tag.label}}</text></view></block><text>{{item.name || item.title}}</text></view>
            <view class="product-bottom">
              <view class="product-price-row">
                <view class="product-price">¥{{item.retailPrice || item.displayPrice}}</view>
              </view>
              <view class="btn-add-cart" catchtap="openSkuPanel" data-product="{{item}}">
                <image class="add-cart-icon" src="/images/add-cart.png" mode="aspectFit"></image>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <scroll-view wx:else class="list-scroll home-editor-scroll" scroll-y scroll-with-animation="{{false}}" scroll-top="{{homeEditorScrollTop}}" bindscroll="onHomeEditorScroll" style="height: {{listHeight}}px; margin-top: {{listTop}}px;">
    <view class="home-empty" wx:if="{{!homeProducts.length}}">暂无首页商品，点击“新增商品”挑选</view>
    <movable-area class="home-editor-area" style="height: {{homeEditorHeight}}px;">
      <movable-view wx:for="{{homeProducts}}" wx:key="id" x="{{0}}" y="{{item.y}}" direction="vertical" out-of-bounds="{{false}}" disabled="{{true}}" animation="{{homeDragId != item.id}}"
        class="home-editor-row {{homeDragId == item.id ? 'dragging' : ''}}" style="height: {{homeRowHeight}}px;"
        data-id="{{item.id}}" bindtap="toggleHomeProduct" bindtouchmove="moveHomeDrag" bindtouchend="endHomeDrag" bindtouchcancel="cancelHomeDrag">
        <view class="home-row-check {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <view class="home-row-drag-handle" data-id="{{item.id}}" catchlongpress="startHomeDrag" catchtouchmove="moveHomeDrag" bindtouchend="endHomeDrag" bindtouchcancel="cancelHomeDrag" catchtap="stopPanelTouchMove" aria-label="长按拖动排序">⋮⋮</view>
        <image class="home-row-image" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
        <view class="home-row-info"><view class="home-row-name">{{item.name}}</view><view class="home-row-article">货号：{{item.articleNo || '未填写'}}</view></view>
        <view class="home-row-actions" catchlongpress="stopPanelTouchMove">
          <view class="home-row-arrow {{index === 0 ? 'disabled' : ''}}" catchtap="moveHomeProduct" data-id="{{item.id}}" data-direction="-1" aria-label="上移一位">↑</view>
          <view class="home-row-arrow {{index === homeProducts.length - 1 ? 'disabled' : ''}}" catchtap="moveHomeProduct" data-id="{{item.id}}" data-direction="1" aria-label="下移一位">↓</view>
          <view class="home-row-delete" catchtap="removeHomeProducts" data-id="{{item.id}}">删除</view>
        </view>
      </movable-view>
    </movable-area>
    <view class="home-editor-hint" wx:if="{{homeProducts.length}}">长按商品左侧 ⋮⋮ 拖动排序，调整后点击保存</view>
  </scroll-view>

  <!-- 自定义底部导航栏 -->
  <view class="bottom-tab-bar">
    <view class="tab-item active" wx:if="{{canBrowse}}" bindtap="goToIndex">首页</view>
    <view class="tab-item" wx:if="{{canMarket}}" bindtap="goToMarket">市集</view>
    <view class="tab-item admin-portal" wx:if="{{canCreateProduct}}" bindtap="goToCreateProduct">
      <view class="red-plus-btn">+</view>
    </view>
    <view class="tab-item" wx:if="{{canMessages}}" bindtap="goToMessages"><view class="message-tab-label">信息<text wx:if="{{messageUnreadCount > 0}}" class="message-tab-badge">{{messageUnreadLabel}}</text></view></view>
    <view class="tab-item" bindtap="goToUser">我</view>
  </view>
</view>

<include src="../../templates/productSkuPanel.wxml" />

<product-entry-menu id="product-entry-menu" />
<home-product-picker visible="{{showHomeProductPicker}}" existing-ids="{{homeExistingIds}}" bindclose="closeHomeProductPicker" bindconfirm="addHomeProducts" />
