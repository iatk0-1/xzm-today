<view class="container" style="padding-top: {{totalNavHeight}}px;">

  <view class="custom-nav-bar" style="padding-top: {{navTop}}px;">

    <view class="nav-top-row" style="height: {{navHeight}}px;">
      <view class="logo">现在买</view>
      <view class="search-box" bindtap="goToSearch">
        <icon class="search-icon" type="search" size="14" color="#999"></icon>
        <text class="search-placeholder">搜索心仪款式 / 找同款</text>
      </view>
    </view>

    <view class="nav-bottom-row">
      <view class="nav-tabs-left">
        <view class="tab-item {{currentMainTab === '上新' ? 'active' : ''}}" bindtap="handleMainTabChange" data-tab="上新">
          <text>上新</text>
          <view class="line"></view> </view>

        <view class="tab-item {{currentMainTab === '档口' ? 'active' : ''}}" bindtap="handleMainTabChange" data-tab="档口">
          <text>档口</text>
          <view class="line"></view>
        </view>

        <view class="tab-item {{currentMainTab === '分类' ? 'active' : ''}}" bindtap="handleMainTabChange" data-tab="分类">
          <text>分类</text>
          <view class="line"></view>
        </view>

        <view class="tab-item {{currentMainTab === '直播' ? 'active' : ''}}" bindtap="goToLiveRoom" data-tab="直播">
          <text>直播</text>
          <view class="line"></view>
        </view>
      </view>

    
      <view class="nav-cart-right" bindtap="goToCart">
        <text>购物车</text>
      </view>
    </view>
  </view>

  <!-- ================== 新增：左右分治的高级子导航栏 ================== -->
  <view class="sub-nav-bar" wx:if="{{currentMainTab === '档口' || currentMainTab === '分类'}}" style="top: {{totalNavHeight}}px;">
    
    <!-- 左侧固定：总控开关 (支持双向切换与动态图标) -->
    <view class="btn-all-switch" bindtap="toggleAllPanel">
      <text>全部</text>
      <text class="icon-menu">{{showAllPanel ? '×' : '≡'}}</text>
    </view>
    
    <view class="sub-nav-divider"></view> <!-- 微妙的视觉分割线 -->

    <!-- 右侧滑动：纯净列表（不再有重复的全部） -->
    <scroll-view class="sub-nav-scroll" scroll-x="true">
      <view class="sub-nav-container">
        <!-- 档口的标签列表 -->
        <block wx:if="{{currentMainTab === '档口'}}">
          <view class="sub-tag {{selectedStall === item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}" data-name="{{item.name}}">{{item.name}}</view>
        </block>
        <!-- 分类的标签列表 -->
        <block wx:if="{{currentMainTab === '分类'}}">
          <view class="sub-tag {{selectedTag === item.id ? 'active' : ''}}" wx:for="{{tagList}}" wx:key="id" bindtap="selectTag" data-tag="{{item.id}}" data-name="{{item.name}}">{{item.name}}</view>
        </block>
        <view class="sub-tag-placeholder"></view> <!-- 留白占位，更高级 -->
      </view>
    </scroll-view>
  </view>

  <!-- ================== 新增：展开时的高级大面板 (A-Z版) ================== -->
  <view class="all-panel-mask {{showAllPanel ? 'fade-in' : ''}}" wx:if="{{showAllPanel}}" catchtap="closeAllPanel" style="top: {{totalNavHeight}}px; margin-top: 88rpx;"></view>
  
  <view class="all-panel-content {{showAllPanel ? 'slide-down' : ''}}" wx:if="{{showAllPanel}}" style="top: {{totalNavHeight}}px; margin-top: 88rpx;">
    
    <!-- 档口专属：A-Z 分组面板 -->
    <block wx:if="{{currentMainTab === '档口'}}">
      <view class="panel-top-action">
        <!-- 独立放置的全部按钮 -->
        <view class="all-panel-tag {{selectedStall === '' ? 'active' : ''}}" bindtap="selectStall" data-stall="all" data-name="全部档口">全部档口</view>
      </view>
      <scroll-view scroll-y class="panel-scroll-area">
        <view class="group-section" wx:for="{{groupedStalls}}" wx:key="letter">
          <view class="group-title">{{item.letter}}</view> <!-- A, B, C... 标题 -->
          <view class="all-panel-grid">
            <view class="all-panel-tag {{selectedStall === stall.id ? 'active' : ''}}" wx:for="{{item.list}}" wx:for-item="stall" wx:key="id" bindtap="selectStall" data-stall="{{stall.id}}" data-name="{{stall.name}}">{{stall.name}}</view>
          </view>
        </view>
      </scroll-view>
    </block>

    <!-- 分类专属：极简平铺面板 -->
    <block wx:if="{{currentMainTab === '分类'}}">
      <view class="panel-top-action">
        <view class="all-panel-tag {{selectedTag === '' ? 'active' : ''}}" bindtap="selectTag" data-tag="all" data-name="全部分类">全部分类</view>
      </view>
      <scroll-view scroll-y class="panel-scroll-area">
        <view class="all-panel-grid" style="padding-top: 10rpx;">
          <view class="all-panel-tag {{selectedTag === item.id ? 'active' : ''}}" wx:for="{{tagList}}" wx:key="id" bindtap="selectTag" data-tag="{{item.id}}" data-name="{{item.name}}">{{item.name}}</view>
        </view>
      </scroll-view>
    </block>
  </view>

  <!-- 动态增加瀑布流的上边距，防止被上面的导航挡住 -->
  <view class="waterfall-container {{currentMainTab === '档口' || currentMainTab === '分类' ? 'has-sub-nav' : ''}}">
    <!-- 左列 -->
    <view class="waterfall-column">
      <view class="product-item" wx:for="{{leftColumn}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <image class="product-img" src="{{item.coverUrl || item.image}}" mode="widthFix" lazy-load="true"></image>
        <view class="product-info">
          <view class="product-title">{{item.name || item.title}}</view>
          <view class="product-bottom">
            <view class="product-price">¥{{item.retailPrice || item.displayPrice}}</view>
            <view class="btn-add-cart" catchtap="openSkuPanel" data-product="{{item}}">
              <image class="add-cart-icon" src="/images/add-cart.png" mode="aspectFit"></image>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 右列 -->
    <view class="waterfall-column">
      <view class="product-item" wx:for="{{rightColumn}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <image class="product-img" src="{{item.coverUrl || item.image}}" mode="widthFix" lazy-load="true"></image>
        <view class="product-info">
          <view class="product-title">{{item.name || item.title}}</view>
          <view class="product-bottom">
            <view class="product-price">¥{{item.retailPrice || item.displayPrice}}</view>
            <view class="btn-add-cart" catchtap="openSkuPanel" data-product="{{item}}">
              <image class="add-cart-icon" src="/images/add-cart.png" mode="aspectFit"></image>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 自定义底部导航栏 -->
  <view class="bottom-tab-bar">
    <view class="tab-item active" bindtap="goToIndex">首页</view>
    <view class="tab-item" bindtap="goToMarket">市集</view>
    <view class="tab-item admin-portal" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="red-plus-btn">+</view>
    </view>
    <view class="tab-item" bindtap="goToMessage">信息</view>
    <view class="tab-item" bindtap="goToUser">我</view>
  </view>
</view>

<view class="sku-mask {{showSku ? 'fade-in' : ''}}" wx:if="{{showSku}}" catchtap="closeSkuPanel"></view>

<view class="sku-panel {{showSku ? 'slide-up' : ''}}">
  <view class="sku-close" catchtap="closeSkuPanel">×</view>

  <view class="sku-header" wx:if="{{currentProduct}}">
    <image class="sku-img" src="{{currentSkuImage || currentProduct.coverUrl || currentProduct.image}}" mode="aspectFill"></image>
    <view class="sku-main">
      <view class="sku-price">
        ¥{{currentSkuPrice || currentProduct.retailPrice || currentProduct.displayPrice || '0.00'}}
      </view>
      <view class="sku-stock {{currentSkuStock === 0 ? 'out-of-stock' : ''}}">
        库存：{{currentSkuStock !== null ? currentSkuStock : '请选择规格'}}
      </view>
      <view class="sku-choose-tip">已选：{{selectedColor || '颜色'}} / {{selectedSize || '尺码'}}</view>
    </view>
  </view>

  <scroll-view scroll-y class="sku-scroll-area">
    <view class="sku-section" wx:if="{{uniqueColors.length > 0}}">
      <view class="sku-title">颜色</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedColor === item ? 'active' : ''}}" wx:for="{{uniqueColors}}" wx:key="*this" bindtap="selectColor" data-color="{{item}}">{{item}}</view>
      </view>
    </view>

    <view class="sku-section" wx:if="{{uniqueSizes.length > 0}}">
      <view class="sku-title">尺码</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedSize === item ? 'active' : ''}}" wx:for="{{uniqueSizes}}" wx:key="*this" bindtap="selectSize" data-size="{{item}}">{{item}}</view>
      </view>
    </view>
  </scroll-view>

  <view class="sku-actions" wx:if="{{currentSkuStock !== 0}}">
    <view class="sku-btn-cart" bindtap="confirmAddToCart" data-action="cart">加入购物车</view>
    <view class="sku-btn-buy" bindtap="confirmAddToCart" data-action="buy">立即购买</view>
  </view>

  <view class="sku-btn-confirm disabled" wx:else>
    已售罄
  </view>
</view>
