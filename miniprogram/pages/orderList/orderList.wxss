page { background-color: #f7f8fa; }
.page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }

/* 顶部 Tab 栏 */
/* ================= 顶部滑动 Tab 栏 ================= */
.tabs-bar-wrapper {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
  position: relative;
  z-index: 10;
}

/* 固定的“全部”按钮 */
.fixed-tab {
  width: 130rpx;
  flex-shrink: 0;
  text-align: center;
  /* 🚀 核心修复 1：统一字号和行高，彻底锁死高度 */
  font-size: 28rpx; 
  line-height: 40rpx; 
  color: #666;
  padding: 26rpx 0;
  position: relative;
  /* 🚀 核心修复 2：去掉 all，只允许颜色发生动画，杜绝排版挤压 */
  transition: color 0.2s ease; 
}
.fixed-tab.active { font-weight: bold; color: #1a1a1a; }

/* 若隐若现的分割线 */
.tab-divider {
  width: 2rpx;
  height: 30rpx;
  background-color: #eeeeee;
  box-shadow: 2rpx 0 6rpx rgba(0,0,0,0.05);
}

/* 右侧滚动区 */
.scroll-tabs {
  flex: 1;
  white-space: nowrap; /* 核心：强制一行不换行 */
  overflow: hidden;
}

/* 右侧滚动区单项 */
.scroll-tab-item {
  display: inline-block;
  padding: 26rpx 36rpx;
  text-align: center;
  /* 🚀 核心修复 1：统一字号和行高 */
  font-size: 28rpx; 
  line-height: 40rpx;
  color: #666;
  position: relative;
  /* 🚀 核心修复 2：去掉 all，只允许颜色发生动画 */
  transition: color 0.2s ease; 
}
.scroll-tab-item.active { font-weight: bold; color: #1a1a1a; }

/* 底部黑色短滑块 */
.active-line {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 6rpx;
  background-color: #1a1a1a;
  border-radius: 4rpx;
}

/* 滚动区域 */
.order-scroll-area { flex: 1; padding: 20rpx; box-sizing: border-box; overflow-y: auto; -webkit-overflow-scrolling: touch; }

/* 空状态 */
.empty-state { padding: 150rpx 0; text-align: center; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.5; }
.empty-text { font-size: 26rpx; color: #999; }

/* 订单卡片 */
.order-card { background-color: #ffffff; border-radius: 16rpx; padding: 30rpx 24rpx; margin-bottom: 24rpx; }

.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; border-bottom: 1rpx solid #f5f5f5; padding-bottom: 20rpx; }
.order-sn-wrap { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; }
.order-sn { font-size: 22rpx; color: #999; font-family: "Times New Roman", Times, serif; }
.copy-link { flex-shrink: 0; padding: 4rpx 12rpx; font-size: 22rpx; line-height: 1.3; color: #576b95; background: #f5f7fa; border-radius: 6rpx; }
.status-wrapper { display: flex; align-items: center; gap: 12rpx; }
.order-status { font-size: 26rpx; color: #1a1a1a; font-weight: bold; }
.order-status.highlight { color: #d32f2f; }
.after-sale-badge {
  font-size: 20rpx;
  color: #ff4444;
  background-color: #fff5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ffcccc;
  white-space: nowrap;
}
.after-sale-badge.handled {
  color: #4f6f52;
  background-color: #f1f8f2;
  border-color: #c8e6c9;
}
.remark-badge {
  display: inline-block;
  align-self: flex-start;
  font-size: 20rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid #e0e0e0;
  margin-top: 10rpx;
}

.goods-bundle { margin-top: 6rpx; }
.bundle-sub { display: flex; align-items: center; padding: 2rpx 0; }
.bundle-sub-name { font-size: 22rpx; color: #666; margin-right: 6rpx; }
.bundle-sub-spec { font-size: 22rpx; color: #999; }
.bundle-sub-count { font-size: 22rpx; color: #777; }

.goods-list { margin-bottom: 10rpx; }
.goods-item { display: flex; margin-bottom: 30rpx; }
.goods-item:last-child { margin-bottom: 0; }
.goods-img { width: 140rpx; height: 186rpx; background-color: #f0f0f0; border-radius: 8rpx; margin-right: 24rpx; }
.goods-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.goods-title { font-size: 26rpx; color: #333; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.goods-sku { font-size: 22rpx; color: #999; margin-top: 10rpx; }
.goods-price-row { display: flex; justify-content: space-between; align-items: baseline; margin-top: auto; }
.price { font-size: 28rpx; font-weight: bold; font-family: "Times New Roman", Times, serif; }
.count { font-size: 24rpx; color: #999; font-family: "Times New Roman", Times, serif; }

.after-sale-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.4;
}
.after-sale-line text {
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
}
.after-sale-line.active text {
  color: #d84315;
  background: #fff3e0;
}
.after-sale-line.handled text {
  color: #4f6f52;
  background: #f1f8f2;
}

/* 发货数量信息 */
.goods-shipment-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  flex-wrap: wrap;
}
.qty-label { color: #999; font-family: "Times New Roman", Times, serif; }
.qty-pending { color: #ff9800; font-family: "Times New Roman", Times, serif; }
.qty-shipped { color: #4caf50; font-family: "Times New Roman", Times, serif; }
.shipped-done-badge {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  color: #ffffff;
  background-color: #4caf50;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  gap: 4rpx;
}

.card-footer { border-top: 1rpx dashed #eee; padding-top: 24rpx; margin-top: 24rpx; }
.total-row { text-align: right; margin-bottom: 24rpx; }
.total-label { font-size: 24rpx; color: #666; margin-right: 10rpx; }
.total-price { font-size: 32rpx; font-weight: bold; font-family: "Times New Roman", Times, serif; }

.action-row { display: flex; justify-content: flex-end; gap: 12rpx; }
.btn-ghost { margin: 0; padding: 0 20rpx; height: 56rpx; line-height: 54rpx; font-size: 24rpx; color: #333; background: transparent; border: 1rpx solid #ddd; border-radius: 28rpx; font-weight: normal; white-space: nowrap; }
.btn-ghost::after { display: none; }
.btn-solid { padding: 0 20rpx; height: 56rpx; line-height: 56rpx; font-size: 24rpx; color: #fff; background: #1a1a1a; border-radius: 28rpx; font-weight: bold; white-space: nowrap; }

/* 发货信息区域 */
.shipment-section {
  margin-top: 8rpx;
}

.shipment-divider {
  width: 100%;
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 12rpx 0 10rpx 0;
}

.shipment-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.shipment-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  background-color: #f5f5f5;
  color: #555;
  border-radius: 16rpx;
  line-height: 1.4;
  font-family: "Times New Roman", Times, serif;
}

.tag-shipped {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.tag-pending {
  background-color: #fff3e0;
  color: #e65100;
}

/* 已发完徽章（与售后徽章风格统一） */
.shipped-done-badge {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  color: #ffffff;
  background-color: #4caf50;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  gap: 4rpx;
  line-height: 1.4;
}

/* 固定 Tab 栏容器 */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

/* 确保 Tab 栏背景纯白 */
.tabs-bar-wrapper {
  background-color: #ffffff;
}

/* ① 让 sticky 容器盖住下方的 scroll-view，不留物理缝隙 */
.sticky-header {
  position: sticky;
  top: -1rpx;           /* 轻微上移，盖住可能的白线 */
  margin-top: -1rpx;     /* 双重保险 */
  padding-top: 1rpx;     /* 防止内容被裁切 */
}
