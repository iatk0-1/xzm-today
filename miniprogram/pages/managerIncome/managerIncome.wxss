page { background:#f5f6f8; color:#222; } .page { padding:24rpx; } .card { background:#fff; border-radius:18rpx; padding:24rpx; margin-bottom:20rpx; } .title { font-size:34rpx; font-weight:600; margin-bottom:16rpx; } .muted { color:#747a83; font-size:25rpx; line-height:1.7; } .error { padding:20rpx; background:#fff0ee; color:#ac2d24; margin-bottom:18rpx; white-space:pre-wrap; } .tabs { white-space:nowrap; margin-bottom:20rpx; } .tab { display:inline-block; padding:16rpx 22rpx; background:#fff; border-radius:12rpx; margin-right:12rpx; } .active { background:#173e33; color:#fff; } .row { display:flex; gap:12rpx; align-items:center; flex-wrap:wrap; } .choice { display:block; padding:16rpx 0; border-bottom:1rpx solid #eee; } input,textarea { background:#f5f6f8; border-radius:10rpx; padding:18rpx; margin:14rpx 0; box-sizing:border-box; width:100%; } textarea { min-height:110rpx; } button { margin:12rpx 0; font-size:28rpx; } .primary { background:#173e33; color:#fff; } .amount { color:#173e33; font-size:38rpx; margin-bottom:10rpx; } .grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; } .label { font-size:25rpx; color:#606873; } .metric { font-size:33rpx; } .overlay { position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:30; padding:35rpx 22rpx; box-sizing:border-box; } .modal { background:#fff; border-radius:18rpx; height:90vh; padding:25rpx; box-sizing:border-box; } .badge { font-size:24rpx; color:#747a83; }
