page { background: #f5f6f8; color: #26313e; }
.selector-toolbar { background: #fff; padding: 22rpx 24rpx 16rpx; }
.search-row { display: flex; align-items: center; gap: 16rpx; background: #f3f5f8; border-radius: 12rpx; padding: 0 0 0 20rpx; }
.search-row input { flex: 1; min-width: 0; height: 76rpx; font-size: 26rpx; }.clear-search { font-size: 36rpx; color: #9aa3af; padding: 0 10rpx; }
.search-row button { flex-shrink: 0; margin: 0; padding: 0 24rpx; height: 76rpx; line-height: 76rpx; background: #26313e; color: #fff; border-radius: 0 12rpx 12rpx 0; font-size: 25rpx; }
.filter-scroll { flex: 1; min-width: 0; white-space: nowrap; }.filter-track { display: inline-flex; flex-wrap: nowrap; min-width: 100%; }.status-scroll { margin: 14rpx 0; }
.status-tab { flex-shrink: 0; padding: 22rpx 25rpx; font-size: 26rpx; color: #8a929f; border-bottom: 4rpx solid transparent; }.status-tab.active { color: #26313e; border-color: #26313e; font-weight: 600; }
.relation-row { display: flex; align-items: center; gap: 14rpx; padding: 10rpx 0; }.relation-label { flex: 0 0 56rpx; font-size: 25rpx; color: #8b94a1; }
.filter-chip { flex-shrink: 0; padding: 12rpx 20rpx; margin-right: 12rpx; background: #f3f5f8; color: #7b8797; border-radius: 24rpx; font-size: 23rpx; }.fixed-chip { margin-right: 0; }.filter-chip.active { background: #26313e; color: #fff; }
.selection-actions { display: flex; align-items: center; gap: 20rpx; margin: 22rpx 0 14rpx; }.selection-actions button { flex: 1; height: 76rpx; line-height: 76rpx; font-size: 26rpx; margin: 0; border-radius: 12rpx; }.select-all { background: #eef1f6; color: #4f6076; }.confirm-selection { background: #26313e; color: #fff; }
.selection-tip { font-size: 22rpx; color: #929aa6; line-height: 1.6; }
.product-list { padding: 20rpx; }.product-card { display: flex; align-items: flex-start; gap: 18rpx; border: 2rpx solid transparent; padding: 24rpx 18rpx; background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; }.product-card.selected { border-color: #526b84; }.product-card.unavailable { opacity: .55; }
.card-checkbox { flex: 0 0 40rpx; padding-top: 34rpx; }.checkbox { width: 34rpx; height: 34rpx; border: 2rpx solid #cdd5df; border-radius: 7rpx; display: flex; align-items: center; justify-content: center; font-size: 25rpx; box-sizing: border-box; }.checkbox.checked { color: #fff; background: #26313e; border-color: #26313e; }
.product-image { width: 136rpx; height: 160rpx; border-radius: 10rpx; flex-shrink: 0; background: #f1f2f5; }.card-info { flex: 1; min-width: 0; }.product-title { font-size: 28rpx; line-height: 1.6; font-weight: 600; overflow-wrap: anywhere; }.product-labels { display: flex; gap: 10rpx; flex-wrap: wrap; padding: 12rpx 0; }.status-label, .schedule-label { padding: 4rpx 12rpx; background: #eaf5ee; color: #5b8365; font-size: 20rpx; border-radius: 6rpx; }.status-label.off { color: #9a8170; background: #f5efe8; }.schedule-label { color: #6e80a2; background: #eef2f9; }.product-specs { font-size: 22rpx; color: #929ba8; line-height: 1.8; overflow-wrap: anywhere; }
.state { padding: 50rpx 20rpx; text-align: center; font-size: 25rpx; line-height: 1.8; color: #929aa6; }.state.error { color: #b16c58; }.state button, .load-more { margin-top: 18rpx; font-size: 24rpx; }
