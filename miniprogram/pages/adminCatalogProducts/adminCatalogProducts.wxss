/* 页面高度写死成视口高度：顶部信息/tab/筛选和底部批量操作固定，只有商品列表滚动 */
page { height: 100vh; background: #f4f6f8; }
.page { height: 100%; display: flex; flex-direction: column; overflow: hidden; }
.group-header { padding: 22rpx 24rpx; background: #fff; border-bottom: 1rpx solid #edf0f2; flex-shrink: 0; }
.group-label { color: #89929b; font-size: 22rpx; }
.group-name-row { display: flex; align-items: center; gap: 20rpx; margin-top: 6rpx; }
.group-name { flex: 1; min-width: 0; color: #1f2933; font-size: 34rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rename-btn { flex-shrink: 0; padding: 10rpx 16rpx; color: #486780; font-size: 24rpx; }
/* flex-shrink: 0：tab 高度锁死，列表再长也不会被压扁 */
.scope-tabs { display: flex; height: 84rpx; background: #fff; border-bottom: 1rpx solid #e8ecef; flex-shrink: 0; }
.scope-tab { flex: 1; display: flex; align-items: center; justify-content: center; color: #707b85; font-size: 27rpx; position: relative; }
.scope-tab.active { color: #1f2933; font-weight: 700; }
.scope-tab.active::after { content: ''; position: absolute; left: 25%; right: 25%; bottom: 0; height: 5rpx; background: #1f2933; }
.filter-panel { padding: 18rpx 24rpx; background: #fff; border-bottom: 1rpx solid #edf0f2; flex-shrink: 0; }
.search-row { display: flex; align-items: center; gap: 12rpx; }
.search-input { flex: 1; height: 68rpx; padding: 0 18rpx; background: #f2f4f6; border-radius: 8rpx; font-size: 25rpx; box-sizing: border-box; }
.search-btn, .clear-btn { height: 68rpx; line-height: 68rpx; font-size: 24rpx; white-space: nowrap; }
.search-btn { padding: 0 22rpx; color: #fff; background: #1f2933; border-radius: 8rpx; }
.clear-btn { color: #68737d; }
.status-tabs { display: flex; width: 360rpx; margin-top: 16rpx; padding: 4rpx; background: #eef1f4; border-radius: 8rpx; box-sizing: border-box; }
.status-tab { flex: 1; height: 48rpx; line-height: 48rpx; text-align: center; color: #707b85; font-size: 22rpx; border-radius: 6rpx; }
.status-tab.active { color: #fff; background: #59636d; }
/* min-height: 0 是让滚动区老老实实占满剩余高度、不再被内容撑开的关键 */
.product-scroll { flex: 1; min-height: 0; padding: 16rpx 20rpx; box-sizing: border-box; }
.product-row { display: flex; align-items: center; min-height: 132rpx; padding: 18rpx; margin-bottom: 12rpx; background: #fff; border: 2rpx solid transparent; border-radius: 8rpx; box-sizing: border-box; }
.product-row.selected { border-color: #748392; background: #f8fafb; }
.checkbox { width: 36rpx; height: 36rpx; margin-right: 16rpx; border: 2rpx solid #c8cfd5; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22rpx; flex-shrink: 0; box-sizing: border-box; }
.checkbox.checked { border-color: #1f2933; background: #1f2933; }
.product-image { width: 96rpx; height: 96rpx; margin-right: 18rpx; background: #edf0f2; border-radius: 6rpx; flex-shrink: 0; }
.product-info { flex: 1; min-width: 0; }
.product-name { color: #202932; font-size: 27rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.product-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 14rpx; color: #66717b; font-size: 23rpx; }
.status { padding: 3rpx 10rpx; border-radius: 4rpx; font-size: 20rpx; }
.status.on { color: #246447; background: #e8f4ed; }
.status.off { color: #985044; background: #f8eae7; }
.empty { padding: 180rpx 0; text-align: center; color: #919aa3; font-size: 26rpx; }
.loading-more { padding: 24rpx; text-align: center; color: #929ba4; font-size: 22rpx; }
.batch-bar { padding: 14rpx 22rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e3e7ea; flex-shrink: 0; }
.selection-line { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; color: #4e5963; font-size: 23rpx; }
.selection-actions { display: flex; gap: 26rpx; color: #1f2933; }
.batch-btn { height: 76rpx; line-height: 76rpx; text-align: center; color: #fff; background: #1f2933; border-radius: 8rpx; font-size: 27rpx; font-weight: 600; }
.batch-btn.remove { background: #b9433b; }
.batch-btn.disabled { background: #c9cfd5; }
.rename-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(0, 0, 0, 0.45); box-sizing: border-box; }
.rename-dialog { width: 100%; max-width: 600rpx; padding: 36rpx; border-radius: 16rpx; background: #fff; box-sizing: border-box; }
.rename-title { color: #1f2933; font-size: 30rpx; font-weight: 600; }
.rename-input { height: 80rpx; margin-top: 28rpx; padding: 0 20rpx; border-radius: 8rpx; background: #f4f6f8; font-size: 28rpx; box-sizing: border-box; }
.rename-actions { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 32rpx; }
.rename-cancel, .rename-save { min-width: 120rpx; padding: 14rpx 20rpx; border-radius: 8rpx; text-align: center; font-size: 26rpx; box-sizing: border-box; }
.rename-cancel { color: #68737d; background: #f4f6f8; }
.rename-save { color: #fff; background: #1f2933; }
