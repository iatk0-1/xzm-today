page { background-color: #f7f8fa; padding-bottom: 40px; }
.admin-container { padding: 20px; }
.header-title { font-size: 24px; font-weight: bold; margin-bottom: 20px; color: #333; }
.form-group { background: #fff; padding: 15px; border-radius: 12px; margin-bottom: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.02); }
.label { font-size: 14px; font-weight: bold; margin-bottom: 12px; color: #333; }
.sub-label { font-size: 12px; color: #666; margin-top: 15px; margin-bottom: 8px; }
.required { color: red; margin-right: 4px; }
.input-box { background: #f5f5f5; height: 44px; padding: 0 15px; border-radius: 8px; font-size: 14px; }
.divider { text-align: center; font-size: 12px; color: #aaa; margin: 30px 0 15px; }

/* ================= 拖拽媒体池黑科技样式 ================= */
.drag-area { width: 100%; position: relative; }
.drag-item { width: 90px; height: 90px; position: absolute; z-index: 1; }
.drag-item.is-dragging { z-index: 99; transform: scale(1.05); box-shadow: 0 10px 20px rgba(0,0,0,0.15); border-radius: 8px; }
.img-box { width: 100%; height: 100%; position: relative; border-radius: 8px; overflow: hidden; background: #eee; }
.media-img { width: 100%; height: 100%; display: block; }
.cover-tag { position: absolute; left: 0; bottom: 0; width: 100%; background: rgba(0,0,0,0.6); color: #fff; font-size: 11px; text-align: center; padding: 3px 0; font-weight: bold; }
.delete-btn { position: absolute; top: 0; right: 0; width: 22px; height: 22px; background: rgba(0,0,0,0.5); color: #fff; border-bottom-left-radius: 8px; text-align: center; line-height: 20px; font-size: 14px; z-index: 10; }
.upload-btn-box { background: #f5f5f5; border: 1px dashed #ccc; border-radius: 8px; display: flex; justify-content: center; align-items: center; box-sizing: border-box; }
.upload-placeholder { font-size: 10px; color: #ccc; font-weight: 300; }

/* 其他普通图片上传区 */
.multi-image-box { display: flex; flex-wrap: wrap; gap: 10px; }
.multi-preview { width: 70px; height: 70px; border-radius: 6px; background: #eee; }
.multi-upload-btn { width: 70px; height: 70px; border-radius: 6px; background: #f5f5f5; display: flex; justify-content: center; align-items: center; font-size: 30px; color: #ccc; }

/* 档口分类和标签分类样式 */
.tags-display { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
.tag-capsule { padding: 6px 14px; border-radius: 15px; font-size: 12px; display: flex; align-items: center; }
.active-tag { background: #000; color: #fff; }
.history-tag { background: #f0f0f0; color: #555; border: 1px solid #ddd; }
.color-tag { background: #e0e0e0; color: #333; }
.remove-icon { margin-left: 6px; font-size: 14px; font-weight: bold; padding: 0 5px; }
.tag-input-row { display: flex; gap: 10px; }
.search-input-row { margin-bottom: 10px; }
.tag-input { flex: 1; }
.btn-add-tag { background: #333; color: #fff; line-height: 44px; padding: 0 20px; border-radius: 8px; font-size: 14px; }

/* 历史记录区域样式 */
.history-section { margin-bottom: 12px; }
.history-label { font-size: 11px; color: #999; margin-bottom: 8px; }
.history-scroll { white-space: nowrap; }
.history-item {
  display: inline-block;
  padding: 4px 12px;
  background: #f5f5f5;
  border-radius: 12px;
  font-size: 11px;
  color: #666;
  margin-right: 6px;
  white-space: nowrap;
  transition: all 0.2s;
}
.history-item:active { background: #000; color: #fff; }

/* 搜索结果下拉样式 - 浮动定位 */
.stall-section, .tag-section { position: relative; }
.search-results { position: absolute; top: 100%; left: 0; right: 0; max-height: 200px; overflow-y: auto; background: #fff; border-radius: 8px; margin-top: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.12); z-index: 1000; }
.search-results.floating-dropdown { position: absolute; }
.search-result-item { padding: 10px 15px; font-size: 13px; color: #333; border-bottom: 1px solid #f0f0f0; }
.search-result-item:active { background: #f0f0f0; }
.search-empty-item { padding: 10px 15px; font-size: 13px; color: #007aff; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center; }
.search-empty-item:active { background: #f0f0f0; }
.add-new-text { font-weight: bold; color: #007aff; }

/* 尺码框 */
.size-options { display: flex; flex-wrap: wrap; gap: 10px; }
.size-box { padding: 8px 16px; background: #f5f5f5; border-radius: 6px; font-size: 13px; color: #666; transition: all 0.2s; }
.size-box.active { background: #000; color: #fff; font-weight: bold; }

/* SKU 矩阵 */
.sku-matrix-section { background: #fff; padding: 15px; border-radius: 12px; margin-bottom: 15px; border: 1px solid #ffeded; }
.batch-row { display: flex; gap: 10px; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px dashed #eee; }
.batch-input { flex: 1; height: 36px; background: #f9f9f9; border-radius: 6px; padding: 0 10px; font-size: 13px; text-align: center; }
.btn-batch { background: #ff4d4f; color: #fff; line-height: 36px; padding: 0 15px; border-radius: 6px; font-size: 13px; font-weight: bold; }
.sku-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.sku-delete { width: 24px; height: 24px; background: #ff4d4f; color: #fff; border-radius: 50%; text-align: center; line-height: 22px; font-size: 18px; margin-right: 5px; flex-shrink: 0; }
.sku-name { flex: 1; font-size: 12px; color: #333; font-weight: bold; display: flex; align-items: center; }
.sku-input { width: 70px; height: 32px; background: #f5f5f5; border-radius: 4px; text-align: center; font-size: 12px; }

/* 关联商品 */
.related-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
.btn-add-related { border: 1px dashed #ccc; color: #666; text-align: center; line-height: 40px; border-radius: 8px; font-size: 14px; }
.related-item { display: flex; align-items: center; background: #fafafa; padding: 10px; border-radius: 8px; margin-bottom: 10px; }
.related-img { width: 40px; height: 40px; border-radius: 4px; margin-right: 10px; }
.related-info { flex: 1; }
.related-title { font-size: 13px; color: #333; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; overflow: hidden; }
.related-price { font-size: 12px; color: #666; margin-top: 4px; }
.btn-remove-related { font-size: 12px; color: #ff4d4f; padding: 5px 10px; }

/* 提交按钮 */
.btn-submit { background: #000; color: #fff; text-align: center; line-height: 50px; border-radius: 25px; font-size: 16px; font-weight: bold; margin-top: 20px; }

/* ================= 搜索弹窗样式 ================= */
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999; }
.related-modal { position: fixed; bottom: -100%; left: 0; width: 100%; height: 80vh; background: #fff; border-radius: 16px 16px 0 0; z-index: 1000; display: flex; flex-direction: column; transition: all 0.3s ease-in-out; }
.related-modal.show { bottom: 0; }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; border-bottom: 1px solid #f0f0f0; }
.modal-title { font-size: 16px; font-weight: bold; }
.modal-close { font-size: 24px; color: #999; padding: 0 10px; }
.search-bar-wrap { padding: 10px 20px; background: #f9f9f9; }
.search-input { background: #fff; height: 36px; border-radius: 18px; padding: 0 15px; font-size: 13px; border: 1px solid #eee; }
.product-scroll-list { flex: 1; padding: 10px 20px; overflow-y: auto; }
.product-row { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #f5f5f5; }
.checkbox { width: 18px; height: 18px; border: 1px solid #ccc; border-radius: 50%; margin-right: 15px; }
.checkbox.checked { background: #000; border-color: #000; position: relative; }
.checkbox.checked::after { content: ''; position: absolute; left: 5px; top: 2px; width: 4px; height: 8px; border: solid white; border-width: 0 2px 2px 0; transform: rotate(45deg); }
.row-img { width: 50px; height: 50px; border-radius: 6px; margin-right: 15px; background: #eee; }
.row-info { flex: 1; }
.row-title { font-size: 14px; color: #333; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin-bottom: 5px;}
.row-price { font-size: 13px; font-weight: bold; }
.empty-tip { text-align: center; color: #999; font-size: 13px; margin-top: 30px; }
.modal-footer { padding: 15px 20px; background: #fff; border-top: 1px solid #eee; padding-bottom: calc(15px + env(safe-area-inset-bottom)); }
.btn-confirm-modal { background: #000; color: #fff; text-align: center; line-height: 44px; border-radius: 22px; font-size: 15px; font-weight: bold; }

/* ====== 新增视频上传区样式 ====== */
.video-upload-box {
  width: 105px;
  height: 105px;
  background-color: #f7f7f7;
  border: 1px dashed #cccccc;
  border-radius: 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 10px;
}
.video-preview-box {
  position: relative;
  width: 105px;
  height: 105px;
  margin-top: 10px;
  border-radius: 8px;
  overflow: hidden;
}
.preview-video {
  width: 100%;
  height: 100%;
  display: block;
}
/* 这里的 .delete-btn 借用了你原本的删除按钮样式，如果不居中，可以加一行 z-index: 10; */