  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.manage-item-deleted {
  font-size: 12px;
  color: #999;
  font-style: italic;
  flex-shrink: 0;
}
.manage-item-actions {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
  flex-grow: 0;
  margin-left: 12px;
  position: relative;
  z-index: 1;
}
.manage-action-btn {
  font-size: 12px;
  padding: 6px 14px;
  border-radius: 16px;
  font-weight: 500;
  transition: all 0.2s;
}
.delete-btn {
  background: #fff0f0;
  color: #ff4d4f;
}
.delete-btn:active {
  background: #ff4d4f;
  color: #fff;
}
.restore-btn {
  background: #f0f9ff;
  color: #007aff;
}
.restore-btn:active {
  background: #007aff;
  color: #fff;
}
.manage-empty {
  text-align: center;
