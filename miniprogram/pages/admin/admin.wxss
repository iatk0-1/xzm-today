/* 切换尺码按钮 */
.switch-size-btn {
  margin-top: 12px;
  padding: 8px 16px;
  background: #f5f5f5;
  border-radius: 8px;
  font-size: 13px;
  color: #666;
  text-align: center;
  display: inline-block;
  transition: all 0.2s;
}
.switch-size-btn:active {
