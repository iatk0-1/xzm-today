  color: #666;
  text-align: center;
  display: inline-block;
  transition: all 0.2s;
}
.switch-size-btn:active {
  background: #e0e0e0;
}

/* 尺码类型显示 */
.size-type-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  padding: 8px 12px;
  background: #f9f9f9;
  border-radius: 8px;
}
.size-type-name {
  font-size: 13px;
  color: #333;
  font-weight: 500;
}

/* ================= 编辑按钮样式 ================= */
.label-with-edit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.label-with-edit .label {
  font-size: 14px;
  font-weight: bold;
  color: #333;
  margin: 0;
}
.edit-btn {
  font-size: 12px;
  color: #007aff;
  padding: 4px 12px;
  background: #f0f8ff;
  border-radius: 12px;
  font-weight: 500;
  transition: all 0.2s;
}
.edit-btn:active {
  background: #007aff;
  color: #fff;
}

/* ================= 管理弹窗样式 ================= */
.manage-modal {
  position: fixed;
  bottom: -100%;
  left: 0;
  width: 100%;
  height: 70vh;
  background: #fff;
  border-radius: 16px 16px 0 0;
  z-index: 1003;
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease-in-out;
  box-sizing: border-box;
}
.manage-modal.show {
  bottom: 0;
}
.manage-scroll {
  flex: 1;
  padding: 15px 20px 20px 20px;
  overflow-y: auto;
  box-sizing: border-box;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  position: relative;
}

/* 新增输入行（scroll-view 外面） */
.manage-add-row-outside {
  display: flex;
  flex-direction: row;
  gap: 10px;
  margin: 15px 20px 0 20px;
  padding-bottom: 15px;
  border-bottom: 1px solid #f0f0f0;
  align-items: center;
  width: calc(100% - 40px);
  box-sizing: border-box;
}
.manage-add-row-outside .manage-input {
  flex: 1;
  height: 40px;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 0 15px;
  font-size: 14px;
  box-sizing: border-box;
  min-width: 0;
}
.manage-add-row-outside .manage-add-btn {
  width: 80px;
  height: 40px;
  background: #000;
  color: #fff;
  border-radius: 8px;
  text-align: center;
  line-height: 40px;
  font-size: 14px;
  font-weight: 500;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 搜索提示 */
.manage-search-hint {
  font-size: 12px;
  color: #999;
  padding: 8px 0;
  margin-bottom: 8px;
}

/* 新增输入行（scroll-view 内部 - 保留备用） */
.manage-add-row {
  display: flex;
  flex-direction: row;
  gap: 10px;
  margin-bottom: 15px;
  padding-bottom: 15px;
  border-bottom: 1px solid #f0f0f0;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.manage-input {
  flex: 1;
  height: 40px;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 0 15px;
  font-size: 14px;
  box-sizing: border-box;
  min-width: 0;
  position: relative;
  z-index: 1;
}
.manage-add-btn {
  width: 80px;
  height: 40px;
  background: #000;
  color: #fff;
  border-radius: 8px;
  text-align: center;
  line-height: 40px;
  font-size: 14px;
  font-weight: 500;
  flex-shrink: 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.manage-add-btn:active {
  background: #333;
}

/* 管理列表 - 标签形式 */
.manage-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  width: 100%;
  padding: 10px 0;
}
.manage-tag-item {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 8px 14px;
  background: #f5f5f5;
  border-radius: 16px;
  gap: 6px;
  transition: all 0.2s;
}
.manage-tag-item.deleted {
  background: #e8e8e8;
  opacity: 0.7;
}
.manage-tag-name {
  font-size: 13px;
  color: #333;
  font-weight: 500;
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.manage-tag-delete {
  font-size: 16px;
  color: #ff4d4f;
  font-weight: bold;
  padding: 0 2px;
  line-height: 1;
  cursor: pointer;
}
.manage-tag-delete:active {
  color: #ff7875;
}
.manage-tag-restore {
  font-size: 11px;
  color: #007aff;
  font-weight: 500;
  padding: 2px 6px;
  background: #f0f9ff;
  border-radius: 8px;
}
.manage-tag-restore:active {
  background: #007aff;
  color: #fff;
}

/* 管理列表 - 旧版样式（保留备用） */
.manage-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  position: relative;
  z-index: 1;
}
.manage-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12px 15px;
  background: #fafafa;
  border-radius: 8px;
  transition: all 0.2s;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.manage-item.deleted {
  background: #f5f5f5;
  opacity: 0.7;
}
.manage-item-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  overflow: hidden;
}
.manage-item-name {
  font-size: 14px;
