<view class="admin-container">
  <view class="header-title">{{convertFromLiveProductId ? '从直播商品创建新商品' : '发布新商品'}}</view>
  <view class="header-hint" wx:if="{{convertFromLiveProductId}}">
    请检查并编辑商品信息，确认后创建新商品并自动关联
  </view>

  <!-- 视频上传区（在图片池上方，体现"视频排第一"） -->
  <view class="form-group">
    <view class="label">商品视频 (选填，上传后展示在轮播图第一位，最长1分钟)</view>
    <view class="video-upload-box" wx:if="{{!videoUrl}}" bindtap="uploadVideo">
      <view class="upload-placeholder">+ 添加视频</view>
    </view>
    <view class="video-preview-box" wx:else>
      <video src="{{videoUrl}}" class="preview-video" object-fit="cover" show-play-btn="{{false}}" controls="{{false}}" autoplay loop muted></video>
      <view class="delete-btn" catchtap="removeVideo">×</view>
    </view>
    <view class="video-cover-checkbox" wx:if="{{videoUrl}}">
      <view class="checkbox-row" bindtap="toggleVideoCover">
        <view class="checkbox-icon {{useVideoCover ? 'checked' : ''}}"></view>
        <text class="checkbox-label">使用视频封面作为商品封面</text>
      </view>
      <text class="checkbox-hint">勾选后，视频首帧将作为商品在列表中的封面图</text>
    </view>
  </view>

  <view class="form-group">
    <view class="label"><text class="required">*</text>商品图片（最多99张，首图自动设为封面，长按可拖拽排序）</view>

    <movable-area class="drag-area" style="height: {{dragAreaHeight}}px;">
      <movable-view
        wx:for="{{mediaList}}"
        wx:key="id"
        class="drag-item {{dragIndex === index ? 'is-dragging' : ''}}"
        x="{{item.x}}"
        y="{{item.y}}"
        direction="all"
        out-of-bounds="true"
        bindlongpress="onDragStart"
        bindchange="onDragMove"
        bindtouchend="onDragEnd"
        data-index="{{index}}"
        animation="{{dragIndex !== index}}"
        disabled="{{dragIndex !== index}}">

        <view class="img-box">
          <image src="{{item.url}}" mode="aspectFill" class="media-img" catchtap="previewMediaImage" data-index="{{index}}"></image>
          <view class="cover-tag" wx:if="{{index === 0}}">封面</view>
          <view class="delete-btn" catchtap="removeMedia" data-index="{{index}}">×</view>
        </view>
      </movable-view>

      <view class="drag-item upload-btn-box" style="transform: translate({{uploadBtnX}}px, {{uploadBtnY}}px);" wx:if="{{mediaList.length < maxProductImages}}" bindtap="chooseMedia">
        <view class="upload-placeholder">+</view>
      </view>
    </movable-area>
  </view>

  <view class="form-group">
    <view class="label"><text class="required">*</text>商品名称</view>
    <input class="input-box" placeholder="例如：经典藏青百褶裙" value="{{title}}" bindinput="onInput" data-field="title" />
  </view>

  <!-- 套装模式开关 -->
  <view class="form-group">
    <view class="bundle-mode-row">
      <text class="bundle-mode-label">套装商品</text>
      <switch checked="{{isBundleMode}}" bindchange="toggleBundleMode" color="#07c160" />
    </view>
  </view>

  <!-- 套装子项管理 -->
  <view class="bundle-groups-section" wx:if="{{isBundleMode}}">
    <view class="label">套装子项</view>
    <scroll-view class="bundle-group-tabs" scroll-x>
      <view class="bundle-group-tab {{activeGroupIndex === index ? 'active' : ''}}"
            wx:for="{{bundleGroups}}" wx:key="index"
            bindtap="selectBundleGroup" data-index="{{index}}">
        <text>{{item.name || ('子项' + (index + 1))}}</text>
        <text class="bundle-group-del" catchtap="removeBundleGroup" data-index="{{index}}">×</text>
      </view>
      <view class="bundle-group-tab add-tab" bindtap="addBundleGroup">
        <text>+ 添加</text>
      </view>
    </scroll-view>
    <!-- 当前子项名称 -->
    <view class="bundle-group-name-row" wx:if="{{activeGroupIndex >= 0}}">
      <text class="bundle-group-name-label">子项名称：</text>
      <input id="bundleGroupNameInput" class="bundle-group-name-input" placeholder="如：上衣"
             value="{{bundleGroups[activeGroupIndex].name}}"
             bindinput="onBundleGroupNameInput"
             focus="{{bundleGroupNameFocus}}"
             bindblur="onBundleGroupNameBlur" />
    </view>
  </view>

  <!-- 当前子项提示条（套装模式下显示） -->
  <view class="bundle-group-banner" wx:if="{{isBundleMode && activeGroupIndex >= 0}}">
    <text>正在编辑：{{bundleGroups[activeGroupIndex].name || ('子项' + (activeGroupIndex + 1))}}</text>
  </view>

  <view class="form-group">
    <view class="label"><text class="required">*</text>可选尺码 (点击多选)</view>
    <view class="size-type-display" wx:if="{{currentSizeCategoryId}}">
      <text class="size-type-name">{{currentSizeCategoryName}}</text>
      <view class="switch-size-btn" bindtap="openSizeModal">切换尺码</view>
    </view>
    <view class="size-type-display" wx:else>
      <text class="size-type-name" style="color: #999;">暂无尺码类型</text>
      <view class="switch-size-btn" bindtap="openSizeModal">配置尺码</view>
    </view>
    <view class="size-options">
      <view class="size-box {{item.selected ? 'active' : ''}}" wx:for="{{sizeOptions}}" wx:key="name" bindtap="toggleSize" data-index="{{index}}">
        {{item.name}}
      </view>
    </view>
  </view>

  <view class="form-group">
    <view class="label"><text class="required">*</text>商品颜色 (打标签输入)</view>
    <view class="tags-display">
      <view class="tag-capsule color-tag" wx:for="{{colors}}" wx:key="*this">
        {{item}} <text class="remove-icon" bindtap="removeColor" data-index="{{index}}">×</text>
      </view>
    </view>
    <view class="tag-input-row">
      <input class="input-box tag-input" placeholder="例如：燕麦色..." value="{{colorInput}}" bindinput="onInput" data-field="colorInput" bindconfirm="addColor"/>
      <view class="btn-add-tag" bindtap="addColor">添加颜色</view>
    </view>
  </view>

  <view class="sku-matrix-section" wx:if="{{skuList.length > 0}}">
    <view class="label">SKU 明细</view>

    <view class="sku-console-row">
      <input class="console-input" type="digit" placeholder="价格" model:value="{{quickPrice}}" />
      <input class="console-input" type="number" placeholder="库存" model:value="{{quickStock}}" />
      
      <view class="console-img-btn" bindtap="chooseQuickImage">
        <image wx:if="{{quickImage}}" src="{{quickImage}}" mode="aspectFill" catchtap="previewQuickImage"></image>
        <view wx:if="{{quickImage}}" class="console-img-del" catchtap="removeQuickImage">×</view>
        <text wx:else class="icon-camera">📷</text>
      </view>
      
      <view class="btn-quick-fill" bindtap="applyQuickFillAll">一键填充</view>
      <view class="btn-advanced-batch" bindtap="applyBatch">批量设置</view>
    </view>

    <view class="minimal-sku-list">
      <view class="minimal-sku-row" wx:for="{{skuList}}" wx:if="{{!item._toBeRemoved}}" wx:key="index">
        <view class="sku-left">
          <view class="sku-del" catchtap="removeSku" data-index="{{index}}">×</view>
          <text class="sku-name-text">{{item.color}} / {{item.size}}</text>
        </view>

        <view class="sku-right">
          <input class="mini-input" type="digit" placeholder="价格" value="{{item.price}}" bindinput="onSkuInput" data-index="{{index}}" data-field="price" />
          <input class="mini-input" type="number" placeholder="无限" value="{{item.stock}}" bindinput="onSkuInput" data-index="{{index}}" data-field="stock" maxlength="9" />

          <view class="mini-img-upload" bindtap="uploadSkuImage" data-index="{{index}}">
            <image wx:if="{{item.image && item.image !== ''}}" src="{{item.image}}" mode="aspectFill" catchtap="previewSkuImage" data-index="{{index}}"></image>
            <text wx:elif="{{item.image === ''}}" class="img-lost-text">丢失</text>
            <text class="icon-plus" wx:else>+</text>
            <view wx:if="{{item.image && item.image !== ''}}" class="mini-img-del" catchtap="removeSkuImage" data-index="{{index}}">×</view>
            <view wx:elif="{{item.image === ''}}" class="mini-img-del" catchtap="removeSkuImage" data-index="{{index}}">×</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="divider">--- 以下为高级选填项 (丰富详情页) ---</view>

  <!-- 所属档口 -->
  <view class="form-group stall-section" style="position: relative; z-index: 100;">
    <view class="label-with-edit">
      <view class="label">所属档口 (可多选)</view>
      <view class="edit-btn" bindtap="openStallManageModal">编辑</view>
    </view>
    <view class="tags-display">
      <block wx:for="{{selectedStalls}}" wx:key="id">
        <view class="tag-capsule active-tag">
          {{item.name}} <text class="remove-icon" catchtap="removeStall" data-id="{{item.id}}">×</text>
        </view>
      </block>
    </view>
    <view class="history-section" wx:if="{{recentStalls.length > 0}}">
      <view class="history-label">最近使用</view>
      <scroll-view scroll-x class="history-scroll" enable-flex>
        <view class="history-item" wx:for="{{recentStalls}}" wx:key="id" bindtap="selectRecentStall" data-item="{{item}}">
          {{item.name}}
        </view>
      </scroll-view>
    </view>
    <view class="search-input-row">
      <input class="input-box tag-input" placeholder="输入档口名称搜索..." value="{{stallSearchKeyword}}" bindinput="onStallSearchInput" />
    </view>
    <view class="search-results floating-dropdown" wx:if="{{showStallSearch || showStallCreate}}">
      <view class="search-result-item" wx:for="{{stallSearchResults}}" wx:key="id" bindtap="selectStall" data-item="{{item}}">
        {{item.name}}
      </view>
      <view class="search-empty-item" wx:if="{{stallSearchResults.length === 0 && showStallCreate}}" bindtap="createStall">
        <text>暂无相关档口，</text>
        <text class="add-new-text">新增"{{stallSearchKeyword}}"</text>
      </view>
      <view class="search-result-item" wx:if="{{stallSearchResults.length > 0 && showStallCreate}}" bindtap="createStall" style="color: #007aff; font-weight: bold;">
        + 新增档口："{{stallSearchKeyword}}"
      </view>
    </view>
  </view>

  <!-- 标签分类 -->
  <view class="form-group tag-section" style="position: relative; z-index: 99;">
    <view class="label-with-edit">
      <view class="label">标签分类 (可多选)</view>
      <view class="edit-btn" bindtap="openTagManageModal">编辑</view>
    </view>
    <view class="tags-display">
      <block wx:for="{{selectedTags}}" wx:key="id">
        <view class="tag-capsule active-tag">
          {{item.name}} <text class="remove-icon" catchtap="removeTag" data-id="{{item.id}}">×</text>
        </view>
      </block>
    </view>
    <view class="history-section" wx:if="{{recentTags.length > 0}}">
      <view class="history-label">最近使用</view>
      <scroll-view scroll-x class="history-scroll" enable-flex>
        <view class="history-item" wx:for="{{recentTags}}" wx:key="id" bindtap="selectRecentTag" data-item="{{item}}">
          {{item.name}}
        </view>
      </scroll-view>
    </view>
    <view class="search-input-row">
      <input class="input-box tag-input" placeholder="输入标签名称搜索..." value="{{tagSearchKeyword}}" bindinput="onTagSearchInput" />
    </view>
    <view class="search-results floating-dropdown" wx:if="{{showTagSearch || showTagCreate}}">
      <view class="search-result-item" wx:for="{{tagSearchResults}}" wx:key="id" bindtap="selectTag" data-item="{{item}}">
        {{item.name}}
      </view>
      <view class="search-empty-item" wx:if="{{tagSearchResults.length === 0 && showTagCreate}}" bindtap="createTag">
        <text>暂无相关标签，</text>
        <text class="add-new-text">新增"{{tagSearchKeyword}}"</text>
      </view>
      <view class="search-result-item" wx:if="{{tagSearchResults.length > 0 && showTagCreate}}" bindtap="createTag" style="color: #007aff; font-weight: bold;">
        + 新增标签："{{tagSearchKeyword}}"
      </view>
    </view>
  </view>

  <view class="form-group">
    <view class="label">预计发货时间</view>
    <input class="input-box" placeholder="例如：付款后 48 小时内发货" value="{{shippingInfo}}" bindinput="onInput" data-field="shippingInfo" />
  </view>

  <view class="form-group">
    <view class="label">商品详情 (Description)</view>
    <textarea id="desc-input" class="textarea-box" placeholder="输入商品详细介绍、设计亮点、版型等..." value="{{description}}" bindinput="onInput" data-field="description" maxlength="-1" adjust-position="{{true}}" adjust-keyboard-to="cursor" cursor-spacing="140"></textarea>
  </view>

  <view class="form-group">
    <view class="label">材质保养 (Fabric & Care)</view>
    <textarea id="fabric-input" class="textarea-box" placeholder="例如：100% 纯棉。建议手洗，不可漂白，阴凉处悬挂晾干..." value="{{fabricCare}}" bindinput="onInput" data-field="fabricCare" maxlength="-1" adjust-position="{{true}}" adjust-keyboard-to="cursor" cursor-spacing="140"></textarea>
  </view>

  <view class="form-group">
    <view class="label">尺码指南 (Size Chart)</view>
    <textarea id="sizechart-input" class="textarea-box" placeholder="例如：S 码 裙长 80 腰围 64 (支持回车换行排版)..." value="{{sizeChartTip}}" bindinput="onInput" data-field="sizeChartTip" maxlength="-1" adjust-position="{{true}}" adjust-keyboard-to="cursor" cursor-spacing="140"></textarea>
  </view>

  <view class="form-group">
    <view class="label">温馨提示 (Tip / Q&A)</view>
    <textarea id="warmtips-input" class="textarea-box" placeholder="例如：深色衣物首次洗涤可能轻微浮色，属正常现象..." value="{{warmTips}}" bindinput="onInput" data-field="warmTips" maxlength="-1" adjust-position="{{true}}" adjust-keyboard-to="cursor" cursor-spacing="140"></textarea>
  </view>
  <view class="form-group">
    <view class="label">Lookbook 详情长图 (选填，多张)</view>
    <view class="multi-image-box">
      <image wx:for="{{lookbookImgs}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="multi-preview" catchtap="previewExtraImage" bindlongpress="removeExtraImage" data-type="lookbook" data-index="{{index}}"></image>
      <view class="multi-upload-btn" bindtap="chooseExtraImage" data-type="lookbook">+</view>
    </view>
  </view>

  <view class="form-group">
    <view class="label">Detail 细节横滑图 (选填，多张)</view>
    <view class="multi-image-box">
      <image wx:for="{{detailImgs}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="multi-preview" catchtap="previewExtraImage" bindlongpress="removeExtraImage" data-type="detail" data-index="{{index}}"></image>
      <view class="multi-upload-btn" bindtap="chooseExtraImage" data-type="detail">+</view>
    </view>
  </view>

  <view class="form-group">
    <view class="label">搭配商品 (Shop the Look)</view>
    <view class="related-list" wx:if="{{manualRelated.length > 0}}">
      <view class="related-item" wx:for="{{manualRelated}}" wx:key="id">
        <image class="related-img" src="{{item.coverUrl}}" mode="aspectFill" catchtap="previewRelatedImage" data-index="{{index}}"></image>
        <view class="related-info">
          <view class="related-title">{{item.name}}</view>
          <view class="related-price">¥ {{item.displayPrice || item.retailPrice}}</view>
        </view>
        <view class="btn-remove-related" bindtap="removeRelated" data-id="{{item.id}}">移除</view>
      </view>
    </view>
    <view class="btn-add-related" bindtap="openRelatedModal">+ 添加搭配商品</view>
    <view style="font-size: 11px; color: #999; margin-top: 8px;">未添加将根据分类标签自动智能匹配</view>
  </view>
</view>

<view class="submit-area">
  <view class="btn-draft" bindtap="saveDraft">保存草稿</view>
  <view class="btn-submit" bindtap="submitProduct">确认上架</view>
</view>

<view class="modal-mask" wx:if="{{showRelatedModal}}" catchtap="closeRelatedModal"></view>
<view class="related-modal {{showRelatedModal ? 'show' : ''}}">
  <view class="modal-header">
    <view class="modal-title">选择搭配商品</view>
    <view class="modal-close" catchtap="closeRelatedModal">×</view>
  </view>

  <view class="search-bar-wrap">
    <input class="search-input" placeholder="输入商品名称快速查找..." value="{{searchKeyword}}" bindinput="onSearchInput" />
  </view>

  <scroll-view scroll-y class="product-scroll-list">
    <view class="product-row" wx:for="{{filteredProducts}}" wx:key="id" bindtap="toggleRelated" data-item="{{item}}">
      <view class="checkbox {{item.selected ? 'checked' : ''}}"></view>
      <image class="row-img" src="{{item.coverUrl}}" mode="aspectFill"></image>
      <view class="row-info">
        <view class="row-title">{{item.name}}</view>
        <view class="row-price">¥ {{item.displayPrice || item.retailPrice}}</view>
      </view>
    </view>
    <view wx:if="{{filteredProducts.length === 0}}" class="empty-tip">未找到相关商品</view>
  </scroll-view>

  <view class="modal-footer">
    <view class="btn-confirm-modal" bindtap="confirmRelated">确认选择</view>
  </view>
</view>

<!-- 批量设置弹窗 -->
<view class="modal-mask" wx:if="{{showBatchModal}}" catchtap="closeBatchModal"></view>
<view class="batch-modal {{showBatchModal ? 'show' : ''}}">
  <view class="modal-header">
    <view class="modal-title">批量设置</view>
    <view class="modal-close" catchtap="closeBatchModal">×</view>
  </view>

  <scroll-view scroll-y class="batch-scroll">
    <view class="batch-section">
      <view class="batch-section-header">
        <view class="batch-section-title">选择颜色</view>
        
      </view>
      <view class="batch-options">
        <view class="batch-select-all" bindtap="toggleSelectAllColors">全选</view>
        <view class="batch-option {{item.selected ? 'active' : ''}}" wx:for="{{batchSelectedColors}}" wx:key="name" bindtap="toggleBatchColor" data-index="{{index}}">
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="batch-section">
      <view class="batch-section-header">
        <view class="batch-section-title">选择尺码</view>
        
      </view>
      <view class="batch-options">
        <view class="batch-select-all" bindtap="toggleSelectAllSizes">全选</view>
        <view class="batch-option {{item.selected ? 'active' : ''}}" wx:for="{{batchSelectedSizes}}" wx:key="name" bindtap="toggleBatchSize" data-index="{{index}}">
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="batch-section" style="border-bottom: none;">
      <view class="batch-section-title" style="margin-bottom: 12px;">设置参数 (留空则不修改该项)</view>
      
      <view class="batch-inputs-row">
        <input class="batch-input-wide" type="digit" placeholder="价格 (可选)" value="{{batchPrice}}" bindinput="onInput" data-field="batchPrice" />
        <input class="batch-input-wide" type="number" placeholder="库存 (可选)" value="{{batchStock}}" bindinput="onInput" data-field="batchStock" />
      </view>
      
      <view class="batch-image-section">
        <view class="batch-image-preview" wx:if="{{batchImage}}">
          <image class="batch-image" src="{{batchImage}}" mode="aspectFill" catchtap="previewBatchImage"></image>
          <view class="batch-image-del" catchtap="onInput" data-field="batchImage" data-value="">×</view>
        </view>
        <view class="batch-image-upload" wx:else bindtap="chooseBatchImage">
          <text class="icon-camera">📷 选择图片</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="modal-footer">
    <view class="btn-confirm-modal" bindtap="confirmBatch">应用批量设置</view>
  </view>
</view>

<!-- 尺码配置弹窗 -->
<view class="modal-mask" wx:if="{{showSizeModal}}" catchtap="closeSizeModal"></view>
<view class="size-modal {{showSizeModal ? 'show' : ''}}">
  <view class="modal-header">
    <view class="modal-title">尺码配置</view>
    <view class="modal-close" catchtap="closeSizeModal">×</view>
  </view>

  <scroll-view scroll-y class="size-scroll">
    <!-- 尺码类型选择 -->
    <view class="size-section">
      <view class="section-header">
        <view class="section-title">选择尺码类型</view>
      </view>
      <view class="category-list">
        <view class="category-item {{item.id === currentSizeCategoryId ? 'active' : ''}}" wx:for="{{sizeCategoryList}}" wx:key="id" bindtap="switchSizeCategory" data-id="{{item.id}}">
          {{item.name}}
          <view class="delete-category" catchtap="deleteSizeCategory" data-id="{{item.id}}">×</view>
        </view>
        <view class="add-category-input">
          <input class="category-input" placeholder="新增类型..." value="{{newCategoryName}}" bindinput="onInput" data-field="newCategoryName" />
          <view class="btn-add-category" bindtap="addSizeCategory">+</view>
        </view>
      </view>
    </view>

    <!-- 当前类型下的尺码列表 -->
    <view class="size-section">
      <view class="section-header">
        <view class="section-title">当前类型尺码</view>
      </view>
      <view class="size-list">
        <view class="size-item" wx:for="{{sizeOptions}}" wx:key="name">
          <text>{{item.name}}</text>
          <view class="delete-size" catchtap="deleteSize" data-id="{{item.id}}" data-name="{{item.name}}">×</view>
        </view>
        <view class="add-size-input">
          <input class="size-input" placeholder="新增尺码..." value="{{newSizeName}}" bindinput="onInput" data-field="newSizeName" />
          <view class="btn-add-size" bindtap="addSize">+</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="modal-footer">
    <view class="btn-confirm-modal" bindtap="closeSizeModal">完成</view>
  </view>
</view>

<!-- 档口管理弹窗 -->
<view class="modal-mask" wx:if="{{showStallManageModal}}" catchtap="closeStallManageModal"></view>
<view class="manage-modal {{showStallManageModal ? 'show' : ''}}">
  <view class="modal-header">
    <view class="modal-title">档口管理</view>
    <view class="modal-close" catchtap="closeStallManageModal">×</view>
  </view>

  <!-- 新增档口输入行（移到 scroll-view 外面） -->
  <view class="manage-add-row-outside">
    <input class="manage-input" placeholder="输入档口名称搜索或新增..." value="{{manageStallSearchKeyword}}" bindinput="onManageStallSearchInput" />
    <view class="manage-add-btn" bindtap="createStallFromModal">新增</view>
  </view>

  <scroll-view scroll-y class="manage-scroll" style="width: 100%;" scroll-top="0" show-scrollbar="{{false}}" bindscrolltoupper="onManageScrollToUpper" bindscrolltolower="onManageScrollToLower">
    <!-- 搜索提示 -->
    <view class="manage-search-hint" wx:if="{{manageStallSearchKeyword && filteredStalls.length < allStalls.length}}">
      找到 {{filteredStalls.length}} 个结果
    </view>
    <!-- 档口列表 -->
    <view class="manage-tag-list">
      <view class="manage-tag-item {{item.deleted ? 'deleted' : ''}}" wx:for="{{filteredStalls}}" wx:key="id">
        <text class="manage-tag-name">{{item.name}}</text>
        <text class="manage-tag-delete" wx:if="{{!item.deleted}}" catchtap="deleteStall" data-id="{{item.id}}">×</text>
        <text class="manage-tag-restore" wx:else catchtap="restoreStall" data-id="{{item.id}}">恢复</text>
      </view>
      <view wx:if="{{filteredStalls.length === 0}}" class="manage-empty">
        <text wx:if="{{manageStallSearchKeyword}}">未找到匹配的档口</text>
        <text wx:else>暂无档口</text>
      </view>
    </view>
  </scroll-view>
</view>

<!-- 标签管理弹窗 -->
<view class="modal-mask" wx:if="{{showTagManageModal}}" catchtap="closeTagManageModal"></view>
<view class="manage-modal {{showTagManageModal ? 'show' : ''}}">
  <view class="modal-header">
    <view class="modal-title">标签管理</view>
    <view class="modal-close" catchtap="closeTagManageModal">×</view>
  </view>

  <!-- 新增标签输入行（移到 scroll-view 外面） -->
  <view class="manage-add-row-outside">
    <input class="manage-input" placeholder="输入标签名称搜索或新增..." value="{{manageTagSearchKeyword}}" bindinput="onManageTagSearchInput" />
    <view class="manage-add-btn" bindtap="createTagFromModal">新增</view>
  </view>

  <scroll-view scroll-y class="manage-scroll" style="width: 100%;" scroll-top="0" show-scrollbar="{{false}}" bindscrolltoupper="onManageScrollToUpper" bindscrolltolower="onManageScrollToLower">
    <!-- 搜索提示 -->
    <view class="manage-search-hint" wx:if="{{manageTagSearchKeyword && filteredTags.length < allTags.length}}">
      找到 {{filteredTags.length}} 个结果
    </view>
    <!-- 标签列表 -->
    <view class="manage-tag-list">
      <view class="manage-tag-item {{item.deleted ? 'deleted' : ''}}" wx:for="{{filteredTags}}" wx:key="id">
        <text class="manage-tag-name">{{item.name}}</text>
        <text class="manage-tag-delete" wx:if="{{!item.deleted}}" catchtap="deleteTag" data-id="{{item.id}}">×</text>
        <text class="manage-tag-restore" wx:else catchtap="restoreTag" data-id="{{item.id}}">恢复</text>
      </view>
      <view wx:if="{{filteredTags.length === 0}}" class="manage-empty">
        <text wx:if="{{manageTagSearchKeyword}}">未找到匹配的标签</text>
        <text wx:else>暂无标签</text>
      </view>
    </view>
  </scroll-view>
</view>
