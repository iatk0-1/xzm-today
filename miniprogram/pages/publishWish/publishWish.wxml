<view class="publish-wrapper">

  <view class="section-tip" wx:if="{{loading}}">正在加载心愿...</view>
  <view class="section-tip" wx:if="{{loadFailed}}">心愿加载失败，请返回后重试</view>

  <view class="image-header">
    <view>
      <view class="section-title">心愿图片</view>
      <view class="section-tip">第一张作为市集封面，单次最多选择20张</view>
    </view>
    <text class="image-count">{{imageList.length}} / {{maxImages}}</text>
  </view>

  <view class="image-grid">
    <view class="image-item" wx:for="{{imageList}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" class="preview-img" bindtap="previewImage" data-index="{{index}}"></image>
      <view class="cover-tag" wx:if="{{index === 0}}">封面</view>
      <view class="delete-btn" catchtap="removeImage" data-index="{{index}}">×</view>
      <view class="sort-actions">
        <view class="sort-btn {{index === 0 ? 'disabled' : ''}}" catchtap="moveImageLeft" data-index="{{index}}">‹</view>
        <text class="image-index">{{index + 1}}</text>
        <view class="sort-btn {{index === imageList.length - 1 ? 'disabled' : ''}}" catchtap="moveImageRight" data-index="{{index}}">›</view>
      </view>
    </view>

    <view class="add-image-btn" wx:if="{{imageList.length < maxImages}}" bindtap="chooseImage">
      <view class="upload-icon">+</view>
      <text class="upload-text">添加图片</text>
    </view>
  </view>

  <view class="form-section">
    <view class="input-group">
      <input class="input-title" placeholder="品牌 / 款式名称" placeholder-class="ph-style" bindinput="inputTitle" value="{{title}}" />
    </view>

    <view class="input-group">
      <textarea class="input-desc" placeholder="描述你的具体需求：如尺码、颜色、新旧程度要求等..." placeholder-class="ph-style" bindinput="inputDesc" value="{{content}}" maxlength="200" auto-height></textarea>
    </view>

    <view class="split-setting">
      <view class="split-copy">
        <view class="split-title">按图片分别创建心愿</view>
        <view class="split-desc" wx:if="{{wishId}}">编辑时，全部图片保留在当前心愿</view>
        <view class="split-desc" wx:elif="{{linkedProduct}}">已关联商品，不可按图片分别创建心愿</view>
        <view class="split-desc" wx:elif="{{!splitByImage}}">关闭时，全部图片归入同一条心愿</view>
        <view class="split-desc active" wx:else>开启后，将创建 {{imageList.length}} 条心愿</view>
      </view>
      <switch checked="{{splitByImage}}" disabled="{{!!linkedProduct || !!wishId}}" bindchange="toggleSplitByImage" color="#111111" />
    </view>

    <view class="linked-products" wx:if="{{canLinkProduct}}">
      <view class="section-title">关联商品</view>
      <view class="section-tip">{{isStallManager ? '仅可选择自己创建且在负责档口的商品' : '选择一件商品，与当前心愿关联'}}</view>
      <view class="linked-product-row" wx:if="{{linkedProduct}}">
        <image wx:if="{{linkedProduct.coverUrl}}" class="product-cover" src="{{linkedProduct.coverUrl}}" mode="aspectFill" />
        <view class="product-info">
          <view class="product-name">{{linkedProduct.name}}</view>
          <view class="product-price" wx:if="{{linkedProduct.displayPrice || linkedProduct.retailPrice}}">¥ {{linkedProduct.displayPrice || linkedProduct.retailPrice}}</view>
        </view>
        <view class="remove-product" bindtap="removeLinkedProduct">移除</view>
      </view>
      <view class="add-product" bindtap="openProductPicker">{{linkedProduct ? '更换关联商品' : '+ 添加关联商品'}}</view>
    </view>
  </view>

  <view class="bottom-action">
    <view class="btn-publish {{imageList.length && title && content && !submitting && !loading && !loadFailed ? '' : 'disabled'}}" bindtap="submitWish">
      {{submitting ? '保 存 中...' : (wishId ? '保 存 修 改' : (splitByImage ? '分 别 发 布' : '发 布 求 购'))}}
    </view>
  </view>
</view>

<view class="product-picker-mask" wx:if="{{showProductPicker}}" catchtap="closeProductPicker" catchtouchmove="stopPickerTap"></view>
<view class="product-picker" wx:if="{{showProductPicker}}" catchtap="stopPickerTap">
  <view class="picker-header"><text>选择关联商品</text><text bindtap="closeProductPicker">×</text></view>
  <view class="product-search">
    <input placeholder="搜索商品、档口或标签" value="{{productKeyword}}" bindinput="inputProductKeyword" bindconfirm="searchProducts" confirm-type="search" />
    <view bindtap="searchProducts">搜索</view>
  </view>
  <view class="product-filters">
    <picker class="product-filter" range="{{stallOptions}}" range-key="name" value="{{stallIndex}}" bindchange="changeProductStall"><view>{{stallOptions[stallIndex].name}} ▾</view></picker>
    <picker class="product-filter" range="{{tagOptions}}" range-key="name" value="{{tagIndex}}" bindchange="changeProductTag"><view>{{tagOptions[tagIndex].name}} ▾</view></picker>
  </view>
  <scroll-view class="product-scroll" scroll-y="true" bindscrolltolower="loadMoreProducts">
    <view class="picker-product-row" wx:for="{{productList}}" wx:key="id" bindtap="selectProduct" data-id="{{item.id}}">
      <image class="product-cover" src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="product-info"><view class="product-name">{{item.name}}</view><view class="product-price">¥ {{item.displayPrice || item.retailPrice}}</view></view>
      <view class="product-radio {{pickerProduct && pickerProduct.id == item.id ? 'selected' : ''}}">{{pickerProduct && pickerProduct.id == item.id ? '✓' : ''}}</view>
    </view>
    <view class="picker-status" wx:if="{{productLoading}}">加载中...</view>
    <view class="picker-status" wx:elif="{{productError}}" bindtap="searchProducts">{{productError}}，点击重试</view>
    <view class="picker-status" wx:elif="{{!productList.length}}">暂无符合条件的商品</view>
    <view class="picker-status" wx:elif="{{!productHasMore}}">已加载全部商品</view>
  </scroll-view>
  <view class="picker-selected" wx:if="{{pickerProduct}}">已选：{{pickerProduct.name}}</view>
  <view class="picker-confirm" bindtap="confirmProduct">确认选择</view>
</view>
