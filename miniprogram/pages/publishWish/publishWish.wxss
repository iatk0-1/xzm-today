page { background-color: #ffffff; }
.publish-wrapper { padding: 40rpx; padding-bottom: 160rpx; }

/* 占位符统一高级灰 */
.ph-style { color: #cccccc; font-weight: normal; }

/* 图片上传区 */
.upload-section { width: 100%; height: 600rpx; background-color: #f8f9fa; border-radius: 20rpx; margin-bottom: 60rpx; overflow: hidden; display: flex; justify-content: center; align-items: center; position: relative; border: 2rpx dashed #eeeeee; }
.preview-img { width: 100%; height: 100%; display: block; }
.upload-placeholder { display: flex; flex-direction: column; align-items: center; color: #999; }
.upload-icon { font-size: 80rpx; font-weight: 200; margin-bottom: 20rpx; color: #ccc; }
.upload-text { font-size: 26rpx; letter-spacing: 2rpx; }

/* 表单区 */
.form-section { display: flex; flex-direction: column; gap: 40rpx; }
.input-group { border-bottom: 1rpx solid #eeeeee; padding-bottom: 20rpx; }

.input-title { font-size: 36rpx; font-weight: bold; color: #111; height: 60rpx; }
.input-desc { width: 100%; min-height: 120rpx; font-size: 28rpx; color: #333; line-height: 1.5; padding-top: 10rpx; }

.price-group { display: flex; align-items: center; justify-content: space-between; border-bottom: none; background: #f8f9fa; padding: 30rpx; border-radius: 16rpx; }
.price-label { font-size: 28rpx; color: #666; font-weight: bold; }
.input-price { flex: 1; text-align: right; font-size: 36rpx; font-weight: bold; font-family: "Times New Roman", Times, serif; color: #111; }

/* 底部发布按钮 */
.bottom-action { position: fixed; bottom: 0; left: 0; width: 100%; padding: 20rpx 40rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-sizing: border-box; z-index: 100; border-top: 1rpx solid #f5f5f5; }
.btn-publish { height: 90rpx; background-color: #111; color: #fff; border-radius: 45rpx; display: flex; justify-content: center; align-items: center; font-size: 30rpx; font-weight: bold; letter-spacing: 4rpx; transition: all 0.2s; }
.btn-publish.disabled { background-color: #cccccc; color: #ffffff; pointer-events: none; }