page { background-color: #ffffff; }
.publish-wrapper { padding: 40rpx; padding-bottom: 180rpx; }

/* 占位符统一高级灰 */
.ph-style { color: #cccccc; font-weight: normal; }

/* 图片上传区 */
.image-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #111; }
.section-tip { margin-top: 8rpx; font-size: 22rpx; color: #999; }
.image-count { font-size: 24rpx; color: #666; }
.image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18rpx; margin-bottom: 50rpx; }
.image-item, .add-image-btn { position: relative; height: 240rpx; border-radius: 12rpx; overflow: hidden; background: #f8f9fa; }
.preview-img { width: 100%; height: 190rpx; display: block; }
.cover-tag { position: absolute; top: 8rpx; left: 8rpx; padding: 4rpx 10rpx; color: #fff; background: rgba(0,0,0,.7); border-radius: 6rpx; font-size: 20rpx; }
.delete-btn { position: absolute; top: 6rpx; right: 6rpx; width: 42rpx; height: 42rpx; line-height: 38rpx; text-align: center; color: #fff; background: rgba(0,0,0,.65); border-radius: 50%; font-size: 34rpx; }
.sort-actions { height: 50rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 12rpx; background: #f2f2f2; }
.sort-btn { width: 46rpx; text-align: center; color: #111; font-size: 36rpx; }
.sort-btn.disabled { color: #ccc; }
.image-index { color: #777; font-size: 20rpx; }
.add-image-btn { box-sizing: border-box; height: 240rpx; border: 2rpx dashed #ddd; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #999; }
.upload-icon { font-size: 58rpx; line-height: 1; font-weight: 200; margin-bottom: 14rpx; color: #bbb; }
.upload-text { font-size: 22rpx; letter-spacing: 1rpx; }

/* 表单区 */
.form-section { display: flex; flex-direction: column; gap: 40rpx; }
.input-group { border-bottom: 1rpx solid #eeeeee; padding-bottom: 20rpx; }

.input-title { font-size: 36rpx; font-weight: bold; color: #111; height: 60rpx; }
.input-desc { width: 100%; min-height: 120rpx; font-size: 28rpx; color: #333; line-height: 1.5; padding-top: 10rpx; }

.split-setting { display: flex; align-items: center; justify-content: space-between; padding: 30rpx; background: #f8f9fa; border-radius: 16rpx; }
.split-copy { flex: 1; padding-right: 24rpx; }
.split-title { color: #111; font-size: 28rpx; font-weight: 700; }
.split-desc { margin-top: 8rpx; color: #999; font-size: 22rpx; line-height: 1.4; }
.split-desc.active { color: #d32f2f; }

/* 底部发布按钮 */
.bottom-action { position: fixed; bottom: 0; left: 0; width: 100%; padding: 20rpx 40rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-sizing: border-box; z-index: 100; border-top: 1rpx solid #f5f5f5; }
.btn-publish { height: 90rpx; background-color: #111; color: #fff; border-radius: 45rpx; display: flex; justify-content: center; align-items: center; font-size: 30rpx; font-weight: bold; letter-spacing: 4rpx; transition: all 0.2s; }
.btn-publish.disabled { background-color: #cccccc; color: #ffffff; pointer-events: none; }

.linked-product-row, .picker-product-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #eee; }
.product-cover { flex-shrink: 0; width: 110rpx; height: 130rpx; border-radius: 8rpx; background: #f5f5f5; }
.product-info { flex: 1; min-width: 0; }
.product-name { color: #111; font-size: 26rpx; word-break: break-all; }
.product-price { margin-top: 12rpx; color: #888; font-size: 24rpx; }
.remove-product { color: #999; font-size: 24rpx; padding: 16rpx; }
.add-product { margin-top: 24rpx; padding: 24rpx; border: 1rpx dashed #ccc; text-align: center; font-size: 26rpx; border-radius: 8rpx; }
.product-picker-mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 2000; }
.product-picker { position: fixed; left: 0; right: 0; bottom: 0; z-index: 2001; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.picker-header { display: flex; align-items: center; justify-content: space-between; color: #111; font-size: 32rpx; font-weight: 600; }
.picker-header text:last-child { font-size: 46rpx; padding: 0 12rpx; color: #999; }
.product-search { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; background: #f5f5f5; padding: 18rpx 22rpx; border-radius: 10rpx; font-size: 26rpx; }
.product-search input { flex: 1; min-width: 0; }
.product-filters { display: flex; gap: 20rpx; margin: 24rpx 0; }
.product-filter { flex: 1; min-width: 0; padding: 18rpx; background: #f8f8f8; border-radius: 8rpx; font-size: 24rpx; }
.product-filter view { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.product-scroll { height: 42vh; }
.product-radio { width: 38rpx; height: 38rpx; border-radius: 50%; border: 2rpx solid #ddd; text-align: center; line-height: 38rpx; font-size: 24rpx; flex-shrink: 0; }
.product-radio.selected { background: #111; color: #fff; border-color: #111; }
.picker-status { padding: 32rpx; color: #999; text-align: center; font-size: 24rpx; }
.picker-selected { padding: 16rpx 0; font-size: 24rpx; color: #666; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.picker-confirm { margin-top: 20rpx; padding: 24rpx; text-align: center; background: #111; color: #fff; border-radius: 8rpx; font-size: 28rpx; }
