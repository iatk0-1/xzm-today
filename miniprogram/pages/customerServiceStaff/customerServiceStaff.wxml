<view class="page">
  <view class="title">客服管理</view>
  <view class="hint">管理员可直接接待。新增客服需要先用手机号登录小程序。</view>
  <view class="form"><input type="number" maxlength="11" placeholder="输入用户手机号" value="{{phone}}" bindinput="onPhone"/><view class="add" bindtap="add">开通</view></view>
  <view class="section">已开通客服</view>
  <view class="staff-item" wx:for="{{staff}}" wx:key="userId">
    <image class="avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"/>
    <view class="staff-info"><view>{{item.nickname || '未设置昵称'}}</view><view class="phone">{{item.phone || '未绑定手机号'}}</view></view>
    <view class="remove" bindtap="remove" data-id="{{item.userId}}">撤销</view>
  </view>
  <view class="empty" wx:if="{{!staff.length && !loading}}">暂无单独授权的客服</view>
</view>
