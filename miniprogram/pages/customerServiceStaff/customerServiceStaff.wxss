.page { min-height: 100vh; background: #f6f6f6; padding: 22px 16px; box-sizing: border-box; }
.title { font-size: 20px; font-weight: bold; margin: 12px 0; }.hint { font-size: 12px; color: #888; line-height: 1.5; }
.form { display: flex; align-items: center; gap: 10px; margin: 18px 0 28px; }
.form input { flex: 1; height: 42px; padding: 0 12px; background: #fff; border-radius: 8px; font-size: 14px; }
.add { padding: 10px 15px; background: #1a1a1a; color: #fff; border-radius: 8px; font-size: 13px; }
.section { font-size: 14px; font-weight: bold; margin-bottom: 10px; }.staff-item { display: flex; align-items: center; gap: 10px; background: #fff; padding: 12px; border-bottom: 1rpx solid #eee; }
.avatar { width: 40px; height: 40px; border-radius: 20px; background: #ddd; }.staff-info { flex: 1; font-size: 14px; }.phone { color: #999; font-size: 12px; margin-top: 4px; }.remove { color: #d44; font-size: 12px; }.empty { color: #aaa; text-align: center; font-size: 13px; padding: 30px; }
