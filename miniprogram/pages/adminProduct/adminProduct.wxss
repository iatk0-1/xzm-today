page { background-color: #f0f0f0; height: 100vh; display: flex; flex-direction: column; }
.admin-wrapper { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

.product-scroll-area { flex: 1; padding: 20rpx; box-sizing: border-box; }
.empty-state { padding: 100px 0; text-align: center; color: #999; font-size: 14px; }

/* 商品卡片 */
.product-card { background-color: #ffffff; border-radius: 12rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }

.card-main { display: flex; margin-bottom: 24rpx; }
.product-img { width: 140rpx; height: 140rpx; border-radius: 8rpx; background-color: #f5f5f5; margin-right: 20rpx; flex-shrink: 0; }
.product-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.product-title { font-size: 28rpx; font-weight: bold; color: #111; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.product-price { font-size: 28rpx; font-weight: bold; color: #111; font-family: "Times New Roman", Times, serif; }

.product-tags { display: flex; gap: 10rpx; margin-top: 10rpx; }
.tag { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 6rpx; background: #f5f5f5; color: #666; }
.status-tag.online { background: #e6f7ff; color: #1890ff; }
.status-tag.offline { background: #fff1f0; color: #f5222d; }

/* 底部操作 */
.card-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1rpx dashed #eee; padding-top: 24rpx; }
.time { font-size: 22rpx; color: #999; }
.action-group { display: flex; gap: 20rpx; }
.btn-ghost { padding: 0 24rpx; height: 50rpx; line-height: 48rpx; font-size: 24rpx; color: #333; border: 1rpx solid #ccc; border-radius: 25rpx; }
.btn-danger { padding: 0 24rpx; height: 50rpx; line-height: 50rpx; font-size: 24rpx; color: #fff; background: #f5222d; border-radius: 25rpx; }