<view class="admin-wrapper">
  <!-- 顶部操作栏 -->
  <view class="admin-header">
    <view class="page-title">商品管理台</view>
    <view class="header-actions">
      <view class="header-btn" bindtap="goToDraftBox">草稿箱（{{draftCount}}）</view>
      <view class="header-btn {{selectMode ? 'active' : ''}}" bindtap="toggleSelectMode">
        {{selectMode ? '退出多选' : '多选'}}
      </view>
      <view class="recycle-bin-btn" wx:if="{{!isStallManager}}" bindtap="goToRecycleBin">
        <text class="icon">🗑️</text>
        <text>回收站</text>
      </view>
    </view>
  </view>

  <view class="product-toolbar">
    <view class="search-input-wrapper">
      <input class="search-input" placeholder="搜索名称、货号、档口或标签" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearchConfirm" focus="{{searchFocus}}" />
      <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">×</view>
      <view class="search-btn" bindtap="onSearchConfirm">搜索</view>
    </view>

    <scroll-view class="status-tabs" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="status-tab {{activeStatus === 'all' ? 'active' : ''}}" bindtap="selectStatusTab" data-status="all">全部</view>
      <view class="status-tab {{activeStatus === 'on' ? 'active' : ''}}" bindtap="selectStatusTab" data-status="on">已上架</view>
      <view class="status-tab {{activeStatus === 'off' ? 'active' : ''}}" bindtap="selectStatusTab" data-status="off">已下架</view>
      <view class="status-tab {{activeStatus === 'sold_out' ? 'active' : ''}}" bindtap="selectStatusTab" data-status="sold_out">已售罄</view>
      <view class="status-tab {{activeStatus === 'scheduled' ? 'active' : ''}}" bindtap="selectStatusTab" data-status="scheduled">已定时</view>
    </scroll-view>

    <view class="filter-section">
      <view class="filter-row">
        <text class="filter-label">档口</text>
        <view class="filter-fixed-option filter-tag {{selectedStall === '' ? 'active' : ''}}" bindtap="selectStall" data-stall="all">全部</view>
        <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="filter-options">
            <view class="filter-tag {{selectedStall === item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="filter-row">
        <text class="filter-label">标签</text>
        <view class="filter-fixed-option filter-tag {{selectedTag === '' ? 'active' : ''}}" bindtap="selectTag" data-tag="all">全部</view>
        <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="filter-options">
            <view class="filter-tag {{selectedTag === item.id ? 'active' : ''}}" wx:for="{{tagList}}" wx:key="id" bindtap="selectTag" data-tag="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="product-scroll-area {{selectMode ? 'with-batch-bar' : ''}}" enable-flex enhanced refresher-enabled="true" refresher-triggered="{{isRefreshing}}" refresher-background="#f2f2f2" bindrefresherrefresh="onRefresh" bindscrolltolower="loadMore">

    <view class="empty-state" wx:if="{{products.length === 0 && !isLoading}}">
      <view class="empty-text" wx:if="{{searchKeyword || activeStatus !== 'all' || selectedStall || selectedTag}}">没有找到符合条件的商品</view>
      <view class="empty-text" wx:else>系统里还没有任何商品</view>
    </view>

    <view class="product-card {{item.selected ? 'selected' : ''}}" wx:for="{{products}}" wx:key="id">

      <view class="card-main" bindtap="handleProductTap" data-id="{{item.id}}">
        <view class="product-select" wx:if="{{selectMode}}" catchtap="toggleProductSelect" data-id="{{item.id}}">
          <view class="checkbox {{item.selected ? 'checked' : ''}}">
            <text wx:if="{{item.selected}}">✓</text>
          </view>
        </view>
        <image class="product-img" src="{{item.coverUrl}}" mode="aspectFill"></image>
        <view class="product-info">
          <view class="product-title">{{item.name}}</view>
          <view class="manager-label" wx:if="{{item.managerName}}">档口负责人：{{item.managerName}}</view>
          <view class="product-pricing-row" catchtap="openSkuPricing" data-id="{{item.id}}">
            <text class="product-price">￥{{item.displayPrice || item.retailPrice}}</text>
            <text class="product-cost">成本：￥{{item.costPrice == null ? '--' : item.costPrice}}</text>
            <view class="quick-edit-icon"><view class="pencil-icon"></view></view>
          </view>
          <view class="product-article-row" catchtap="openArticleNoEditor" data-id="{{item.id}}">
            <text class="product-article-text">货号：{{item.articleNo || '未填写'}}</text>
            <view class="quick-edit-icon"><view class="pencil-icon"></view></view>
          </view>
          <view class="relation-group" wx:if="{{!isStallManager}}" catchtap="onRelationTap" catchlongpress="onRelationLongPress" data-type="stall" data-product-id="{{item.id}}">
            <text class="relation-label">档口</text>
            <view class="relation-list">
              <view class="tag stall-tag" wx:for="{{item.stallRelations}}" wx:for-item="relation" wx:key="id" catchlongpress="onRelationLongPress" data-type="stall" data-product-id="{{item.id}}">
                <text>{{relation.name}}</text>
                <text class="relation-remove" wx:if="{{relationEditProductId === item.id && relationEditType === 'stall'}}" catchtap="removeProductRelation" data-id="{{relation.id}}" data-name="{{relation.name}}" data-type="stall" data-product-id="{{item.id}}">×</text>
              </view>
            </view>
            <view class="relation-add" catchtap="openRelationPicker" data-type="stall" data-product-id="{{item.id}}">+</view>
          </view>
          <view class="relation-group" wx:if="{{!isStallManager}}" catchtap="onRelationTap" catchlongpress="onRelationLongPress" data-type="tag" data-product-id="{{item.id}}">
            <text class="relation-label">标签</text>
            <view class="relation-list">
              <view class="tag" wx:for="{{item.tagRelations}}" wx:for-item="relation" wx:key="id" catchlongpress="onRelationLongPress" data-type="tag" data-product-id="{{item.id}}">
                <text>{{relation.name}}</text>
                <text class="relation-remove" wx:if="{{relationEditProductId === item.id && relationEditType === 'tag'}}" catchtap="removeProductRelation" data-id="{{relation.id}}" data-name="{{relation.name}}" data-type="tag" data-product-id="{{item.id}}">×</text>
              </view>
            </view>
            <view class="relation-add" catchtap="openRelationPicker" data-type="tag" data-product-id="{{item.id}}">+</view>
          </view>
          <view class="product-tags">
            <text class="tag status-tag {{item.status === 'off' ? 'offline' : (item.soldOut ? 'sold-out' : 'online')}}">{{item.status === 'off' ? '已下架' : (item.soldOut ? '已售罄' : '售卖中')}}</text>
            <text class="tag status-tag sold-out" wx:if="{{item.status === 'off' && item.soldOut}}">已售罄</text>
          </view>
        </view>
      </view>

      <view class="card-footer {{item.hasSchedule ? 'with-schedule' : ''}}">
        <view class="card-time-row">
          <view class="time">上架时间：{{item.listedTimeStr || '未上架'}}</view>
          <view class="schedule-info" wx:if="{{item.hasSchedule}}">
            <text>定时时间：{{item.scheduleTimeStr}} {{item.scheduleAction}}</text>
            <view class="schedule-cancel {{batchOperating ? 'disabled' : ''}}" catchtap="cancelProductSchedule" data-id="{{item.id}}">取消</view>
          </view>
        </view>
        <view class="action-group" wx:if="{{!selectMode}}">
          <view class="btn-ghost" catchtap="toggleStatus" data-id="{{item.id}}" data-status="{{item.status}}">
            {{item.status === 'off' ? '重新上架' : '下架'}}
          </view>
          <view class="btn-danger" catchtap="deleteProduct" data-id="{{item.id}}">删除</view>
        </view>
      </view>

    </view>
  </scroll-view>

  <view class="relation-picker" wx:if="{{showRelationPicker}}">
    <view class="relation-picker-mask" catchtap="closeRelationPicker"></view>
    <view class="relation-picker-panel">
      <view class="relation-picker-header">
        <text>添加{{relationPickerType === 'stall' ? '档口' : '标签'}}</text>
        <text class="relation-picker-close" catchtap="closeRelationPicker">×</text>
      </view>
      <scroll-view class="relation-picker-list" scroll-y="true">
        <view class="relation-picker-item" wx:for="{{relationPickerItems}}" wx:key="id" bindtap="selectRelationOption" data-id="{{item.id}}" data-name="{{item.name}}">
          <text>{{item.name}}</text>
          <text class="relation-picker-arrow">›</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="batch-bar" wx:if="{{selectMode}}">
    <view class="batch-summary">
      <view class="batch-count">已选 {{selectedCount}} 个</view>
      <view class="batch-selection-actions">
        <view class="batch-clear cancel-schedule {{selectedCount === 0 || batchOperating ? 'disabled' : ''}}" bindtap="batchCancelSchedules">取消定时</view>
        <view class="batch-clear" bindtap="toggleSelectAllLoaded">{{allSelected ? '取消全选' : '全选当前列表'}}</view>
        <view class="batch-clear {{selectedCount === 0 ? 'disabled' : ''}}" bindtap="clearSelection">清空</view>
      </view>
    </view>
    <view class="batch-actions">
      <view class="batch-btn secondary {{selectedCount === 0 ? 'disabled' : ''}}" bindtap="openBatchSchedule">定时上架/下架</view>
      <view class="batch-btn primary {{selectedCount === 0 ? 'disabled' : ''}}" bindtap="batchSetStatus" data-status="on">上架</view>
      <view class="batch-btn danger {{selectedCount === 0 ? 'disabled' : ''}}" bindtap="batchSetStatus" data-status="off">下架</view>
      <view class="batch-btn delete {{selectedCount === 0 ? 'disabled' : ''}}" bindtap="batchDelete">删除</view>
    </view>
  </view>
</view>

<product-schedule visible="{{showProductSchedule}}" busy="{{batchOperating}}" allow-cancel="{{false}}" hint="确认后立即为所选商品保存定时设置" bind:close="closeProductSchedule" bind:confirm="confirmBatchSchedule" />

<view class="quick-edit-overlay" wx:if="{{quickEditVisible}}">
  <view class="quick-edit-mask" catchtap="closeQuickEdit" catchtouchmove="stopQuickEditTouch"></view>
  <view class="quick-edit-panel">
    <view class="quick-edit-header">
      <text>{{quickEditType === 'sku' ? 'SKU 明细' : '修改货号'}}</text>
      <view class="quick-edit-close" catchtap="closeQuickEdit">×</view>
    </view>
    <view class="quick-edit-product">{{quickEditProductName}}</view>
    <block wx:if="{{quickEditType === 'sku'}}">
      <view class="quick-edit-hint" wx:if="{{isStallManager}}">修改成本后，保存时按商品计价规则更新售价</view>
      <view class="quick-edit-loading" wx:if="{{quickEditLoading}}">正在加载规格…</view>
      <block wx:else>
        <view class="quick-pricing-console">
          <input class="quick-pricing-input" type="digit" placeholder="批量成本" value="{{quickEditCost}}" bindinput="onQuickEditInput" data-field="quickEditCost" disabled="{{quickEditSaving}}" />
          <input wx:if="{{!isStallManager}}" class="quick-pricing-input" type="digit" placeholder="批量价格" value="{{quickEditPrice}}" bindinput="onQuickEditInput" data-field="quickEditPrice" disabled="{{quickEditSaving}}" />
        </view>
        <view class="quick-pricing-actions">
          <view bindtap="fillAllSkuPricing">一键填充</view>
          <view bindtap="toggleSkuPricingBatch">{{quickEditBatchVisible ? '收起批量设置' : '批量设置'}}</view>
        </view>
        <scroll-view class="quick-edit-scroll" scroll-y="true">
          <view class="quick-pricing-batch" wx:if="{{quickEditBatchVisible}}">
            <text class="quick-batch-title">选择颜色（不选则不限）</text>
            <view class="quick-batch-options">
              <view class="quick-batch-option" bindtap="toggleAllPricingOptions" data-field="quickEditColors">全选/取消</view>
              <view class="quick-batch-option {{item.selected ? 'active' : ''}}" wx:for="{{quickEditColors}}" wx:key="name" bindtap="togglePricingOption" data-field="quickEditColors" data-index="{{index}}">{{item.name}}</view>
            </view>
            <text class="quick-batch-title">选择尺码（不选则不限）</text>
            <view class="quick-batch-options">
              <view class="quick-batch-option" bindtap="toggleAllPricingOptions" data-field="quickEditSizes">全选/取消</view>
              <view class="quick-batch-option {{item.selected ? 'active' : ''}}" wx:for="{{quickEditSizes}}" wx:key="name" bindtap="togglePricingOption" data-field="quickEditSizes" data-index="{{index}}">{{item.name}}</view>
            </view>
            <view class="quick-batch-apply" bindtap="applySkuPricingBatch">应用批量设置</view>
          </view>
          <view class="quick-sku-row" wx:for="{{quickEditSkus}}" wx:key="id">
            <view class="quick-sku-name">{{item.bundleGroupName ? item.bundleGroupName + ' · ' : ''}}{{item.spec || '默认'}} / {{item.size || '均码'}}</view>
            <view class="quick-sku-fields">
              <view class="quick-sku-field"><text>成本</text><input type="digit" placeholder="选填" value="{{item.costPrice}}" bindinput="onQuickSkuInput" data-index="{{index}}" data-field="costPrice" bindblur="onQuickSkuCostBlur" disabled="{{quickEditSaving}}" /></view>
              <view class="quick-sku-field"><text>价格</text><input type="digit" placeholder="售价" value="{{item.retailPrice}}" bindinput="onQuickSkuInput" data-index="{{index}}" data-field="retailPrice" disabled="{{isStallManager || quickEditSaving}}" /></view>
            </view>
          </view>
          <view class="quick-edit-loading" wx:if="{{!quickEditSkus.length}}">暂无可编辑的规格</view>
        </scroll-view>
      </block>
    </block>
    <view class="quick-article-form" wx:else>
      <input class="quick-article-input" placeholder="请输入货号（选填）" value="{{quickEditArticleNo}}" bindinput="onQuickEditInput" data-field="quickEditArticleNo" maxlength="100" disabled="{{quickEditSaving}}" />
    </view>
    <view class="quick-edit-footer">
      <button class="quick-edit-cancel" bindtap="closeQuickEdit" disabled="{{quickEditSaving}}">取消</button>
      <button class="quick-edit-save" bindtap="saveQuickEdit" loading="{{quickEditSaving}}" disabled="{{quickEditLoading || quickEditSaving || quickEditPricingBusy || (quickEditType === 'sku' && !quickEditSkus.length)}}">保存</button>
    </view>
  </view>
</view>
