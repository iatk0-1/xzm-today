<view class="page-wrapper" style="padding-top: {{navHeight}}px;">
  
  <view class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px; height: 44px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
  </view>

  <swiper class="main-swiper" indicator-dots="true" indicator-color="rgba(0,0,0,0.15)" indicator-active-color="#111" circular="true">
    <swiper-item wx:for="{{bannerImgs}}" wx:key="*this">
      <image class="swiper-img" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <view class="content-wrapper">
    <!-- <view class="shipping-info" wx:if="{{product.shippingInfo}}">{{product.shippingInfo}}</view> 发货时间暂时不写 -->
    <view class="detail-title">{{product.title}}</view>
    <view class="detail-price">¥ {{product.displayPrice || product.price}}</view>

    <view class="options-section" bindtap="openSkuPanel" data-action="cart">
      <view class="size-selector">
        <text class="size-text" style="color: #333;">{{selectedColor || '颜色'}} / {{selectedSize || '尺码'}}</text>
        <text class="select-icon">↕</text>
      </view>
    </view>

    <view class="consult-section" bindtap="consultService">
      <view class="consult-left">
        <image class="consult-icon" src="/images/icons/customer-service.svg" mode="aspectFit"></image>
        <text class="consult-label">咨询客服</text>
      </view>
      <text class="consult-arrow">›</text>
    </view>

<!-- 四段提示信息-->
<view class="aura-tabs-container" wx:if="{{product.description || product.fabricCare || product.sizeChartTip || product.warmTips}}">
      
      <view class="aura-tabs-header">
        <view class="aura-tab {{currentAuraTab === 'desc' ? 'active' : ''}}" wx:if="{{product.description}}" bindtap="switchAuraTab" data-tab="desc">详情</view>
        <view class="aura-tab {{currentAuraTab === 'fabric' ? 'active' : ''}}" wx:if="{{product.fabricCare}}" bindtap="switchAuraTab" data-tab="fabric">材质</view>
        <view class="aura-tab {{currentAuraTab === 'size' ? 'active' : ''}}" wx:if="{{product.sizeChartTip}}" bindtap="switchAuraTab" data-tab="size">尺码</view>
        <view class="aura-tab {{currentAuraTab === 'tips' ? 'active' : ''}}" wx:if="{{product.warmTips}}" bindtap="switchAuraTab" data-tab="tips">提示</view>
      </view>

      <view class="aura-tabs-content">
        <view class="aura-tab-panel" wx:if="{{product.description && currentAuraTab === 'desc'}}">
          <text class="panel-text">{{product.description}}</text>
        </view>
        <view class="aura-tab-panel" wx:if="{{product.fabricCare && currentAuraTab === 'fabric'}}">
          <text class="panel-text">{{product.fabricCare}}</text>
        </view>
        <view class="aura-tab-panel" wx:if="{{product.sizeChartTip && currentAuraTab === 'size'}}">
          <text class="panel-text">{{product.sizeChartTip}}</text>
        </view>
        <view class="aura-tab-panel" wx:if="{{product.warmTips && currentAuraTab === 'tips'}}">
          <text class="panel-text">{{product.warmTips}}</text>
        </view>
      </view>
      
    </view>
    <!--四段提示信息-->
  </view> 

  <view class="lookbook-section" wx:if="{{lookbookImgs && lookbookImgs.length > 0}}">
    <image class="lookbook-img" wx:for="{{lookbookImgs}}" wx:key="*this" src="{{item}}" mode="widthFix"></image>
  </view>

  <view class="detail-views-section" wx:if="{{detailImgs && detailImgs.length > 0}}">
    <view class="detail-views-header">
      <text class="detail-title-eng">Detail Views</text>
      <text class="detail-counter">{{currentDetailIndex}} / {{detailImgs.length}}</text>
    </view>
    <swiper class="detail-swiper" bindchange="onDetailSwiperChange" next-margin="25px">
      <swiper-item class="detail-swiper-item" wx:for="{{detailImgs}}" wx:key="*this">
        <image class="detail-swiper-img" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
  </view>

  <view class="related-products-section" wx:if="{{relatedProducts.length > 0}}">
    <view class="section-title-eng" style="text-align: left; padding-left: 20px;">关联商品</view>
    <view class="related-grid">
      <view class="related-item" wx:for="{{relatedProducts}}" wx:key="id" bindtap="goToRelatedDetail" data-id="{{item.id}}">
        <image class="related-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="related-info">
          <view class="related-title">{{item.title}}</view>
          <view class="related-price">¥ {{item.displayPrice || item.price}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="floating-action-bar">
  <view class="btn-add-half" bindtap="openSkuPanel" data-action="cart">加入购物车</view>
  <view class="btn-buy-half" bindtap="openSkuPanel" data-action="buy">立即购买</view>
</view>
<view class="sku-mask" wx:if="{{showSku}}" catchtap="closeSkuPanel"></view>

<view class="sku-panel {{showSku ? 'show' : ''}}">
  <view class="sku-close" catchtap="closeSkuPanel">×</view>
  <view class="sku-header">
    <image class="sku-img" src="{{currentSkuImage || product.image}}" mode="aspectFill"></image>
    <view class="sku-main">
      <view class="sku-price" style="color: #d32f2f;">¥ {{currentSkuPrice || product.displayPrice || product.price}}</view>
      <view class="sku-stock" style="color: {{currentSkuStock === 0 && !currentSkuUnlimited ? 'red' : '#999'}};">库存: {{currentSkuStockText || '请选择规格'}}</view>
      <view class="sku-choose-tip">已选: {{selectedColor || '颜色'}} / {{selectedSize || '尺码'}}</view>
    </view>
  </view>

  <!-- 套装商品子项选择 -->
  <scroll-view scroll-y style="max-height: 50vh;padding:0 16rpx;" wx:if="{{bundleSelections.length > 0}}">
    <view class="bundle-group-card" wx:for="{{bundleSelections}}" wx:key="index" wx:for-item="sel" wx:for-index="bgIdx">
      <view class="bundle-group-name">
        <text class="bg-step">{{bgIdx + 1}}</text>
        <text>{{sel.bundleGroupName}}</text>
      </view>
      <view class="bundle-group-colors" wx:if="{{sel.uniqueColors.length > 0}}">
        <text class="bundle-group-label">颜色</text>
        <view class="sku-options">
          <view class="sku-tag {{sel.selectedColor === item ? 'active' : ''}}" wx:for="{{sel.uniqueColors}}" wx:key="*this" wx:for-item="item" bindtap="selectBundleColor" data-index="{{bgIdx}}" data-color="{{item}}">{{item}}</view>
        </view>
      </view>
      <view class="bundle-group-sizes" wx:if="{{sel.uniqueSizes.length > 0}}">
        <text class="bundle-group-label">尺码</text>
        <view class="sku-options">
          <view class="sku-tag {{sel.selectedSize === item ? 'active' : ''}}" wx:for="{{sel.uniqueSizes}}" wx:key="*this" wx:for-item="item" bindtap="selectBundleSize" data-index="{{bgIdx}}" data-size="{{item}}">{{item}}</view>
        </view>
      </view>
      <view wx:if="{{sel.selectedSku}}" class="bundle-group-selected">
        <text class="bg-check">✓</text> {{sel.selectedColor}} / {{sel.selectedSize}} · 库存 {{sel.selectedSku.unlimitedStock ? '无限' : sel.selectedSku.stock}}
      </view>
    </view>
  </scroll-view>

  <!-- 普通商品颜色/尺码选择 -->
  <scroll-view scroll-y style="max-height: 50vh;" wx:else>
    <view class="sku-section" wx:if="{{uniqueColors.length > 0}}">
      <view class="sku-title">颜色</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedColor === item ? 'active' : ''}}" wx:for="{{uniqueColors}}" wx:key="*this" bindtap="selectColor" data-color="{{item}}">{{item}}</view>
      </view>
    </view>

    <view class="sku-section" wx:if="{{uniqueSizes.length > 0}}">
      <view class="sku-title">尺码</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedSize === item ? 'active' : ''}}" wx:for="{{uniqueSizes}}" wx:key="*this" bindtap="selectSize" data-size="{{item}}">{{item}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 按钮区域 -->
  <block wx:if="{{bundleSelections.length > 0}}">
    <view class="sku-btn-confirm disabled" wx:if="{{!bundleAllSelected}}">请选择所有子项规格</view>
    <view class="sku-btn-confirm" wx:else bindtap="confirmSkuAction" data-action="{{skuAction}}">
      {{skuAction === 'buy' ? '下一步：立即购买' : '确定加入购物车'}}
    </view>
  </block>
  <block wx:else>
    <view class="sku-btn-confirm disabled" wx:if="{{currentSkuStock === 0 && !currentSkuUnlimited}}">已售罄</view>
    <view class="sku-btn-confirm" wx:if="{{currentSkuStock > 0 || currentSkuUnlimited || currentSkuStock === null}}" bindtap="confirmSkuAction" data-action="{{skuAction}}">
      {{skuAction === 'buy' ? '下一步：立即购买' : '确定加入购物车'}}
    </view>
  </block>
</view>

<view class="floating-video-btn" wx:if="{{product.videoUrl}}" bindtap="openVideoOverlay">
  <video class="floating-video-thumb" src="{{product.videoUrl}}" autoplay loop muted show-play-btn="{{false}}" controls="{{false}}" object-fit="cover"></video>
  <!-- 这个播放三角不显示 暂时留着位置 -->
  <view class="play-icon-overlay"></view>
</view>

<view class="video-overlay-mask" wx:if="{{showVideo}}" catchtap="closeVideoOverlay">
  <view class="close-video-btn" catchtap="closeVideoOverlay" style="top: {{statusBarHeight + 10}}px;">×</view>
  <video id="mainFullscreenVideo" class="fullscreen-video" src="{{product.videoUrl}}" autoplay loop controls object-fit="contain" catchtap="doNothing" show-fullscreen-btn="{{false}}"></video>
</view>