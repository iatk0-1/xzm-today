<view class="page-wrapper" style="padding-top: {{navHeight}}px;">
  
  <view class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px; height: 44px;">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
  </view>

  <view class="main-swiper-wrap">
    <swiper class="main-swiper" indicator-dots="true" indicator-color="rgba(0,0,0,0.15)" indicator-active-color="#111" circular="true">
      <swiper-item wx:if="{{product.videoUrl}}">
        <video class="swiper-video"
               src="{{product.videoUrl}}"
               poster="{{product.image}}"
               object-fit="cover"
               show-play-btn="{{true}}"
               controls="{{false}}"
               autoplay="{{false}}"
               muted
               loop>
        </video>
      </swiper-item>
      <swiper-item wx:for="{{bannerImgs}}" wx:key="*this">
        <image class="swiper-img" src="{{item}}" mode="aspectFill" catchtap="previewBannerImage" data-index="{{index}}"></image>
      </swiper-item>
    </swiper>
    <view class="sold-out-overlay main-sold-out-overlay" wx:if="{{product.offSale}}"><text>已下架</text></view>
    <view class="sold-out-overlay main-sold-out-overlay" wx:elif="{{product.soldOut}}"><text>售罄</text></view>
  </view>

  <view class="content-wrapper">
    <!-- <view class="shipping-info" wx:if="{{product.shippingInfo}}">{{product.shippingInfo}}</view> 发货时间暂时不写 -->
    <view class="detail-title">{{product.title}}</view>
    <view class="detail-price">¥ {{product.displayPrice || product.price}}</view>

    <view class="options-section" bindtap="openSkuPanel" data-action="cart">
      <view class="size-selector">
        <text class="size-text" style="color: #333;">{{selectedColor || '颜色'}} / {{selectedSize || '尺码'}}</text>
        <text class="select-icon">↕</text>
      </view>
    </view>

    <view class="consult-section" bindtap="consultService">
      <view class="consult-left">
        <image class="consult-icon" src="/images/icons/customer-service.svg" mode="aspectFit"></image>
        <text class="consult-label">咨询客服</text>
      </view>
      <text class="consult-arrow">›</text>
    </view>

<!-- 四段提示信息-->
<view class="aura-tabs-container" wx:if="{{product.description || product.fabricCare || product.sizeChartTip || product.warmTips}}">
      
      <view class="aura-tabs-header">
        <view class="aura-tab {{currentAuraTab === 'desc' ? 'active' : ''}}" wx:if="{{product.description}}" bindtap="switchAuraTab" data-tab="desc">详情</view>
        <view class="aura-tab {{currentAuraTab === 'fabric' ? 'active' : ''}}" wx:if="{{product.fabricCare}}" bindtap="switchAuraTab" data-tab="fabric">材质</view>
        <view class="aura-tab {{currentAuraTab === 'size' ? 'active' : ''}}" wx:if="{{product.sizeChartTip}}" bindtap="switchAuraTab" data-tab="size">尺码</view>
        <view class="aura-tab {{currentAuraTab === 'tips' ? 'active' : ''}}" wx:if="{{product.warmTips}}" bindtap="switchAuraTab" data-tab="tips">提示</view>
      </view>

      <view class="aura-tabs-content">
        <view class="aura-tab-panel" wx:if="{{product.description && currentAuraTab === 'desc'}}">
          <text class="panel-text">{{product.description}}</text>
        </view>
        <view class="aura-tab-panel" wx:if="{{product.fabricCare && currentAuraTab === 'fabric'}}">
          <text class="panel-text">{{product.fabricCare}}</text>
        </view>
        <view class="aura-tab-panel" wx:if="{{product.sizeChartTip && currentAuraTab === 'size'}}">
          <text class="panel-text">{{product.sizeChartTip}}</text>
        </view>
        <view class="aura-tab-panel" wx:if="{{product.warmTips && currentAuraTab === 'tips'}}">
          <text class="panel-text">{{product.warmTips}}</text>
        </view>
      </view>
      
    </view>
    <!--四段提示信息-->
  </view> 

  <view class="lookbook-section" wx:if="{{lookbookImgs && lookbookImgs.length > 0}}">
    <image class="lookbook-img" wx:for="{{lookbookImgs}}" wx:key="*this" src="{{item}}" mode="widthFix" catchtap="previewLookbookImage" data-index="{{index}}"></image>
  </view>

  <view class="detail-views-section" wx:if="{{detailImgs && detailImgs.length > 0}}">
    <view class="detail-views-header">
      <text class="detail-title-eng">Detail Views</text>
      <text class="detail-counter">{{currentDetailIndex}} / {{detailImgs.length}}</text>
    </view>
    <swiper class="detail-swiper" bindchange="onDetailSwiperChange" next-margin="25px">
      <swiper-item class="detail-swiper-item" wx:for="{{detailImgs}}" wx:key="*this">
        <image class="detail-swiper-img" src="{{item}}" mode="aspectFill" catchtap="previewDetailImage" data-index="{{index}}"></image>
      </swiper-item>
    </swiper>
  </view>

  <view class="related-products-section" wx:if="{{relatedProducts.length > 0}}">
    <view class="section-title-eng" style="text-align: left; padding-left: 20px;">关联商品</view>
    <view class="related-grid">
      <view class="related-item" wx:for="{{relatedProducts}}" wx:key="id" bindtap="goToRelatedDetail" data-id="{{item.id}}">
        <image class="related-img" src="{{item.image}}" mode="aspectFill" catchtap="previewRelatedImage" data-index="{{index}}"></image>
        <view class="related-info">
          <view class="related-title">{{item.title}}</view>
          <view class="related-price">¥ {{item.displayPrice || item.price}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="share-float" wx:if="{{canShowShareFloat}}" style="left: {{shareFloatLeft}}px; top: {{shareFloatTop}}px;" catchtouchstart="startShareFloatDrag" catchtouchmove="moveShareFloat" catchtouchend="endShareFloatDrag">
  <text>分享</text>
</view>

<!-- 分享卡片专用画布：按图片数量生成单图、双图或三联图，不影响页面展示 -->
<canvas canvas-id="detailShareCanvasSingle" class="share-canvas" width="500" height="400"></canvas>
<canvas canvas-id="detailShareCanvasDouble" class="share-canvas" width="500" height="400"></canvas>
<canvas canvas-id="detailShareCanvasTriple" class="share-canvas" width="500" height="400"></canvas>

<view class="share-template-mask" wx:if="{{showShareTemplates}}" bindtap="closeShareTemplateSelector"></view>
<view class="share-template-panel" wx:if="{{showShareTemplates}}" catchtap="stopShareTemplateTap">
  <view class="share-template-header">
    <text>选择分享版式</text>
    <text class="share-template-close" bindtap="closeShareTemplateSelector">×</text>
  </view>
  <scroll-view class="share-template-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="share-template-options">
      <button class="share-template-option" open-type="share" data-template="single">
        <image class="share-template-preview" src="{{shareImages.single}}" mode="aspectFill"></image>
        <text class="share-template-label">单图模板</text>
      </button>
      <button class="share-template-option" wx:if="{{shareImageCount >= 2}}" open-type="share" data-template="double">
        <image class="share-template-preview" src="{{shareImages.double}}" mode="aspectFill"></image>
        <text class="share-template-label">双图模板</text>
      </button>
      <button class="share-template-option" wx:if="{{shareImageCount >= 3}}" open-type="share" data-template="triple">
        <image class="share-template-preview" src="{{shareImages.triple}}" mode="aspectFill"></image>
        <text class="share-template-label">三联模板</text>
      </button>
    </view>
  </scroll-view>
  <view class="share-template-cancel" bindtap="closeShareTemplateSelector">取消</view>
</view>

<view class="floating-action-bar">
  <view class="btn-add-half" bindtap="openSkuPanel" data-action="cart">加入购物车</view>
  <view class="btn-buy-half" bindtap="openSkuPanel" data-action="buy">立即购买</view>
</view>
<view class="sku-mask" wx:if="{{showSku}}" catchtap="closeSkuPanel"></view>

<view class="sku-panel {{showSku ? 'show' : ''}}">
  <view class="sku-close" catchtap="closeSkuPanel">×</view>
  <view class="sku-header">
    <view class="sku-image-column">
      <view class="sku-img-wrap">
        <image class="sku-img" src="{{currentSkuImage || product.image}}" mode="aspectFill" catchtap="previewSkuPanelImage"></image>
        <view class="sold-out-overlay" wx:if="{{currentSkuId ? currentSkuSoldOut : product.soldOut}}"><text>售罄</text></view>
      </view>
    </view>
    <view class="sku-main">
      <view class="sku-price" style="color: #d32f2f;">¥ {{currentSkuPrice || product.displayPrice || product.price}}</view>
      <view class="sku-stock" style="color: {{currentSkuStock === 0 && !currentSkuUnlimited ? 'red' : '#999'}};">库存: {{currentSkuStockText || '请选择规格'}}</view>
      <view class="sku-meta-row">
        <view class="sku-choose-tip">已选: {{selectedColor || '颜色'}} / {{selectedSize || '尺码'}}</view>
        <view class="sku-quantity" wx:if="{{bundleSelections.length === 0}}">
          <text class="sku-quantity-label">数量</text>
          <view class="sku-quantity-control">
            <view class="sku-quantity-btn {{quantity <= 1 ? 'disabled' : ''}}" catchtap="skuQuantityMinus">-</view>
            <input class="sku-quantity-input" type="number" value="{{quantity}}" bindinput="skuQuantityInput" bindblur="skuQuantityInputBlur" />
            <view class="sku-quantity-btn {{!currentSkuUnlimited && currentSkuStock !== null && currentSkuStock <= quantity ? 'disabled' : ''}}" catchtap="skuQuantityPlus">+</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- 套装商品颜色/尺码选择 -->
  <scroll-view scroll-y style="max-height: 55vh; padding: 0 16rpx; padding-bottom: 40rpx;" wx:if="{{bundleSelections.length > 0}}">
    <view class="bundle-group-card {{sel.isChecked === false ? 'disabled-card' : ''}}" wx:for="{{bundleSelections}}" wx:key="index" wx:for-item="sel" wx:for-index="bgIdx">
      
      <view class="bundle-card-img-wrap">
        <image class="bundle-card-img" src="{{sel.displayImage || product.coverUrl}}" mode="aspectFill"></image>
        <view class="sold-out-overlay" wx:if="{{sel.imageSoldOut}}"><text>售罄</text></view>
      </view>
      
      <view class="bundle-card-right">
        <view class="bundle-card-header">
          <view class="bundle-card-title">
            <text class="bg-step">{{bgIdx + 1}}</text>
            <text>{{sel.bundleGroupName}}</text>
          </view>
          <view class="bundle-checkbox {{sel.isChecked !== false ? 'checked' : ''}}" bindtap="toggleBundleCheck" data-index="{{bgIdx}}"></view>
        </view>
        
        <view class="bundle-card-specs" wx:if="{{sel.uniqueColors.length > 0}}">
          <text class="spec-label">颜色</text>
          <view class="sku-options minimal">
            <view class="sku-tag minimal {{sel.selectedColor === item ? 'active' : ''}}" wx:for="{{sel.uniqueColors}}" wx:key="*this" wx:for-item="item" bindtap="selectBundleColor" data-index="{{bgIdx}}" data-color="{{item}}">{{item}}</view>
          </view>
        </view>
        
        <view class="bundle-card-specs" wx:if="{{sel.uniqueSizes.length > 0}}">
          <text class="spec-label">尺码</text>
          <view class="sku-options minimal">
            <view class="sku-tag minimal {{sel.selectedSize === item ? 'active' : ''}}" wx:for="{{sel.uniqueSizes}}" wx:key="*this" wx:for-item="item" bindtap="selectBundleSize" data-index="{{bgIdx}}" data-size="{{item}}">{{item}}</view>
          </view>
        </view>

        <view class="bundle-card-footer" wx:if="{{sel.selectedSku}}">
          <text class="stock-status out" wx:if="{{!sel.selectedSku.unlimitedStock && sel.selectedSku.stock <= 0}}">已售罄</text>
          <text class="stock-status danger" wx:elif="{{!sel.selectedSku.unlimitedStock && sel.selectedSku.stock <= 5}}">🔥 仅剩少量</text>
          <text class="stock-status normal" wx:else>已选定</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 普通商品颜色/尺码选择 -->
  <scroll-view scroll-y style="max-height: 50vh;" wx:else>
    <view class="sku-section" wx:if="{{uniqueColors.length > 0}}">
      <view class="sku-title">颜色</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedColor === item ? 'active' : ''}}" wx:for="{{uniqueColors}}" wx:key="*this" bindtap="selectColor" data-color="{{item}}">{{item}}</view>
      </view>
    </view>

    <view class="sku-section" wx:if="{{uniqueSizes.length > 0}}">
      <view class="sku-title">尺码</view>
      <view class="sku-options">
        <view class="sku-tag {{selectedSize === item ? 'active' : ''}}" wx:for="{{uniqueSizes}}" wx:key="*this" bindtap="selectSize" data-size="{{item}}">{{item}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 按钮区域 -->
  <block wx:if="{{bundleSelections.length > 0}}">
    <view class="sku-actions" wx:if="{{!bundleAllSelected}}">
      <view class="sku-btn-confirm disabled">请至少完整选择一个子项</view>
    </view>
    <view class="sku-actions" wx:else>
      <view class="sku-btn-cart" bindtap="confirmSkuAction" data-action="cart">加入购物车</view>
      <view class="sku-btn-buy" bindtap="confirmSkuAction" data-action="buy">立即购买</view>
    </view>
  </block>
  <block wx:else>
    <view class="sku-actions" wx:if="{{currentSkuStock <= 0 && currentSkuStock !== null && !currentSkuUnlimited}}">
      <view class="sku-btn-confirm disabled">已售罄</view>
    </view>
    <view class="sku-actions" wx:else>
      <view class="sku-btn-cart" bindtap="confirmSkuAction" data-action="cart">加入购物车</view>
      <view class="sku-btn-buy" bindtap="confirmSkuAction" data-action="buy">立即购买</view>
    </view>
  </block>
</view>

<view class="floating-video-btn" wx:if="{{product.videoUrl}}" bindtap="openVideoOverlay">
  <video class="floating-video-thumb" src="{{product.videoUrl}}" autoplay loop muted show-play-btn="{{false}}" controls="{{false}}" object-fit="cover"></video>
  <!-- 这个播放三角不显示 暂时留着位置 -->
  <view class="play-icon-overlay"></view>
</view>

<view class="video-overlay-mask" wx:if="{{showVideo}}" catchtap="closeVideoOverlay">
  <view class="close-video-btn" catchtap="closeVideoOverlay" style="top: {{statusBarHeight + 10}}px;">×</view>
  <video id="mainFullscreenVideo" class="fullscreen-video" src="{{product.videoUrl}}" autoplay loop controls object-fit="contain" catchtap="doNothing" show-fullscreen-btn="{{false}}"></video>
</view>
