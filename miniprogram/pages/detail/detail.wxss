page { 
  background-color: #ffffff; /* 页面最底层背景色设置为纯白 */
}

.page-wrapper { 
  width: 100%; /* 页面容器宽度占满屏幕 */
  overflow-x: hidden; /* 隐藏水平滚动条，防止页面左右晃动 */
  padding-bottom: 120px; /* 底部留出120像素空白，防止文字被底部的悬浮按钮挡住 */
}

/* ================= 沉浸式顶部导航栏 ================= */
.custom-nav-bar { 
  position: fixed; /* 固定定位，使得导航栏吸附在屏幕最顶部 */
  top: 0; /* 距离顶部0像素 */
  left: 0; /* 距离左侧0像素 */
  width: 100%; /* 宽度占满整个屏幕 */
  z-index: 999; /* 层级设置很高，保证不被页面里滚动的图片遮挡 */
  display: flex; /* 开启弹性布局，方便里面元素对齐 */
  align-items: center; /* 垂直居中对齐 */
  padding-left: 15px; /* 左侧留出15像素的内边距 */
}

.nav-back { 
  width: 32px; /* 返回按钮的宽度 */
  height: 32px; /* 返回按钮的高度 */
  background: rgba(255,255,255,0.8); /* 半透明白色背景 */
  border-radius: 50%; /* 圆形按钮 */
  display: flex; /* 开启弹性布局 */
  justify-content: center; /* 内容水平居中 */
  align-items: center; /* 内容垂直居中 */
  backdrop-filter: blur(5px); /* 背景产生毛玻璃模糊高级效果 */
  box-shadow: 0 2px 6px rgba(0,0,0,0.05); /* 添加微弱的阴影让按钮有立体感 */
}

.back-arrow { 
  width: 10px; /* 箭头线条长度 */
  height: 10px; /* 箭头线条高度 */
  border-top: 2px solid #333; /* 箭头上半部分线条颜色和粗细 */
  border-left: 2px solid #333; /* 箭头左半部分线条颜色和粗细 */
  transform: rotate(-45deg); /* 将方形线条旋转45度形成指向左侧的箭头 */
  margin-left: 4px; /* 稍微往右微调一下位置，让视觉上居中 */
}

/* ================= 🚀 极简韩系悬浮双排栏 (真·绝对居中版) ================= */
.floating-action-bar {
  position: fixed; /* 固定在屏幕底部 */
  bottom: calc(0px + env(safe-area-inset-bottom)); /* 避开底部安全区 */
  
  /* --- 👇 彻底解决不对称的黑科技 👇 --- */
  left: 50%; /* 先把整个容器的左边缘强行推到屏幕的正中央 */
  transform: translateX(-50%); /* 然后让容器向左回退自身宽度的一半，实现毫米级绝对居中 */
  width: calc(100vw - 40px); /* 宽度使用 100vw（即屏幕物理总宽度）减去40px，彻底无视内部画布和隐藏滚动条 */
  /* --- 👆 黑科技结束 👆 --- */

  display: flex; /* 弹性布局 */
  justify-content: space-between; /* 两端对齐 */
  gap: 12px; /* 两个按钮中间的缝隙 */
  z-index: 100; /* 保持在最上层 */
}

.btn-add-half {
  flex: 1 1 0%; /* 核心修复：强制平分剩余空间，无视内部内容或边框的干扰 */
  background-color: #ffffff; /* 白色背景 */
  color: #555555; /* 深灰文字 */
  text-align: center; /* 文字居中 */
  padding: 12px 0; /* 撑开高度 */
  font-family: "Times New Roman", Times, serif; /* 英文字体 */
  font-size: 14px; /* 字体大小 */
  box-shadow: 0 4px 15px rgba(0,0,0,0.08); /* 悬浮阴影 */
  box-sizing: border-box; /* 将内边距算在宽度内 */
}

.btn-buy-half {
  flex: 1 1 0%; /* 核心修复：强制与左侧按钮保持完全一样的大小 */
  
  background-color: #8c8c8c; /* 灰色背景 */
  color: #ffffff; /* 白色文字 */
  border: 1px solid #dddddd; /* 1像素灰色边框 */
  text-align: center; /* 文字居中 */
  padding: 12px 0; /* 撑开高度，与左侧保持一致 */
  font-family: "Times New Roman", Times, serif; /* 英文字体 */
  font-size: 14px; /* 字体大小 */
  box-shadow: 0 4px 15px rgba(0,0,0,0.04); /* 极弱悬浮阴影 */
  box-sizing: border-box; /* 核心：确保1px的边框被吞进内部，绝不向外扩张挤压 */
}

/* ================= 页面主体内容 ================= */
.main-swiper { 
  width: 100%; /* 轮播图宽度占满屏幕 */
  height: 125vw; /* 高度根据宽度按比例自适应 */
  background-color: #f9f9f9; /* 图片未加载出时的浅灰底色 */
}

.swiper-img { 
  width: 100%; /* 图片宽度撑满轮播图 */
  height: 100%; /* 图片高度撑满轮播图 */
  display: block; /* 清除图片默认的底部留白 */
}

.content-wrapper { 
  padding: 20px 20px 10px 20px; /* 标题文字区域的上、右、下、左内边距 */
}

.shipping-info { 
  font-family: "Times New Roman", Times, serif; /* 英文字体 */
  font-size: 13px; /* 发货信息字体大小 */
  color: #aaaaaa; /* 浅灰色字体 */
  margin-bottom: 8px; /* 距离下方元素的底部外边距 */
}

.detail-title { 
  font-family: "Times New Roman", Times, serif; /* 标题英文字体 */
  font-size: 15px; /* 标题字体大小 */
  color: #555555; /* 深灰色字体 */
  margin-bottom: 8px; /* 距离下方元素的底部外边距 */
  line-height: 1.4; /* 标题多行时的行高 */
}

.detail-price { 
  font-family: "Times New Roman", Times, serif; /* 价格英文字体 */
  font-size: 14px; /* 价格字体大小 */
  color: #999999; /* 浅灰色字体 */
}

.options-section { 
  margin-top: 40px; /* 规格选择区距离上方元素的顶部外边距 */
}

.option-row { 
  display: flex; /* 开启弹性布局横向排列 */
  align-items: center; /* 元素垂直居中对齐 */
  margin-bottom: 20px; /* 距离下方元素的底部外边距 */
}

.option-label { 
  width: 70px; /* 标签文字固定宽度 */
  font-family: "Times New Roman", Times, serif; /* 标签英文字体 */
  font-size: 14px; /* 标签字体大小 */
  color: #999999; /* 标签浅灰色字体 */
}

.size-selector { 
  flex: 1; /* 规格选择框占据右侧剩余全部空间 */
  border: 1px solid #eeeeee; /* 极浅的灰色边框 */
  padding: 12px 15px; /* 选择框上下的内边距 */
  display: flex; /* 开启弹性布局 */
  justify-content: space-between; /* 内部文字和图标分别靠左右两边 */
  align-items: center; /* 内部垂直居中对齐 */
  background-color: #fdfdfd; /* 极浅的灰色背景 */
}

.size-text { 
  font-family: -apple-system, sans-serif; /* 苹果系统默认字体 */
  font-size: 13px; /* 选中的规格文字大小 */
  color: #888888; /* 灰色字体 */
}

.select-icon { 
  font-size: 12px; /* 右侧上下箭头大小 */
  color: #888888; /* 右侧上下箭头颜色 */
}

/* ================= 选项卡切换区 ================= */
.tabs-wrap { 
  display: flex; /* 开启弹性布局横向排列 */
  justify-content: space-between; /* 四个选项卡平均分布 */
  margin-bottom: 30px; /* 距离下方内容的底部外边距 */
  margin-top: 40px; /* 距离上方规格选择的顶部外边距 */
}

.tab-item { 
  font-family: "Times New Roman", Times, serif; /* 选项卡英文字体 */
  font-size: 12px; /* 选项卡文字大小 */
  color: #cccccc; /* 未选中的浅灰色字体 */
  padding-bottom: 8px; /* 底部内边距，为了让下划线隔开一段距离 */
  letter-spacing: 0.5px; /* 字母间距，增加高级感 */
}

.tab-item.active { 
  color: #555555; /* 选中时的深灰色字体 */
  border-bottom: 1px solid #555555; /* 选中时的底边黑线 */
}

/* ================= 🌟 选项卡下方的图文详情区 (全新替换版) ================= */
.tab-content {
  width: 100%;
  min-height: 150px; /* 核心细节：预留足够的最小高度，防止点击切换不同长短的 Tab 时，页面下方内容剧烈上下跳动 */
  padding: 10px 0 10px 0; /* 顶部留出 10px 呼吸空间，底部留出充足的空白 */
  box-sizing: border-box;
}

.desc-content {
  width: 100%;
  /* 🌟 注入灵魂：Tab 切换时的丝滑淡入过渡动画 */
  animation: tabFadeIn 0.35s ease-out forwards;
}

.desc-line {
  /* 字体使用系统默认的无衬线体，最契合韩系极简的干净利落 */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 12px;         /* 还原原版的小巧精致感 */
  color: #777777;          /* 还原原版的低对比度高级灰 */
  line-height: 2.2;        /* 🌟 原版的排版精髓：2.2 倍极其宽裕的行高，呼吸感拉满 */
  letter-spacing: 0.5px;   /* 增加微小的字间距，提升文字的清冷感 */
  word-wrap: break-word;   /* 保证中英文和符号都能优雅换行 */
}

/* 居中修饰类 */
.center-text {
  text-align: center;
}

/* 模特信息区包裹框 */
.model-info-box {
  width: 100%;
  padding-bottom: 10px;
}

/* 🌟 Tab 切换专属的淡入微动画 */
@keyframes tabFadeIn {
  0% { 
    opacity: 0; 
    transform: translateY(4px); /* 初始状态极其轻微地偏下 */
  }
  100% { 
    opacity: 1; 
    transform: translateY(0);   /* 极速且轻柔地回到原位 */
  }
}
/* ========================================================================= */

/* ================= 长图与关联商品 ================= */
.lookbook-section { 
  width: 100%; /* Lookbook区块占满全宽 */
  margin-top: 10px; /* 顶部距离 */
}

.lookbook-img { 
  width: 100%; /* 图片占满全宽 */
  display: block; /* 清除默认底部留白 */
  margin-bottom: -1px; /* 消除多张图片拼接时的细微白线 */
}

.section-title-eng { 
  font-family: "Times New Roman", Times, serif; /* 英文标题字体 */
  font-size: 16px; /* 标题字体大小 */
  color: #333333; /* 标题字体深灰色 */
  margin-bottom: 20px; /* 标题底部间距 */
}

.detail-views-section { 
  width: 100%; /* 细节轮播图区域占满全宽 */
  padding: 40px 0; /* 上下预留40px内边距 */
  border-top: 1px solid #f5f5f5; /* 顶部细分割线 */
}

.detail-views-header { 
  display: flex; /* 开启弹性布局 */
  justify-content: space-between; /* 标题和角标左右分开 */
  align-items: center; /* 垂直居中对齐 */
  padding: 0 20px; /* 左右内边距20px */
