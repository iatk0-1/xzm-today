}

.related-products-section { 
  width: 100%; /* 关联商品区占满全宽 */
  padding: 20px 0 80px 0; /* 预留充足的底部空间 */
  border-top: 1px solid #f5f5f5; /* 顶部细分割线 */
}

.related-grid { 
  display: grid; /* 使用强大的CSS Grid网格布局 */
  grid-template-columns: repeat(2, 1fr); /* 强制分成相等的两列 */
