}

.related-info { 
  text-align: left; /* 文字全部向左对齐 */
}

.related-title { 
  font-family: "Times New Roman", Times, serif; /* 标题英文字体 */
  font-size: 13px; /* 标题文字大小 */
  color: #333333; /* 标题深色 */
  line-height: 1.4; /* 标题行高 */
  margin-bottom: 6px; /* 标题底部间距 */
  white-space: normal; /* 允许文字正常换行 */
}

.related-price { 
  font-family: "Times New Roman", Times, serif; /* 价格英文字体 */
  font-size: 13px; /* 价格文字大小 */
  color: #999999; /* 价格浅灰色 */
  margin-bottom: 6px; /* 价格底部间距 */
}

/* ================= 底部 SKU 弹窗样式 (完全保留原生版) ================= */
.sku-mask { 
  position: fixed; /* 遮罩层固定定位 */
  top: 0; /* 从屏幕最上方开始 */
  left: 0; /* 从屏幕最左方开始 */
  width: 100%; /* 遮罩层宽度100% */
  height: 100%; /* 遮罩层高度100% */
  background: rgba(0,0,0,0.5); /* 半透明黑色遮罩 */
  z-index: 999; /* 层级位于弹窗之下，页面之上 */
}

.sku-panel { 
  position: fixed; /* 弹窗主体固定定位 */
  bottom: -100%; /* 默认隐藏在屏幕正下方之外 */
  left: 0; /* 从屏幕左侧开始 */
  width: 100%; /* 弹窗宽度满屏 */
  background: #fff; /* 弹窗白色背景 */
  border-radius: 16px 16px 0 0; /* 左上右上有16px的圆角 */
  z-index: 1000; /* 最高层级保证不被遮挡 */
  padding: 20px; /* 弹窗内部上下左右留白 */
  box-sizing: border-box; /* 保证留白不会撑破屏幕宽度 */
  transition: all 0.3s ease; /* 弹起和收回的丝滑动画效果 */
}

.sku-panel.show { 
  bottom: 0; /* 激活时，底部距离变为0，顺滑弹起 */
}

.sku-close { 
  position: absolute; /* 关闭按钮绝对定位 */
  top: 15px; /* 距离弹窗顶部15px */
  right: 20px; /* 距离弹窗右侧20px */
  font-size: 24px; /* 关闭按钮大小 */
  color: #999; /* 关闭按钮颜色 */
}

.sku-header { 
  display: flex; /* 头部商品信息横向排列 */
  margin-bottom: 20px; /* 头部距离下方选项的间距 */
}

.sku-img { 
  width: 80px; /* 弹窗里商品小图的宽度 */
  height: 80px; /* 弹窗里商品小图的高度 */
  border-radius: 8px; /* 小图加8px圆角 */
  margin-right: 15px; /* 小图距离右侧文字的间距 */
  background: #eee; /* 小图未加载时的底色 */
}

.sku-main { 
  flex: 1; /* 右侧文字区占满剩余空间 */
  display: flex; /* 开启弹性布局 */
  flex-direction: column; /* 内部文字纵向排列 */
  justify-content: center; /* 纵向居中 */
}

.sku-price { 
  font-size: 18px; /* 弹窗大字价格 */
  font-weight: bold; /* 价格加粗 */
  margin-bottom: 5px; /* 价格距下方间距 */
}

.sku-stock { 
  font-size: 12px; /* 库存文字大小 */
  margin-bottom: 5px; /* 库存距下方间距 */
}

.sku-choose-tip { 
  font-size: 12px; /* 已选提示文字大小 */
  color: #666; /* 已选提示深灰色 */
}

.sku-section { 
  margin-bottom: 20px; /* 每组规格区域底部间距 */
}

.sku-title { 
  font-size: 14px; /* 规格组标题文字大小 */
  font-weight: bold; /* 规格组标题加粗 */
  margin-bottom: 10px; /* 距下方选项标签间距 */
  color: #333; /* 标题深黑色 */
}

.sku-options { 
  display: flex; /* 选项标签横向排列 */
  flex-wrap: wrap; /* 超过一行自动折行 */
  gap: 10px; /* 每个选项标签之间的间距 */
}

.sku-tag { 
  padding: 6px 16px; /* 选项标签的上下左右内边距 */
  background: #f5f5f5; /* 选项标签未选中时的浅灰底色 */
  border-radius: 4px; /* 选项标签圆角 */
  font-size: 13px; /* 选项标签字体大小 */
  color: #333; /* 选项标签字体颜色 */
  border: 1px solid transparent; /* 预留透明边框，防止选中时尺寸跳动 */
}

.sku-tag.active { 
  background: #fcf0f0; /* 选中时的浅红色背景 */
  color: #d32f2f; /* 选中时的深红色文字 */
  border-color: #d32f2f; /* 选中时的红色边框 */
  font-weight: bold; /* 选中时文字加粗 */
}

.sku-btn-confirm { 
  background: #000; /* 确认按钮纯黑背景 */
  color: #fff; /* 确认按钮纯白文字 */
  text-align: center; /* 文字居中 */
  line-height: 44px; /* 行高撑起按钮高度 */
  border-radius: 22px; /* 极其圆润的半圆角 */
  font-size: 15px; /* 按钮文字大小 */
  font-weight: bold; /* 按钮文字加粗 */
  margin-top: 10px; /* 距离上方区域间距 */
  margin-bottom: env(safe-area-inset-bottom); /* 自动适配苹果底部黑线，防止误触 */
}

/* ================= 悬浮动态视频小窗 ================= */
.floating-video-btn {
  position: fixed;
  right: 20px;
  /* 悬浮在屏幕右下角，距离底部操作栏往上留出充足距离 */
  bottom: calc(85px + env(safe-area-inset-bottom)); 
  width: 56px;
  height: 56px;
  border-radius: 50%; /* 完美的圆形 */
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15); /* 高级悬浮阴影 */
  border: 2px solid #ffffff; /* 白边包裹，增加质感 */
  z-index: 90;
  background-color: #f0f0f0;
}

.floating-video-thumb {
  width: 100%;
  height: 100%;
  pointer-events: none; /* 让缩略图里的视频无视所有点击事件 */
}

.play-icon-overlay {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.25); /* 覆盖一层淡淡的黑膜，让白色播放键更清晰 */
  color: rgba(255,255,255,0.9);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 14px;
  padding-left: 2px; /* 视觉微调，让三角形看起来更居中 */
}

/* ================= 沉浸式全屏播放弹窗 ================= */
.video-overlay-mask {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background-color: #000000; /* 纯黑沉浸感底色 */
  z-index: 99999; /* 最高层级，挡住一切 */
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.fullscreen-video {
  width: 100%;
  height: 100vh; /* 视频高度撑满全屏 */
}

.close-video-btn {
  position: absolute;
  left: 20px;
  width: 36px;
  height: 36px;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  color: #ffffff;
  font-size: 24px;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100000;
  backdrop-filter: blur(5px);
}

/* ================= 🌟 统一高级感动态文本容器 ================= */
.tab-content {
  width: 100%;
  /* 🚀 核心修改：去掉了 150px 的最小高度限制，让它完全像橡皮筋一样自由伸缩！ */
  min-height: 0; 
  /* 稍微减小底部的留白，让文字和下方的图片衔接更紧凑高级 */
  padding: 5px 0 5px 0; 
  box-sizing: border-box;
}

.desc-text {
  /* 强制统一极简字体 */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif !important;
  font-size: 12px !important;       /* 极致精巧的小字号 */
  color: #777777 !important;        /* 统一的高级冷灰色 */
  line-height: 2.4 !important;      /* 2.4倍超大呼吸行距（灵魂所在） */
  letter-spacing: 0.5px !important; /* 微小字间距提升清冷感 */
  
  /* 👇 核心黑科技：完美识别后台回车，高度像橡皮筋一样自适应 👇 */
  white-space: pre-wrap !important; 
  word-break: break-all !important;
  display: block !important;        
  width: 100% !important;
  
  /* 切换时的丝滑淡入微动画，绝不生硬 */
  animation: tabFadeIn 0.35s ease-out forwards;
}

@keyframes tabFadeIn {
  0% { opacity: 0; transform: translateY(4px); }
  100% { opacity: 1; transform: translateY(0); }
}