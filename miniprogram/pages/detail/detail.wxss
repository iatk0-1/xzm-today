}

.detail-counter { 
  font-family: "Times New Roman", Times, serif; /* 角标英文字体 */
  font-size: 12px; /* 角标字体大小 */
  color: #cccccc; /* 角标浅灰色 */
  letter-spacing: 1px; /* 角标字母间距 */
}

.detail-swiper { 
  width: 100%; /* 细节轮播图占满全宽 */
  height: 130vw; /* 细节轮播高度按比例调整 */
