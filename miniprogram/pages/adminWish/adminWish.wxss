/* pages/adminWish/adminWish.wxss */page { background-color: #f0f0f0; height: 100vh; display: flex; flex-direction: column; }
.admin-wrapper { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

/* 顶部 Tab */
.tabs-bar { display: flex; background-color: #111111; padding: 0 10rpx; }
.tab-item { flex: 1; text-align: center; font-size: 28rpx; color: #888; padding: 30rpx 0; position: relative; transition: color 0.2s ease; }
.tab-item.active { font-weight: bold; color: #ffffff; }
.active-line { position: absolute; bottom: 10rpx; left: 50%; transform: translateX(-50%); width: 40rpx; height: 6rpx; background-color: #ffffff; border-radius: 4rpx; }

.wish-scroll-area { flex: 1; padding: 20rpx; box-sizing: border-box; }
.empty-state { padding: 100px 0; text-align: center; color: #999; font-size: 14px; }

/* 卡片样式 */
.wish-card { position: relative; background-color: #ffffff; border-radius: 12rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }

/* 排名角标 */
.rank-badge { position: absolute; top: 0; left: 0; background: #333; color: #fff; font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 12rpx 0 12rpx 0; font-weight: bold; font-family: "Times New Roman", Times, serif; }
.rank-badge.top3 { background: #d32f2f; }

.card-main { display: flex; margin-bottom: 24rpx; margin-top: 10rpx; }
.wish-img { width: 140rpx; height: 180rpx; border-radius: 8rpx; background-color: #f5f5f5; margin-right: 20rpx; flex-shrink: 0; }
.wish-info { flex: 1; display: flex; flex-direction: column; }
.wish-content { font-size: 26rpx; color: #333; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; margin-bottom: 20rpx; }

.wish-data { display: flex; align-items: center; margin-top: auto; }
.fire-icon { font-size: 32rpx; margin-right: 8rpx; }
.likes-count { font-size: 28rpx; font-weight: bold; color: #d32f2f; font-family: "Times New Roman", Times, serif; }

.linked-id { font-size: 20rpx; color: #1890ff; margin-top: 10rpx; background: #e6f7ff; padding: 4rpx 10rpx; border-radius: 6rpx; display: inline-block; }

.card-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1rpx dashed #eee; padding-top: 24rpx; }
.time { font-size: 22rpx; color: #999; }
.action-group { display: flex; gap: 20rpx; }
.btn-ghost { padding: 0 24rpx; height: 50rpx; line-height: 48rpx; font-size: 24rpx; color: #333; border: 1rpx solid #ccc; border-radius: 25rpx; }
.btn-solid { padding: 0 24rpx; height: 50rpx; line-height: 50rpx; font-size: 24rpx; color: #fff; background: #111; border-radius: 25rpx; font-weight: bold; }
