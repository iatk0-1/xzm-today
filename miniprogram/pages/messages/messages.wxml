<view class="messages-page" style="padding-top: {{statusBarHeight}}px;">
  <view wx:if="{{loadError}}" style="padding:24rpx;color:#b42318;text-align:center" bindtap="retryContact">{{loadError}} · 点击重试</view>
  <view class="nav-bar"><view class="nav-title">消息</view><view wx:if="{{canServe && isAdmin}}" class="staff-manage-link" bindtap="goStaffManage">客服管理</view></view>

  <scroll-view class="conv-list" scroll-y refresher-enabled bindrefresherrefresh="onRefresh" refresher-triggered="{{refreshing}}">
    <view wx:if="{{hasContacted}}" class="conv-item">
      <view class="conv-avatar-wrap"><image class="conv-avatar" src="/images/customer-service-teddy-bear.jpg" mode="aspectFill"/></view>
      <view class="conv-body">
        <view class="conv-top">
          <text class="conv-name">现在买</text>
          <text class="conv-role">我的咨询</text>
          <text class="conv-time">{{latestStaffReplyAt || firstMessageTime}}</text>
        </view>
        <view class="conv-preview">{{latestStaffReplyAt ? '客服曾回复 · 点击查看' : '点击进入微信客服会话'}}</view>
      </view>
      <view wx:if="{{contactUnreadCount > 0}}" class="unread-badge">{{contactUnreadLabel}}</view>
      <button class="conv-contact-button" open-type="contact" bindcontact="handleCustomerServiceContact" session-from="page:messages" aria-label="进入现在买客服会话"></button>
    </view>
    <block wx:if="{{canServe}}">
      <view wx:for="{{sessions}}" wx:key="id" class="conv-item" bindtap="goSession" data-id="{{item.id}}">
        <view class="conv-avatar-wrap"><image class="conv-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"/></view>
        <view class="conv-body">
          <view class="conv-top"><text class="conv-name">{{item.displayName}}</text><text class="conv-role {{item.status === 'pending' ? 'role-pending' : ''}}">{{item.status === 'pending' ? '待接入' : (item.status === 'active' ? '接待中' : '已结束')}}</text><text class="conv-time">{{item.displayTime}}</text></view>
          <view class="conv-preview">{{item.preview}}</view>
        </view>
        <view wx:if="{{item.unreadCount > 0}}" class="unread-badge">{{item.unreadLabel}}</view>
        <view wx:if="{{item.status === 'pending'}}" class="claim-mini-btn" catchtap="claimSession" data-id="{{item.id}}">接入</view>
      </view>
      <view class="conv-empty" wx:if="{{sessions.length === 0 && !hasContacted && !loading && !loadError}}">暂无客服会话</view>
    </block>
    <view class="conv-empty" wx:if="{{!canServe && !hasContacted && !loading && !loadError}}">
      <text>{{loadError || '暂无消息'}}</text>
    </view>
  </scroll-view>

  <view class="bottom-tab-bar">
    <view class="tab-item" bindtap="goToIndex">首页</view>
    <view class="tab-item" bindtap="goToMarket">市集</view>
    <view class="tab-item admin-portal" wx:if="{{isAdmin || isStallManager}}" bindtap="goToCreateProduct"><view class="red-plus-btn">+</view></view>
    <view class="tab-item active"><view class="message-tab-label">信息<text wx:if="{{messageUnreadCount > 0}}" class="message-tab-badge">{{messageUnreadLabel}}</text></view></view>
    <view class="tab-item" bindtap="goToUser">我</view>
  </view>
</view>
