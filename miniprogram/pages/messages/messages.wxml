<view class="messages-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar"><view class="nav-title">消息</view></view>

  <scroll-view class="conv-list" scroll-y refresher-enabled bindrefresherrefresh="onRefresh" refresher-triggered="{{refreshing}}">
    <button wx:if="{{hasContacted}}" class="conv-item" open-type="contact" bindcontact="handleCustomerServiceContact" session-from="page:messages">
      <view class="conv-avatar-wrap"><image class="conv-avatar" src="/images/avatar.png" mode="aspectFill"/></view>
      <view class="conv-body">
        <view class="conv-top">
          <text class="conv-name">现在买客服</text>
          <text class="conv-time">{{firstMessageTime}}</text>
        </view>
        <view class="conv-preview">点击进入微信客服会话</view>
      </view>
    </button>
    <view class="conv-empty" wx:if="{{!hasContacted && !loading}}">
      <text>{{loadError ? '消息加载失败，下拉重试' : '暂无消息'}}</text>
    </view>
  </scroll-view>

  <view class="bottom-tab-bar">
    <view class="tab-item" bindtap="goToIndex">首页</view>
    <view class="tab-item" bindtap="goToMarket">市集</view>
    <view class="tab-item admin-portal" wx:if="{{isAdmin}}" bindtap="goToAdmin"><view class="red-plus-btn">+</view></view>
    <view class="tab-item active">信息</view>
    <view class="tab-item" bindtap="goToUser">我</view>
  </view>
</view>
