.messages-page {
  display: flex; flex-direction: column;
  height: 100vh; width: 100vw; overflow: hidden;
  background: #fff; box-sizing: border-box;
}
.nav-bar {
  display: flex; align-items: center; height: 44px;
  padding: 0 16px; background: #fff; border-bottom: 1rpx solid #e5e5e5;
  flex-shrink: 0;
}
.nav-title { font-size: 16px; font-weight: bold; }
.conv-list { flex: 1; overflow-y: auto; padding-bottom: 100rpx; }
.conv-item {
  display: flex; align-items: center; width: 100%; padding: 14px 16px;
  border: 0; border-bottom: 1rpx solid #f0f0f0;
  border-radius: 0; background: #fff; text-align: left;
  font-size: inherit; line-height: normal; box-sizing: border-box;
}
.conv-item::after { display: none; }
.conv-item:active { background: #f5f5f5; }
.conv-avatar-wrap { margin-right: 12px; flex-shrink: 0; }
.conv-avatar { width: 48px; height: 48px; border-radius: 24px; background: #eee; }
.conv-body { flex: 1; min-width: 0; }
.conv-top { display: flex; align-items: center; margin-bottom: 4px; }
.conv-name { font-size: 15px; color: #333; font-weight: 500; white-space: nowrap; }
.conv-time { font-size: 11px; color: #bbb; margin-left: auto; white-space: nowrap; }
.conv-preview { font-size: 13px; color: #999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.conv-empty { text-align: center; color: #bbb; font-size: 14px; padding: 60px 0; }
.bottom-tab-bar {
  position: fixed; bottom: 0; left: 0; width: 100%; height: 100rpx;
  background-color: #fff; display: flex; z-index: 100;
  border-top: 1rpx solid rgba(0,0,0,0.04);
  padding-bottom: env(safe-area-inset-bottom); flex-shrink: 0;
}
.tab-item {
  flex: 1; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #999;
}
.bottom-tab-bar .active { color: #1a1a1a; font-weight: 800; }
.admin-portal { flex: 1; }
.red-plus-btn {
  width: 80rpx; height: 80rpx; background-color: #1a1a1a; color: #fff;
  border-radius: 50%; display: flex; align-items: center;
  justify-content: center; font-size: 44rpx; font-weight: 300;
  transform: translateY(-16rpx); box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}
