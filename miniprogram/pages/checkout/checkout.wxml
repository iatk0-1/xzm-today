<view class="checkout-wrapper">
  
  <view class="page-title">订单结算</view>

  <view class="address-section" bindtap="chooseAddress">
    <view class="empty-address" wx:if="{{!address}}">
      <view class="add-icon">+</view>
      <text>请选择微信收货地址</text>
    </view>

    <view class="real-address" wx:else>
      <view class="address-user">
        <text class="name">{{address.recipient}}</text>
        <text class="phone">{{address.phone}}</text>
      </view>
      <view class="address-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view>
      <view class="arrow">></view>
    </view>
  </view>

  <view class="order-items-section">
    <view class="section-label">商品清单 · {{orderCount}} 笔订单</view>

    <view class="checkout-group" wx:for="{{checkoutGroups}}" wx:key="key" wx:for-item="group" wx:for-index="groupIndex">
      <view class="checkout-group-header">
        <view>
          <view class="checkout-group-title">订单 {{groupIndex + 1}} · {{group.title}}</view>
          <view class="checkout-group-shop" wx:if="{{group.shopCode}}">店铺 {{group.shopCode}}</view>
        </view>
        <view class="checkout-group-total">¥ {{group.totalPrice}}</view>
      </view>
    <view class="item-card" wx:for="{{group.items}}" wx:key="sourceIndex" wx:for-item="item" wx:for-index="itemIndex">
      <image class="item-img" src="{{item.coverUrl || item.image}}" mode="aspectFill"></image>
      <view class="item-info">
        <view class="item-title">{{item.name || item.title}}</view>
        
        <view class="item-bundle" wx:if="{{item.bundleConfig && item.bundleConfig.length > 0}}">
          <view class="bundle-sub-item" wx:for="{{item.bundleConfig}}" wx:key="skuId" wx:for-item="sub">
            <text class="sub-name">{{sub.bundleGroupName}}</text>
            <text class="sub-spec">{{sub.color}} / {{sub.size}} x {{sub.count}}</text>
            <text class="sub-price">¥{{sub.price}}</text>
          </view>
        </view>
        <view class="item-sku" wx:else>
          {{item.selectedColor ? '颜色：' + item.selectedColor : ''}}
          {{item.selectedColor && item.selectedSize ? ' / ' : ''}}
          {{item.selectedSize ? '尺码：' + item.selectedSize : ''}}
          {{!item.selectedColor && !item.selectedSize ? '默认规格' : ''}}
        </view>
        
        <view class="item-bottom">
          <view class="item-price">¥ {{item.finalPrice || item.price}}</view>
          <view class="item-count">x {{item.count}}</view>
        </view>
        <view class="item-remark">
          <input class="remark-input" placeholder="给这件商品加个备注..." value="{{item.remark}}" bindinput="onRemarkInput"
            data-source-index="{{item.sourceIndex}}" data-group-index="{{groupIndex}}" data-item-index="{{itemIndex}}" maxlength="200" />
        </view>
      </view>
    </view>
    </view>
  </view>

  <view class="summary-section">
    <view class="summary-row">
      <text class="sum-label">商品小计</text>
      <text class="sum-value">¥ {{totalPrice}}</text>
    </view>
    <view class="summary-row">
      <text class="sum-label">运费</text>
      <text class="sum-value">¥ 0.00</text>
    </view>
    <view class="summary-row total-row">
      <text class="sum-label">合计</text>
      <text class="sum-value total-val">¥ {{totalPrice}}</text>
    </view>
  </view>

  <view class="bottom-pay-bar">
    <view class="pay-total">
      <text class="pay-label">合计</text>
      <text class="pay-price">¥ {{totalPrice}}</text>
    </view>
    <view class="btn-pay {{submitting ? 'disabled' : ''}}" bindtap="submitOrder">{{submitting ? '处理中...' : (orderCount > 1 ? '分单支付' : '立即支付')}}</view>
  </view>

</view>
