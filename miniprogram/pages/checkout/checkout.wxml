<view class="checkout-wrapper">
  
  <view class="page-title">订单结算</view>

  <view class="address-section" bindtap="chooseAddress">
    <view class="empty-address" wx:if="{{!address}}">
      <view class="add-icon">+</view>
      <text>请选择微信收货地址</text>
    </view>

    <view class="real-address" wx:else>
      <view class="address-user">
        <text class="name">{{address.recipient}}</text>
        <text class="phone">{{address.phone}}</text>
      </view>
      <view class="address-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view>
      <view class="arrow">></view>
    </view>
  </view>

  <view class="order-items-section">
    <view class="section-label">商品清单 · 共 {{itemQuantity}} 件（一套算一件）</view>
    <view class="shipping-hint" wx:if="{{!checkoutItems.length}}">暂无结算商品，请返回挑选商品。</view>
    
    <view class="item-card" wx:for="{{checkoutItems}}" wx:key="id">
      <image class="item-img" src="{{item.coverUrl || item.image}}" mode="aspectFill"></image>
      <view class="item-info">
        <view class="item-title">{{item.name || item.title}}</view>
        
        <view class="item-bundle" wx:if="{{item.bundleConfig && item.bundleConfig.length > 0}}">
          <view class="bundle-sub-item" wx:for="{{item.bundleConfig}}" wx:key="skuId" wx:for-item="sub">
            <text class="sub-name">{{sub.bundleGroupName}}</text>
            <text class="sub-spec">{{sub.color}} / {{sub.size}} x {{sub.count}}</text>
            <text class="sub-price">¥{{sub.price}}</text>
          </view>
        </view>
        <view class="item-sku" wx:else>
          {{item.selectedColor ? '颜色：' + item.selectedColor : ''}}
          {{item.selectedColor && item.selectedSize ? ' / ' : ''}}
          {{item.selectedSize ? '尺码：' + item.selectedSize : ''}}
          {{!item.selectedColor && !item.selectedSize ? '默认规格' : ''}}
        </view>
        
        <view class="item-bottom">
          <view class="item-price">¥ {{item.finalPrice || item.price}}</view>
          <view class="quantity-controls">
            <button size="mini" data-index="{{index}}" data-delta="-1" bindtap="changeQuantity" disabled="{{item.count <= 1 || submitting || orderCreated}}">−</button>
            <text>{{item.count}}{{item.bundleConfig && item.bundleConfig.length ? '套' : '件'}}</text>
            <button size="mini" data-index="{{index}}" data-delta="1" bindtap="changeQuantity" disabled="{{submitting || orderCreated}}">＋</button>
          </view>
        </view>
        <view class="remove-item" data-index="{{index}}" bindtap="removeItem" wx:if="{{!submitting && !orderCreated}}">移除商品</view>
        <view class="item-remark">
          <input class="remark-input" placeholder="给这件商品加个备注..." value="{{item.remark}}" bindinput="onRemarkInput" data-index="{{index}}" maxlength="200" />
        </view>
      </view>
    </view>
  </view>

  <view class="summary-section">
    <view class="summary-row">
      <text class="sum-label">商品小计</text>
      <text class="sum-value">¥ {{goodsAmount}}</text>
    </view>
    <view class="summary-row">
      <text class="sum-label">运费</text>
      <text class="sum-value" wx:if="{{shippingReady}}">¥ {{shippingFee}}</text>
      <text class="sum-value" wx:else>{{!address ? '选择地址后计算' : (shippingLoading ? '计算中…' : '待计算')}}</text>
    </view>
    <view class="shipping-error" wx:if="{{shippingError}}" bindtap="refreshShippingQuote">{{shippingError}} · 点击重试</view>
    <view class="shipping-error" wx:if="{{shippingMessage}}">{{shippingMessage}}</view>
    <view class="shipping-hint" wx:elif="{{shippingReady && maxQuantity}}">当前收货省份每单最多购买 {{maxQuantity}} 件</view>
    <view class="summary-row total-row">
      <text class="sum-label">合计</text>
      <text class="sum-value total-val">¥ {{totalPrice}}</text>
    </view>
  </view>

  <view class="bottom-pay-bar">
    <view class="pay-left">
      <view class="pay-total">
        <text class="pay-label">合计</text>
        <text class="pay-price">¥ {{totalPrice}}</text>
      </view>
      <view class="purchase-notice-agreement">
        <view class="agreement-toggle" bindtap="togglePurchaseNoticeAgreement">
          <view class="agreement-radio {{purchaseNoticeAgreed ? 'checked' : ''}}">{{purchaseNoticeAgreed ? '✓' : ''}}</view>
          <text>已阅读并同意</text>
        </view>
        <text class="agreement-link" catchtap="openPurchaseNotice">购买须知</text>
      </view>
    </view>
    <view class="btn-pay {{!orderCreated && (!purchaseNoticeAgreed || !purchaseNoticeReady || submitting || !shippingReady || !shippingAllowed) ? 'disabled' : ''}}" bindtap="submitOrder">{{submitting ? '支付处理中' : (orderCreated ? '查看订单并支付' : '立即支付')}}</view>
  </view>

</view>

<view class="purchase-notice-mask" wx:if="{{showPurchaseNotice}}" bindtap="closePurchaseNotice" catchtouchmove="stopPurchaseNoticeTouch">
  <view class="purchase-notice-modal" catchtap="stopPurchaseNoticeTouch">
    <view class="purchase-notice-modal-header">
      <text>购买须知</text>
      <view class="purchase-notice-close" bindtap="closePurchaseNotice">×</view>
    </view>
    <scroll-view class="purchase-notice-scroll" scroll-y="true">
      <view class="purchase-notice-entry" wx:for="{{purchaseNoticeSections}}" wx:key="id">
        <view class="purchase-notice-product" wx:if="{{item.title}}">{{item.title}}</view>
        <text class="purchase-notice-text" user-select="true">{{item.content}}</text>
      </view>
    </scroll-view>
    <view class="purchase-notice-dismiss" bindtap="closePurchaseNotice">关闭</view>
  </view>
</view>
