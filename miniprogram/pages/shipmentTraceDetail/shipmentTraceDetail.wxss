page {
  background: #f7f8fa;
  min-height: 100vh;
}

.page {
  padding: 20rpx;
}

.package-section {
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
}

.package-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.package-heading-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.package-count,
.package-hint {
  font-size: 22rpx;
  color: #8a929d;
}

.package-scroll {
  width: 100%;
}

.package-options {
  display: flex;
}

.package-option {
  display: flex;
  flex: 0 0 174rpx;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 14rpx 10rpx;
  margin-right: 16rpx;
  border: 2rpx solid #edf0f3;
  border-radius: 14rpx;
  background: #fafbfc;
}

.package-option:last-child {
  margin-right: 0;
}

.package-option.is-active {
  border-color: #ea580c;
  background: #fff7ed;
}

.package-image-wrap {
  position: relative;
  width: 132rpx;
  height: 132rpx;
}

.package-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background: #f0f2f5;
}

.package-latest {
  position: absolute;
  top: 0;
  left: 0;
  padding: 3rpx 10rpx;
  border-radius: 8rpx 0 8rpx 0;
  color: #fff;
  background: #ea580c;
  font-size: 19rpx;
}

.package-name {
  margin-top: 12rpx;
  color: #333;
  font-size: 26rpx;
  font-weight: 600;
}

.is-active .package-name {
  color: #c2410c;
}

.package-quantity,
.package-carrier {
  max-width: 100%;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #8a929d;
  font-size: 20rpx;
}

.package-hint {
  margin-top: 18rpx;
}

.selected-package {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
}

.selected-package-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.selected-product-name {
  font-size: 26rpx;
  line-height: 1.4;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.selected-product-spec,
.selected-package-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8a929d;
}

.shipment-items {
  margin-top: 16rpx;
}

.shipment-goods {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}

.shipment-goods:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.shipment-goods-image {
  width: 120rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.shipment-goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.shipment-goods-qty {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #333;
  font-weight: 600;
  text-align: right;
}

.btn-retry {
  display: inline-block;
  margin-top: 28rpx;
  padding: 12rpx 32rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
}

.page-loading {
  margin: 20rpx;
}

.trace-header,
.trace-card,
.empty-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.header-top {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.header-status {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 12rpx;
  background: #fff7ed;
}

.header-status-label {
  margin-bottom: 6rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #c2410c;
  font-weight: 600;
}

.header-status-text {
  display: block;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.65;
  color: #9a3412;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.header-meta {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.meta-label {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.meta-value-box {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.meta-value {
  font-size: 24rpx;
  color: #333;
  word-break: break-all;
  text-align: right;
}

.btn-copy {
  font-size: 20rpx;
  color: #1a1a1a;
  border: 1rpx solid #1a1a1a;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.header-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a929d;
  line-height: 1.6;
}

.trace-list {
  display: flex;
  flex-direction: column;
}

.trace-node {
  display: flex;
  gap: 18rpx;
}

.trace-axis {
  width: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.trace-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #c9ced6;
  margin-top: 8rpx;
}

.trace-line {
  width: 2rpx;
  flex: 1;
  background: #e5e9ef;
  margin: 8rpx 0;
}

.trace-content {
  flex: 1;
  padding-bottom: 28rpx;
}

.trace-node:last-child .trace-content {
  padding-bottom: 0;
}

.trace-desc {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.trace-phone {
  color: #1769aa;
  text-decoration: underline;
}

.trace-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a929d;
}

.trace-node.latest .trace-dot {
  background: #1f2933;
}

.trace-node.latest .trace-desc {
  color: #111;
  font-weight: 600;
}

.empty-card {
  text-align: center;
  padding: 100rpx 28rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #333;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}
