<!-- miniprogram/pages/afterSaleApply/afterSaleApply.wxml -->
<view class="page-wrapper">

  <!-- 顶部订单信息 -->
  <view class="order-info-section" wx:if="{{order}}">
    <view class="order-header">
      <view class="order-id-box">
        <text class="order-id">订单号：{{order.id}}</text>
        <text class="copy-btn" catchtap="copyOrderNo">复制</text>
      </view>
      <text class="order-status">{{order.statusDisplay}}</text>
    </view>
  </view>

  <!-- 选择商品区域 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">选择售后商品</view>
      <view class="select-all" bindtap="toggleSelectAll" aria-role="button">
        {{selectedItems.length === splitItems.length && splitItems.length > 0 ? '取消全选' : '全选'}}<view class="select-all-circle {{selectedItems.length === splitItems.length && splitItems.length > 0 ? 'checked' : ''}}"><text wx:if="{{selectedItems.length === splitItems.length && splitItems.length > 0}}">✓</text></view>
      </view>
    </view>
    <view class="after-sale-type-tip">未发货仅退款；已发货退货退款。
部分发货按已发、未发分别申请。</view>
    <view class="split-items-list">
      <view
        class="split-item {{item.selected ? 'selected' : ''}}"
        wx:for="{{splitItems}}"
        wx:key="itemKey"
        bindtap="toggleSelectItem"
        data-index="{{index}}">

        <view class="goods-main">
          <view class="checkbox {{item.selected ? 'checked' : ''}}">
          <text wx:if="{{item.selected}}">✓</text>
        </view>
          <image class="goods-img" src="{{item.productImage}}" mode="aspectFill"></image>
          <view class="goods-info">
            <view class="goods-title">{{item.productName}}</view>
            <view class="goods-sku">
            <!-- 旧格式套装子项列表（bundleConfig JSONB） -->
            <view class="goods-bundle" wx:if="{{item.bundleConfig && item.bundleConfig.length > 0}}">
              <view class="bundle-sub" wx:for="{{item.bundleConfig}}" wx:key="skuId" wx:for-item="sub">
                <text class="bundle-sub-name">{{sub.bundleGroupName}}:</text>
                <text class="bundle-sub-spec">{{sub.color}} / {{sub.size}} x {{sub.count}}</text>
              </view>
            </view>
            <!-- 新格式扁平化套装子项（bundleGroupName） -->
            <text wx:elif="{{item.bundleGroupName}}">
              <text class="bundle-sub-name">{{item.bundleGroupName}}:</text> {{item.skuSpec}} / {{item.skuSize}}
            </text>
            <!-- 普通商品 -->
            <text wx:else>{{item.skuSpec}} / {{item.skuSize}}</text>
          </view>
            <view class="goods-status"><text>{{item.displayStatus}}</text><text>· 可申请 {{item.qty}} 件</text></view>
            <view class="after-sale-type-tag">{{item.type === 'refund' ? '仅退款' : '退货退款'}}</view>
            <view class="goods-price-row"><text class="price">¥{{item.salePriceDisplay || item.salePrice}}</text><text class="max-refund">最多可退 ¥{{item.maxRefundAmount}}</text></view>
            <view class="after-sale-limit" wx:if="{{item.reservedQty > 0}}">已售后占用 {{item.reservedQty}}件 / ¥{{item.reservedAmount}}</view>
          </view>
        </view>
        <view class="refund-edit-row" wx:if="{{item.selected}}" catchtap="noop">
            <view class="refund-edit-field">
              <text class="refund-edit-label">申请数量</text>
              <view class="refund-edit-control">
              <view class="refund-qty-stepper after-sale-qty-stepper">
                <view
                  class="refund-qty-btn after-sale-qty-button {{item.selectedQty <= 1 ? 'disabled' : ''}}"
                  data-index="{{index}}"
                  catchtap="decreaseRefundQty">-</view>
                <view class="refund-qty-value after-sale-qty-number">{{item.selectedQty}}</view>
                <view
                  class="refund-qty-btn after-sale-qty-button {{item.selectedQty >= item.qty ? 'disabled' : ''}}"
                  data-index="{{index}}"
                  catchtap="increaseRefundQty">+</view>
              </view>
              <text class="refund-edit-unit">件</text>
              </view>
            </view>
            <view class="refund-edit-field">
              <text class="refund-edit-label">退款金额</text>
              <view class="refund-edit-control">
              <input
                class="refund-edit-input amount"
                type="digit"
                value="{{item.inputAmount}}"
                data-index="{{index}}"
                bindinput="onRefundAmountInput"
                catchtap="noop" />
              <text class="refund-edit-unit">元</text>
              </view>
            </view>
          </view>
        <view class="item-channel-note" wx:if="{{item.selected && selectedItems.length > 1 && order.offlinePaidAmount > 0 && refundQuote && refundQuote.offlineAmount > 0 && !refundQuoteLoading}}">线上 ¥{{item.onlineRefundAmount}} · 线下 ¥{{item.offlineRefundAmount}}</view>
      </view>
    </view>
  </view>

  <view class="section refund-channel-summary" wx:if="{{selectedItems.length}}">
    <view class="section-title">退款明细</view>
    <view class="refund-detail-row"><text>申请退款</text><text>¥ {{totalAmount}}</text></view>
    <block wx:if="{{order.offlinePaidAmount > 0}}">
      <view wx:if="{{refundQuoteLoading}}">正在计算线上、线下退款金额…</view>
      <view class="refund-channel-error" wx:elif="{{refundQuoteError}}">{{refundQuoteError}}</view>
      <block wx:elif="{{refundQuote}}">
        <block wx:if="{{refundQuote.offlineAmount > 0}}">
        <view class="refund-detail-row"><text>线上退款</text><text>¥ {{refundQuote.onlineAmount}}</text></view><view class="refund-detail-row"><text>线下退款</text><text>¥ {{refundQuote.offlineAmount}}</text></view>
        <view class="refund-channel-tip">线下退款请联系客服处理；线上退款按审核结果原路退回。</view>
        <view class="refund-channel-tip" wx:if="{{!refundQuote.finalSettlement}}">部分退款保留最后0.01元线上款，剩余商品和应退余额全部结清时再退。</view>
        </block>
      </block>
    </block>
  </view>

  <!-- 售后原因 -->
  <view class="section">
    <view class="section-title">售后原因</view>
    <view class="reason-tags">
      <view
        class="reason-tag {{reason === item ? 'selected' : ''}}"
        wx:for="{{reasonOptions}}"
        wx:key="*this"
        bindtap="selectReason"
        data-reason="{{item}}">
        {{item}}
      </view>
    </view>
    <view id="reason-description" class="reason-description">
    <textarea
      class="reason-textarea"
      placeholder="补充说明（选填）"
      model:value="{{reasonInputValue}}"
      auto-height="{{true}}"
      disable-default-padding="{{true}}"
      adjust-position="{{false}}"
      bindfocus="onReasonFocus"
      bindkeyboardheightchange="onReasonKeyboardHeightChange"
      bindinput="onReasonInput"
      bind:keyboardcompositionstart="onReasonCompositionStart"
      bind:keyboardcompositionend="onReasonCompositionEnd"
      bindblur="onReasonBlur"
      bindconfirm="onReasonFinish"
      maxlength="-1"/>
    <view class="reason-count">{{reasonLength}}/500</view>
    </view>
  </view>

  <!-- 上传凭证图片 -->
  <view class="section">
    <view class="section-header"><view class="section-title">凭证图片</view><text class="section-note">选填 · 最多 9 张</text></view>
    <view class="evidence-uploader">
      <view
        class="image-preview"
        wx:for="{{evidenceImages}}"
        wx:key="*this"
        bindtap="previewImage"
        data-index="{{index}}">
        <image class="evidence-image" src="{{item}}" mode="aspectFill"></image>
        <view class="image-delete" catchtap="deleteImage" data-index="{{index}}">×</view>
      </view>
      <view class="upload-btn" bindtap="uploadImage" wx:if="{{evidenceImages.length < 9}}">
        <view class="upload-icon">+</view>
        <view class="upload-text">上传凭证</view>
      </view>
    </view>
  </view>

  <!-- 底部提交栏 -->
  <view style="height: {{reasonKeyboardSpace}}px;" aria-hidden="true"></view>
  <view class="submit-bar">
    <view class="submit-info">
      <text class="submit-label">申请退款 · 已选 {{selectedItems.length}} 项</text>
      <text class="submit-amount">¥ {{totalAmount || '0.00'}}</text>
    </view>
    <view class="submit-btn {{selectedItems.length > 0 ? 'active' : ''}}" bindtap="submitAfterSale">提交申请</view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

</view>
