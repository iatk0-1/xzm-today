/* miniprogram/pages/afterSaleApply/afterSaleApply.wxss */

.page-wrapper {
  padding-bottom: 120rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 订单信息区域 */
.order-info-section {
  background-color: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-id {
  font-size: 26rpx;
  color: #666;
}

.order-status {
  font-size: 26rpx;
  color: #111;
  font-weight: 500;
}

/* 通用区块样式 */
.section {
  background-color: #fff;
  margin-bottom: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 24rpx;
}

/* 商品列表 */
.goods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background-color: #fafafa;
  position: relative;
}

.goods-item.selected {
  background-color: #fff5f5;
  border: 2rpx solid #ff6b6b;
}

.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goods-title {
  font-size: 28rpx;
  color: #111;
  font-weight: 500;
  line-height: 1.4;
}

.goods-sku {
  font-size: 24rpx;
  color: #999;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.price {
  font-size: 32rpx;
  color: #ff4444;
  font-weight: 600;
}

.stock-qty {
  font-size: 24rpx;
  color: #999;
}

/* 单选按钮 */
.radio-circle {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.radio-circle-checked {
  width: 40rpx;
  height: 40rpx;
  background-color: #ff4444;
  border-radius: 50%;
  margin-left: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

/* 售后类型选择 */
.type-selector {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 12rpx;
  background-color: #fafafa;
  position: relative;
}

.type-item.selected {
  background-color: #fff5f5;
  border: 2rpx solid #ff6b6b;
}

.type-title {
  font-size: 28rpx;
  color: #111;
  font-weight: 600;
  margin-right: 16rpx;
}

.type-desc {
  flex: 1;
  font-size: 24rpx;
  color: #999;
}

/* 数量选择器 */
.quantity-selector {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.quantity-btn {
  width: 64rpx;
  height: 64rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #111;
}

.quantity-btn:active {
  background-color: #e0e0e0;
}

.quantity-value {
  width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.quantity-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 退款金额输入 */
.refund-amount-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.currency-symbol {
  font-size: 32rpx;
  color: #ff4444;
  font-weight: 600;
}

.refund-amount-input {
  flex: 1;
  font-size: 40rpx;
  color: #ff4444;
  font-weight: 600;
  border-bottom: 2rpx solid #eee;
  padding: 16rpx 0;
}

.max-refund-tip {
  font-size: 24rpx;
  color: #999;
  margin-left: auto;
}

/* 原因标签 */
.reason-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.reason-tag {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background-color: #f5f5f5;
  font-size: 26rpx;
  color: #666;
}

.reason-tag.selected {
  background-color: #fff5f5;
  border: 2rpx solid #ff6b6b;
  color: #ff4444;
}

.reason-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 图片上传 */
.evidence-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-icon {
  font-size: 64rpx;
  color: #ccc;
  line-height: 1;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.image-preview {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.evidence-image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}

/* 提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.submit-label {
  font-size: 26rpx;
  color: #666;
}

.submit-amount {
  font-size: 40rpx;
  color: #ff4444;
  font-weight: 600;
}

.submit-btn {
  background-color: #ff4444;
  color: #fff;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.submit-btn:active {
  background-color: #ff3333;
}

/* 加载状态 */
.loading-state {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 1000;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #ff4444;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}
