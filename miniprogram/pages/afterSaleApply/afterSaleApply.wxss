@import "../../styles/afterSale.wxss";
.order-info-section { padding: 16rpx 40rpx; background: #f7f7f7; }
.order-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.order-id-box { display: flex; align-items: center; flex: 1; min-width: 0; gap: 12rpx; }
.order-id { color: #333; font-size: 22rpx; word-break: break-all; }
.order-id-box .copy-btn { margin-left: auto; color: #333; }
.order-status { color: #888; font-size: 22rpx; padding-left: 18rpx; border-left: 1rpx solid #ddd; flex-shrink: 0; }
.section { padding: 22rpx 0; }
.section-title { font-size: 32rpx; line-height: 44rpx; }
.section-header { margin-bottom: 8rpx; }
.select-all { display: flex; align-items: center; gap: 10rpx; font-size: 24rpx; color: #666; padding: 8rpx 0 8rpx 16rpx; }
.select-all-circle { width: 28rpx; height: 28rpx; border: 1rpx solid #aaa; border-radius: 50%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #fff; font-size: 20rpx; line-height: 1; }
.select-all-circle.checked { background: #111; border-color: #111; }
.after-sale-type-tip { font-size: 22rpx; line-height: 32rpx; color: #888; white-space: pre-line; margin-bottom: 28rpx; }
.split-item { padding: 24rpx 0; border-bottom: 1rpx solid #ededed; }
.split-item:first-child { padding-top: 0; }
.split-item:last-child { border-bottom: 0; padding-bottom: 0; }
.goods-main { display: flex; align-items: flex-start; gap: 28rpx; }
.checkbox { display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; box-sizing: border-box; border: 1rpx solid #aaa; border-radius: 50%; margin-top: 76rpx; flex-shrink: 0; font-size: 22rpx; color: #fff; }
.checkbox.checked { border-color: #111; background: #111; }
.goods-img { width: 148rpx; height: 188rpx; border-radius: 4rpx; background: #f7f7f7; flex-shrink: 0; }
.goods-info { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 4rpx; }
.goods-title { color: #222; font-size: 28rpx; font-weight: 500; line-height: 40rpx; word-break: break-all; }
.goods-sku, .bundle-sub { font-size: 24rpx; color: #888; line-height: 34rpx; word-break: break-all; }
.bundle-sub-name { margin-right: 6rpx; }
.goods-status { display: flex; flex-wrap: wrap; gap: 8rpx; color: #888; font-size: 22rpx; line-height: 32rpx; }
.after-sale-type-tag { padding: 0 8rpx; font-size: 22rpx; color: #666; line-height: 30rpx; border: 1rpx solid #ddd; border-radius: 4rpx; }
.goods-price-row { width: 100%; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4rpx 8rpx; margin-top: 4rpx; }
.price { color: #111; font-size: 28rpx; line-height: 38rpx; font-weight: 600; }
.max-refund { color: #888; font-size: 20rpx; line-height: 32rpx; }
.after-sale-limit { color: #a0753c; font-size: 22rpx; line-height: 32rpx; }
.refund-edit-row { margin: 20rpx 0 0 72rpx; padding: 14rpx 0 0; border-top: 1rpx solid #ededed; display: flex; flex-direction: column; gap: 14rpx; }
.refund-edit-field { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; }
.refund-edit-label { flex: 1; font-size: 24rpx; color: #444; }
.refund-edit-control { width: 115px; flex-shrink: 0; display: flex; align-items: center; gap: 6px; }
.refund-edit-input { width: 95px; height: 30px; box-sizing: border-box; padding: 0 8px; text-align: right; font-size: 13px; border: 1px solid #eee; border-radius: 0; }
.refund-edit-unit { width: 14px; flex-shrink: 0; font-size: 22rpx; color: #888; }
.item-channel-note { margin: 12rpx 0 0 58rpx; font-size: 22rpx; color: #888; }
.refund-detail-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 5rpx 0; font-size: 26rpx; line-height: 36rpx; }
.refund-detail-row:first-of-type { border-bottom: 1rpx solid #eee; }
.reason-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.reason-tag { width: calc((100% - 24rpx) / 3); min-height: 52rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 6rpx 4rpx; color: #444; font-size: 23rpx; line-height: 32rpx; border: 1rpx solid #ddd; border-radius: 6rpx; text-align: center; }
.reason-tag.selected { border-color: #111; background: #f7f7f7; color: #111; }
.reason-description { position: relative; padding-bottom: 28rpx; border-radius: 6rpx; background: #f7f7f7; }
.reason-textarea { width: 100%; height: 76rpx; box-sizing: border-box; padding: 14rpx 16rpx; background: #f7f7f7; border-radius: 6rpx; font-size: 24rpx; line-height: 36rpx; }
.reason-count { position: absolute; right: 16rpx; bottom: 8rpx; font-size: 22rpx; line-height: 28rpx; color: #999; }
.evidence-uploader { display: flex; flex-wrap: wrap; gap: 16rpx; }
.upload-btn, .image-preview { width: 128rpx; height: 128rpx; box-sizing: border-box; border-radius: 4rpx; position: relative; }
.upload-btn { border: 1rpx solid #ddd; background: #fafafa; display: flex; align-items: center; justify-content: center; flex-direction: column; color: #777; }
.upload-icon { font-size: 40rpx; line-height: 48rpx; font-weight: 300; }
.upload-text { font-size: 22rpx; margin-top: 6rpx; }
.evidence-image { width: 100%; height: 100%; border-radius: 4rpx; }
.image-delete { position: absolute; top: -8rpx; right: -8rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #111; color: #fff; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
.submit-bar { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.submit-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.submit-label { font-size: 22rpx; color: #888; line-height: 32rpx; }
.submit-amount { font-size: 38rpx; line-height: 48rpx; font-weight: 600; color: #111; word-break: break-all; }
.submit-btn { background: #eee; border-color: #eee; color: #999; min-width: 220rpx; flex-shrink: 0; }
.submit-btn.active { background: #111; border-color: #111; color: #fff; }
