.page { min-height: 100vh; padding: 16px; box-sizing: border-box; background: #f6f6f6; font-size: 14px; color: #333; }
.title { font-size: 18px; font-weight: bold; margin: 8px 0 18px; }.card { background: #fff; border-radius: 8px; padding: 14px; line-height: 2; }
.section { margin: 22px 0 10px; font-weight: bold; }.item { display: flex; gap: 10px; align-items: center; padding: 12px; background: #fff; border-bottom: 1rpx solid #eee; line-height: 1.8; }
.item image { width: 72px; height: 72px; border-radius: 5px; background: #eee; }.muted { color: #999; font-size: 12px; }.empty { color: #999; text-align: center; padding: 30px; }
