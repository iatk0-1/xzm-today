<view class="page">
  <view class="title">客服订单详情</view>
  <view wx:if="{{order}}" class="card">
    <view>订单号：{{order.id}}</view>
    <view>状态：{{order.statusDisplay}}</view>
    <view>金额：¥{{order.payAmount}}</view>
    <view>下单时间：{{order.createdAtDisplay}}</view>
  </view>
  <view class="section">商品信息</view>
  <view class="item" wx:for="{{items}}" wx:key="index">
    <image src="{{item.productImage}}" mode="aspectFill"/>
    <view><view>{{item.productName || '商品'}}</view><view class="muted">{{item.skuSpec}} {{item.skuSize}}</view><view>¥{{item.salePrice}} × {{item.qty}}</view></view>
  </view>
  <view class="empty" wx:if="{{!order && !loading}}">暂无法查看此订单</view>
</view>
