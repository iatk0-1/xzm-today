page {
  background-color: #f7f8fa;
  padding-bottom: 120rpx;
}

.container {
  padding: 20rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

.info-value.status-active {
  color: #1890ff;
}

.info-value.status-completed {
  color: #52c41a;
}

/* 区块 */
.section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-item {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-id {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.order-status.status-paid {
  background-color: #fff3e0;
  color: #ff9800;
}

.order-status.status-shipped {
  background-color: #e8f5e9;
  color: #4caf50;
}

.order-amount {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
}

.btn-unbind {
  font-size: 24rpx;
  color: #ff4d4f;
  background-color: #fff5f5;
  border: 1rpx solid #ffcccc;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.add-order-btn {
  margin-top: 20rpx;
  text-align: center;
}

/* 发货记录 */
.shipment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.shipment-item {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.shipment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #e0e0e0;
}

.shipment-index {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.shipment-time {
  font-size: 22rpx;
  color: #999;
}

.shipment-info .info-row {
  padding: 8rpx 0;
}

.shipment-info .label {
  font-size: 24rpx;
  color: #999;
}

.shipment-info .value {
  font-size: 24rpx;
  color: #333;
  font-family: -apple-system, sans-serif;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 20rpx;
  gap: 20rpx;
}

.btn-complete {
  background-color: #fff;
  color: #1890ff;
  border: 1rpx solid #1890ff;
  padding: 0 36rpx;
  height: 64rpx;
  line-height: 62rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.btn-ship {
  background-color: #1a1a1a;
  color: #ffffff;
  padding: 0 36rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  font-weight: bold;
}

.btn-primary {
  background-color: #1890ff;
  color: #ffffff;
  padding: 12rpx 48rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  border: none;
}
