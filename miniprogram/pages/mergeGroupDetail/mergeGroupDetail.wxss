page {
  background-color: #f7f8fa;
  padding-bottom: 120rpx;
}

.container {
  padding: 20rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

.info-value.status-active {
  color: #1890ff;
}

.info-value.status-completed {
  color: #52c41a;
}

/* 区块 */
.section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-item {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-id {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.order-status.status-paid {
  background-color: #fff3e0;
  color: #ff9800;
}

.order-status.status-shipped {
  background-color: #e8f5e9;
  color: #4caf50;
}

.order-amount {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

/* 商品列表 */
.goods-list {
  margin-bottom: 16rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.goods-item:first-child {
  border-top: none;
}

.goods-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  overflow: hidden;
}

.goods-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.goods-price {
  font-size: 24rpx;
  color: #ff6b00;
  font-weight: bold;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
}

.btn-unbind {
  font-size: 24rpx;
  color: #ff4d4f;
  background-color: #fff5f5;
  border: 1rpx solid #ffcccc;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.add-order-btn {
  margin-top: 20rpx;
  text-align: center;
}

/* 发货记录 */
.shipment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.shipment-item {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.shipment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #e0e0e0;
}

.shipment-index {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.shipment-time {
  font-size: 22rpx;
  color: #999;
}

.shipment-info .info-row {
  padding: 8rpx 0;
}

.shipment-info .label {
  font-size: 24rpx;
  color: #999;
}

.shipment-info .value {
  font-size: 24rpx;
  color: #333;
  font-family: -apple-system, sans-serif;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 20rpx;
  gap: 20rpx;
}

.btn-complete {
  background-color: #fff;
  color: #1890ff;
  border: 1rpx solid #1890ff;
  padding: 0 36rpx;
  height: 64rpx;
  line-height: 62rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.btn-ship {
  background-color: #1a1a1a;
  color: #ffffff;
  padding: 0 36rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  font-weight: bold;
}

.btn-primary {
  background-color: #1890ff;
  color: #ffffff;
  padding: 12rpx 48rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  border: none;
}

/* 发货记录头部 - 全选按钮 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.select-all-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #ff4d4f;
  font-weight: bold;
}

/* 发货单列表 - 带选择框 */
.shipment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.shipment-item-with-checkbox {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.shipment-checkbox {
  flex-shrink: 0;
  padding-top: 8rpx;
}

.shipment-content {
  flex: 1;
}

.shipment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #e0e0e0;
}

.shipment-index {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.shipment-time {
  font-size: 22rpx;
  color: #999;
}

.shipment-info .info-row {
  padding: 8rpx 0;
}

.shipment-info .label {
  font-size: 24rpx;
  color: #999;
}

.shipment-info .value {
  font-size: 24rpx;
  color: #333;
  font-family: -apple-system, sans-serif;
}

.shipment-action {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e0e0e0;
}

.btn-print-single {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
}

/* 批量打印栏 - 底部固定 */
.batch-print-bar {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  z-index: 100;
}

.batch-print-bar .selected-count {
  font-size: 26rpx;
  color: #666;
}

.btn-batch-print {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  padding: 0 48rpx;
}

.btn-batch-print[disabled] {
  background-color: #e0e0e0;
  color: #999;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: #1890ff;
  border-color: #1890ff;
}

.checkbox.checked::after {
  content: '✓';
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
}
