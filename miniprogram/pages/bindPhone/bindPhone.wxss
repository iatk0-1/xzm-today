/* miniprogram/pages/bindPhone/bindPhone.wxss */

.bind-phone-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

.header-section {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

.content-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-top: 40rpx;
}

.info-card {
  display: flex;
  align-items: flex-start;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.info-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.info-text {
  flex: 1;
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.info-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.btn-bind {
  width: 100%;
  background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
  color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 30rpx;
}

.btn-bind::after {
  border: none;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  font-size: 32rpx;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin: 30rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider-text {
  font-size: 26rpx;
  color: #999;
}

.btn-skip {
  width: 100%;
  background: transparent;
  color: #999;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee;
}

.btn-skip::after {
  border: none;
}

.tips-section {
  text-align: center;
  margin-top: 60rpx;
  padding: 20rpx;
}

.tips {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.links {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.link {
  color: #1a1a1a;
  text-decoration: underline;
}
