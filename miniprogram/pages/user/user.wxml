<view class="profile-container">

  <view class="header-section" style="padding-top: {{navTop + navHeight + 20}}px;">
    <view class="user-info">
      <view class="avatar-box">
        <open-data type="userAvatarUrl" class="avatar-img"></open-data>
      </view>
      <view class="user-text">
        <open-data type="userNickName" class="nickname">微信用户</open-data>
        <view class="user-tag">VIP Member</view>
      </view>
    </view>
  </view>

  <view class="order-section">
    <view class="section-header" bindtap="goToOrderList" data-status="all">
      <text class="title">我的订单</text>
      <text class="view-all">查看全部 ></text>
    </view>

    <scroll-view scroll-x class="order-scroll-grid" enhanced show-scrollbar="{{false}}">
      <view class="grid-item" bindtap="goToOrderList" data-status="pay">
        <view class="icon-box">💳</view>
        <text>待付款</text>
      </view>
      <view class="grid-item" bindtap="goToOrderList" data-status="paid">
        <view class="icon-box">📦</view>
        <text>待发货</text>
      </view>
      <view class="grid-item" bindtap="goToOrderList" data-status="shipped">
        <view class="icon-box">🚚</view>
        <text>待收货</text>
      </view>
      <view class="grid-item" bindtap="goToOrderList" data-status="completed">
        <view class="icon-box">✨</view>
        <text>已完成</text>
      </view>
    </scroll-view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToAddress">
      <text>收货地址</text>
      <text class="arrow">></text>
    </view>
    <button class="menu-item contact-btn" open-type="contact">
      <text>联系主理人</text>
      <text class="arrow">></text>
    </button>
  </view>

  <view class="bottom-tab-bar">
    <view class="tab-item" bindtap="goToIndex">首页</view>
    <view class="tab-item" bindtap="goToMarket">市集</view>
    <view class="tab-item admin-portal" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="red-plus-btn">+</view>
    </view>
    <view class="tab-item" bindtap="goToMessage">信息</view>
    <view class="tab-item active">我</view>
  </view>

</view>
