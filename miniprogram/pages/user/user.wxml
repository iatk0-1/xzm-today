<page-meta page-style="{{workbenchDraggingId ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="profile-container">

  <view class="header-section" style="padding-top: {{navTop + navHeight + 20}}px;">
    <view class="user-info">
      <view class="avatar-box" bindtap="goToEditProfile">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <open-data wx:else type="userAvatarUrl" class="avatar-img"></open-data>
      </view>
      <view class="user-text" bindtap="goToEditProfile">
        <view class="nickname">{{userInfo.nickname || '微信用户'}}</view>
        <!-- 已绑定手机号：显示手机号，点击可重新授权 -->
        <view class="user-tag" wx:if="{{isPhoneBound}}" catchtap="requestPhoneAuth">手机号：{{phone}}</view>
        <!-- 未绑定手机号：使用官方按钮直接触发授权 -->
        <button wx:else class="user-tag-btn unbound" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" catchtap="stopPropagation" disabled="{{phoneBinding}}">
          {{phoneBinding ? '绑定中...' : '未绑定手机号，点击去绑定'}}
        </button>
        <view class="role-row" wx:if="{{hasMultipleRoles}}">
          <view class="user-tag role-switch-btn" catchtap="switchRole">{{currentRoleLabel}}</view>
          <button size="mini" class="user-tag-btn role-switch-btn" catchtap="switchRole">切换</button>
        </view>
      </view>
      <view class="edit-icon" bindtap="goToEditProfile">✏️</view>
    </view>
  </view>

  <view class="order-section">
    <view class="section-header" bindtap="goToOrderList" data-status="all">
      <text class="title">我的订单</text>
      <text class="view-all">查看全部 ></text>
    </view>

    <scroll-view scroll-x class="order-scroll-grid" enhanced show-scrollbar="{{false}}">
      <view class="grid-item" bindtap="goToOrderList" data-status="pay">
        <view class="icon-box">💳</view>
        <text>待付款</text>
      </view>
      <view class="grid-item" bindtap="goToOrderList" data-status="stocking">
        <view class="icon-box">📦</view>
        <text>备货中</text>
      </view>
      <view class="grid-item" bindtap="goToOrderList" data-status="paid">
        <view class="icon-box">📦</view>
        <text>待发货</text>
      </view>
      <view class="grid-item" bindtap="goToOrderList" data-status="shipped">
        <view class="icon-box">🚚</view>
        <text>待收货</text>
      </view>
      <view class="grid-item" bindtap="goToOrderList" data-status="completed">
        <view class="icon-box">✨</view>
        <text>已完成</text>
      </view>
    </scroll-view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToAddress">
      <text>收货地址</text>
      <text class="arrow">></text>
    </view>
    <button class="menu-item contact-btn" open-type="contact" bindcontact="handleCustomerServiceContact" session-from="page:user">
      <text>联系客服</text>
      <text class="arrow">></text>
    </button>
  </view>

  <view class="workbench-section" wx:if="{{isAdmin || isStallManager}}">
    <view class="workbench-header">
      <view class="workbench-title">工作台</view>
      <text class="workbench-hint">{{workbenchDraggingId ? '松手保存位置' : workbenchSaving ? '正在同步排序...' : '长按按钮可拖动排序'}}</text>
    </view>
    <movable-area class="workbench-grid" style="height: {{workbenchHeight}}px;">
      <view wx:if="{{workbenchDraggingId}}" class="workbench-drop-slot" style="width: {{workbenchItemWidth}}px; height: {{workbenchItemHeight}}px; left: {{workbenchDropX}}px; top: {{workbenchDropY}}px;"></view>
      <movable-view wx:for="{{workbenchItems}}" wx:key="renderKey"
        class="workbench-movable {{workbenchDraggingId === item.id ? 'is-dragging' : ''}}"
        style="width: {{workbenchItemWidth}}px; height: {{workbenchItemHeight}}px;"
        x="{{item.x}}" y="{{item.y}}" direction="all" inertia="{{false}}" out-of-bounds="{{false}}"
        disabled="{{workbenchDraggingId !== item.id}}" animation="{{workbenchDraggingId !== item.id}}"
        data-entry="{{item.id}}" bindtouchstart="onWorkbenchTouchStart" bindlongpress="onWorkbenchDragStart"
        bindchange="onWorkbenchDragMove" bindtouchend="onWorkbenchDragEnd" bindtouchcancel="onWorkbenchDragCancel">
        <button class="workbench-button" bindtap="goToWorkbench" data-entry="{{item.id}}"
          style="width: {{workbenchItemWidth}}px; height: {{workbenchItemHeight}}px; margin: 0;"
          hover-class="{{workbenchDraggingId ? 'none' : 'workbench-button-hover'}}">
          <text class="workbench-button-label">{{item.label}}</text>
        </button>
      </movable-view>
    </movable-area>
  </view>

  <view class="bottom-tab-bar">
    <view class="tab-item" bindtap="goToIndex">首页</view>
    <view class="tab-item" bindtap="goToMarket">市集</view>
    <view class="tab-item admin-portal" wx:if="{{isAdmin || isStallManager}}" bindtap="goToCreateProduct">
      <view class="red-plus-btn">+</view>
    </view>
    <view class="tab-item" bindtap="goToMessages"><view class="message-tab-label">信息<text wx:if="{{messageUnreadCount > 0}}" class="message-tab-badge">{{messageUnreadLabel}}</text></view></view>
    <view class="tab-item active">我</view>
  </view>

</view>
