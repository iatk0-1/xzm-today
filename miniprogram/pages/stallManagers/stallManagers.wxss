page{background:#f4f6f8;color:#18212b}.page{padding:24rpx 24rpx 80rpx}.card{background:white;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}.title{font-size:34rpx;font-weight:600;margin-bottom:20rpx}.row{display:flex;align-items:center;gap:16rpx;margin:16rpx 0;flex-wrap:wrap}.field,input,textarea{background:#f4f6f8;padding:18rpx;border-radius:8rpx;margin:12rpx 0;box-sizing:border-box}input{min-height:72rpx;flex:1}textarea{width:100%}.muted{color:#667788;font-size:25rpx;line-height:1.7}.amount{font-size:40rpx;font-weight:600}.badge{padding:6rpx 14rpx;background:#e9eef3;border-radius:8rpx}.danger{color:#b3261e}button{margin:12rpx 0;font-size:28rpx}button.primary{background:#18212b;color:white}.tabs{display:flex;flex-wrap:wrap;gap:12rpx}.tab{padding:16rpx;background:#e9eef3;border-radius:8rpx}.tab.active{background:#18212b;color:white}.list-item{border-bottom:1rpx solid #e9eef3;padding:18rpx 0}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx}.key{padding:24rpx;text-align:center;background:#e9eef3;border-radius:8rpx}.expression{padding:24rpx;background:#f4f6f8;min-height:45rpx;word-break:break-all;font-size:34rpx}.small{font-size:24rpx}.error{padding:20rpx;color:#b3261e;background:#fff0ee}.choice{padding:18rpx;border-bottom:1rpx solid #eee}.selected{background:#e4f1e9}