<view class="page">
<view class="card">
<view class="title">档口负责人</view>
<input value="{{keyword}}" bindinput="input" placeholder="昵称、手机号、用户 ID" bindconfirm="search"/>
<view class="row">
<button bindtap="search">搜索负责人</button>
<button wx:if="{{canAssignRoles}}" class="primary" bindtap="searchUsers">分配负责人角色</button>
</view>
</view>
<view class="error" wx:if="{{error}}">{{error}}</view>
<view class="card" wx:for="{{managers}}" wx:key="userId" data-id="{{item.userId}}" bindtap="open">
<view class="manager-heading">
<view class="manager-summary">档口 {{item.stallNames}} · 商品 {{item.productCount || 0}} 件</view>
<text class="badge">{{item.active ? '激活' : '下线'}}</text>
</view>
<view class="manager-profile">
<image class="manager-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"/>
<view class="manager-info">
<view class="manager-name">{{item.nickname || ('用户未设置昵称(' + item.userId + ')')}}</view>
<view class="muted manager-phone">{{item.phone || '用户未绑定手机号'}}</view>
</view>
</view>
</view>
<view class="muted">{{loading ? '加载中…' : (hasNext ? '上拉加载更多' : '已加载全部')}}</view>
</view>
