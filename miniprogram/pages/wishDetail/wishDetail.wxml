<view class="page-wrapper">

  <view class="share-float" wx:if="{{canShowShareFloat}}" style="left: {{shareFloatLeft}}px; top: {{shareFloatTop}}px;" catchtouchstart="startShareFloatDrag" catchtouchmove="moveShareFloat" catchtouchend="endShareFloatDrag">
    <text>分享</text>
  </view>

  <!-- 心愿图片 -->
  <swiper class="wish-swiper" indicator-dots="{{wish.images.length > 1}}" circular="{{wish.images.length > 1}}" wx:if="{{wish.images.length}}">
    <swiper-item wx:for="{{wish.images}}" wx:key="*this">
      <image class="wish-image" src="{{item}}" mode="aspectFill" catchtap="previewImage" data-index="{{index}}"></image>
    </swiper-item>
  </swiper>
  <view class="image-count" wx:if="{{wish.images.length > 1}}">共 {{wish.images.length}} 张</view>

  <!-- 内容区 -->
  <view class="content-section">
    <view class="wish-title">{{wish.title || wish.content}}</view>
    <view class="wish-content" wx:if="{{wish.content && wish.content !== wish.title}}">{{wish.content}}</view>

    <!-- 点赞区域 -->
    <view class="like-section">
      <view class="like-btn {{wish.isLiked ? 'liked' : ''}}" bindtap="handleLike">
        <text class="heart-icon">{{wish.isLiked ? '♥' : '♡'}}</text>
        <text class="like-count">热度 {{wish.likes || 0}}</text>
      </view>
      <text class="like-hint">点赞支持这个心愿，达到50热度主理人将为你寻觅</text>
    </view>

    <!-- 已关联商品入口 -->
    <view class="linked-section" wx:if="{{wish.linkedProductId}}">
      <view class="section-divider"></view>
      <view class="linked-label">已关联商品</view>
      <view class="btn-go-product" bindtap="goToProduct">查看商品详情 →</view>
    </view>

    <!-- 底部信息 -->
    <view class="meta-section">
      <text class="meta-text">发布于 {{createdAtDisplay}}</text>
    </view>
  </view>

</view>

<!-- 分享卡片专用画布：按图片数量生成单图、双图或三联图，不影响页面展示 -->
<canvas canvas-id="wishDetailShareCanvasSingle" class="share-canvas" width="500" height="400"></canvas>
<canvas canvas-id="wishDetailShareCanvasDouble" class="share-canvas" width="500" height="400"></canvas>
<canvas canvas-id="wishDetailShareCanvasTriple" class="share-canvas" width="500" height="400"></canvas>

<view class="share-template-mask" wx:if="{{showShareTemplates}}" bindtap="closeShareTemplateSelector"></view>
<view class="share-template-panel" wx:if="{{showShareTemplates}}" catchtap="stopShareTemplateTap">
  <view class="share-template-header">
    <text>选择分享版式</text>
    <text class="share-template-close" bindtap="closeShareTemplateSelector">×</text>
  </view>
  <scroll-view class="share-template-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="share-template-options">
      <button class="share-template-option" open-type="share" data-template="single">
        <image class="share-template-preview" src="{{shareImages.single}}" mode="aspectFill"></image>
        <text class="share-template-label">单图模板</text>
      </button>
      <button class="share-template-option" wx:if="{{shareImageCount >= 2}}" open-type="share" data-template="double">
        <image class="share-template-preview" src="{{shareImages.double}}" mode="aspectFill"></image>
        <text class="share-template-label">双图模板</text>
      </button>
      <button class="share-template-option" wx:if="{{shareImageCount >= 3}}" open-type="share" data-template="triple">
        <image class="share-template-preview" src="{{shareImages.triple}}" mode="aspectFill"></image>
        <text class="share-template-label">三联模板</text>
      </button>
    </view>
  </scroll-view>
  <view class="share-template-cancel" bindtap="closeShareTemplateSelector">取消</view>
</view>

<!-- 底部删除按钮（仅创建者/管理员可见） -->
<view class="bottom-delete-bar" wx:if="{{canDelete}}">
  <view class="btn-delete" bindtap="deleteWish">删除此心愿</view>
</view>
