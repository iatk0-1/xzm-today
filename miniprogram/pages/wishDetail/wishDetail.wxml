<view class="wish-nav" wx:if="{{!productSheetVisible}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="wish-nav-row"><view class="nav-back" bindtap="goBack" aria-role="button" aria-label="返回"><view class="back-arrow"></view></view></view>
</view>
<scroll-view class="wish-page-scroll" scroll-y="{{!productSheetVisible && !showVideo}}" style="height: 100vh;" enhanced="true" show-scrollbar="false">
<view class="page-wrapper">

  <view class="share-float" wx:if="{{canShowShareFloat && !productSheetVisible}}" style="left: {{shareFloatLeft}}px; top: {{shareFloatTop}}px;" catchtouchstart="startShareFloatDrag" catchtouchmove="moveShareFloat" catchtouchend="endShareFloatDrag" catchtouchcancel="cancelFloatTouch">
    <text>分享</text>
  </view>

  <!-- 心愿图片 -->
  <swiper class="wish-swiper" indicator-dots="{{wish.images.length + (wish.videoUrl ? 1 : 0) > 1}}" circular="{{false}}" wx:if="{{wish.images.length || wish.videoUrl}}" bindchange="onWishMediaChange">
    <swiper-item wx:if="{{wish.videoUrl}}">
      <video id="wishBannerVideo" class="wish-video" src="{{wish.videoUrl}}" poster="{{wish.image}}" controls object-fit="contain" binderror="onWishVideoError" />
    </swiper-item>
    <swiper-item wx:for="{{wish.images}}" wx:key="*this">
      <image class="wish-image" src="{{item}}" mode="aspectFill" catchtap="previewImage" data-index="{{index}}"></image>
    </swiper-item>
  </swiper>

  <!-- 内容区 -->
  <view class="content-section">
    <view class="linked-section" wx:if="{{linkedProducts.length}}">
      <view class="linked-label">关联商品 · {{linkedProducts.length}} 件</view>
      <scroll-view class="linked-product-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="linked-product-list">
          <view class="linked-product-card" wx:for="{{linkedProducts}}" wx:key="id" bindtap="goToProduct" data-id="{{item.id}}">
            <image wx:if="{{item.coverUrl}}" class="linked-product-cover" src="{{item.coverUrl}}" mode="aspectFill" />
            <view wx:else class="linked-product-cover linked-product-placeholder">暂无图片</view>
            <view class="linked-product-name">{{item.name}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="wish-title">{{wish.title || wish.content}}</view>
    <view class="wish-content" wx:if="{{wish.content && wish.content !== wish.title}}">{{wish.content}}</view>

    <!-- 点赞区域 -->
    <view class="like-section">
      <view class="like-btn wish-like-control" bindtap="handleLike" aria-role="button" aria-label="{{wish.isLiked ? '取消点赞' : '点赞'}}">
        <text class="heart-icon {{wish.isLiked ? 'liked' : ''}} {{likeAnimation}}" bindanimationend="clearLikeAnimation">{{wish.isLiked ? '♥' : '♡'}}</text>
        <text class="like-count">{{wish.likes || 0}}</text>
      </view>
      <text class="like-hint">点赞支持这个心愿，达到50热度主理人将为你寻觅</text>
    </view>

    <!-- 底部信息 -->
    <view class="meta-section">
      <text class="meta-text">发布于 {{createdAtDisplay}}</text>
    </view>
  </view>

</view>

</scroll-view>

<!-- 分享卡片专用画布：按图片数量生成单图、双图或三联图，不影响页面展示 -->
<canvas canvas-id="wishDetailShareCanvasSingle" class="share-canvas" width="500" height="400"></canvas>
<canvas canvas-id="wishDetailShareCanvasDouble" class="share-canvas" width="500" height="400"></canvas>
<canvas canvas-id="wishDetailShareCanvasTriple" class="share-canvas" width="500" height="400"></canvas>

<view class="share-template-mask" wx:if="{{showShareTemplates}}" bindtap="closeShareTemplateSelector"></view>
<view class="share-template-panel" wx:if="{{showShareTemplates}}" catchtap="stopShareTemplateTap">
  <view class="share-template-header">
    <text>选择分享版式</text>
    <text class="share-template-close" bindtap="closeShareTemplateSelector">×</text>
  </view>
  <scroll-view class="share-template-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="share-template-options">
      <button class="share-template-option" open-type="share" data-template="single">
        <image class="share-template-preview" src="{{shareImages.single}}" mode="aspectFill"></image>
        <text class="share-template-label">单图模板</text>
      </button>
      <button class="share-template-option" wx:if="{{shareImageCount >= 2}}" open-type="share" data-template="double">
        <image class="share-template-preview" src="{{shareImages.double}}" mode="aspectFill"></image>
        <text class="share-template-label">双图模板</text>
      </button>
      <button class="share-template-option" wx:if="{{shareImageCount >= 3}}" open-type="share" data-template="triple">
        <image class="share-template-preview" src="{{shareImages.triple}}" mode="aspectFill"></image>
        <text class="share-template-label">三联模板</text>
      </button>
    </view>
  </scroll-view>
  <view class="share-template-cancel" bindtap="closeShareTemplateSelector">取消</view>
</view>

<!-- 底部操作（仅创建者/管理员可见） -->
<view class="bottom-delete-bar" wx:if="{{!productSheetVisible && (canDelete || canEdit)}}">
  <view class="btn-delete" wx:if="{{canDelete}}" bindtap="deleteWish">删除此心愿</view>
  <view class="btn-edit" wx:if="{{canEdit}}" bindtap="editWish">编辑心愿</view>
</view>

<product-detail-sheet id="productSheet" bindvisibilitychange="onProductSheetVisibility" />


<!-- 与商品详情一致的视频悬浮入口和全屏播放层 -->
<view class="wish-floating-video" wx:if="{{wish.videoUrl && !productSheetVisible && !showVideo}}" style="{{videoFloatStyle}}"
      catchtouchstart="startVideoFloatTouch" catchtouchmove="moveVideoFloat"
      catchtouchend="endVideoFloatTouch" catchtouchcancel="cancelVideoFloatTouch">
  <image class="wish-floating-video-thumb" src="{{wish.image}}" mode="aspectFill" />
  <view class="wish-floating-video-icon"><view class="wish-video-play-icon" /></view>
</view>
<view class="wish-video-overlay" wx:if="{{showVideo && !productSheetVisible}}" catchtap="closeVideoOverlay" catchtouchmove="stopVideoTap">
  <video id="wishFullscreenVideo" class="wish-fullscreen-video" src="{{wish.videoUrl}}" autoplay loop controls object-fit="contain" show-fullscreen-btn="{{false}}" catchtap="stopVideoTap" binderror="onWishVideoError" />
  <view class="wish-close-video" catchtap="closeVideoOverlay" style="top: {{statusBarHeight + 10}}px;">×</view>
</view>
