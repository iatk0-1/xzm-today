page { background-color: #ffffff; }

.share-float {
  position: fixed;
  z-index: 1200;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #e5e5e5;
  color: #111;
  font-size: 13px;
  line-height: 58px;
  text-align: center;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}

.share-template-mask {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(0, 0, 0, 0.35);
}

.share-template-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2001;
  padding: 24px 18px calc(18px + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 20px 20px 0 0;
  box-sizing: border-box;
}

.share-template-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
  color: #111;
  font-size: 16px;
  font-weight: 600;
}

.share-template-close {
  color: #999;
  font-size: 26px;
  font-weight: 300;
  line-height: 20px;
}

.share-template-scroll {
  width: 100%;
  white-space: nowrap;
}

.share-template-options {
  display: flex;
  width: max-content;
  gap: 16px;
  padding: 0 2px 4px;
}

.share-template-option {
  flex: 0 0 142px;
  width: 142px;
  min-width: 142px;
  padding: 0;
  overflow: hidden;
  border: 1px solid #e8e8e8;
  border-radius: 8px;
  background: #fff;
  color: #333;
  line-height: normal;
}

.share-template-option::after {
  border: 0;
}

.share-template-preview {
  display: block;
  width: 142px;
  height: 114px;
  background: #f6f6f6;
}

.share-template-label {
  display: block;
  padding: 12px 4px;
  font-size: 13px;
  text-align: center;
}

.share-template-cancel {
  margin-top: 20px;
  padding: 14px 0 4px;
  border-top: 1px solid #f2f2f2;
  color: #999;
  font-size: 13px;
  text-align: center;
}

.share-canvas {
  position: fixed;
  left: -1000px;
  top: -1000px;
  width: 500px;
  height: 400px;
  opacity: 0;
  pointer-events: none;
}

.page-wrapper { padding-bottom: 160rpx; }

/* ====== 图片区 ====== */
.wish-swiper {
  width: 100%;
  height: 125vw;
  background: #f9f9f9;
}
.wish-image {
  width: 100%;
  height: 100%;
  display: block;
}
.image-count { padding: 12rpx 30rpx; text-align: right; color: #999; font-size: 22rpx; background: #f9f9f9; }

/* ====== 内容区 ====== */
.content-section {
  padding: 30rpx 32rpx;
}

.wish-title { font-size: 38rpx; color: #111; font-weight: 700; line-height: 1.4; margin-bottom: 20rpx; }
.wish-content {
  font-family: -apple-system, sans-serif;
  font-size: 16px;
  color: #111;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

/* 点赞 */
.like-section {
  padding: 30rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.like-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.heart-icon {
  font-size: 22px;
  color: #111;
}
.like-btn.liked .heart-icon {
  color: #d32f2f;
}

.like-count {
  font-family: -apple-system, sans-serif;
  font-size: 13px;
  color: #666;
  letter-spacing: 0.5px;
}

.like-hint {
  font-family: -apple-system, sans-serif;
  font-size: 11px;
  color: #bbb;
  line-height: 1.5;
}

/* 关联商品 */
.section-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin-bottom: 30rpx;
}

.linked-label {
  font-family: -apple-system, sans-serif;
  font-size: 12px;
  color: #999;
  margin-bottom: 20rpx;
  letter-spacing: 1px;
}

.btn-go-product {
  width: 100%;
  text-align: center;
  background: #111;
  color: #fff;
  font-family: "Times New Roman", Times, serif;
  font-size: 13px;
  padding: 22rpx 0;
  letter-spacing: 2px;
  border-radius: 2px;
}

/* 底部信息 */
.meta-section {
  margin-top: 50rpx;
  text-align: center;
}

.meta-text {
  font-family: -apple-system, sans-serif;
  font-size: 11px;
  color: #ccc;
  letter-spacing: 0.5px;
}

/* 底部删除按钮 */
.bottom-delete-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f5f5f5;
  box-sizing: border-box;
  z-index: 100;
}

.btn-delete {
  height: 90rpx;
  border: 2rpx solid #d32f2f;
  color: #d32f2f;
  border-radius: 2px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 1px;
  transition: all 0.2s;
}
.btn-delete:active {
  background: #fef0f0;
}
