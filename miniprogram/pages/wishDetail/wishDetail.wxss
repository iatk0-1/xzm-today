page { background-color: #ffffff; }

.page-wrapper { padding-bottom: 160rpx; }

/* ====== 图片区 ====== */
.wish-swiper { width: 100%; height: 760rpx; background: #f9f9f9; }
.wish-image {
  width: 100%;
  height: 100%;
  display: block;
}
.image-count { padding: 12rpx 30rpx; text-align: right; color: #999; font-size: 22rpx; background: #f9f9f9; }

/* ====== 内容区 ====== */
.content-section {
  padding: 30rpx 32rpx;
}

.wish-title { font-size: 38rpx; color: #111; font-weight: 700; line-height: 1.4; margin-bottom: 20rpx; }
.wish-content {
  font-family: -apple-system, sans-serif;
  font-size: 16px;
  color: #111;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

/* 点赞 */
.like-section {
  padding: 30rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.like-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.heart-icon {
  font-size: 22px;
  color: #111;
}
.like-btn.liked .heart-icon {
  color: #d32f2f;
}

.like-count {
  font-family: -apple-system, sans-serif;
  font-size: 13px;
  color: #666;
  letter-spacing: 0.5px;
}

.like-hint {
  font-family: -apple-system, sans-serif;
  font-size: 11px;
  color: #bbb;
  line-height: 1.5;
}

/* 关联商品 */
.section-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin-bottom: 30rpx;
}

.linked-label {
  font-family: -apple-system, sans-serif;
  font-size: 12px;
  color: #999;
  margin-bottom: 20rpx;
  letter-spacing: 1px;
}

.btn-go-product {
  width: 100%;
  text-align: center;
  background: #111;
  color: #fff;
  font-family: "Times New Roman", Times, serif;
  font-size: 13px;
  padding: 22rpx 0;
  letter-spacing: 2px;
  border-radius: 2px;
}

/* 底部信息 */
.meta-section {
  margin-top: 50rpx;
  text-align: center;
}

.meta-text {
  font-family: -apple-system, sans-serif;
  font-size: 11px;
  color: #ccc;
  letter-spacing: 0.5px;
}

/* 底部删除按钮 */
.bottom-delete-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f5f5f5;
  box-sizing: border-box;
  z-index: 100;
}

.btn-delete {
  height: 90rpx;
  border: 2rpx solid #d32f2f;
  color: #d32f2f;
  border-radius: 2px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 1px;
  transition: all 0.2s;
}
.btn-delete:active {
  background: #fef0f0;
}
