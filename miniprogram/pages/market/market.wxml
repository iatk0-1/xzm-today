<view class="market-wrapper">

  <view class="header-section">
    <view class="page-title">Curation Market</view>
    <view class="page-subtitle">探索 · 许愿 · 为你寻觅</view>
  </view>

  <view class="masonry-grid" wx:if="{{wishes.length > 0}}">
    <!-- 左列 -->
    <view class="masonry-column">
      <view class="wish-card" wx:for="{{leftColumn}}" wx:key="id" bindtap="goToWishDetail" data-id="{{item.id}}">

        <image class="card-img" src="{{item.image}}" mode="widthFix"></image>

        <view class="card-content">
          <view class="card-desc">{{item.title || item.content}}</view>
          <view class="card-price" wx:if="{{item.expectedPrice !== null && item.expectedPrice !== undefined}}">预算 ¥{{item.expectedPrice}}</view>

          <view class="progress-section" wx:if="{{!item.linkedProductId}}">
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{ (item.likes / 50) * 100 }}%; max-width: 100%;"></view>
            </view>

            <view class="progress-text">
              <text class="heart-btn" bindtap="handleLike" data-index="{{index}}" data-id="{{item.id}}">{{item.isLiked ? '♥' : '♡'}}</text>
              <text>热度 {{item.likes || 0}} / 50</text>
            </view>
          </view>

          <view class="buy-section" wx:else>
            <view class="btn-buy-black" bindtap="goToProduct" data-id="{{item.linkedProductId}}">BUY NOW</view>
          </view>
        </view>

      </view>
    </view>

    <!-- 右列 -->
    <view class="masonry-column">
      <view class="wish-card" wx:for="{{rightColumn}}" wx:key="id" bindtap="goToWishDetail" data-id="{{item.id}}">

        <image class="card-img" src="{{item.image}}" mode="widthFix"></image>

        <view class="card-content">
          <view class="card-desc">{{item.title || item.content}}</view>
          <view class="card-price" wx:if="{{item.expectedPrice !== null && item.expectedPrice !== undefined}}">预算 ¥{{item.expectedPrice}}</view>

          <view class="progress-section" wx:if="{{!item.linkedProductId}}">
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{ (item.likes / 50) * 100 }}%; max-width: 100%;"></view>
            </view>

            <view class="progress-text">
              <text class="heart-btn" bindtap="handleLike" data-index="{{index}}" data-id="{{item.id}}">{{item.isLiked ? '♥' : '♡'}}</text>
              <text>热度 {{item.likes || 0}} / 50</text>
            </view>
          </view>

          <view class="buy-section" wx:else>
            <view class="btn-buy-black" bindtap="goToProduct" data-id="{{item.linkedProductId}}">BUY NOW</view>
          </view>
        </view>

      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>暂无心愿，点击右下角成为第一个策展人</view>

  <view class="fab-upload" bindtap="uploadWish">
    <view class="fab-icon">+</view>
  </view>

  <!-- 自定义底部导航栏 -->
  <view class="bottom-tab-bar">
    <view class="tab-item" bindtap="goToIndex">首页</view>
    <view class="tab-item active">市集</view>
    <view class="tab-item admin-portal" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="red-plus-btn">+</view>
    </view>
    <view class="tab-item" bindtap="goToMessage">信息</view>
    <view class="tab-item" bindtap="goToUser">我</view>
  </view>

</view>
