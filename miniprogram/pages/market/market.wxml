<view class="market-wrapper">

  <scroll-view
    class="market-scroll"
    scroll-y
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    refresher-threshold="60"
    refresher-background="#ffffff"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onReachBottom"
    lower-threshold="50"
  >
    <view class="header-section">
      <view class="page-title">Curation Market</view>
      <view class="page-subtitle">探索 · 许愿 · 为你寻觅</view>
    </view>

    <view class="waterfall-container" wx:if="{{wishes.length > 0}}">
      <!-- 左列 -->
      <view class="waterfall-column">
        <view class="wish-item" wx:for="{{leftColumn}}" wx:key="id" bindtap="goToWishDetail" data-id="{{item.id}}">
          <view class="wish-image-wrap">
            <image class="wish-img" src="{{item.image}}" mode="aspectFill" lazy-load="true"></image>
          </view>

          <view class="wish-info">
            <view class="wish-title">{{item.title || item.content}}</view>

            <view class="progress-section" wx:if="{{!item.linkedProductId}}">
              <view class="progress-bar">
                <view class="progress-fill" style="width: {{ (item.likes / 50) * 100 }}%; max-width: 100%;"></view>
              </view>

              <view class="progress-text">
                <text class="heart-btn" catchtap="handleLike" data-index="{{index}}" data-id="{{item.id}}">{{item.isLiked ? '♥' : '♡'}}</text>
                <text>热度 {{item.likes || 0}}</text>
              </view>
            </view>

            <view class="buy-section" wx:else>
              <view class="btn-buy-black" catchtap="goToProduct" data-id="{{item.linkedProductId}}">BUY NOW</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 右列 -->
      <view class="waterfall-column">
        <view class="wish-item" wx:for="{{rightColumn}}" wx:key="id" bindtap="goToWishDetail" data-id="{{item.id}}">
          <view class="wish-image-wrap">
            <image class="wish-img" src="{{item.image}}" mode="aspectFill" lazy-load="true"></image>
          </view>

          <view class="wish-info">
            <view class="wish-title">{{item.title || item.content}}</view>

            <view class="progress-section" wx:if="{{!item.linkedProductId}}">
              <view class="progress-bar">
                <view class="progress-fill" style="width: {{ (item.likes / 50) * 100 }}%; max-width: 100%;"></view>
              </view>

              <view class="progress-text">
                <text class="heart-btn" catchtap="handleLike" data-index="{{index}}" data-id="{{item.id}}">{{item.isLiked ? '♥' : '♡'}}</text>
                <text>热度 {{item.likes || 0}}</text>
              </view>
            </view>

            <view class="buy-section" wx:else>
              <view class="btn-buy-black" catchtap="goToProduct" data-id="{{item.linkedProductId}}">BUY NOW</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{!loading}}">暂无心愿，点击右下角成为第一个策展人</view>
  </scroll-view>

  <view class="fab-upload" bindtap="uploadWish">
    <view class="fab-icon">+</view>
  </view>

  <!-- 自定义底部导航栏 -->
  <view class="bottom-tab-bar">
    <view class="tab-item" bindtap="goToIndex">首页</view>
    <view class="tab-item active">市集</view>
    <view class="tab-item admin-portal" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="red-plus-btn">+</view>
    </view>
    <view class="tab-item" bindtap="goToMessage">信息</view>
    <view class="tab-item" bindtap="goToUser">我</view>
  </view>

</view>
