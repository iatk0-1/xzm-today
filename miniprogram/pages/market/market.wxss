page { background-color: #ffffff; }
.market-wrapper { padding-bottom: 0; }
.market-scroll { height: calc(100vh - 100rpx - env(safe-area-inset-bottom)); }

/* 头部策展区 */
.header-section { text-align: center; padding: 25px 0 35px; }
.page-title { 
  font-family: "Times New Roman", Times, serif; 
  font-size: 22px; color: #111111; letter-spacing: 1px; 
}
.page-subtitle { 
  font-family: -apple-system, sans-serif; font-size: 10px; 
  color: #999999; margin-top: 8px; letter-spacing: 3px; text-transform: uppercase; 
}

/* ================== 首页同款瀑布流布局 ================== */
.waterfall-container {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 20rpx calc(120rpx + env(safe-area-inset-bottom)) 20rpx;
  box-sizing: border-box;
  width: 100%;
}

.waterfall-column {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  width: auto;
  box-sizing: border-box;
}

.waterfall-column:last-child {
  margin-left: 20rpx;
}

.wish-item {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.wish-image-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  overflow: hidden;
  background: #f9f9f9;
}

.wish-img {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.wish-info { padding: 20rpx; }

.wish-title {
  font-family: -apple-system, sans-serif;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical; overflow: hidden;
}

/* ================= 🚀 核心：极简进度条系统 ================= */
.progress-section { margin-top: 10rpx; }
.progress-bar {
  width: 100%; height: 2rpx; background: #f0f0f0; margin-bottom: 8rpx;
}
.progress-fill {
  height: 100%; background: #111111; transition: width 0.4s ease-out;
}
.progress-text {
  display: flex; justify-content: space-between; align-items: center;
  font-family: -apple-system, sans-serif; font-size: 20rpx; color: #888888; letter-spacing: 0.5px;
}
.heart-btn { font-size: 32rpx; color: #111111; padding-right: 15rpx; line-height: 1; }

/* 已上架的黑底购买按钮 */
.btn-buy-black {
  width: 100%; text-align: center; background: #111111; color: #ffffff;
  font-family: "Times New Roman", Times, serif; font-size: 22rpx;
  padding: 20rpx 0; letter-spacing: 3rpx;
}

/* 悬浮发布按钮 */
.fab-upload {
  position: fixed; right: 20px; bottom: calc(85px + env(safe-area-inset-bottom));
  width: 50px; height: 50px; background-color: #111111; border-radius: 50%;
  display: flex; justify-content: center; align-items: center;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15); z-index: 100; transition: transform 0.2s;
}
.fab-upload:active { transform: scale(0.9); }
.fab-icon { color: #ffffff; font-size: 24px; font-weight: 300; position: relative; top: -2px; }
.empty-state { text-align: center; color: #cccccc; font-size: 24rpx; padding: 60rpx 0; }

/* ==================
   底部 TabBar
================== */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  z-index: 100;
  border-top: 1rpx solid rgba(0,0,0,0.04);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

.bottom-tab-bar .active {
  color: #1a1a1a;
  font-weight: 800;
}

.admin-portal { flex: 1; }

.red-plus-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: #1a1a1a;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 300;
  transform: translateY(-16rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}
