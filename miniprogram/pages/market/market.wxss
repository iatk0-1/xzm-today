page { background-color: #ffffff; }
.market-wrapper { padding-bottom: 120px; }
.market-scroll { height: calc(100vh - 100rpx - env(safe-area-inset-bottom)); }

/* 头部策展区 */
.header-section { text-align: center; padding: 25px 0 35px; }
.page-title { 
  font-family: "Times New Roman", Times, serif; 
  font-size: 22px; color: #111111; letter-spacing: 1px; 
}
.page-subtitle { 
  font-family: -apple-system, sans-serif; font-size: 10px; 
  color: #999999; margin-top: 8px; letter-spacing: 3px; text-transform: uppercase; 
}

/* ================= Flexbox 双列布局（还原市集原样式） ================= */
.masonry-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 15px;
  gap: 15px;
}

.masonry-column {
  display: flex;
  flex-direction: column;
  width: calc(50% - 7.5px);
  gap: 30px;
}

.wish-card {
  background: #ffffff;
  position: relative;
}

.management-hint { margin-top: 14px; color: #666; font-size: 11px; }
.wish-selection {
  position: absolute; top: 8px; left: 8px; z-index: 2;
  width: 24px; height: 24px; border: 1px solid #999; border-radius: 50%;
  background: #fff; color: #fff; display: flex; align-items: center; justify-content: center;
  box-sizing: border-box; font-size: 15px;
}
.wish-selection.selected { background: #111; border-color: #111; }
.wish-selection.unavailable { width: auto; padding: 0 8px; border-radius: 12px; color: #999; font-size: 10px; }
.wish-selection-outline { position: absolute; top: -4px; right: -4px; bottom: -4px; left: -4px; border: 2px solid #111; border-radius: 4px; pointer-events: none; }

.card-img {
  width: 100%; display: block;
  background: #f9f9f9; border-radius: 2px;
}

.card-content { padding: 12px 0 0 0; }

.card-desc {
  font-family: -apple-system, sans-serif; font-size: 12px; color: #333333;
  line-height: 1.5; margin-bottom: 12px;
  display: -webkit-box; -webkit-line-clamp: 2;
  -webkit-box-orient: vertical; overflow: hidden;
}

/* ================= 🚀 核心：极简进度条系统 ================= */
.progress-section { margin-top: 10px; }
.progress-bar {
  width: 100%; height: 2px; background: #f0f0f0; margin-bottom: 8px;
}
.progress-fill {
  height: 100%; background: #111111; transition: width 0.4s ease-out;
}
.progress-text {
  display: flex; justify-content: space-between; align-items: center;
  font-family: -apple-system, sans-serif; font-size: 10px; color: #888888; letter-spacing: 0.5px;
}
.heart-btn { font-size: 16px; color: #111111; padding-right: 15px; }

/* 已上架的黑底购买按钮 */
.btn-buy-black {
  width: 100%; text-align: center; background: #111111; color: #ffffff;
  font-family: "Times New Roman", Times, serif; font-size: 11px;
  padding: 10px 0; letter-spacing: 1.5px;
}

/* 悬浮发布按钮 */
.wish-management-actions {
  position: fixed; right: 20px; bottom: calc(147px + env(safe-area-inset-bottom));
  z-index: 100; display: flex; align-items: center; gap: 10px;
}
.wish-action {
  min-width: 50px; height: 40px; padding: 0 12px; box-sizing: border-box;
  display: flex; justify-content: center; align-items: center;
  background: #fff; border: 1px solid #ddd; border-radius: 20px; color: #111;
  font-size: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.12);
}
.wish-action-manage { padding: 0; background: #111; color: #fff; border-color: #111; }
.wish-action-delete { color: #d32f2f; border-color: #d32f2f; }
.wish-action.disabled { opacity: 0.45; }
.market-scroll { padding-bottom: 180px; box-sizing: border-box; }
.fab-upload {
  position: fixed; right: 20px; bottom: calc(85px + env(safe-area-inset-bottom));
  width: 50px; height: 50px; background-color: #111111; border-radius: 50%;
  display: flex; justify-content: center; align-items: center;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15); z-index: 100; transition: transform 0.2s;
}
.fab-upload:active { transform: scale(0.9); }
.fab-icon { color: #ffffff; font-size: 24px; font-weight: 300; position: relative; top: -2px; }
.empty-state { text-align: center; color: #cccccc; font-size: 12px; padding: 60px 0; }

/* ==================
   底部 TabBar
================== */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  z-index: 100;
  border-top: 1rpx solid rgba(0,0,0,0.04);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}
.customer-service-tab {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
}
.customer-service-tab::after { display: none; }

.bottom-tab-bar .active {
  color: #1a1a1a;
  font-weight: 800;
}

.admin-portal { flex: 1; }

.red-plus-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: #1a1a1a;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 300;
  transform: translateY(-16rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}
