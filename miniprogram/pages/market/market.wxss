@import "../../styles/wishLike.wxss";
page { background-color: #ffffff; }
.market-wrapper { height: 100vh; overflow: hidden; display: flex; flex-direction: column; padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.market-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }

/* 沿用首页排序标签的字号、间距和选中下划线。 */
.market-sort-tabs { flex-shrink: 0; display: flex; align-items: center; gap: 20px; padding: 10rpx 20px; margin-bottom: 20rpx; background: #fff; }
.market-sort-tab { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; white-space: nowrap; }
.market-sort-tab:active { opacity: 0.7; }
.market-sort-tab text { font-size: 16px; line-height: 22px; font-weight: 400; letter-spacing: 0; color: #999; transition: color 0.2s ease; }
.market-sort-tab.active text { font-weight: bold; color: #1a1a1a; }
.market-sort-tab .line { width: 40rpx; height: 1rpx; background: #1a1a1a; border-radius: 4rpx; transform: scaleX(0); opacity: 0; transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
.market-sort-tab.active .line { transform: scaleX(1); opacity: 1; }

/* ================= Flexbox 双列布局（还原市集原样式） ================= */
.masonry-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 15px;
  gap: 15px;
}

.masonry-column {
  display: flex;
  flex-direction: column;
  width: calc(50% - 7.5px);
  gap: 30px;
}

.wish-card {
  background: #ffffff;
  position: relative;
}

.management-hint { margin: 0 15px 14px; color: #666; font-size: 11px; }
.wish-selection {
  position: absolute; top: 8px; left: 8px; z-index: 2;
  width: 24px; height: 24px; border: 1px solid #999; border-radius: 50%;
  background: #fff; color: #fff; display: flex; align-items: center; justify-content: center;
  box-sizing: border-box; font-size: 15px;
}
.wish-selection.selected { background: #111; border-color: #111; }
.wish-selection.unavailable { width: auto; padding: 0 8px; border-radius: 12px; color: #999; font-size: 10px; }
.wish-selection-outline { position: absolute; top: -4px; right: -4px; bottom: -4px; left: -4px; border: 2px solid #111; border-radius: 4px; pointer-events: none; }

.card-img {
  width: 100%; display: block;
  background: #f9f9f9; border-radius: 2px;
}

.card-content { padding: 12px 0 0 0; }

.card-desc {
  font-family: -apple-system, sans-serif; font-size: 12px; color: #333333;
  /* 点赞按钮自身已有上下留白，标题下方不再叠加间距。 */
  line-height: 1.5; margin-bottom: 0;
  display: -webkit-box; -webkit-line-clamp: 2;
  -webkit-box-orient: vertical; overflow: hidden;
}

/* 卡片底部：关联商品入口在左，点赞和数量在右。 */
.progress-bar { width: 100%; height: 2px; margin-top: 10px; background: #f0f0f0; }
.progress-fill { height: 100%; background: #111; transition: width 0.4s ease-out; }
.card-actions { display: flex; align-items: center; min-height: 28px; }
.linked-cart { display: flex; align-items: center; justify-content: flex-start; gap: 4px; min-height: 28px; }
.linked-cart-icon { flex-shrink: 0; width: 16px; height: 16px; display: block; }
.linked-cart-label { font-family: -apple-system, sans-serif; font-size: 14px; line-height: 24px; color: #888; white-space: nowrap; }
/* 恢复原来的点赞行高度，数字贴齐卡片右边缘。 */
.like-action { margin-left: auto; flex-shrink: 0; justify-content: flex-end; align-items: center; gap: 2px; min-height: 28px; padding: 0 0 0 10px; }
/* 爱心保留旧版字号，移除固定占位，保留颜色和动画。 */
.like-action .heart-icon { flex: 0 0 auto; width: auto; font-size: 16px; line-height: 24px; letter-spacing: 0; }
.like-action .heart-icon:not(.liked) { color: #888; }
.like-action .like-count { position: relative; font-size: 14px; line-height: 24px; letter-spacing: 0; }

/* 悬浮发布按钮 */
.wish-management-actions {
  position: fixed; right: 20px; bottom: calc(147px + env(safe-area-inset-bottom));
  z-index: 100; display: flex; align-items: center; gap: 10px;
}
.wish-action {
  min-width: 50px; height: 40px; padding: 0 12px; box-sizing: border-box;
  display: flex; justify-content: center; align-items: center;
  background: #fff; border: 1px solid #ddd; border-radius: 20px; color: #111;
  font-size: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.12);
}
.wish-action-manage { padding: 0; background: #111; color: #fff; border-color: #111; }
.wish-action-delete { color: #d32f2f; border-color: #d32f2f; }
.wish-action.disabled { opacity: 0.45; }
/* 底部留白随内容滚动，避免内边距挤占 scroll-view 的可视区域。 */
.market-scroll-spacer { height: 180px; }
.fab-upload {
  position: fixed; right: 20px; bottom: calc(85px + env(safe-area-inset-bottom));
  width: 50px; height: 50px; background-color: #111111; border-radius: 50%;
  display: flex; justify-content: center; align-items: center;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15); z-index: 100; transition: transform 0.2s;
}
.fab-upload:active { transform: scale(0.9); }
.fab-icon { color: #ffffff; font-size: 24px; font-weight: 300; position: relative; top: -2px; }
.empty-state { text-align: center; color: #cccccc; font-size: 12px; padding: 60px 0; }

/* ==================
   底部 TabBar
================== */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  z-index: 100;
  border-top: 1rpx solid rgba(0,0,0,0.04);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}
.customer-service-tab {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
}
.customer-service-tab::after { display: none; }

.bottom-tab-bar .active {
  color: #1a1a1a;
  font-weight: 800;
}

.admin-portal { flex: 1; }

.red-plus-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: #1a1a1a;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 300;
  transform: translateY(-16rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}
