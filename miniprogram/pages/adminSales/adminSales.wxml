<view class="page-wrapper">
  <!-- 筛选区 -->
  <view class="filter-bar">
    <view class="search-row">
      <input class="search-input" placeholder="搜索商品名称..." value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
    <view class="date-row">
      <picker mode="date" value="{{startDate}}" end="{{endDate || today}}" bindchange="onStartDateChange">
        <view class="date-pick">{{startDate || '开始日期'}}</view>
      </picker>
      <text class="date-sep">—</text>
      <picker mode="date" value="{{endDate}}" start="{{startDate}}" end="{{today}}" bindchange="onEndDateChange">
        <view class="date-pick">{{endDate || '结束日期'}}</view>
      </picker>
      <view class="clear-date" wx:if="{{startDate || endDate}}" bindtap="clearDate">清除</view>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="products-section">
    <view class="section-title">商品销售 ({{total}})</view>
    <view class="product-card" wx:for="{{products}}" wx:key="productId" bindtap="goToDetail" data-item="{{item}}">
      <image class="product-img" src="{{item.productImage || '/images/placeholder.png'}}" mode="aspectFill" />
      <view class="product-info">
        <text class="product-name">{{item.productName}}</text>
        <view class="product-stats">
          <text class="product-qty">售出 {{item.soldQty || 0}} 件</text>
          <text class="product-amount">¥{{item.totalAmount || 0}}</text>
        </view>
      </view>
      <view class="product-arrow">></view>
    </view>
    <view class="load-more" wx:if="{{products.length < total}}" bindtap="loadMore">加载更多</view>
    <view class="empty-state" wx:if="{{products.length === 0}}">暂无销售记录</view>
  </view>
</view>