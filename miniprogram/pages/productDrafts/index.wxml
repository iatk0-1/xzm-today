<view class="draft-page">
  <view class="draft-heading"><view><view class="heading-title">商品草稿</view><text class="subtitle">已保存 {{total}} / {{limit}} · 长期保留</text></view><button class="text-button" bindtap="toggleSelectMode" disabled="{{deleting}}">{{selecting ? '完成' : '批量管理'}}</button></view>
  <view class="search-row"><input value="{{keyword}}" placeholder="搜索商品标题" maxlength="200" bindinput="onKeywordInput" bindconfirm="search" confirm-type="search"/><button wx:if="{{keyword}}" class="clear" bindtap="clearSearch">×</button><button class="search-button" bindtap="search">搜索</button></view>
  <view class="filter-row"><picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="selectType"><view class="filter">{{types[typeIndex].label}} ▾</view></picker><view wx:if="{{sessionId}}" class="session-filter" bindtap="clearSession">本场直播 ×</view><button class="text-button" bindtap="createProduct">＋ 新增商品</button></view>
  <view wx:if="{{error}}" class="state"><text>{{error}}</text><button bindtap="reload">重新加载</button></view>
  <scroll-view wx:else scroll-y class="draft-list {{selecting ? 'with-actions' : ''}}" refresher-enabled="true" refresher-triggered="{{refreshing}}" bindrefresherrefresh="reload" bindscrolltolower="loadMore">
    <view wx:if="{{!items.length && !loading}}" class="state"><view>{{keyword || typeIndex || sessionId ? '没有找到符合条件的草稿' : '还没有商品草稿'}}</view><text class="subtitle">在商品编辑页点击“保存草稿”，下次接着编辑</text></view>
    <view class="draft-card {{item.selected ? 'selected' : ''}}" wx:for="{{items}}" wx:key="id">
      <view class="card-content" bindtap="openDraft" data-id="{{item.id}}"><view wx:if="{{selecting}}" class="checkbox">{{item.selected ? '✓' : ''}}</view><image wx:if="{{item.coverUrl}}" class="cover" src="{{item.coverUrl}}" mode="aspectFill"/><view wx:else class="cover placeholder">暂无图片</view><view class="card-info"><view class="card-title">{{item.title}}</view><view class="badges"><text>{{item.typeLabel}}</text><text wx:if="{{item.summary.bundle}}">套装</text></view><view wx:if="{{item.stallsText}}" class="subtitle">{{item.stallsText}}</view><view wx:if="{{item.sessionId}}" class="subtitle">直播场次 {{item.sessionId}}</view><view class="saved-time">{{item.savedText}} 保存</view></view></view>
      <view wx:if="{{item.warningText}}" class="warning">{{item.warningText}}</view>
      <view wx:if="{{!selecting}}" class="card-actions"><button class="text-button danger" bindtap="deleteOne" data-id="{{item.id}}" disabled="{{deleting}}">删除</button><button class="continue" bindtap="openDraft" data-id="{{item.id}}">{{item.capabilities.edit ? '继续编辑' : '查看草稿'}}</button></view>
    </view>
    <view wx:if="{{loading}}" class="list-state">正在加载…</view><view wx:elif="{{moreError}}" class="list-state" bindtap="loadMore">{{moreError}} · 点击重试</view><view wx:elif="{{items.length && !hasMore}}" class="list-state">已显示全部草稿</view>
  </scroll-view>
  <view wx:if="{{selecting}}" class="batch-actions"><text>已选 {{selectedCount}} 份</text><button bindtap="deleteSelected" disabled="{{!selectedCount || deleting}}" loading="{{deleting}}">删除所选</button></view>
</view>
