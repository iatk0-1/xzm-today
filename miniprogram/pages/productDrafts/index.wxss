page { height:100%; background:#f6f6f6; color:#202020; }
button::after { border:0; }
.draft-page { height:100vh; display:flex; flex-direction:column; box-sizing:border-box; padding:28rpx 28rpx 0; }
.draft-heading,.filter-row,.search-row,.card-actions,.batch-actions { display:flex; align-items:center; justify-content:space-between; }
.draft-heading { margin-bottom:28rpx; }.heading-title { font-size:42rpx; font-weight:600; margin-bottom:8rpx; }
.subtitle { font-size:24rpx; line-height:1.6; color:#777; }.text-button { background:transparent; margin:0; padding:0 12rpx; font-size:26rpx; line-height:64rpx; color:#444; }
.search-row { background:#fff; border-radius:16rpx; padding:8rpx 10rpx 8rpx 22rpx; }.search-row input { flex:1; min-width:0; font-size:28rpx; }.search-button,.clear { margin:0; background:transparent; padding:0 18rpx; font-size:26rpx; line-height:60rpx; }.search-button { font-weight:600; }.clear { color:#888; }
.filter-row { margin:18rpx 0; gap:12rpx; }.filter { padding:10rpx 18rpx; border-radius:10rpx; background:#eaeaea; font-size:25rpx; }.session-filter { font-size:24rpx; color:#555; margin-right:auto; }
.draft-list { flex:1; height:0; min-height:0; }.draft-card { background:#fff; border:2rpx solid transparent; border-radius:22rpx; padding:24rpx; margin-bottom:20rpx; }.draft-card.selected { border-color:#222; }.card-content { display:flex; align-items:center; gap:20rpx; }.cover { width:146rpx; height:164rpx; flex-shrink:0; border-radius:12rpx; background:#f0f0f0; }.placeholder { display:flex; align-items:center; justify-content:center; font-size:23rpx; color:#999; }.card-info { flex:1; min-width:0; }.card-title { font-size:30rpx; line-height:1.5; font-weight:600; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; word-break:break-all; }.badges { display:flex; flex-wrap:wrap; gap:8rpx; margin:12rpx 0; }.badges text { background:#f3f3f3; color:#555; padding:4rpx 10rpx; border-radius:6rpx; font-size:22rpx; }.saved-time { font-size:22rpx; color:#888; margin-top:10rpx; }.card-actions { justify-content:flex-end; gap:24rpx; border-top:1rpx solid #f3f3f3; margin-top:20rpx; padding-top:12rpx; }.danger { color:#ba3c2c; }.continue { margin:0; background:#222; color:#fff; font-size:25rpx; padding:0 26rpx; line-height:62rpx; border-radius:10rpx; }.warning { font-size:24rpx; color:#95631e; line-height:1.6; margin-top:18rpx; }.checkbox { width:34rpx; height:34rpx; border:2rpx solid #777; text-align:center; line-height:34rpx; border-radius:8rpx; flex-shrink:0; }.state { text-align:center; padding:110rpx 25rpx; font-size:28rpx; color:#777; line-height:2; }.state button { font-size:26rpx; background:#fff; margin-top:24rpx; }.list-state { text-align:center; color:#888; padding:28rpx 0 50rpx; font-size:24rpx; }.batch-actions { padding:20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); font-size:28rpx; }.batch-actions button { margin:0; color:#fff; background:#b83d2f; font-size:27rpx; border-radius:12rpx; padding:0 30rpx; }.batch-actions button[disabled] { background:#ddd; color:#999; }
