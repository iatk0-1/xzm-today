page { height:100%; background:#f6f6f6; color:#202020; }
button::after { border:0; }
.draft-page { height:100vh; display:flex; flex-direction:column; box-sizing:border-box; padding:28rpx 28rpx 0; }
.draft-heading,.filter-row,.search-row,.card-actions,.batch-actions { display:flex; align-items:center; justify-content:space-between; }
.draft-heading { margin-bottom:28rpx; }
.subtitle { font-size:24rpx; line-height:1.6; color:#777; }.text-button { background:transparent; margin:0; padding:0 12rpx; font-size:26rpx; line-height:64rpx; color:#444; }
.search-row { flex-shrink:0; background:#fff; border-radius:16rpx; padding:8rpx 10rpx 8rpx 22rpx; }.search-row input { flex:1; width:0; min-width:0; height:60rpx; line-height:60rpx; font-size:28rpx; color:#202020; }.search-button,.clear { box-sizing:border-box; min-width:0; margin:0; background:transparent; padding:0; font-size:26rpx; line-height:60rpx; white-space:nowrap; }.search-button { flex:0 0 100rpx; width:100rpx; color:#202020; font-weight:600; }.clear { flex:0 0 60rpx; width:60rpx; color:#888; }
.filter-row { margin:18rpx 0; gap:12rpx; }.filter { min-width:100rpx; box-sizing:border-box; padding:10rpx 18rpx; border-radius:10rpx; background:#eaeaea; font-size:25rpx; white-space:nowrap; }.session-filter { font-size:24rpx; color:#555; margin-right:auto; white-space:nowrap; }
.filter-controls { display:flex; align-items:center; flex-wrap:wrap; gap:12rpx; flex:1; min-width:170rpx; }.filter-controls picker { flex:0 0 auto; width:auto; }.filter-actions { display:flex; align-items:center; gap:12rpx; flex:0 0 auto; margin-left:auto; }.filter-actions .text-button { width:auto; min-width:0; flex:none; white-space:nowrap; }
.draft-list { flex:1; height:0; min-height:0; }.draft-card { background:#fff; border:2rpx solid transparent; border-radius:22rpx; padding:24rpx; margin-bottom:20rpx; }.draft-card.selected { border-color:#222; }.card-content { display:flex; align-items:center; gap:20rpx; }.cover { width:146rpx; height:164rpx; flex-shrink:0; border-radius:12rpx; background:#f0f0f0; }.placeholder { display:flex; align-items:center; justify-content:center; font-size:23rpx; color:#999; }.card-info { flex:1; min-width:0; }.card-title { font-size:30rpx; line-height:1.5; font-weight:600; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; word-break:break-all; }.badges { display:flex; flex-wrap:wrap; gap:8rpx; margin:12rpx 0; }.badges text { background:#f3f3f3; color:#555; padding:4rpx 10rpx; border-radius:6rpx; font-size:22rpx; }.saved-time { font-size:22rpx; color:#888; margin-top:10rpx; }.card-actions { justify-content:flex-end; gap:24rpx; border-top:1rpx solid #f3f3f3; margin-top:20rpx; padding-top:12rpx; }.danger { color:#ba3c2c; }.continue { margin:0; background:#222; color:#fff; font-size:25rpx; padding:0 26rpx; line-height:62rpx; border-radius:10rpx; }.warning { font-size:24rpx; color:#95631e; line-height:1.6; margin-top:18rpx; }.checkbox { width:34rpx; height:34rpx; border:2rpx solid #777; text-align:center; line-height:34rpx; border-radius:8rpx; flex-shrink:0; }.state { text-align:center; padding:110rpx 25rpx; font-size:28rpx; color:#777; line-height:2; }.state button { font-size:26rpx; background:#fff; margin-top:24rpx; }.list-state { text-align:center; color:#888; padding:28rpx 0 50rpx; font-size:24rpx; }.batch-actions { padding:20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); font-size:28rpx; }.batch-actions button { margin:0; color:#fff; background:#b83d2f; font-size:27rpx; border-radius:12rpx; padding:0 30rpx; }.batch-actions button[disabled] { background:#ddd; color:#999; }
.batch-panel { flex-shrink:0; background:#f6f6f6; }.batch-status { font-size:24rpx; color:#777; padding-top:16rpx; }.batch-actions { gap:16rpx; }.batch-actions button { flex:1; min-width:0; padding:0 16rpx; line-height:76rpx; white-space:nowrap; }.batch-actions .select-all { color:#333; background:#e8e8e8; }.batch-actions .publish-selected { background:#22864a; }.batch-actions button[disabled] { background:#ddd; color:#999; }
.draft-pricing { margin-top:20rpx; padding-top:20rpx; border-top:1rpx solid #f0f0f0; }
.pricing-fields { display:flex; align-items:center; gap:16rpx; }
.draft-cost-field { display:flex; align-items:center; gap:12rpx; flex:0 0 224rpx; min-width:0; }
.pricing-label { flex-shrink:0; font-size:23rpx; color:#777; white-space:nowrap; }
.draft-cost-input { width:0; min-width:0; flex:1; height:60rpx; line-height:60rpx; box-sizing:border-box; border-radius:10rpx; background:#f5f5f5; padding:0 12rpx; font-size:26rpx; color:#222; }
.draft-rule-picker { flex:1; min-width:0; }
.draft-rule-field { display:flex; align-items:center; gap:10rpx; height:60rpx; }
.draft-rule-name { flex:1; min-width:0; font-size:25rpx; color:#222; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.draft-rule-arrow { flex-shrink:0; font-size:32rpx; color:#888; }
.draft-pricing-status { display:flex; align-items:center; gap:12rpx; min-height:42rpx; margin-top:8rpx; font-size:21rpx; line-height:1.6; color:#999; }
.draft-pricing-status > text { flex:1; min-width:0; overflow-wrap:break-word; }
.pricing-save-error { color:#ba3c2c; }.pricing-saved { color:#22864a; }
.draft-pricing-status .pricing-retry { flex:0 0 auto; width:auto; min-width:0; margin:0; padding:0 12rpx; line-height:44rpx; font-size:23rpx; color:#22864a; background:transparent; }
.card-actions button { width:auto; min-width:0; flex:0 0 auto; white-space:nowrap; }
.card-actions .publish-one { margin:0; background:#22864a; color:#fff; font-size:25rpx; padding:0 26rpx; line-height:62rpx; border-radius:10rpx; }
.card-actions button[disabled] { color:#999; background:#eee; }
