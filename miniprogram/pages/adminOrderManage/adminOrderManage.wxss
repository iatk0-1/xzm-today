page { background-color: #f7f8fa; }
.page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }

/* 搜索栏 */
.search-bar {
  background-color: #ffffff;
  padding: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
}

.search-input-wrapper {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #000;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0;
}

/* 时间范围筛选 */
.date-filter {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
}

.clear-date {
  width: 50rpx;
  height: 50rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
}

/* 收件人信息 */
.recipient-info {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recipient-address {
  color: #999;
  font-size: 22rpx;
}

/* 物流信息 */
.logistics-info {
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #fff5f5;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #f44336;
}

.express-text {
  font-family: "Times New Roman", Times, serif;
}

/* 顶部 Tab 栏 */
/* ================= 顶部滑动 Tab 栏 ================= */
.tabs-bar-wrapper {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
  position: relative;
  z-index: 10;
}

/* 固定的“全部”按钮 */
.fixed-tab {
  width: 130rpx;
  flex-shrink: 0;
  text-align: center;
  /* 🚀 核心修复 1：统一字号和行高，彻底锁死高度 */
  font-size: 28rpx; 
  line-height: 40rpx; 
  color: #666;
  padding: 26rpx 0;
  position: relative;
  /* 🚀 核心修复 2：去掉 all，只允许颜色发生动画，杜绝排版挤压 */
  transition: color 0.2s ease; 
}
.fixed-tab.active { font-weight: bold; color: #1a1a1a; }

/* 若隐若现的分割线 */
.tab-divider {
  width: 2rpx;
  height: 30rpx;
  background-color: #eeeeee;
  box-shadow: 2rpx 0 6rpx rgba(0,0,0,0.05);
}

/* 右侧滚动区 */
.scroll-tabs {
  flex: 1;
  white-space: nowrap; /* 核心：强制一行不换行 */
  overflow: hidden;
}

/* 右侧滚动区单项 */
.scroll-tab-item {
  display: inline-block;
  padding: 26rpx 36rpx;
  text-align: center;
  /* 🚀 核心修复 1：统一字号和行高 */
  font-size: 28rpx; 
  line-height: 40rpx;
  color: #666;
  position: relative;
  /* 🚀 核心修复 2：去掉 all，只允许颜色发生动画 */
  transition: color 0.2s ease; 
}
.scroll-tab-item.active { font-weight: bold; color: #1a1a1a; }

/* 底部黑色短滑块 */
.active-line {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 6rpx;
  background-color: #1a1a1a;
  border-radius: 4rpx;
}

/* 滚动区域 */
.order-scroll-area { flex: 1; padding: 20rpx; box-sizing: border-box; overflow-y: auto; -webkit-overflow-scrolling: touch; }

/* 空状态 */
.empty-state { padding: 150rpx 0; text-align: center; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.5; }
.empty-text { font-size: 26rpx; color: #999; }

/* 订单卡片 */
.order-card { background-color: #ffffff; border-radius: 16rpx; padding: 30rpx 24rpx; margin-bottom: 24rpx; }

.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; border-bottom: 1rpx solid #f5f5f5; padding-bottom: 20rpx; }
.order-sn { font-size: 22rpx; color: #999; font-family: "Times New Roman", Times, serif; }
.status-wrapper { display: flex; align-items: center; gap: 12rpx; }
.order-status { font-size: 26rpx; color: #1a1a1a; font-weight: bold; }
.order-status.highlight { color: #d32f2f; }
.after-sale-badge {
  font-size: 20rpx;
  color: #ff4444;
  background-color: #fff5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ffcccc;
}

.goods-list { margin-bottom: 10rpx; }
.goods-item { display: flex; margin-bottom: 30rpx; }
.goods-item:last-child { margin-bottom: 0; }
.goods-img { width: 140rpx; height: 186rpx; background-color: #f0f0f0; border-radius: 8rpx; margin-right: 24rpx; }
.goods-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.goods-title { font-size: 26rpx; color: #333; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.goods-sku { font-size: 22rpx; color: #999; margin-top: 10rpx; }
.goods-price-row { display: flex; justify-content: space-between; align-items: baseline; margin-top: auto; }
.price { font-size: 28rpx; font-weight: bold; font-family: "Times New Roman", Times, serif; }
.count { font-size: 24rpx; color: #999; font-family: "Times New Roman", Times, serif; }

/* 发货数量信息 */
.shipment-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
}

.shipment-divider {
  height: 1rpx;
  background: linear-gradient(to right, transparent, #f0f0f0, transparent);
  margin-bottom: 12rpx;
}

.shipment-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.shipment-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-family: "Times New Roman", Times, serif;
}

.tag-total {
  color: #999;
  background: #f5f5f5;
}

.tag-shipped {
  color: #4caf50;
  background: rgba(76, 175, 80, 0.1);
}

.tag-pending {
  color: #ff9800;
  background: rgba(255, 152, 0, 0.1);
}

.shipped-done-badge {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  color: #ffffff;
  background-color: #4caf50;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  gap: 4rpx;
}

.card-footer { border-top: 1rpx dashed #eee; padding-top: 24rpx; margin-top: 24rpx; }
.total-row { text-align: right; margin-bottom: 24rpx; }
.total-label { font-size: 24rpx; color: #666; margin-right: 10rpx; }
.total-price { font-size: 32rpx; font-weight: bold; font-family: "Times New Roman", Times, serif; }

.action-row { display: flex; justify-content: flex-end; gap: 20rpx; }
.btn-ghost { margin: 0; padding: 0 30rpx; height: 56rpx; line-height: 54rpx; font-size: 24rpx; color: #333; background: transparent; border: 1rpx solid #ddd; border-radius: 28rpx; font-weight: normal; }
.btn-ghost::after { display: none; }
.btn-solid { padding: 0 30rpx; height: 56rpx; line-height: 56rpx; font-size: 24rpx; color: #fff; background: #1a1a1a; border-radius: 28rpx; font-weight: bold; }

/* 时间选择器模态框 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  max-height: 70vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-title {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 快捷选项 */
.quick-options {
  display: flex;
  padding: 20rpx;
  gap: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.quick-option {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #666;
}

.quick-option.selected {
  background: #1890ff;
  color: #fff;
}

/* 自定义时间 */
.custom-section {
  padding: 30rpx 20rpx;
}

.custom-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.date-picker-input {
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-cancel, .modal-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 0;
  padding: 0;
  border: none;
}

.modal-cancel {
  background: #f5f5f5;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal-confirm {
  background: #1890ff;
  color: #fff;
}

/* 固定头部容器 */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

/* 确保搜索栏和 Tab 栏背景不透明 */
.search-bar,
.tabs-bar-wrapper {
  background-color: #ffffff;
}

/* ① 让 sticky 容器盖住下方的 scroll-view，不留物理缝隙 */
.sticky-header {
  position: sticky;
  top: -1rpx;           /* 轻微上移，盖住可能的白线 */
  margin-top: -1rpx;     /* 双重保险 */
  padding-top: 1rpx;     /* 防止内容被裁切 */
}