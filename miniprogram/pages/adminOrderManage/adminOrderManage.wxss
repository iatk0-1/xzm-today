page { background-color: #f2f2f2; }
.page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }

/* 搜索栏 */
.search-bar {
  background-color: #fff;
  padding: 24rpx;
}

.search-input-wrapper {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  padding: 0;
}

/* 时间筛选 */
.date-filter {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-picker {
  flex: 1;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

.clear-date {
  width: 40rpx;
  height: 40rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
}

/* 收件人信息 */
.recipient-info {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recipient-address {
  color: #999;
  font-size: 22rpx;
}

/* 物流信息 */
.logistics-info {
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #fef5f5;
  border-radius: 8rpx;
  border: 1rpx solid #fce4e4;
  font-size: 22rpx;
  color: #d32f2f;
}

.express-text {
  font-family: inherit;
}

/* 顶部 Tab 栏 */
.tabs-bar-wrapper {
  display: flex;
  align-items: center;
  background-color: #fff;
  position: relative;
  z-index: 10;
}

.fixed-tab {
  width: 120rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #999;
  padding: 24rpx 0;
  position: relative;
}
.fixed-tab.active { font-weight: 600; color: #1a1a1a; }

.tab-divider {
  width: 1rpx;
  height: 28rpx;
  background-color: #e8e8e8;
}

.scroll-tabs {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.scroll-tab-item {
  display: inline-block;
  padding: 24rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #999;
  position: relative;
}
.scroll-tab-item.active { font-weight: 600; color: #1a1a1a; }

.active-line {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 4rpx;
  background-color: #1a1a1a;
  border-radius: 2rpx;
}

.order-scroll-area { flex: 1; padding: 16rpx; box-sizing: border-box; }

.empty-state { padding: 180rpx 0; text-align: center; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; opacity: .35; }
.empty-text { font-size: 26rpx; color: #999; }

/* 订单卡片 */
.order-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }

.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0; }
.order-sn { font-size: 22rpx; color: #999; font-family: inherit; }
.status-wrapper { display: flex; align-items: center; gap: 12rpx; }
.order-status { font-size: 26rpx; color: #1a1a1a; font-weight: 600; }
.order-status.highlight { color: #d32f2f; }
.after-sale-badge {
  font-size: 20rpx;
  color: #f44336;
  background: #fff5f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid #ffcdd2;
}

.goods-list { margin-bottom: 0; }
.goods-item { display: flex; margin-bottom: 24rpx; }
.goods-item:last-child { margin-bottom: 0; }
.goods-img { width: 130rpx; height: 173rpx; background-color: #f5f5f5; border-radius: 8rpx; margin-right: 20rpx; }
.goods-info { flex: 1; display: flex; flex-direction: column; }
.goods-title { font-size: 26rpx; color: #333; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.goods-sku { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.goods-bundle { margin-top: 6rpx; }
.bundle-sub { display: flex; align-items: center; padding: 2rpx 0; }
.bundle-sub-name { font-size: 22rpx; color: #666; margin-right: 6rpx; }
.bundle-sub-spec { font-size: 22rpx; color: #999; }
.goods-price-row { display: flex; justify-content: space-between; align-items: baseline; margin-top: 8rpx; }
.price { font-size: 28rpx; font-weight: 600; font-family: inherit; }
.count { font-size: 24rpx; color: #999; font-family: inherit; }

/* 发货数量信息 */
.shipment-section { margin-top: 12rpx; }
.shipment-divider { height: 1rpx; background: #f0f0f0; margin-bottom: 10rpx; }
.shipment-tags { display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.shipment-tag { font-size: 20rpx; padding: 4rpx 10rpx; border-radius: 4rpx; font-family: inherit; }
.tag-total { color: #999; background: #f5f5f5; }
.tag-shipped { color: #43a047; background: #e8f5e9; }
.tag-pending { color: #ef6c00; background: #fff3e0; }
.shipped-done-badge { display: inline-flex; align-items: center; font-size: 20rpx; color: #fff; background: #43a047; padding: 4rpx 12rpx; border-radius: 4rpx; }

.card-footer { border-top: 1rpx solid #f0f0f0; padding-top: 20rpx; margin-top: 20rpx; }
.total-row { text-align: right; margin-bottom: 20rpx; }
.total-label { font-size: 24rpx; color: #666; margin-right: 8rpx; }
.total-price { font-size: 30rpx; font-weight: 600; font-family: inherit; }

.action-row { display: flex; justify-content: flex-end; gap: 16rpx; }
.btn-ghost { margin: 0; padding: 0 24rpx; height: 56rpx; line-height: 54rpx; font-size: 24rpx; color: #333; background: #fff; border: 1rpx solid #ddd; border-radius: 8rpx; }
.btn-ghost::after { display: none; }
.btn-solid { margin: 0; padding: 0 24rpx; height: 56rpx; line-height: 56rpx; font-size: 24rpx; color: #fff; background: #1a1a1a; border-radius: 8rpx; font-weight: 600; }

/* 时间选择器模态框 */
.modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000;
}
.modal-mask {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45);
}
.modal-content {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 600rpx; max-height: 70vh; background: #fff; border-radius: 16rpx; overflow: hidden;
  display: flex; flex-direction: column;
}
.modal-title {
  padding: 28rpx; font-size: 30rpx; font-weight: 600; text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}
.quick-options {
  display: flex; padding: 16rpx; gap: 12rpx; border-bottom: 1rpx solid #f0f0f0;
}
.quick-option {
  flex: 1; height: 64rpx; line-height: 64rpx; text-align: center;
  background: #f5f5f5; border-radius: 8rpx; font-size: 24rpx; color: #666;
}
.quick-option.selected { background: #1a1a1a; color: #fff; }

.custom-section { padding: 24rpx 16rpx; }
.custom-title { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }
.date-picker-input {
  height: 64rpx; background: #f5f5f5; border-radius: 8rpx; padding: 0 24rpx;
  display: flex; align-items: center; font-size: 26rpx; color: #333; margin-bottom: 12rpx;
}
.modal-footer { display: flex; border-top: 1rpx solid #f0f0f0; }
.modal-cancel, .modal-confirm { flex: 1; height: 88rpx; line-height: 88rpx; font-size: 28rpx; border-radius: 0; padding: 0; border: none; }
.modal-cancel { background: #f5f5f5; color: #666; border-right: 1rpx solid #f0f0f0; }
.modal-confirm { background: #1a1a1a; color: #fff; }

.sticky-header {
  position: sticky; top: 0; z-index: 100; background: #fff;
}