<view class="page">
  <view class="top-header">
    <view class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{currentTab === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchTab">
        {{item.label}}
      </view>
    </view>

    <view class="search-bar">
      <input
        class="search-input"
        placeholder="订单号/收件人/商品名称/序号"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearchConfirm" />
      <button class="search-btn" bindtap="onSearchConfirm">搜索</button>
    </view>
  </view>

  <scroll-view
    class="request-list"
    scroll-y
    scroll-top="{{scrollTop}}"
    lower-threshold="120"
    refresher-enabled
    bindscrolltolower="onScrollToLower"
    bindrefresherrefresh="onPullDownRefresh"
    refresher-triggered="{{isLoading}}">
    <view wx:if="{{isLoading && requests.length === 0}}" class="state">加载中...</view>
    <view wx:elif="{{requests.length === 0}}" class="state">暂无申请记录</view>

    <view class="request-card" wx:for="{{requests}}" wx:key="id">
      <view class="card-header">
        <view>
          <text class="type">{{item.requestTypeText}}</text>
          <text class="admin-seq" wx:if="{{item.adminSeqNo}}">序号：{{item.adminSeqNo}}</text>
          <view class="order-line">
            <text class="order">订单 {{item.displayOrderNo}}</text>
            <text class="copy-link" catchtap="copyOrderNo" data-order-no="{{item.displayOrderNo}}">复制</text>
            <text class="order-status order-status-{{item.orderStatusClass}}">{{item.orderStatusText}}</text>
          </view>
        </view>
        <text class="status status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="meta">申请时间：{{item.createdAt}}</view>

      <view class="content-block order-info-block">
        <view class="label">订单当前信息</view>
        <view class="recipient-head">
          <text class="recipient-name">{{item.currentRecipientName}} {{item.currentRecipientPhone}}</text>
          <text class="copy-link" catchtap="copyRecipientInfo" data-name="{{item.currentRecipientName}}" data-phone="{{item.currentRecipientPhone}}" data-address="{{item.currentRecipientAddress}}">复制</text>
        </view>
        <view class="recipient-address">{{item.currentRecipientAddress || '暂无收件信息'}}</view>
        <view class="label order-items-label">订单商品明细</view>
        <view wx:for="{{item.orderItems}}" wx:for-item="goods" wx:key="id" class="order-item-line">
          <image class="order-item-image" src="{{goods.skuImageUrl || goods.productImage || '/images/default-goods-image.png'}}" mode="aspectFill"></image>
          <view class="order-item-info">
            <text class="order-item-name">{{goods.productName}}</text>
            <text class="order-item-sku">{{goods.skuSpec}} / {{goods.skuSize}}</text>
            <text class="order-item-qty">×{{goods.qty}}</text>
            <text class="order-item-remark">备注：{{goods.remark || '暂无备注'}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{item.requestType === 'recipient'}}" class="content-block">
        <view class="label">收件信息变更记录</view>
        <view class="history-row">
          <view class="history-content">
            <view class="history-label">修改前</view>
            <view class="recipient-name">{{item.beforeRecipientName}} {{item.beforeRecipientPhone}}</view>
            <view class="recipient-address">{{item.beforeRecipientAddress || '暂无收件信息'}}</view>
          </view>
          <text class="copy-link" catchtap="copyRecipientInfo" data-name="{{item.beforeRecipientName}}" data-phone="{{item.beforeRecipientPhone}}" data-address="{{item.beforeRecipientAddress}}">复制</text>
        </view>
        <view class="history-row requested-history-row">
          <view class="history-content">
            <view class="history-label requested-label">申请修改为</view>
            <view class="recipient-name">{{item.recipientName}} {{item.recipientPhone}}</view>
            <view class="recipient-address">{{item.requestedRecipientAddress}}</view>
          </view>
          <text class="copy-link" catchtap="copyRecipientInfo" data-name="{{item.recipientName}}" data-phone="{{item.recipientPhone}}" data-address="{{item.requestedRecipientAddress}}">复制</text>
        </view>
      </view>

      <view wx:if="{{item.requestType === 'item_remark'}}" class="content-block">
        <view class="label">申请商品备注</view>
        <view wx:for="{{item.itemRemarks}}" wx:for-item="remark" wx:key="orderItemId" class="remark-line">
          <view class="remark-product">
            <text class="remark-product-name">{{remark.productName || ('商品 SKU 项 ' + remark.orderItemId)}}</text>
            <text wx:if="{{remark.productName}}" class="remark-product-spec">{{remark.skuSpec}} / {{remark.skuSize}} ×{{remark.qty}}</text>
          </view>
          <view class="remark-change">
            <text class="remark-before">原备注：{{remark.beforeRemark || '暂无备注'}}</text>
            <text class="remark-value">申请修改为：{{remark.remark || '清空备注'}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{item.status === 'rejected' && item.rejectionReason}}" class="reject-reason">
        拒绝原因：{{item.rejectionReason}}
      </view>

      <view class="actions">
        <button class="order-btn" data-order-id="{{item.orderId}}" bindtap="viewOrder">查看订单</button>
        <button wx:if="{{item.status === 'pending'}}" class="reject-btn" data-id="{{item.id}}" bindtap="rejectRequest">拒绝</button>
        <button wx:if="{{item.status === 'pending'}}" class="approve-btn" data-id="{{item.id}}" bindtap="approveRequest">通过</button>
      </view>
    </view>

    <view class="loading-more" wx:if="{{isLoadingMore}}">加载中...</view>
    <view class="no-more" wx:elif="{{!hasMore && requests.length > 0}}">没有更多申请了</view>
  </scroll-view>
</view>
