<view class="search-page">
  <view class="search-header">
    <view class="search-bar">
      <input
        class="search-input"
        placeholder="输入衣服名称、关键词..."
        bindinput="onInput"
        confirm-type="search"
        bindconfirm="doSearch"
        focus="{{focus}}"
        value="{{keyword}}"
        bindfocus="onSearchFocus"
        bindblur="onSearchBlur"
      />
      <view class="search-btn" bindtap="doSearch">搜索</view>
    </view>

    <!-- 首页同款导航：上新、档口和购物车。 -->
    <view class="nav-bottom-row">
      <view class="nav-tabs-left">
        <view class="tab-item {{currentMainTab === '上新' ? 'active' : ''}}" bindtap="handleMainTabChange" data-tab="上新">
          <text>上新</text>
          <view class="line"></view>
        </view>
        <view class="tab-item {{currentMainTab === '档口' ? 'active' : ''}}" bindtap="handleMainTabChange" data-tab="档口">
          <text>档口</text>
          <view class="line"></view>
        </view>
      </view>
      <view class="nav-cart-right" bindtap="goToCart"><text>购物车</text></view>
    </view>

    <view class="sub-nav-bar" wx:if="{{currentMainTab === '档口'}}">
      <view class="btn-all-switch" bindtap="toggleAllPanel">
        <text>全部</text>
        <text class="icon-menu">{{showAllPanel ? '×' : '≡'}}</text>
      </view>
      <view class="sub-nav-divider"></view>
      <scroll-view class="sub-nav-scroll" scroll-x="true">
        <view class="sub-nav-container">
          <view class="sub-tag {{selectedStall == item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}" data-name="{{item.name}}">{{item.name}}</view>
          <view class="sub-tag-placeholder"></view>
        </view>
      </scroll-view>
    </view>

    <view class="all-panel-mask {{showAllPanel ? 'fade-in' : ''}}" wx:if="{{showAllPanel}}" catchtap="closeAllPanel"></view>
    <view class="all-panel-content {{showAllPanel ? 'slide-down' : ''}}" wx:if="{{showAllPanel}}">
      <view class="panel-top-action">
        <view class="all-panel-tag {{selectedStall === '' ? 'active' : ''}}" bindtap="selectStall" data-stall="all" data-name="全部档口">全部档口</view>
      </view>
      <scroll-view scroll-y class="panel-scroll-area">
        <view class="group-section" wx:for="{{groupedStalls}}" wx:key="letter">
          <view class="group-title">{{item.letter}}</view>
          <view class="all-panel-grid">
            <view class="all-panel-tag {{selectedStall == stall.id ? 'active' : ''}}" wx:for="{{item.list}}" wx:for-item="stall" wx:key="id" bindtap="selectStall" data-stall="{{stall.id}}" data-name="{{stall.name}}">{{stall.name}}</view>
          </view>
        </view>
        <view wx:if="{{!stallList.length}}" class="stall-empty">暂无档口</view>
      </scroll-view>
    </view>

    <view class="search-history-dropdown {{showHistory ? 'show' : ''}}" wx:if="{{recentSearches.length > 0}}">
      <view class="history-header">
        <view class="history-title">最近搜索</view>
        <view class="history-clear" bindtap="clearAllSearches">清空</view>
      </view>
      <view class="history-list">
        <view class="history-item" wx:for="{{recentSearches}}" wx:key="*this" bindtap="onSearchHistoryTap" data-keyword="{{item}}">
          {{item}}
          <text class="delete-icon" catchtap="deleteSearchHistory" data-keyword="{{item}}">×</text>
        </view>
      </view>
    </view>
  </view>

  <view class="result-box">
    <view wx:if="{{loadError}}" style="padding:24rpx;color:#b42318;text-align:center" bindtap="retrySearch">{{loadError}} · 点击重试</view>
    <!-- 搜索后的结果展示 -->
    <view wx:if="{{results.length === 0 && searched && !loadError && !loading}}" class="empty-tip">没有找到相关的衣服哦~</view>

    <view class="goods-list" wx:if="{{results.length > 0}}">
      <!-- 左列 -->
      <view class="goods-column">
        <view class="goods-item" wx:for="{{leftColumn}}" wx:key="id" bindtouchstart="onProductTouchStart" bindtap="goToDetail" data-id="{{item.id}}">
          <view class="goods-image-wrap">
            <image class="goods-img" src="{{item.coverUrl || item.image}}" mode="widthFix"></image>
            <view class="sold-out-overlay" wx:if="{{item.soldOut}}"><text>售罄</text></view>
          </view>
          <view class="goods-info">
            <view class="goods-title">{{item.name || item.title}}</view>
            <view class="goods-price">¥ {{item.displayPrice || item.price || '0.00'}}</view>
          </view>
        </view>
      </view>

      <!-- 右列 -->
      <view class="goods-column">
        <view class="goods-item" wx:for="{{rightColumn}}" wx:key="id" bindtouchstart="onProductTouchStart" bindtap="goToDetail" data-id="{{item.id}}">
          <view class="goods-image-wrap">
            <image class="goods-img" src="{{item.coverUrl || item.image}}" mode="widthFix"></image>
            <view class="sold-out-overlay" wx:if="{{item.soldOut}}"><text>售罄</text></view>
          </view>
          <view class="goods-info">
            <view class="goods-title">{{item.name || item.title}}</view>
            <view class="goods-price">¥ {{item.displayPrice || item.price || '0.00'}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
