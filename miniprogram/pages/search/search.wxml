<view class="search-page">
  <view class="search-bar">
    <input 
      class="search-input" 
      placeholder="输入衣服名称、关键词..." 
      bindinput="onInput" 
      confirm-type="search" 
      bindconfirm="doSearch"
      auto-focus="true"
    />
    <view class="search-btn" bindtap="doSearch">搜索</view>
  </view>

  <view class="result-box">
    <view wx:if="{{results.length === 0 && searched}}" class="empty-tip">没有找到相关的衣服哦~</view>
    
    <view class="goods-list" wx:if="{{results.length > 0}}">
      <view class="goods-item" wx:for="{{results}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
        <image class="goods-img" src="{{item.image}}" mode="widthFix"></image>
        <view class="goods-info">
          <view class="goods-title">{{item.title}}</view>
          <view class="goods-price">¥ {{item.displayPrice || item.price || '0.00'}}</view>
        </view>
      </view>
    </view>
  </view>
</view>