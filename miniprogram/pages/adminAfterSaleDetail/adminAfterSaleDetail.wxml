<!-- miniprogram/pages/adminAfterSaleDetail/adminAfterSaleDetail.wxml -->
<view class="page-wrapper" wx:if="{{afterSale}}">

  <!-- 状态卡片 -->
  <view class="status-card {{afterSale.status}}">
    <view class="status-badge">{{afterSale.statusDisplay}}</view>
    <view class="status-desc" wx:if="{{afterSale.status === 'cancelled' && afterSale.rejectReason}}">{{afterSale.rejectReason}}</view>
    <view class="refund-total">¥ {{afterSale.totalRefundAmount}}</view>
    <view class="status-desc">
      <text>{{afterSale.typeDisplay}}</text>
      <text> · 共 {{afterSale.totalQty}} 件商品</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section">
    <view class="section-title">订单信息</view>
    <view class="order-info">
      <view class="info-row">
        <text class="info-label">订单号</text>
        <view class="info-value-box">
          <text class="info-value">{{afterSale.outTradeNo}}</text>
          <text class="copy-btn" catchtap="copyOrderNo">复制</text>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">申请时间</text>
        <text class="info-value">{{afterSale.createdAtDisplay}}</text>
      </view>
      <view class="info-row" wx:if="{{afterSale.orderId}}">
        <text class="info-label">关联订单</text>
        <text class="order-detail-link" bindtap="goToOrderDetail">查看订单详情 ›</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{afterSale.orderDetail}}">
    <view class="section-title">关联订单详情</view>
    <view class="info-group">
      <view class="info-row">
        <text class="info-label">订单状态</text>
        <text class="info-value">{{afterSale.orderDetail.statusDisplay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{afterSale.orderDetail.createdAtDisplay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">收货人</text>
        <text class="info-value">{{afterSale.orderDetail.recipientName}} {{afterSale.orderDetail.recipientPhone}}</text>
      </view>
      <view class="info-row info-row-top">
        <text class="info-label">收货地址</text>
        <view class="info-value-box info-value-box-column">
          <text class="info-value info-value-multiline">{{afterSale.orderDetail.recipientAddress}}</text>
          <text class="copy-btn" catchtap="copyRecipientInfo">复制</text>
        </view>
      </view>
    </view>
    <view class="order-items-list">
      <view class="order-item-row" wx:for="{{afterSale.orderDetail.items}}" wx:key="id">
        <image
          class="item-img"
          src="{{item.skuImageUrl || item.productImage}}"
          mode="aspectFill"
          bindtap="previewPageImage"
          data-image-url="{{item.skuImageUrl || item.productImage}}"></image>
        <view class="item-info">
          <view class="item-name">{{item.productName}}</view>
          <view class="item-sku">{{item.productSpec || '图片色'}} / {{item.productSize || '均码'}}</view>
          <view class="item-detail-row">
            <text class="item-qty">×{{item.qty}}</text>
            <text class="item-type" wx:if="{{item.afterSaleStatusDisplay}}">{{item.afterSaleStatusDisplay}}</text>
          </view>
        </view>
        <view class="item-refund">¥ {{item.salePriceDisplay}}</view>
      </view>
    </view>
    <view class="amount-group">
      <view class="info-row">
        <text class="info-label">商品总价</text>
        <text class="info-value">¥ {{afterSale.orderDetail.totalPriceDisplay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">实付款</text>
        <text class="info-value amount-strong">¥ {{afterSale.orderDetail.payAmountDisplay}}</text>
      </view>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="section">
    <view class="section-title">商品清单</view>
    <view class="items-list">
      <view class="item-row" wx:for="{{afterSale.items}}" wx:key="id">
        <image
          class="item-img"
          src="{{item.displayImage}}"
          mode="aspectFill"
          bindtap="previewPageImage"
          data-image-url="{{item.displayImage}}"></image>
        <view class="item-info">
          <view class="item-name">{{item.productName}}</view>
          <view class="item-sku">{{item.skuSpec}} / {{item.skuSize}}</view>
          <view class="item-detail-row">
            <text class="item-qty">×{{item.qty}}</text>
            <text class="item-type {{item.afterSaleType}}">{{item.afterSaleType === 'refund' ? '仅退款' : '退货退款'}}</text>
            <text class="item-status {{item.status}}" wx:if="{{item.status}}">{{item.statusDisplay}}</text>
          </view>
        </view>
        <view class="item-refund">¥ {{item.refundAmount}}</view>
      </view>
    </view>
  </view>

  <!-- 售后原因 -->
  <view class="section">
    <view class="section-title">售后原因</view>
    <view class="reason-content">{{afterSale.reason || '未填写'}}</view>
  </view>

  <!-- 凭证图片 -->
  <view class="section" wx:if="{{afterSale.evidenceImages.length > 0}}">
    <view class="section-title">凭证图片</view>
    <view class="evidence-images">
      <image
        class="evidence-img"
        wx:for="{{afterSale.evidenceImages}}"
        wx:key="*this"
        src="{{item}}"
        mode="aspectFill"
        bindtap="previewImage"
        data-index="{{index}}"></image>
    </view>
  </view>

  <!-- 退货物流 -->
  <view class="section" wx:if="{{afterSale.hasReturnLogistics}}">
    <view class="section-title">退货物流</view>
    <view class="logistics-info" wx:if="{{afterSale.hasReturnShipment}}">
      <view class="logistics-row">
        <text class="logistics-label">快递公司</text>
        <text class="logistics-value">{{afterSale.returnExpressCode}}</text>
      </view>
      <view class="logistics-row">
        <text class="logistics-label">快递单号</text>
        <text class="logistics-value">{{afterSale.returnExpressNo}}</text>
        <text class="copy-btn" bindtap="copyExpressNo">复制</text>
      </view>
      <view class="logistics-row" wx:if="{{afterSale.returnShippedAt}}">
        <text class="logistics-label">发货时间</text>
        <text class="logistics-value">{{afterSale.returnShippedAtDisplay}}</text>
      </view>
    </view>
    <view class="no-logistics" wx:else>用户暂未填写退货物流信息</view>
  </view>

  <!-- 售后日志 -->
  <view class="section">
    <view class="section-title">处理记录</view>
    <view class="timeline">
      <view class="timeline-item" wx:for="{{logs}}" wx:key="id">
        <view class="timeline-node {{index === logs.length - 1 ? 'last' : ''}}">
          <view class="timeline-dot"></view>
          <view class="timeline-line" wx:if="{{index < logs.length - 1}}"></view>
        </view>
        <view class="timeline-content">
          <view class="timeline-status">{{item.actionDisplay}}</view>
          <view class="timeline-time">{{item.time}}</view>
          <view class="timeline-desc">{{item.note || item.operator}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="action-bar">
    <!-- 待审核状态 -->
    <view class="action-btn-group" wx:if="{{afterSale.status === 'pending'}}">
      <view class="btn-ghost" bindtap="showReviewModal" data-decision="reject">拒绝</view>
      <view class="btn-primary" bindtap="showReviewModal" data-decision="approve">审核通过</view>
    </view>

    <!-- 已同意状态：退货项走仓库验收，仅退款失败可直接重试 -->
    <view wx:if="{{afterSale.status === 'approved'}}">
      <view
        class="action-fail-tip"
        wx:if="{{afterSale.hasApprovedRefundItems && afterSale.refundStatus === 'failed'}}">
        退款失败：{{afterSale.refundError || '请重试退款'}}
      </view>
      <view
        class="action-processing-tip"
        wx:if="{{afterSale.hasApprovedRefundItems && afterSale.refundStatus === 'processing'}}">
        微信退款处理中，系统会自动查询结果
      </view>
      <view
        class="action-btn-group"
        wx:if="{{afterSale.hasApprovedReturnRefundItems || (afterSale.hasApprovedRefundItems && afterSale.refundStatus === 'failed')}}">
        <view
          class="btn-ghost"
          wx:if="{{afterSale.hasApprovedReturnRefundItems}}"
          bindtap="showReceiveModal">仓库收货</view>
        <view
          class="btn-primary"
          wx:if="{{afterSale.hasApprovedRefundItems && afterSale.refundStatus === 'failed'}}"
          bindtap="submitRefund">重试退款</view>
      </view>
    </view>

    <!-- 已收货状态 -->
    <view class="action-btn-group" wx:if="{{afterSale.status === 'received' && afterSale.warehouseCheck === 'pass'}}">
      <view class="btn-primary" bindtap="submitRefund">确认退款</view>
    </view>

    <view wx:if="{{afterSale.status === 'received' && afterSale.warehouseCheck === 'fail'}}">
      <view class="action-fail-tip">验收未通过，请重新验收或填写原因进行协商退款</view>
      <view class="action-btn-group">
        <view class="btn-ghost" bindtap="showReinspectModal">重新验收</view>
        <view class="btn-primary" bindtap="showNegotiatedRefundModal">协商退款</view>
      </view>
    </view>

    <!-- 已拒绝/已退款/已取消 -->
    <view class="action-bar-hint" wx:if="{{afterSale.status === 'rejected' || afterSale.status === 'refunded' || afterSale.status === 'cancelled'}}">
      <text>处理完成</text>
    </view>
  </view>

  <!-- 审核弹窗 -->
  <view class="modal-mask" wx:if="{{showReviewModal}}" bindtap="hideReviewModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">审核售后</view>
      <view class="modal-options">
        <view
          class="option-item {{reviewDecision === 'approve' ? 'selected' : ''}}"
          bindtap="selectDecision"
          data-decision="approve">
          <view class="option-icon">✓</view>
          <view class="option-text">审核通过</view>
        </view>
        <view
          class="option-item {{reviewDecision === 'reject' ? 'selected' : ''}}"
          bindtap="selectDecision"
          data-decision="reject">
          <view class="option-icon">✕</view>
          <view class="option-text">拒绝</view>
        </view>
      </view>
      <scroll-view class="review-items" scroll-y wx:if="{{reviewDecision === 'approve'}}">
        <view class="review-item" wx:for="{{reviewItems}}" wx:key="id">
          <view class="review-item-header">
            <view
              class="review-check {{item.selected ? 'selected' : ''}}"
              data-index="{{index}}"
              bindtap="toggleReviewItem">{{item.selected ? '✓' : ''}}</view>
            <image
              class="review-item-img"
              src="{{item.displayImage}}"
              mode="aspectFill"
              bindtap="previewPageImage"
              data-image-url="{{item.displayImage}}"></image>
            <view class="review-item-info">
              <text class="review-item-name">{{item.productName}}</text>
              <text class="review-item-spec">{{item.skuSpec}} / {{item.skuSize}}</text>
              <text class="review-item-limit">用户申请 {{item.requestedQty || item.qty}} 件，¥ {{item.requestedRefundAmount || item.refundAmount}}</text>
            </view>
          </view>
          <view class="review-edit-row" wx:if="{{item.selected}}">
            <view class="review-edit-field">
              <text>数量</text>
              <view class="review-qty-stepper">
                <view
                  class="review-qty-btn {{item.reviewQty <= 1 ? 'disabled' : ''}}"
                  data-index="{{index}}"
                  catchtap="decreaseReviewQty">-</view>
                <view class="review-qty-value">{{item.reviewQty}}</view>
                <view
                  class="review-qty-btn {{item.reviewQty >= item.reviewQtyLimit ? 'disabled' : ''}}"
                  data-index="{{index}}"
                  catchtap="increaseReviewQty">+</view>
              </view>
            </view>
            <view class="review-edit-field">
              <text>金额</text>
              <input
                class="review-edit-input amount"
                type="digit"
                value="{{item.reviewAmount}}"
                data-index="{{index}}"
                bindinput="onReviewAmountInput"
                catchtap="noop" />
            </view>
          </view>
          <view class="review-type-row" wx:if="{{item.selected}}">
            <text class="review-type-label">退款方式</text>
            <view
              class="review-type-option {{item.reviewType === 'refund' ? 'selected' : ''}}"
              data-index="{{index}}"
              data-type="refund"
              bindtap="chooseReviewType">仅退款</view>
            <view
              class="review-type-option {{item.reviewType === 'return_refund' ? 'selected' : ''}}"
              data-index="{{index}}"
              data-type="return_refund"
              bindtap="chooseReviewType">退货退款</view>
          </view>
        </view>
      </scroll-view>
      <view class="modal-input-group" wx:if="{{reviewDecision === 'reject'}}">
        <view class="input-label">拒绝原因</view>
        <textarea
          class="input-textarea"
          placeholder="请填写拒绝原因"
          value="{{rejectReason}}"
          bindinput="onRejectReasonInput"
          maxlength="200"/>
      </view>
      <checkbox-group wx:if="{{reviewDecision === 'approve'}}" bindchange="changeReturnPurchaseOrder" class="purchase-return-choice">
        <label><checkbox value="return" checked="{{returnPurchaseOrder}}" />是否返回报单（默认不返回）</label>
      </checkbox-group>
      <view wx:if="{{reviewDecision === 'approve'}}" class="purchase-return-choice">勾选后退款成功会重新分配；不勾选则作废对应已报件数。</view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hideReviewModal">取消</view>
        <view class="modal-btn confirm {{reviewDecision === 'reject' ? 'danger' : ''}}" bindtap="submitReview">确认</view>
      </view>
    </view>
  </view>

  <!-- 仓库收货弹窗 -->
  <view class="modal-mask" wx:if="{{showReceiveModal}}" bindtap="hideReceiveModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">{{isReinspection ? '重新验收' : '退货验收'}}</view>
      <view class="modal-options">
        <view
          class="option-item {{warehouseCheck === 'pass' ? 'selected' : ''}}"
          bindtap="selectWarehouseCheck"
          data-check="pass">
          <view class="option-icon">✓</view>
          <view class="option-text">验收通过</view>
        </view>
        <view
          class="option-item {{warehouseCheck === 'fail' ? 'selected' : ''}}"
          bindtap="selectWarehouseCheck"
          data-check="fail">
          <view class="option-icon">✕</view>
          <view class="option-text">验收不通过</view>
        </view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hideReceiveModal">取消</view>
        <view class="modal-btn confirm" bindtap="submitReceive">确认</view>
      </view>
    </view>
  </view>

  <!-- 协商退款弹窗 -->
  <view class="modal-mask" wx:if="{{showNegotiatedRefundModal}}" bindtap="hideNegotiatedRefundModal">
    <view class="modal-content negotiated-modal" catchtap="noop">
      <view class="modal-title">协商退款</view>
      <view class="negotiated-tip">必须记录协商原因；退款成功后，所选明细将按实际金额结案。</view>
      <scroll-view class="negotiated-list" scroll-y>
        <view class="negotiated-item" wx:for="{{negotiatedItems}}" wx:key="id">
          <view class="negotiated-item-main">
            <view
              class="negotiated-check {{item.selected ? 'selected' : ''}}"
              data-index="{{index}}"
              bindtap="toggleNegotiatedItem">{{item.selected ? '✓' : ''}}</view>
            <view class="negotiated-product">
              <view class="negotiated-name">{{item.productName}}</view>
              <view class="negotiated-limit">原申请 ¥{{item.refundAmount}}，共 {{item.qty}} 件</view>
            </view>
          </view>
          <input
            class="negotiated-amount"
            type="digit"
            disabled="{{!item.selected}}"
            value="{{item.inputAmount}}"
            data-index="{{index}}"
            bindinput="onNegotiatedAmountInput"
            placeholder="退款金额" />
        </view>
      </scroll-view>
      <view class="modal-input-group">
        <view class="input-label">协商原因（必填）</view>
        <textarea
          class="input-textarea negotiated-reason"
          placeholder="例如：退回商品轻微破损，双方协商部分退款"
          value="{{negotiatedReason}}"
          bindinput="onNegotiatedReasonInput"
          maxlength="200" />
      </view>
      <view class="modal-input-group">
        <view class="input-label">处理备注（选填）</view>
        <input
          class="negotiated-note"
          placeholder="补充沟通记录"
          value="{{negotiatedNote}}"
          bindinput="onNegotiatedNoteInput" />
      </view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hideNegotiatedRefundModal">取消</view>
        <view class="modal-btn confirm" bindtap="submitNegotiatedRefund">确认退款</view>
      </view>
    </view>
  </view>

  <!-- 原订单发货物流 -->
  <view class="section" wx:if="{{shipments.length > 0}}">
    <view class="section-title">关联发货物流</view>
    <view class="shipment-list">
      <view class="shipment-card" wx:for="{{shipments}}" wx:key="id">
        <view class="shipment-header">
          <text class="shipment-title">发货单 {{index + 1}}</text>
          <text class="shipment-time" wx:if="{{item.shippedAt}}">{{item.shippedAtDisplay}}</text>
        </view>
        <view class="logistics-row">
          <text class="logistics-label">快递公司</text>
          <text class="logistics-value">{{item.expressName}}</text>
        </view>
        <view class="logistics-row">
          <text class="logistics-label">快递单号</text>
          <text class="logistics-value">{{item.expressNo || '暂无单号'}}</text>
          <text class="copy-btn" wx:if="{{item.expressNo}}" bindtap="copyShipmentExpressNo" data-express-no="{{item.expressNo}}">复制</text>
        </view>
        <view class="shipment-goods-list" wx:if="{{item.items.length > 0}}">
          <view class="shipment-goods" wx:for="{{item.items}}" wx:for-item="goodsItem" wx:key="id">
            <image
              class="shipment-goods-img"
              src="{{goodsItem.displayImage}}"
              mode="aspectFill"
              bindtap="previewPageImage"
              data-image-url="{{goodsItem.displayImage}}"></image>
            <view class="shipment-goods-info">
              <text class="shipment-goods-name">{{goodsItem.productName || '商品'}}</text>
              <text class="shipment-goods-spec">{{goodsItem.specDisplay}}</text>
              <text class="shipment-goods-qty">×{{goodsItem.shipQty}}</text>
            </view>
          </view>
        </view>
        <view class="shipment-actions" wx:if="{{item.id}}">
          <view class="shipment-trace-btn" bindtap="viewShipmentTrace" data-shipment-id="{{item.id}}">物流详情</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

</view>
