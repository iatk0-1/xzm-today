/* miniprogram/pages/adminAfterSaleDetail/adminAfterSaleDetail.wxss */

.page-wrapper {
  padding-bottom: 140rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4444 100%);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.status-card.refunded {
  background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);
}

.status-card.rejected {
  background: linear-gradient(135deg, #9e9e9e 0%, #757575 100%);
}

.status-badge {
  padding: 8rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fff;
}

.refund-total {
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
}

.status-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 通用区块 */
.section {
  background-color: #fff;
  margin-bottom: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 24rpx;
}

/* 订单信息 */
.order-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-row-top {
  align-items: flex-start;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #111;
}

.info-value-box {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.info-value-box .info-value {
  word-break: break-all;
  text-align: right;
}

.info-value-box-column {
  flex-direction: column;
  align-items: flex-end;
}

.info-value-multiline {
  white-space: pre-wrap;
}

.info-group,
.amount-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-items-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.order-item-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.amount-group {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.amount-strong {
  font-weight: 600;
  color: #111;
}

/* 商品列表 */
.items-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.item-name {
  font-size: 26rpx;
  color: #111;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.item-sku {
  font-size: 22rpx;
  color: #999;
}

.item-detail-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.item-qty {
  font-size: 24rpx;
  color: #666;
}

.item-type {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  background-color: #f0f0f0;
  color: #666;
}

.item-type.refund {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.item-type.return_refund {
  background-color: #fce4ec;
  color: #c2185b;
}

.item-status {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  background-color: #f0f0f0;
  color: #666;
}

.item-status.pending {
  background-color: #fff3e0;
  color: #f57c00;
}

.item-status.approved {
  background-color: #e3f2fd;
  color: #1976d2;
}

.item-status.rejected {
  background-color: #ffebee;
  color: #c62828;
}

.item-status.received,
.item-status.refunded {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.item-refund {
  font-size: 32rpx;
  color: #ff4444;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 原因内容 */
.reason-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 凭证图片 */
.evidence-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.evidence-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

/* 物流信息 */
.logistics-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.logistics-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logistics-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
}

.logistics-value {
  flex: 1;
  font-size: 28rpx;
  color: #111;
}

.copy-btn {
  padding: 8rpx 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

/* 时间轴 */
.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  position: relative;
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  background-color: #ff4444;
  border-radius: 50%;
  z-index: 1;
}

.timeline-node.last .timeline-dot {
  background-color: #ddd;
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  background-color: #f0f0f0;
  margin-top: 8rpx;
}

.timeline-content {
  flex: 1;
  padding-bottom: 32rpx;
}

.timeline-status {
  font-size: 28rpx;
  color: #111;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.timeline-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.action-btn-group {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
}

.btn-ghost {
  padding: 24rpx 48rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4444 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.action-bar-hint {
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.action-fail-tip {
  margin-bottom: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #f57c00;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-options {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.option-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
}

.option-item.selected {
  background-color: #fff5f5;
  border-color: #ff4444;
}

.option-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  color: #ccc;
}

.option-item.selected .option-icon {
  color: #ff4444;
}

.option-text {
  font-size: 28rpx;
  color: #666;
}

.option-item.selected .option-text {
  color: #ff4444;
  font-weight: 600;
}

.modal-input-group {
  margin-bottom: 32rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.negotiated-modal {
  max-height: 88vh;
}

.negotiated-tip {
  margin-bottom: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fff8e8;
  color: #a96800;
  font-size: 24rpx;
  line-height: 1.5;
}

.negotiated-list {
  max-height: 320rpx;
  margin-bottom: 24rpx;
}

.negotiated-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee;
}

.negotiated-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.negotiated-check {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #bbb;
  border-radius: 8rpx;
  color: #fff;
  text-align: center;
  line-height: 38rpx;
  flex-shrink: 0;
}

.negotiated-check.selected {
  border-color: #ff4444;
  background: #ff4444;
}

.negotiated-product {
  min-width: 0;
}

.negotiated-name {
  overflow: hidden;
  color: #222;
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.negotiated-limit {
  margin-top: 6rpx;
  color: #999;
  font-size: 22rpx;
}

.negotiated-amount,
.negotiated-note {
  box-sizing: border-box;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 26rpx;
}

.negotiated-amount {
  width: 170rpx;
  flex-shrink: 0;
}

.negotiated-note {
  width: 100%;
}

.negotiated-reason {
  min-height: 130rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4444 100%);
  color: #fff;
}

.modal-btn.confirm.danger {
  background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
}

/* 加载状态 */
.loading-state {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 1000;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #ff4444;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}
