@import "../../styles/adminProductArticleNo.wxss";
@import "../../styles/afterSale.wxss";
.page-wrapper { padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }
.status-card { padding-bottom: 22rpx; }
.awaiting-inspection .status-badge::before { background: #e3aa4b; }
.status-card .refund-channel-summary { margin-top: 18rpx; }
.status-card .channel-amounts { display: flex; border-top: 0; padding-top: 0; }
.status-card .channel-row { flex: 1; justify-content: flex-start; gap: 16rpx; font-size: 24rpx; }
.status-card .channel-row + .channel-row { border-left: 1rpx solid #ddd; padding-left: 28rpx; }
.detail-order-bar { margin: 0 40rpx; padding: 20rpx 0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; border-bottom: 1rpx solid #ededed; }
.detail-order-bar .related-order-number { font-size: 24rpx; }
.order-bar-label { color: #888; }
.order-detail-link { color: #777; font-size: 22rpx; }
.item-img { width: 144rpx; height: 176rpx; }
.item-row { align-items: flex-start; }
.item-info .admin-product-article-no { margin-top: 0; font-size: 22rpx; }
.review-decision-tabs { flex-direction: row; gap: 0; border-bottom: 1rpx solid #ededed; margin-bottom: 24rpx; }
.review-decision-tabs .option-item { flex: 1; justify-content: center; padding: 12rpx 0 16rpx; font-size: 26rpx; position: relative; }
.review-decision-tabs .option-item.selected { font-weight: 600; }
.review-decision-tabs .option-item.selected::after { content: ''; position: absolute; bottom: 0; left: 25%; right: 25%; height: 2rpx; background: #111; }
.review-item { padding: 20rpx 0 24rpx; border-bottom: 1rpx solid #ededed; }
.review-item:first-child { padding-top: 0; }
.review-item-header { display: flex; align-items: center; gap: 14rpx; }
.review-check, .negotiated-check { display: flex; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; box-sizing: border-box; border: 1rpx solid #bbb; border-radius: 50%; color: #fff; font-size: 20rpx; flex-shrink: 0; }
.review-check.selected, .negotiated-check.selected { background: #111; border-color: #111; }
.review-item-img { width: 112rpx; height: 136rpx; border-radius: 4rpx; background: #f7f7f7; flex-shrink: 0; }
.review-item-info { display: flex; flex-direction: column; flex: 1; min-width: 0; gap: 6rpx; }
.review-item-name { color: #222; font-size: 28rpx; line-height: 40rpx; font-weight: 500; word-break: break-all; }
.review-item-spec, .review-item-limit { color: #999; font-size: 22rpx; line-height: 34rpx; }
.review-edit-row { display: flex; flex-direction: column; gap: 16rpx; margin-top: 20rpx; }
.review-edit-field { display: flex; align-items: center; gap: 20rpx; font-size: 26rpx; color: #555; }
.review-edit-field > text { width: 112rpx; flex-shrink: 0; }
.review-edit-input { width: 95px; height: 30px; box-sizing: border-box; padding: 0 8px; border: 1px solid #eee; border-radius: 0; font-size: 13px; text-align: center; }
.review-type-row { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.review-type-label { width: 112rpx; color: #555; font-size: 24rpx; flex-shrink: 0; }
.review-type-option { padding: 8rpx 14rpx; border: 1rpx solid #ddd; border-radius: 4rpx; color: #888; font-size: 22rpx; }
.review-type-option.selected { border-color: #111; color: #333; }
.review-type-tip { color: #aa493d; font-size: 22rpx; line-height: 1.6; margin-top: 12rpx; }
.modal-body .refund-channel-summary { padding-top: 20rpx; }
.review-total-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; color: #333; font-size: 24rpx; }
.review-total { color: #111; font-size: 36rpx; line-height: 48rpx; font-weight: 600; }
.review-channel-line { color: #999; font-size: 22rpx; text-align: right; margin: 4rpx 0 16rpx; }
.review-summary-note { padding-top: 16rpx; border-top: 1rpx solid #ededed; color: #888; font-size: 22rpx; line-height: 34rpx; }
.review-context-toggle { color: #888; font-size: 20rpx; text-align: right; padding: 4rpx 0 8rpx; }
.inspection-intro { padding-top: 0; }
.inspection-row { padding: 16rpx 0; }
.inspection-row + .inspection-row { border-top: 1rpx solid #ededed; }
.inspection-product { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; }
.inspection-image { width: 120rpx; height: 144rpx; border-radius: 4rpx; background: #f7f7f7; flex-shrink: 0; }
.inspection-name { color: #222; font-size: 28rpx; font-weight: 500; line-height: 40rpx; }
.inspection-meta { color: #999; font-size: 22rpx; line-height: 36rpx; margin-top: 6rpx; }
.inspection-inputs { display: flex; align-items: center; gap: 24rpx; margin: 16rpx 0; color: #555; font-size: 26rpx; }
.inspection-inputs > text { width: 220rpx; flex-shrink: 0; }
.inspection-options { gap: 4rpx; padding-top: 8rpx; border-top: 1rpx solid #ededed; }
.inspection-footnote { padding: 16rpx 0 0; border-top: 1rpx solid #ededed; margin-top: 12rpx; }
.negotiated-item { padding: 20rpx 0; border-bottom: 1rpx solid #ededed; }
.negotiated-item-main { display: flex; gap: 16rpx; }
.negotiated-product { flex: 1; min-width: 0; }
.negotiated-name { color: #333; font-size: 28rpx; word-break: break-all; }
.negotiated-limit { color: #999; font-size: 22rpx; margin-top: 8rpx; }
.negotiated-amount, .negotiated-note { height: 68rpx; padding: 0 18rpx; margin-top: 14rpx; box-sizing: border-box; font-size: 26rpx; background: #f7f7f7; border-radius: 4rpx; }
.shipment-list { display: flex; flex-direction: column; gap: 24rpx; }
.shipment-card { padding: 20rpx; border: 1rpx solid #ededed; border-radius: 4rpx; }
.shipment-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.shipment-title { color: #333; font-size: 26rpx; }
.shipment-time { color: #999; font-size: 22rpx; }
.shipment-card .logistics-row { margin-top: 14rpx; }
.shipment-goods-list { margin-top: 24rpx; }
.shipment-goods { display: flex; gap: 16rpx; margin-top: 16rpx; }
.shipment-goods-img { width: 96rpx; height: 120rpx; border-radius: 4rpx; flex-shrink: 0; }
.shipment-goods-info { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; font-size: 22rpx; color: #888; }
.shipment-goods-name { color: #333; font-size: 26rpx; word-break: break-all; }
.shipment-actions { display: flex; justify-content: flex-end; margin-top: 20rpx; }
.shipment-trace-btn { padding: 10rpx 20rpx; color: #333; font-size: 24rpx; border: 1rpx solid #bbb; border-radius: 4rpx; }
