page { background-color: #f7f8fa; padding-bottom: 120rpx; }
.detail-wrapper { width: 100%; }

/* 顶部状态栏 */
.status-header { padding: 40rpx 40rpx 60rpx; }
.status-title { font-size: 40rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 10rpx; }
.status-desc { font-size: 24rpx; color: #666; display: flex; flex-direction: column; gap: 8rpx; }
.countdown-timer { color: #d32f2f; font-weight: bold; font-size: 26rpx; font-family: "Times New Roman", Times, serif; }

/* 通用卡片样式 */
.info-card { background-color: #ffffff; border-radius: 20rpx; margin: 0 20rpx 24rpx; padding: 30rpx; }

/* 地址卡片 */
.address-card { display: flex; align-items: center; }
.location-icon { font-size: 40rpx; margin-right: 20rpx; }
.address-content { flex: 1; }
.user-row { margin-bottom: 8rpx; }
.name { font-size: 30rpx; font-weight: bold; color: #333; margin-right: 20rpx; }
.phone { font-size: 26rpx; color: #666; font-family: -apple-system, sans-serif; }
.detail-row { font-size: 24rpx; color: #333; line-height: 1.5; }

/* 商品卡片 */
.shop-title { font-size: 26rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 30rpx; }
.goods-item { display: flex; margin-bottom: 30rpx; }
.goods-img { width: 140rpx; height: 186rpx; background-color: #f0f0f0; border-radius: 10rpx; margin-right: 24rpx; }
.goods-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.goods-title { font-size: 26rpx; color: #333; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.goods-sku { font-size: 22rpx; color: #999; margin-top: 10rpx; }
.goods-price-row { display: flex; justify-content: space-between; align-items: baseline; margin-top: auto; }
.price { font-size: 28rpx; font-weight: bold; font-family: "Times New Roman", Times, serif; }
.count { font-size: 24rpx; color: #999; }

/* 费用明细 */
.money-breakdown { border-top: 1rpx solid #f5f5f5; padding-top: 30rpx; margin-top: 10rpx; }
.money-row { display: flex; justify-content: space-between; margin-bottom: 16rpx; font-size: 24rpx; }
.money-label { color: #666; }
.money-val { color: #333; font-family: "Times New Roman", Times, serif; }
.money-row.total { margin-top: 24rpx; margin-bottom: 0; align-items: center; }
.total .money-label { font-size: 26rpx; color: #1a1a1a; font-weight: bold; }
.total .final { font-size: 36rpx; color: #1a1a1a; font-weight: bold; }

/* 订单信息卡片 */
.info-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.info-row:last-child { margin-bottom: 0; }
.info-label { font-size: 24rpx; color: #999; }
.info-val-box { display: flex; align-items: center; }
.info-val { font-size: 24rpx; color: #333; font-family: -apple-system, sans-serif; }
.btn-copy { font-size: 20rpx; color: #1a1a1a; border: 1rpx solid #1a1a1a; padding: 2rpx 12rpx; border-radius: 6rpx; margin-left: 16rpx; }

/* 售后记录卡片 */
.after-sale-card { margin-top: 0; }
.section-title { font-size: 30rpx; font-weight: 600; color: #111; margin-bottom: 24rpx; }
.after-sale-list { display: flex; flex-direction: column; gap: 16rpx; }
.after-sale-item {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
}
.after-sale-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.after-sale-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
}
.after-sale-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.after-sale-status.status-pending {
  background-color: #fff3e0;
  color: #ff9800;
}
.after-sale-status.status-approved,
.after-sale-status.status-received {
  background-color: #e8f5e9;
  color: #4caf50;
}
.after-sale-status.status-rejected {
  background-color: #ffebee;
  color: #f44336;
}
.after-sale-status.status-refunded {
  background-color: #e3f2fd;
  color: #2196f3;
}
.after-sale-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.after-sale-qty {
  font-size: 24rpx;
  color: #666;
}
.after-sale-amount {
  font-size: 26rpx;
  color: #ff4444;
  font-weight: 600;
  font-family: "Times New Roman", Times, serif;
}
.after-sale-reason {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.after-sale-time {
  font-size: 22rpx;
  color: #ccc;
}

/* 底部操作栏 */
.bottom-action-bar { position: fixed; bottom: 0; left: 0; width: 100%; height: 110rpx; background: #fff; border-top: 1rpx solid #eee; display: flex; justify-content: flex-end; align-items: center; padding: 0 20rpx; box-sizing: border-box; padding-bottom: env(safe-area-inset-bottom); z-index: 100; gap: 20rpx; }
.btn-ghost { margin: 0; padding: 0 36rpx; height: 64rpx; line-height: 62rpx; font-size: 26rpx; color: #333; background: #fff; border: 1rpx solid #ddd; border-radius: 32rpx; }
.btn-ghost::after { display: none; }
.btn-solid { padding: 0 36rpx; height: 64rpx; line-height: 64rpx; font-size: 26rpx; color: #fff; background: #1a1a1a; border-radius: 32rpx; font-weight: bold; }

/* 物流信息卡片 */
.logistics-card { margin-top: 0; }
.logistics-info { background-color: #fafafa; border-radius: 12rpx; padding: 20rpx; }
.logistics-row { display: flex; justify-content: space-between; margin-bottom: 16rpx; font-size: 24rpx; }
.logistics-row:last-child { margin-bottom: 0; }
.logistics-label { color: #999; }
.logistics-val { color: #333; font-family: -apple-system, sans-serif; }

/* 发货单列表（支持分批发货） */
.shipment-list { display: flex; flex-direction: column; gap: 24rpx; margin-top: 20rpx; }
.shipment-item {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #f0f0f0;
}
.shipment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #e0e0e0;
}
.shipment-index {
  font-size: 26rpx;
  font-weight: bold;
  color: #111;
}
.shipment-time {
  font-size: 22rpx;
  color: #999;
}
.shipment-info {
  margin-bottom: 20rpx;
}
.shipment-info .info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}
.shipment-info .info-row:last-child { margin-bottom: 0; }
.shipment-info .label { color: #999; }
.shipment-info .value { color: #333; font-family: -apple-system, sans-serif; }

/* 发货单商品列表 */
.shipment-items {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.shipment-goods {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}
.shipment-goods:last-child { border-bottom: none; }
.shipment-goods .goods-img {
  width: 120rpx;
  height: 160rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.shipment-goods .goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}
.shipment-goods .goods-title {
  font-size: 26rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}
.shipment-goods .goods-sku {
  font-size: 22rpx;
  color: #999;
}
.shipment-goods .goods-qty {
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
  text-align: right;
  font-family: "Times New Roman", Times, serif;
}

/* 面单预览按钮 */
.pdf-action {
  margin-bottom: 16rpx;
}
.btn-preview {
  background-color: #1890ff;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  height: auto;
  line-height: 1.5;
}

/* 物流轨迹 */
.trace-title { font-size: 26rpx; font-weight: 600; color: #111; margin: 20rpx 0 16rpx; }
.trace-list { display: flex; flex-direction: column; gap: 20rpx; }
.trace-item { display: flex; gap: 16rpx; }
.trace-time { width: 100rpx; flex-shrink: 0; font-size: 22rpx; color: #999; }
.trace-content { flex: 1; font-size: 24rpx; color: #333; line-height: 1.5; }