<view class="detail-wrapper" wx:if="{{!isLoading && order}}">

  <view class="status-header">
    <view class="status-title">{{order.statusDisplay}}</view>
    <view class="status-desc" wx:if="{{order.status === 'pending'}}">
      <text>请尽快完成支付，超时将自动取消</text>
      <text wx:if="{{countdownText}}" class="countdown-timer">{{countdownText}}</text>
    </view>
    <view class="status-desc" wx:if="{{order.status === 'stocking'}}">订单已支付，正在备货中</view>
    <view class="status-desc" wx:if="{{order.status === 'paid'}}">主理人正在为您精心打包中...</view>
    <view class="status-desc" wx:if="{{order.status === 'partial_shipped'}}">部分商品已发货，其余正在准备中</view>
    <view class="status-desc" wx:if="{{order.status === 'shipped'}}">包裹正飞奔向您，请耐心等待</view>
    <view class="status-desc" wx:if="{{order.status === 'completed'}}">订单已完成，感谢您的惠顾</view>
  </view>

  <view class="info-card address-card" wx:if="{{order.recipientName}}">
    <view class="location-icon">📍</view>
    <view class="address-content">
      <view class="user-row">
        <text class="name">{{order.recipientName}}</text>
        <text class="phone">{{order.recipientPhone}}</text>
      </view>
      <view class="detail-row">{{order.recipientAddress}}</view>
    </view>
    <view class="btn-copy address-copy" catchtap="copyRecipientInfo">复制</view>
  </view>

  <view class="info-card goods-card">
    <view class="shop-title">Curation Market</view>
    <view class="goods-item" wx:for="{{order.items}}" wx:key="id">
      <image class="goods-img" src="{{item.skuImageUrl || item.productImage}}" mode="aspectFill"></image>
      <view class="goods-info">
        <view class="goods-title">{{item.productName}}</view>
        <!-- 套装子项列表 -->
        <view class="goods-bundle" wx:if="{{item.bundleConfig && item.bundleConfig.length > 0}}">
          <view class="bundle-sub" wx:for="{{item.bundleConfig}}" wx:key="skuId" wx:for-item="sub">
            <text class="bundle-sub-name">{{sub.bundleGroupName}}:</text>
            <text class="bundle-sub-spec">{{sub.color}} / {{sub.size}} x {{sub.count}}</text>
          </view>
        </view>
        <view class="goods-sku" wx:else>{{item.productSpec || '图片色'}} / {{item.productSize || '均码'}}</view>
        <view class="after-sale-tag" wx:if="{{item.afterSaleSummary && item.afterSaleSummary.hasAfterSale}}">
          {{item.afterSaleSummary.statusText}} {{item.afterSaleSummary.totalQty}}/{{item.qty}}
          <text wx:if="{{item.afterSaleSummary.shipmentBlockedQty > 0}}"> · 可发 {{item.afterSaleSummary.canShipQty}}</text>
        </view>
        <view class="goods-price-row">
          <text class="price">¥ {{item.salePrice}}</text>
          <text class="count">x {{item.qty}}</text>
        </view>
        <view class="goods-remark" wx:if="{{item.remark}}">
          <text class="remark-tag">备注</text>
          <text class="remark-text">{{item.remark}}</text>
        </view>
      </view>
    </view>

    <view class="money-breakdown">
      <view class="money-row">
        <text class="money-label">商品总价</text>
        <text class="money-val">¥ {{order.totalPrice}}</text>
      </view>
      <view class="money-row">
        <text class="money-label">运费</text>
        <text class="money-val">¥ 0.00</text>
      </view>
      <view class="money-row total">
        <text class="money-label">实付款</text>
        <text class="money-val final">¥ {{order.payAmount}}</text>
      </view>
    </view>
  </view>

  <view class="info-card order-info-card">
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <view class="info-val-box">
        <text class="info-val">{{order.outTradeNo || order.id}}</text>
        <view class="btn-copy" bindtap="copyOrderSn">复制</view>
      </view>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-val">{{order.createdAtDisplay}}</text>
    </view>
  </view>

  <!-- 物流信息区域（支持分批发货，多个发货单） -->
  <view class="info-card logistics-card" wx:if="{{shipments && shipments.length > 0}}">
    <view class="section-title">物流信息</view>

    <!-- 多个发货单列表 -->
    <view class="shipment-list">
      <view class="shipment-item" wx:for="{{shipments}}" wx:key="id">
        <view class="shipment-header">
          <text class="shipment-index">发货单 {{index + 1}}</text>
          <text class="shipment-time" wx:if="{{item.shippedAt}}">{{item.shippedAtDisplay}}</text>
        </view>

        <view class="shipment-info">
          <view class="info-row">
            <text class="label">快递公司</text>
            <text class="value">{{item.expressCode === 'ZTO' ? '中通快递' : item.expressCode}}</text>
          </view>
          <view class="info-row">
            <text class="label">快递单号</text>
            <view class="value-box">
              <text class="value">{{item.expressNo}}</text>
              <text class="btn-copy" catchtap="copyExpressNo" data-express-no="{{item.expressNo}}">复制</text>
            </view>
          </view>
        </view>

        <!-- 发货单商品列表 -->
        <view class="shipment-items">
          <view class="shipment-goods" wx:for="{{item.items}}" wx:for-item="goodsItem" wx:key="id">
            <image class="goods-img" src="{{goodsItem.skuImageUrl || goodsItem.productImage}}" mode="aspectFill"></image>
            <view class="goods-info">
              <view class="goods-title">{{goodsItem.productName || '商品'}}</view>
              <view class="goods-sku">
                <text wx:if="{{goodsItem.bundleGroupName}}">{{goodsItem.bundleGroupName}}: </text>
                <text wx:if="{{goodsItem.spec}}">{{goodsItem.spec}}</text>
                <text wx:if="{{goodsItem.size}}"> / {{goodsItem.size}}</text>
              </view>
              <view class="goods-qty">× {{goodsItem.shipQty}}</view>
            </view>
          </view>
        </view>

        <!-- 面单 PDF 预览 -->
        <view class="pdf-action" wx:if="{{item.pdfShowUrl}}">
          <button class="btn-preview" bindtap="previewWaybill" data-url="{{item.pdfShowUrl}}">预览面单</button>
        </view>

        <!-- 物流轨迹摘要 -->
        <view class="logistics-trace-summary" wx:if="{{logisticsTraceMap[item.id]}}" bindtap="viewShipmentTrace" data-id="{{item.id}}">
          <view class="trace-summary-header">
            <text class="trace-summary-title">物流轨迹</text>
            <text class="trace-summary-link">查看详情</text>
          </view>
          <view class="trace-summary-body" wx:if="{{logisticsTraceMap[item.id].latestNode}}">
            <text class="trace-summary-status">{{logisticsTraceMap[item.id].latestNode.description}}</text>
            <text class="trace-summary-time">{{logisticsTraceMap[item.id].latestNode.timeDisplay}}</text>
          </view>
          <view class="trace-summary-empty" wx:else>暂无物流轨迹</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 售后记录区域 -->
  <view class="info-card after-sale-card" wx:if="{{afterSaleRecords && afterSaleRecords.length > 0}}">
    <view class="section-title">售后记录</view>
    <view class="after-sale-list">
      <view
        class="after-sale-item"
        wx:for="{{afterSaleRecords}}"
        wx:key="id"
        bindtap="viewAfterSaleDetail"
        data-id="{{item.id}}">
        <view class="after-sale-header">
          <text class="after-sale-type">{{item.typeDisplay}}</text>
          <text class="after-sale-status status-{{item.status}}">{{item.statusDisplay}}</text>
        </view>
        <view class="after-sale-info">
          <text class="after-sale-qty">数量：{{item.qty}}</text>
          <text class="after-sale-amount">退款：¥ {{item.refundAmount}}</text>
        </view>
        <view class="after-sale-reason" wx:if="{{item.reason}}">{{item.reason}}</view>
        <view class="after-sale-time">{{item.createdAt}}</view>
      </view>
    </view>
  </view>

  <view class="bottom-action-bar">
    <button class="btn-ghost" open-type="contact">联系主理人</button>

    <view class="btn-solid" wx:if="{{order.status === 'pending'}}" bindtap="payOrder">立即支付</view>
    <view class="btn-ghost" wx:if="{{order.status === 'pending'}}" bindtap="cancelOrder">取消订单</view>

    <view class="btn-solid" wx:if="{{order.canConfirmReceipt}}" bindtap="confirmReceipt">确认收货</view>
    <view class="btn-ghost" wx:if="{{order.status === 'stocking' || order.status === 'paid' || order.status === 'partial_shipped' || order.status === 'shipped' || order.status === 'completed'}}" bindtap="requestRefund">申请售后</view>
  </view>

</view>
