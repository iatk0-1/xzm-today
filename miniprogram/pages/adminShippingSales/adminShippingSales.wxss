page { background: #f5f5f5; }
.page { padding: 16rpx; padding-bottom: 60rpx; }
.summary, .filters, .list { background: #fff; border-radius: 16rpx; margin-bottom: 16rpx; padding: 24rpx; }
.summary-row { display: flex; }
.summary-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; font-size: 24rpx; color: #777; }
.summary-number { font-size: 42rpx; font-weight: 700; color: #1a1a1a; }
.summary-state { text-align: center; padding: 24rpx; color: #777; font-size: 26rpx; }
.summary-note { color: #999; font-size: 22rpx; text-align: center; margin-top: 18rpx; }
.search-row, .date-row { display: flex; align-items: center; gap: 12rpx; }
.search-row { margin-bottom: 16rpx; }
.search-input, .date-picker { background: #f5f5f5; border-radius: 8rpx; font-size: 25rpx; color: #444; }
.search-input { flex: 1; height: 68rpx; padding: 0 16rpx; }
.search-button { background: #222; color: #fff; border-radius: 8rpx; padding: 14rpx 24rpx; font-size: 25rpx; }
.date-picker { flex: 1; min-width: 0; padding: 16rpx 8rpx; text-align: center; }
.date-separator, .clear-date { color: #888; font-size: 23rpx; }
.tabs { white-space: nowrap; background: #fff; border-radius: 16rpx; margin-bottom: 16rpx; }
.tab { display: inline-block; padding: 20rpx 35rpx; font-size: 26rpx; color: #666; }
.tab.active { color: #111; font-weight: 700; box-shadow: inset 0 -5rpx #111; }
.list-title { font-size: 28rpx; font-weight: 600; margin-bottom: 10rpx; }
.card { display: flex; padding: 22rpx 0; border-bottom: 1rpx solid #eee; }
.image { width: 92rpx; height: 92rpx; flex-shrink: 0; border-radius: 10rpx; background: #eee; }
.card-content { flex: 1; min-width: 0; margin-left: 18rpx; }
.product-name { font-size: 27rpx; color: #222; font-weight: 600; }
.sku-name { font-size: 24rpx; color: #777; margin-top: 6rpx; }
.quantities { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 12rpx; font-size: 24rpx; color: #444; }
.after-sales { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; align-items: center; }
.after-sale-label, .after-sale-status { border-radius: 6rpx; padding: 3rpx 10rpx; font-size: 21rpx; }
.after-sale-label { background: #fff0e4; color: #b45116; }
.after-sale-status { background: #fff7f0; color: #a75523; }
.message { text-align: center; padding: 32rpx 0; color: #999; font-size: 25rpx; }
.retry { color: #333; }
