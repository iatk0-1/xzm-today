<view class="page-wrapper">
  <view class="overview-card">
    <view class="overview-status" wx:if="{{overviewLoading}}">统计加载中...</view>
    <view class="overview-status" wx:elif="{{overviewError}}" bindtap="loadOverview">{{overviewError}} · 点击重试</view>
    <view class="stat-row" wx:else>
      <view class="stat-item"><text class="stat-val">{{overview.soldQty}}</text><text class="stat-label">售出数量</text></view>
      <view class="stat-item"><text class="stat-val">{{overview.pendingQty}}</text><text class="stat-label">待发数量</text></view>
      <view class="stat-item"><text class="stat-val">{{overview.shippedQty}}</text><text class="stat-label">已发数量</text></view>
    </view>
    <view class="after-sales" wx:if="{{overview.afterSaleQty > 0 || overview.pendingReviewQty > 0}}">
      <text class="after-sale-label" wx:if="{{overview.afterSaleQty > 0}}">售后 {{overview.afterSaleQty}} 件</text>
      <text class="after-sale-status" wx:if="{{overview.pendingReviewQty > 0}}">待审核 {{overview.pendingReviewQty}} 件</text>
    </view>
    <view class="summary-note">按下单时间统计有效订单；待审核仍计入待发，退款成功后扣除未发数量</view>
  </view>
  <view class="filter-bar">
    <view class="search-row">
      <input class="search-input" placeholder="搜索商品名称..." value="{{keywordInput}}" bindinput="onKeywordInput" bindconfirm="onSearch" confirm-type="search" />
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
    <view class="filter-section">
      <view class="filter-row">
        <text class="filter-label">状态</text>
        <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="filter-options">
            <view class="filter-tag {{selectedStatus === item.value ? 'active' : ''}}" wx:for="{{statusOptions}}" wx:key="value" bindtap="selectStatus" data-status="{{item.value}}">{{item.label}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="filter-row">
        <text class="filter-label">档口</text>
        <view class="filter-fixed-option filter-tag {{selectedStall === '' ? 'active' : ''}}" bindtap="selectStall" data-stall="all">全部</view>
        <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="filter-options">
            <view class="filter-tag {{selectedStall === item.id ? 'active' : ''}}" wx:for="{{stallList}}" wx:key="id" bindtap="selectStall" data-stall="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="filter-row">
        <text class="filter-label">标签</text>
        <view class="filter-fixed-option filter-tag {{selectedTag === '' ? 'active' : ''}}" bindtap="selectTag" data-tag="all">全部</view>
        <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="filter-options">
            <view class="filter-tag {{selectedTag === item.id ? 'active' : ''}}" wx:for="{{tagList}}" wx:key="id" bindtap="selectTag" data-tag="{{item.id}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
    <view class="date-filter">
      <view class="date-picker" bindtap="showDateRangeSelector">
        <text wx:if="{{!startDate && !endDate}}">选择时间范围</text>
        <text wx:else>{{startDate || '开始'}} - {{endDate || '结束'}}</text>
      </view>
      <view class="clear-date" wx:if="{{startDate || endDate}}" bindtap="clearDateRange">×</view>
    </view>
  </view>
  <view class="products-section">
    <view class="section-title">商品出货统计 ({{total}})</view>
    <view class="product-card" wx:for="{{items}}" wx:key="productId" bindtap="goToDetail" data-item="{{item}}">
      <image class="product-img" src="{{item.productImage || '/images/placeholder.png'}}" mode="aspectFill" />
      <view class="product-info">
        <view class="product-name">{{item.productName}}</view>
        <view class="product-stats">
          <text>售出 {{item.soldQty || 0}}</text>
          <text>待发 {{item.pendingQty || 0}}</text>
          <text>已发 {{item.shippedQty || 0}}</text>
        </view>
        <view class="after-sales" wx:if="{{item.afterSaleQty > 0 || item.pendingReviewQty > 0}}">
          <text class="after-sale-label" wx:if="{{item.afterSaleQty > 0}}">售后 {{item.afterSaleQty}} 件</text>
          <text class="after-sale-status" wx:if="{{item.pendingReviewQty > 0}}">待审核 {{item.pendingReviewQty}} 件</text>
        </view>
      </view>
      <view class="product-arrow">›</view>
    </view>
    <view class="load-more" wx:if="{{loading && items.length > 0}}">正在加载更多...</view>
    <view class="load-more" wx:elif="{{hasMore}}" bindtap="onReachBottom">加载更多</view>
    <view class="empty-state" wx:if="{{loading && items.length === 0}}">正在加载...</view>
    <view class="empty-state" wx:elif="{{loadError && items.length === 0}}" bindtap="retryItems">{{loadError}} · 点击重试</view>
    <view class="empty-state" wx:elif="{{items.length === 0}}">暂无统计数据</view>
  </view>
  <view class="modal" wx:if="{{showDateModal}}">
    <view class="modal-mask" bindtap="closeDateModal"></view>
    <view class="modal-content">
      <view class="modal-title">选择时间范围</view>
      <view class="quick-options">
        <view class="quick-option {{editingDateRange.quickSelect === '1day' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="1day">最近 1 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === '7days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="7days">最近 7 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === '30days' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="30days">最近 30 天</view>
        <view class="quick-option {{editingDateRange.quickSelect === 'month' ? 'selected' : ''}}" bindtap="selectDateRange" data-type="month">本月</view>
      </view>
      <view class="custom-section">
        <view class="custom-title">自定义时间</view>
        <picker mode="date" value="{{editingDateRange.startDate}}" end="{{editingDateRange.endDate || today}}" bindchange="onStartDateChange">
          <view class="date-picker-input">开始日期：{{editingDateRange.startDate || '选择'}}</view>
        </picker>
        <picker mode="date" value="{{editingDateRange.endDate}}" start="{{editingDateRange.startDate}}" end="{{today}}" bindchange="onEndDateChange">
          <view class="date-picker-input">结束日期：{{editingDateRange.endDate || '选择'}}</view>
        </picker>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeDateModal">取消</button>
        <button class="modal-confirm" bindtap="confirmDateRange">确定</button>
      </view>
    </view>
  </view>
</view>
