<!-- miniprogram/pages/manualShip/manualShip.wxml -->
<view class="page">
  <!-- 订单信息卡片 -->
  <view class="card order-card">
    <view class="card-hd">
      <text class="card-hd-title">订单信息</text>
      <text class="order-no">{{orderNo}}</text>
      <text class="copy-link" catchtap="copyOrderNo">复制</text>
    </view>
    <view class="recipient-block">
      <view class="recipient-line recipient-line-head">
        <view class="recipient-user">
          <text class="recipient-name">{{recipientName}}</text>
          <text class="recipient-phone">{{recipientPhone}}</text>
        </view>
        <text class="copy-link" catchtap="copyRecipientInfo">复制</text>
      </view>
      <view class="recipient-addr">{{recipientAddress}}</view>
    </view>
  </view>

  <!-- 发货统计 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{totalQty}}</text>
      <text class="stat-label">总量</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num shipped">{{shippedQty}}</text>
      <text class="stat-label">已发</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num pending">{{unshippedQty}}</text>
      <text class="stat-label">待发</text>
    </view>
  </view>

  <!-- 快递信息 -->
  <view class="card">
    <view class="card-hd">
      <text class="card-hd-title">快递信息</text>
    </view>

    <!-- 快递公司 -->
    <view class="form-item">
      <text class="form-label">快递公司</text>
      <picker mode="selector" range="{{expressCodes}}" value="{{expressCodeIndex}}" bindchange="onExpressCodeChange">
        <view class="form-picker">
          <text>{{expressCodes[expressCodeIndex]}}</text>
          <text class="form-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 单号 -->
    <view class="form-item">
      <text class="form-label">快递单号</text>
      <input class="form-input"
             placeholder="输入或扫描单号"
             value="{{expressNo}}"
             bindinput="onExpressNoInput"
             bindblur="onExpressNoBlur" />
      <view class="form-actions">
        <text class="copy-link scan-link" catchtap="scanExpressNo">扫码</text>
        <text class="copy-link" wx:if="{{expressNo}}" catchtap="copyExpressNo">复制</text>
      </view>
    </view>

    <!-- 单号检测 -->
    <view class="form-hint ok" wx:if="{{detectedCourier && !expressNoUsed}}">
      已识别为 {{detectedCourier.name}}
    </view>
    <view class="form-hint warn" wx:if="{{expressNoUsed}}">
      {{expressNoUsageInfo}}
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="card">
    <view class="card-hd card-hd-actions">
      <text class="card-hd-title">本次发货商品</text>
      <view class="card-hd-links">
        <text bindtap="selectAll">全选</text>
        <text bindtap="clearAll">清空</text>
      </view>
    </view>

    <view class="goods-list">
      <view class="goods-item {{item.canShip ? '' : 'done'}} {{item.selected ? 'checked' : ''}}"
            wx:for="{{items}}" wx:key="id" wx:for-item="item" wx:for-index="index">

        <!-- 勾选框 -->
        <view class="check-box {{item.selected ? 'on' : ''}} {{item.canShip ? '' : 'off'}}"
              catchtap="toggleSelect" data-index="{{index}}">
          <text class="check-mark" wx:if="{{item.selected}}">✓</text>
        </view>

        <!-- 图片 -->
        <view class="goods-img-wrap">
          <image class="goods-img" src="{{item.skuImageUrl}}" mode="aspectFill" />
          <view class="goods-img-mask" wx:if="{{!item.canShip}}">
            <text>已发完</text>
          </view>
        </view>

        <!-- 信息 -->
        <view class="goods-info">
          <view class="goods-name">{{item.productName}}</view>
          <view class="goods-spec">
            <text wx:if="{{item.bundleGroupName}}">{{item.bundleGroupName}}: </text>{{item.productSpec}} / {{item.productSize}}
          </view>
          <block wx:if="{{item.bundleConfig && item.bundleConfig.length > 0}}">
            <text class="bundle-sub" wx:for="{{item.bundleConfig}}" wx:key="skuId" wx:for-item="sub">
              {{sub.bundleGroupName}}: {{sub.color}}/{{sub.size}}
            </text>
          </block>
          <view class="goods-meta">
            <text wx:if="{{item.canShip}}">订购 {{item.qty}} 件</text>
            <text wx:if="{{item.shippedQty > 0 && item.canShip}}"> · 已发 {{item.shippedQty}} 件</text>
            <text wx:if="{{!item.canShip}}">已发 {{item.shippedQty}}/{{item.qty}} 件</text>
          </view>
        </view>

        <!-- 数量步进器 -->
        <view class="goods-stepper" wx:if="{{item.canShip && item.selected}}">
          <view class="step-btn minus" catchtap="decreaseQuantity" data-index="{{index}}">−</view>
          <view class="step-val">{{item.shipQty}}</view>
          <view class="step-btn plus" catchtap="increaseQuantity" data-index="{{index}}">+</view>
        </view>
        <view class="goods-stepper-placeholder" wx:if="{{item.canShip && !item.selected}}">
          <text class="unchecked-hint">待勾选</text>
        </view>
      </view>

      <view class="empty-hint" wx:if="{{items.length === 0}}">暂无商品数据</view>
    </view>
  </view>

  <!-- 底部提交栏 -->
  <view class="bottom">
    <view class="bottom-info">
      <text>已选 <text class="bottom-hl">{{selectedCount}}</text> 种 · 共 <text class="bottom-hl">{{totalShipQty}}</text> 件</text>
    </view>
    <button class="bottom-btn"
            bindtap="submitShipment"
            disabled="{{totalShipQty === 0 || isSubmitting || !expressNo}}">
      {{isSubmitting ? '提交中...' : '确认发货'}}
    </button>
  </view>
</view>
