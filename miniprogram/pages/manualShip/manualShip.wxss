/* miniprogram/pages/manualShip/manualShip.wxss */

page {
  background: #f2f2f7;
  font-size: 28rpx;
  color: #1a1a1a;
}

.page {
  padding: 24rpx 24rpx 140rpx;
}

/* ===== 卡片 ===== */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-hd {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.card-hd-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
}

.card-hd-actions {
  justify-content: space-between;
}

.card-hd-links text {
  font-size: 26rpx;
  color: #576b95;
  margin-left: 32rpx;
}

/* ===== 订单卡片 ===== */
.order-no {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.copy-link {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: #576b95;
  background: #eef3fb;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.recipient-block {
  background: #f8f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.recipient-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.recipient-line-head {
  justify-content: space-between;
  gap: 16rpx;
}

.recipient-user {
  min-width: 0;
}

.recipient-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.recipient-phone {
  font-size: 28rpx;
  color: #666;
  margin-left: 20rpx;
}

.recipient-addr {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

/* ===== 统计栏 ===== */
.stats-row {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-divider {
  width: 1rpx;
  background: #eee;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #333;
}

.stat-num.shipped { color: #2e7d32; }
.stat-num.pending { color: #e65100; }

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ===== 表单 ===== */
.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-of-type {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #555;
  flex-shrink: 0;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #111;
}

.form-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #111;
  min-width: 0;
}

.form-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.form-actions .copy-link {
  margin-left: 0;
}

.scan-link {
  background: #eef7ff;
  color: #2b5aad;
}

.form-hint {
  font-size: 24rpx;
  padding: 12rpx 0 0 140rpx;
  line-height: 1.5;
}

.form-hint.ok {
  color: #07c160;
}

.form-hint.warn {
  color: #fa5151;
}

/* ===== 商品列表 ===== */
.goods-list {
  margin-top: 4rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

/* 已发完 */
.goods-item.done {
  opacity: 0.45;
}

/* 勾选框 */
.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #d0d0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  transition: all 0.15s;
}

.check-box.on {
  border-color: #07c160;
  background: #07c160;
}

.check-box.off {
  border-color: #e0e0e0;
  background: #f5f5f5;
}

.check-mark {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
}

/* 图片 */
.goods-img-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.goods-img {
  width: 100%;
  height: 100%;
}

.goods-img-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-img-mask text {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

/* 信息 */
.goods-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.bundle-sub {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

.goods-meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}

/* 步进器 */
.goods-stepper {
  display: flex;
  align-items: center;
  border: 2rpx solid #e5e5e5;
  border-radius: 10rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  background: #f7f7f7;
}

.step-btn:active {
  background: #e8e8e8;
}

.step-val {
  width: 72rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
  background: #fff;
}

.goods-stepper-placeholder {
  flex-shrink: 0;
  margin-left: 12rpx;
  width: 120rpx;
  text-align: center;
}

.unchecked-hint {
  font-size: 22rpx;
  color: #bbb;
}

/* ===== 空状态 ===== */
.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  color: #bbb;
  font-size: 28rpx;
}

/* ===== 底部栏 ===== */
.bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.bottom-info {
  font-size: 26rpx;
  color: #888;
}

.bottom-hl {
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
}

.bottom-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  text-align: center;
  padding: 0;
  border: none;
}

.bottom-btn[disabled] {
  background: #c0c0c0;
  color: #fff;
}

.bottom-btn:active {
  opacity: 0.85;
}
