/* miniprogram/pages/manualShip/manualShip.wxss */

/* === 基础布局 === */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* === 卡片 === */
.card {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 20rpx;
}

/* === 订单信息 === */
.info-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 28rpx;
}

.info-row .label {
  width: 120rpx;
  color: #999;
  flex-shrink: 0;
}

.info-row .value {
  color: #333;
  flex: 1;
}

.address-text {
  line-height: 1.5;
}

/* === 统计栏 === */
.stats-bar {
  display: flex;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.stat-total {
  background: #f0f0f0;
}

.stat-shipped {
  background: #e8f5e9;
}

.stat-pending {
  background: #fff3e0;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-shipped .stat-num {
  color: #2e7d32;
}

.stat-pending .stat-num {
  color: #e65100;
}

/* === 快递表单 === */
.form-card {
  padding-bottom: 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  flex: 1;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 8rpx 0;
}

/* 自动检测提示 */
.detect-hint {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #2e7d32;
  padding: 8rpx 0 0 140rpx;
}

.detect-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  background: #2e7d32;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  margin-right: 8rpx;
}

/* 重复单号警告 */
.duplicate-warning {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  color: #e65100;
  padding: 8rpx 0 0 140rpx;
  line-height: 1.4;
}

.warn-icon {
  margin-right: 6rpx;
  flex-shrink: 0;
}

/* 检查中 */
.checking-hint {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0 0 140rpx;
}

/* === 商品列表 === */
.items-section {
  margin: 16rpx 24rpx;
}

.items-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.items-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.items-actions {
  display: flex;
  gap: 24rpx;
}

.action-link {
  font-size: 26rpx;
  color: #333;
  padding: 4rpx 12rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.item-card.shipped {
  opacity: 0.5;
}

.item-img-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.item-img {
  width: 100%;
  height: 100%;
}

.shipped-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.shipped-tag {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: #111;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.bundle-subs {
  margin-top: 4rpx;
}

.bundle-sub {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.item-qty-info {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.pending-text {
  color: #e65100;
}

.item-ctrl {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
  background: #f5f5f5;
  line-height: 1;
}

.step-num {
  width: 72rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #111;
  background: #fff;
}

.shipped-done {
  font-size: 24rpx;
  color: #999;
}

/* === 空状态 === */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* === 底部栏 === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 10;
}

.ship-summary {
  font-size: 28rpx;
  color: #666;
}

.highlight {
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
}

.btn-submit {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #111;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  text-align: center;
  padding: 0;
  border: none;
}

.btn-submit[disabled] {
  background: #ccc;
  color: #fff;
}
