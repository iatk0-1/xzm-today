<view class="page">
  <view class="card" wx:if="{{profile}}">
    <view class="profile-heading">
      <view class="title profile-name">{{profile.nickname || '未设置昵称'}}</view>
      <view class="active-control"><text>{{profile.active ? '上线' : '下线'}}</text><switch checked="{{activeChecked}}" disabled="{{busy}}" color="#1f2933" bindchange="toggleActive" /></view>
    </view>
    <view class="muted">{{profile.phone || '未绑定手机'}} · 负责人编号 {{userId}}</view>
  </view>
  <view class="assignment-overlay" wx:if="{{assignmentVisible}}" catchtap="closeAssignments" catchtouchmove="noop">
    <view class="assignment-dialog" catchtap="noop">
      <view class="title">分配新档口</view>
      <view class="muted">可多选，点击分配后立即保存</view>
      <view class="error" wx:if="{{error}}">{{error}}</view>
      <scroll-view class="assignment-options" scroll-y>
        <checkbox-group bindchange="assignmentChange">
          <label class="choice" wx:for="{{availableStalls}}" wx:key="id">
            <checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{busy}}" color="#1f2933" />{{item.name}}
          </label>
        </checkbox-group>
        <view class="assignment-empty" wx:if="{{!availableStalls.length}}">所有档口均已分配给该负责人</view>
      </scroll-view>
      <view class="assignment-actions">
        <button disabled="{{busy}}" bindtap="closeAssignments">取消</button>
        <button class="primary" disabled="{{busy || !newAssignmentIds.length}}" bindtap="addAssignments">{{busy ? '分配中...' : '分配所选档口'}}</button>
      </view>
    </view>
  </view>
  <view class="assignment-overlay" wx:if="{{receiverVisible}}" catchtap="closeReceiver" catchtouchmove="noop">
    <view class="assignment-dialog receiver-dialog" catchtap="noop">
      <view class="title">{{receiver.registered ? '变更分账接收关系' : '登记分账接收关系'}}</view>
      <scroll-view class="receiver-fields" scroll-y style="height: {{receiverRelationType === 'CUSTOM' ? '560rpx' : '460rpx'}};">
        <view class="muted">请核实负责人与商户的实际关系，收款身份使用负责人本人小程序登录身份。</view>
        <view class="error" wx:if="{{receiverError}}">{{receiverError}}</view>
        <picker disabled="{{busy}}" range="{{receiverTypes}}" range-key="label" value="{{receiverTypeIndex >= 0 ? receiverTypeIndex : 0}}" bindchange="receiverTypeChange">
          <view class="receiver-picker">{{receiverTypeLabel}}<text>›</text></view>
        </picker>
        <input wx:if="{{receiverRelationType === 'CUSTOM'}}" disabled="{{busy}}" placeholder="自定义实际关系（最多10个字符）" value="{{customRelation}}" data-field="customRelation" bindinput="input" />
        <textarea class="receiver-reason" disabled="{{busy}}" placeholder="关系核验依据（必填）" value="{{receiverReason}}" data-field="receiverReason" bindinput="input" />
        <view class="row receiver-verification"><switch disabled="{{busy}}" checked="{{receiverVerified}}" color="#1f2933" bindchange="receiverVerification" /><text>已核实本人实际关系</text></view>
      </scroll-view>
      <view class="assignment-actions">
        <button disabled="{{busy}}" bindtap="closeReceiver">取消</button>
        <button class="primary" disabled="{{busy}}" bindtap="saveReceiver">{{busy ? '保存中...' : '确认保存'}}</button>
      </view>
    </view>
  </view>
  <view class="assignment-overlay" wx:if="{{commissionEdit}}" catchtap="closeCommission" catchtouchmove="noop">
    <view class="assignment-dialog" catchtap="noop">
      <view class="title">修改每件佣金</view>
      <view class="commission-edit-name">{{commissionEdit.name}}</view>
      <view class="error" wx:if="{{commissionError}}">{{commissionError}}</view>
      <input type="digit" disabled="{{busy}}" placeholder="每件佣金（元，允许0）" value="{{singleCommission}}" data-field="singleCommission" bindinput="input" bindconfirm="saveSingleCommission" />
      <view class="muted">全部SKU统一，仅影响后续下单。单独修改后使用固定金额，下次全局配置生效时统一覆盖。</view>
      <view class="assignment-actions">
        <button disabled="{{busy}}" bindtap="closeCommission">取消</button>
        <button class="primary" disabled="{{busy}}" bindtap="saveSingleCommission">{{busy ? '保存中...' : '确认保存'}}</button>
      </view>
    </view>
  </view>
  <scroll-view class="tabs" scroll-x scroll-with-animation scroll-into-view="manager-tab-{{tab}}">
    <view id="manager-tab-profile" class="tab {{tab === 'profile' ? 'active' : ''}}" data-tab="profile" bindtap="changeTab">档口与状态</view>
    <view id="manager-tab-products" class="tab {{tab === 'products' ? 'active' : ''}}" data-tab="products" bindtap="changeTab">商品佣金</view>
    <view id="manager-tab-records" class="tab {{tab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="changeTab">收入与线下付款</view>
    <view id="manager-tab-history" class="tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="changeTab">历史核对</view>
    <view id="manager-tab-settlements" class="tab {{tab === 'settlements' ? 'active' : ''}}" data-tab="settlements" bindtap="changeTab">线下付款记录</view>
    <view id="manager-tab-withdrawals" class="tab {{tab === 'withdrawals' ? 'active' : ''}}" data-tab="withdrawals" bindtap="changeTab">历史商家转账</view>
    <view id="manager-tab-requests" class="tab {{tab === 'requests' ? 'active' : ''}}" data-tab="requests" bindtap="changeTab">提现申请记录</view>
    <view id="manager-tab-sharing" class="tab {{tab === 'sharing' ? 'active' : ''}}" data-tab="sharing" bindtap="changeTab">微信分账</view>
    <view id="manager-tab-audit" class="tab {{tab === 'audit' ? 'active' : ''}}" data-tab="audit" bindtap="changeTab">财务审计</view>
  </scroll-view>
  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="card" wx:if="{{tab === 'profile'}}">
    <view class="section-heading">
      <view class="title">已分配档口</view>
      <button class="assign-add" disabled="{{busy || !profile}}" bindtap="openAssignments" aria-label="分配新档口">＋</button>
    </view>
    <view class="muted assignment-hint">展示本负责人创建的商品，分配和移除后自动保存。</view>
    <view class="assignment-empty" wx:if="{{!assignedStalls.length}}">暂无已分配档口，点击右上角＋分配</view>
    <view class="assigned-stall" wx:for="{{assignedStalls}}" wx:key="id" bindtap="openStall" data-id="{{item.id}}">
      <view class="stall-heading">
        <view class="stall-name">{{item.name}}</view>
        <button class="assignment-remove" disabled="{{busy}}" catchtap="removeAssignment" data-id="{{item.id}}" aria-label="移除档口分配">删除</button>
      </view>
      <view class="muted" wx:if="{{item.previewLoading}}">商品加载中...</view>
      <view class="muted" wx:elif="{{item.previewError}}">商品预览加载失败，点击档口查看</view>
      <block wx:else>
        <view class="stall-meta">本负责人创建 {{item.productCount}} 件商品 <text class="stall-enter">查看全部 ›</text></view>
        <view class="stall-previews" wx:if="{{item.previewProducts.length}}">
          <view class="stall-preview" wx:for="{{item.previewProducts}}" wx:for-item="product" wx:key="productId" catchtap="openProduct" data-id="{{product.productId}}">
            <image class="preview-image" src="{{product.coverUrl || '/images/default-goods-image.png'}}" mode="aspectFill" />
            <view class="preview-name">{{product.name}}</view>
          </view>
        </view>
        <view class="muted" wx:else>该负责人暂未在此档口创建商品</view>
      </block>
    </view>
    <view class="payment-label">操作备注（选填）</view>
    <textarea class="compact-textarea" placeholder="补充分配或上下线操作说明" value="{{reason}}" maxlength="1000" data-field="reason" bindinput="input" />
    <view class="muted">下线期间新订单不计佣；历史佣金继续完成结算，已完成订单可按原微信交易分账提现。</view>
    <view class="receiver-summary">
      <view class="receiver-title">分账接收关系</view>
      <button class="receiver-action {{receiver.registered ? 'registered' : ''}}" disabled="{{busy}}" bindtap="openReceiver">{{receiverSummary}}<text class="receiver-arrow">›</text></button>
    </view>
  </view>

  <view wx:if="{{tab === 'products'}}">
    <view class="card commission-panel">
      <view class="commission-search">
        <input disabled="{{busy}}" placeholder="搜索商品名称" value="{{keyword}}" data-field="keyword" bindinput="input" bindconfirm="search" />
        <button class="primary" disabled="{{busy}}" bindtap="search">搜索</button>
      </view>
      <view class="commission-filters">
        <picker disabled="{{busy}}" range="{{stallOptions}}" range-key="label" value="{{stallFilterIndex}}" data-filter="stall" bindchange="changeProductFilter"><view class="commission-filter">{{stallOptions[stallFilterIndex].label}}<text>⌄</text></view></picker>
        <picker disabled="{{busy}}" range="{{tagOptions}}" range-key="label" value="{{tagFilterIndex}}" data-filter="tag" bindchange="changeProductFilter"><view class="commission-filter">{{tagOptions[tagFilterIndex].label}}<text>⌄</text></view></picker>
        <picker disabled="{{busy}}" range="{{statusOptions}}" range-key="label" value="{{statusFilterIndex}}" data-filter="status" bindchange="changeProductFilter"><view class="commission-filter">{{statusOptions[statusFilterIndex].label}}<text>⌄</text></view></picker>
        <picker disabled="{{busy}}" range="{{commissionOptions}}" range-key="label" value="{{commissionFilterIndex}}" data-filter="commission" bindchange="changeProductFilter"><view class="commission-filter">{{commissionOptions[commissionFilterIndex].label}}<text>⌄</text></view></picker>
      </view>
      <view class="commission-selection">
        <text>已选 {{selectedProducts.length}} 件 · 共 {{totalElements}} 件</text>
        <button disabled="{{busy || listLoading || !totalElements}}" bindtap="selectFiltered">{{allProductsSelected ? '取消全选' : '全选'}}</button>
      </view>
      <view class="commission-batch">
        <input type="digit" disabled="{{busy}}" placeholder="每件佣金（元，允许0）" value="{{unitCommission}}" data-field="unitCommission" bindinput="input" />
        <button class="primary" disabled="{{busy || !selectedProducts.length}}" bindtap="setCommission">批量设置佣金</button>
      </view>
    </view>
    <checkbox-group bindchange="productChange">
      <view class="card commission-product" wx:for="{{rows}}" wx:key="productId">
        <view class="commission-product-top" bindtap="openProduct" data-id="{{item.productId}}">
          <view class="commission-product-main">
            <label catchtap="noop"><checkbox value="{{item.productId}}" checked="{{item.selected}}" disabled="{{busy}}" color="#1f2933" /></label>
            <image class="commission-cover" src="{{item.coverUrl || '/images/default-goods-image.png'}}" mode="aspectFill" />
            <view class="commission-product-info">
              <view class="commission-product-name">{{item.name}}</view>
              <view class="commission-stall">{{item.stallName || '未设置档口'}}</view>
              <view class="commission-statuses"><text class="commission-status {{item.status === 'on' ? 'on' : 'off'}}">{{item.status === 'on' ? '上架' : '下架'}}</text><text class="commission-status sold-out" wx:if="{{item.soldOut}}">售罄</text></view>
            </view>
          </view>
        </view>
        <view class="commission-product-bottom">
          <text>每件佣金</text>
          <button class="commission-amount" disabled="{{busy}}" bindtap="editCommission" data-id="{{item.productId}}">{{item.profitPercent != null ? '利润的 ' + item.profitPercent + '%' : (item.unitCommission == null ? '未配置' : '¥' + item.unitCommission)}}<text class="commission-edit-label">修改 ›</text></button>
        </view>
      </view>
    </checkbox-group>
  </view>

  <view wx:if="{{tab === 'records' || tab === 'sharing' || tab === 'eligibility'}}" class="card">
    <view class="section-heading"><view class="title">收入账户</view><button class="text-button" bindtap="toggleIncomeDetails">{{incomeDetailsVisible ? '收起详情' : '账户详情'}} ⌄</button></view>
    <view class="grid income-grid">
      <view><view class="label">待完成佣金</view><view class="metric">¥{{income.pendingIncome || '0.00'}}</view></view>
      <view><view class="label">累计完成佣金</view><view class="metric">¥{{income.completedIncome || '0.00'}}</view></view>
      <view><view class="label">微信可提现</view><view class="metric">¥{{income.manualWithdrawalAvailable || '0.00'}}</view></view>
      <view><view class="label">线下可结算</view><view class="metric">¥{{income.settleableIncome || '0.00'}}</view></view>
    </view>
    <view class="muted" wx:if="{{income.debtAmount > 0}}">待抵扣退款欠款 ¥{{income.debtAmount}}，后续收入先抵扣。</view>
    <view class="error" wx:if="{{!income.profitSharingEnabled}}">分账提现功能未开启，已有佣金和分账单仍可查询。</view>
    <view wx:if="{{incomeDetailsVisible}}" class="income-details">
      <view class="detail-line"><text>预计收入</text><text>¥{{income.estimatedIncome || '0.00'}}</text></view>
      <view class="detail-line"><text>线下累计已付</text><text>¥{{income.offlineSettled || '0.00'}}</text></view>
      <view class="detail-line"><text>历史商家转账已付 / 占用</text><text>¥{{income.legacyTransferSettled || '0.00'}} / ¥{{income.legacyTransferHeld || '0.00'}}</text></view>
      <view class="detail-line"><text>微信分账已付 / 占用</text><text>¥{{income.profitSharingSettled || '0.00'}} / ¥{{income.profitSharingHeld || '0.00'}}</text></view>
      <view class="detail-line"><text>售后暂缓</text><text>¥{{income.afterSaleFrozen || '0.00'}}</text></view>
      <view class="detail-line"><text>暂不符合微信提现条件</text><text>¥{{income.profitSharingUnavailable || '0.00'}}</text></view>
      <view class="muted">微信提现可由管理员选单办理；负责人自助提现需管理员开启权限。历史非分账订单、过期或模拟支付订单，可核对后登记线下付款。</view>
      <view class="muted" wx:for="{{income.profitSharingReasons}}" wx:key="orderId">订单 {{item.orderId}}：{{item.reason}}</view>
    </view>
  </view>

  <view wx:if="{{tab === 'records'}}">
    <view class="card">
      <view class="title">佣金付款与提现</view>
      <view class="self-withdrawal-control"><view><view>允许负责人自助提现</view><view class="muted">{{income.selfWithdrawalEnabled === true ? '已开启，负责人可自行申请' : '已关闭，由管理员办理提现'}}</view></view><switch checked="{{selfWithdrawalChecked}}" disabled="{{busy}}" color="#1f2933" bindchange="toggleSelfWithdrawal" /></view>
      <view class="muted">默认关闭；开关只控制新申请，已提交的提现继续处理。</view>
      <view class="payment-entry-actions"><button class="primary" disabled="{{busy}}" data-mode="OFFLINE" bindtap="openSettlement">登记线下付款</button><button disabled="{{busy || !income.profitSharingEnabled || pendingAdminRequest}}" data-mode="WECHAT" bindtap="openSettlement">微信分账提现</button></view>
    </view>
    <view class="card">
      <view class="title">佣金明细</view>
      <view class="record-toolbar">
        <picker disabled="{{busy}}" range="{{recordStatusOptions}}" range-key="label" value="{{recordStatusIndex}}" bindchange="recordStatusChange"><view class="payment-picker">{{recordStatusOptions[recordStatusIndex].label}}<text>⌄</text></view></picker>
        <button disabled="{{busy || listLoading}}" bindtap="refreshRecords">更新收入与明细</button>
      </view>
      <view class="muted record-hint">下方为全部佣金明细；点击上方付款或分账按钮选择可结算订单，待处理售后订单不纳入选单列表。</view>
    </view>
    <view class="card order-card" wx:for="{{rows}}" wx:key="id">
      <view class="order-heading" bindtap="openOrder" data-id="{{item.orderId}}"><text>订单 {{item.orderNo || item.orderId}}</text><text class="link-text">订单详情 ›</text></view>
      <view class="order-product">
        <image class="order-cover" src="{{item.productImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
        <view class="order-product-info"><view class="order-product-name">{{item.productName}}</view><view class="muted">{{item.specLabel}}</view><view class="order-price">¥{{item.salePriceLabel}} × {{item.itemQty || item.qty}} 件</view><view class="bundle-note" wx:if="{{item.bundleLabel}}">{{item.bundleLabel}}</view></view>
      </view>
      <view class="detail-line"><text>下单时间</text><text>{{item.orderedTime}}</text></view>
      <view class="detail-line"><text>佣金状态</text><text>{{item.status === 'SETTLED' ? '已结算' : (item.status === 'COMPLETED' ? '已完成' : '待完成')}}</text></view>
      <view class="money-summary"><view>{{item.isBundle ? '每套佣金' : '每件佣金'}}<text>¥{{item.unitCommissionLabel}}</text></view><view>有效佣金<text>¥{{item.commissionLabel}}</text></view><view>累计已付<text>¥{{item.settledAmount}}</text></view><view>可线下结算<text>¥{{item.availableSettlement || '0.00'}}</text></view></view>
      <view class="muted" wx:if="{{item.afterSaleFrozen > 0}}">售后暂缓 ¥{{item.afterSaleFrozen}}</view>
      <view class="muted" wx:if="{{item.debtOffsetAmount > 0}}">退款欠款抵扣 ¥{{item.debtOffsetAmount}}</view>
      <view class="muted" wx:if="{{item.debtRecoveredAmount > 0}}">旧佣金欠款已追回 ¥{{item.debtRecoveredAmount}}（抵扣后续佣金）</view>
    </view>

  </view>

  <view wx:if="{{tab === 'history'}}">
    <view class="card">
      <view class="section-heading"><view class="title">历史订单核对</view><text class="muted">共 {{totalElements}} 条明细</text></view>
      <view class="muted record-hint">仅展示本负责人创建商品的历史已付款订单。确认应付佣金后，实际付款在“收入与线下付款”登记。</view>
      <picker disabled="{{busy}}" range="{{historyStatusOptions}}" range-key="label" value="{{historyStatusIndex}}" bindchange="historyStatusChange"><view class="payment-picker history-filter">{{historyStatusOptions[historyStatusIndex].label}}<text>⌄</text></view></picker>
    </view>
    <view class="card order-card" wx:for="{{rows}}" wx:key="orderItemId">
      <view class="order-heading" bindtap="openOrder" data-id="{{item.orderId}}"><text>订单 {{item.orderNo || item.orderId}}</text><text class="link-text">订单详情 ›</text></view>
      <view class="order-product" bindtap="openProduct" data-id="{{item.productId}}">
        <image class="order-cover" src="{{item.productImage || '/images/default-goods-image.png'}}" mode="aspectFill" />
        <view class="order-product-info"><view class="order-product-name">{{item.productName}}</view><view class="muted">{{item.specLabel}}</view><view class="bundle-note" wx:if="{{item.bundleLabel}}">{{item.bundleLabel}}</view><view class="order-price">¥{{item.salePriceLabel}} × {{item.qty}} {{item.isBundle ? '件子商品' : '件'}}<text>明细 ¥{{item.lineAmountLabel}}</text></view></view>
      </view>
      <view class="detail-line"><text>所属档口</text><text>{{item.stallName || '档口未记录'}}</text></view>
      <view class="detail-line"><text>下单时间</text><text>{{item.orderedTime}}</text></view>
      <view class="person-line"><text class="detail-label">下单买家</text><image wx:if="{{item.buyerAvatar}}" class="person-avatar" src="{{item.buyerAvatar}}" mode="aspectFill" /><view class="person-name">{{item.buyerName}}<text wx:if="{{item.buyerPhone && item.buyerPhone !== item.buyerName}}"> · {{item.buyerPhone}}</text></view></view>
      <view class="person-line"><text class="detail-label">商品创建人</text><image wx:if="{{item.creatorAvatar}}" class="person-avatar" src="{{item.creatorAvatar}}" mode="aspectFill" /><view class="person-name">{{item.creatorName === '未设置昵称' ? (profile.nickname || item.creatorName) : item.creatorName}}<text wx:if="{{item.creatorPhone && item.creatorPhone !== item.creatorName}}"> · {{item.creatorPhone}}</text></view></view>
      <view class="detail-line"><text>订单实付</text><text>¥{{item.orderPayLabel}}</text></view>
      <view class="detail-line"><text>订单状态</text><text>{{item.orderStatusLabel}}</text></view>
      <view class="detail-line"><text>售后情况</text><text class="{{item.afterSaleStatus ? 'after-sale-text' : ''}}">{{item.afterSaleLabel}}<text wx:if="{{item.refundedAmount > 0}}"> · 退款 ¥{{item.refundedLabel}}</text></text></view>
      <view class="muted" wx:if="{{item.remark}}">订单备注：{{item.remark}}</view>
      <view class="order-ids">订单编号 {{item.orderId}} · 明细 {{item.orderItemId}}</view>
      <view class="card-actions"><view class="history-state {{item.status === 'UNCONFIRMED' ? 'pending' : ''}}">{{item.historyStatusLabel}}<text wx:if="{{item.status !== 'UNCONFIRMED' && item.status !== 'EXCLUDED'}}"> · ¥{{item.commissionLabel}}</text></view><button class="primary small-button" wx:if="{{item.status === 'UNCONFIRMED'}}" disabled="{{busy}}" data-index="{{index}}" bindtap="openHistory">核对并确认</button></view>
    </view>
  </view>

  <view wx:if="{{tab === 'settlements'}}">
    <view class="card"><view class="title">线下付款记录</view><view class="muted">查看已登记付款的时间、凭证及对应佣金明细。登记有误时可冲正，原记录仍保留；冲正只撤销登记，不会退回已付的钱。</view></view>
    <view class="card" wx:for="{{rows}}" wx:key="id">
      <view class="section-heading"><view class="amount">¥{{item.amountLabel}}</view><text class="status-tag {{item.reversed ? 'invalid' : ''}}">{{item.reversed ? '已冲正' : '有效付款'}}</text></view>
      <view class="detail-line"><text>付款方式</text><text>{{item.paymentMethod || '未记录'}}</text></view>
      <view class="detail-line"><text>实际付款时间</text><text>{{item.paidTimeLabel}}</text></view>
      <view class="detail-line"><text>登记人</text><text>{{item.operatorName}}</text></view>
      <view class="detail-line"><text>登记时间</text><text>{{item.createdTime}}</text></view>
      <view class="evidence-box"><view class="payment-label">付款凭证</view><view>{{item.voucher || '未记录'}}</view><view class="voucher-images"><image wx:for="{{item.voucherImages}}" wx:for-item="voucherImage" wx:for-index="voucherIndex" wx:key="*this" src="{{voucherImage}}" mode="aspectFill" data-index="{{voucherIndex}}" data-saved="{{true}}" data-urls="{{item.voucherImages}}" bindtap="previewVoucherImage" /></view></view>
      <view class="muted record-hint" wx:if="{{item.reasonLabel}}">备注：{{item.reasonLabel}}</view>
      <view class="card-actions"><button class="text-button" data-id="{{item.id}}" disabled="{{item.detailsLoading}}" bindtap="toggleSettlementDetails">{{item.detailsLoading ? '加载中...' : (item.detailsVisible ? '收起付款明细' : '查看付款明细')}}（{{item.allocationCount || 0}}）</button><button class="text-button danger" wx:if="{{!item.reversed}}" disabled="{{busy}}" data-id="{{item.id}}" bindtap="openReverseSettlement">冲正错误登记</button></view>
      <view wx:if="{{item.detailsVisible}}" class="settlement-details"><view class="settlement-item" wx:for="{{item.allocationRows}}" wx:for-item="allocation" wx:key="id" bindtap="openOrder" data-id="{{allocation.orderId}}"><view class="section-heading"><text>{{allocation.productName}}</text><text>¥{{allocation.amountLabel}}</text></view><view class="muted">{{allocation.specLabel}} · {{allocation.qty}} 件</view><view class="muted">订单 {{allocation.orderNo || allocation.orderId}} · {{allocation.active ? '有效分配' : '已撤销分配'}} <text class="link-text">详情 ›</text></view></view><view class="muted" wx:if="{{!item.allocationRows.length}}">暂无关联佣金明细</view></view>
    </view>
  </view>

  <view class="card" wx:if="{{tab === 'records' && pendingAdminRequest}}">
    <view class="title">原提现申请待核对</view><view class="muted">已保存 {{pendingAdminRequest.orderIds.length}} 笔订单，处理完原申请后才能发起新申请。</view>
    <view class="muted">{{adminRequestUncertain ? '提交结果暂不确定，请查询原申请' : '继续跟踪原申请，避免重复付款'}}</view>
    <button disabled="{{busy}}" bindtap="queryAdminWithdrawal">查询原申请</button>
    <button wx:if="{{adminRequestMissing}}" disabled="{{busy}}" bindtap="withdrawSelectedOrders">按原订单范围重试原申请</button>
    <button wx:if="{{adminRequestMissing && pendingAdminRequest.rejected}}" disabled="{{busy}}" bindtap="clearMissingAdminWithdrawal">确认未创建后重新选单</button>
  </view>
  <view class="card" wx:if="{{(tab === 'records' || tab === 'requests') && currentWithdrawal}}">
    <view class="title">提现申请 {{currentWithdrawal.id}} · {{currentWithdrawal.statusLabel}}</view>
    <view class="muted">{{currentWithdrawal.sourceLabel}} · 申请时间 {{currentWithdrawal.requestedTime}}</view>
    <view>申请 ¥{{currentWithdrawal.requestedAmount}} · 已到账 ¥{{currentWithdrawal.settledAmount}} · 处理中 ¥{{currentWithdrawal.heldAmount}}</view>
    <view class="withdrawal-request-item" wx:for="{{currentWithdrawal.items}}" wx:key="id"><view>订单 {{item.orderNo || item.orderId}} · {{item.statusLabel}}</view><view class="muted">申请 ¥{{item.snapshotAmount}} · 已到账 ¥{{item.settledAmount}} · {{item.reason || '等待处理结果'}}</view><view class="muted">分账截止 {{item.deadlineLabel}}</view></view>
    <button disabled="{{busy}}" bindtap="queryAdminWithdrawal" data-id="{{currentWithdrawal.id}}">刷新该申请结果</button>
  </view>
  <view wx:if="{{tab === 'requests'}}">
    <view class="card" wx:for="{{rows}}" wx:key="id"><view class="title">¥{{item.requestedAmount}} · {{item.statusLabel}}</view><view class="muted">{{item.sourceLabel}} · 申请时间 {{item.requestedTime}}</view><view>已到账 ¥{{item.settledAmount}} · 处理中 ¥{{item.heldAmount}}</view><button disabled="{{busy}}" data-id="{{item.id}}" bindtap="queryAdminWithdrawal">查看订单及到账结果</button></view>
  </view>
  <view wx:if="{{tab === 'sharing'}}" class="card" wx:for="{{rows}}" wx:key="id">
    <view>¥{{item.amount}} · {{item.statusLabel}}</view>
    <view class="muted">订单 {{item.orderId}} · 微信支付交易 {{item.transactionId}}</view>
    <view class="muted">分账单 {{item.outOrderNo}} · 接收结果 {{item.receiverResultLabel}}</view>
    <view class="muted">{{item.updatedTime}} · {{item.reasonLabel}}</view>
    <button disabled="{{busy}}" data-id="{{item.id}}" bindtap="querySharing">查询原分账单</button>
    <button wx:if="{{item.status !== 'SUCCESS' && item.status !== 'CLOSED'}}" disabled="{{busy}}" data-id="{{item.id}}" data-channel="PROFIT_SHARING" bindtap="openReconciliation">原交易分账账单人工核验</button>
  </view>

  <view wx:if="{{tab === 'withdrawals'}}">
    <view class="card muted">异常原单先核对微信商户账单。只有确定已付款或确定未付款才能人工关闭，不能因超时或查不到直接释放。</view>
    <view class="card" wx:for="{{rows}}" wx:key="id">
      <view>¥{{item.amount}} · {{item.statusLabel}}</view>
      <view class="muted">{{item.createdTime}} · {{item.reasonLabel}}</view>
      <button wx:if="{{item.status !== 'SUCCESS' && item.status !== 'FAIL' && item.status !== 'CANCELLED'}}" data-id="{{item.id}}" bindtap="openReconciliation">商户账单人工核验</button>
    </view>
  </view>

  <view wx:if="{{tab === 'audit'}}">
    <view class="card"><view class="title">财务审计</view><view class="muted">记录佣金设置、历史核对、付款登记、冲正及微信到账结果，方便追查每次资金变化。</view></view>
    <view class="card audit-card" wx:for="{{rows}}" wx:key="id">
      <view class="section-heading"><view class="audit-title">{{item.actionLabel}}</view><text class="audit-amount" wx:if="{{item.amount != null}}">¥{{item.amountLabel}}</text></view>
      <view class="audit-reason">{{item.reasonLabel || '未填写说明'}}</view>
      <view class="detail-line"><text>操作人</text><text>{{item.operatorName}}</text></view>
      <view class="detail-line"><text>操作时间</text><text>{{item.createdTime}}</text></view>
      <view class="order-ids" wx:if="{{item.referenceId}}">关联业务编号 {{item.referenceId}}</view>
    </view>
  </view>
  <view class="muted" wx:if="{{tab !== 'profile'}}">{{listLoading ? '加载中...' : (rows.length ? (hasNext ? '上拉加载更多' : '已加载全部') : '暂无记录')}}</view>


  <view class="overlay" wx:if="{{paymentVisible}}" catchtouchmove="noop">
    <view class="settlement-dialog">
      <view class="settlement-dialog-header"><view class="title">{{settlementMode === 'OFFLINE' ? '登记线下付款' : '微信分账提现'}}</view><button disabled="{{busy}}" class="settlement-dialog-close" bindtap="closeSettlement" aria-label="关闭弹窗">×</button></view>
      <scroll-view class="settlement-dialog-body" scroll-y bindscrolltolower="loadMoreSettlementOrders">
        <view class="error" wx:if="{{error}}">{{error}}</view>
        <view class="muted">只选择已完成、无待处理售后的订单，单次最多100笔。{{settlementMode === 'WECHAT' ? '微信剩余分账额度核验通过才能勾选，提交时会再核对。' : '仅登记已实际支付的款项，系统不会转账。'}}</view>
        <view class="payment-time-row"><picker mode="date" disabled="{{busy || settlementLoading}}" value="{{settlementStartDate}}" data-field="settlementStartDate" bindchange="settlementFilterChange"><view class="payment-picker">{{settlementStartDate || '下单开始日期'}}</view></picker><picker mode="date" disabled="{{busy || settlementLoading}}" value="{{settlementEndDate}}" data-field="settlementEndDate" bindchange="settlementFilterChange"><view class="payment-picker">{{settlementEndDate || '下单结束日期'}}</view></picker></view>
        <picker wx:if="{{settlementStallOptions.length > 2}}" disabled="{{busy || settlementLoading}}" range="{{settlementStallOptions}}" range-key="label" value="{{settlementStallIndex}}" data-field="settlementStallIndex" bindchange="settlementFilterChange"><view class="payment-picker">{{settlementStallOptions[settlementStallIndex].label}}</view></picker>
        <input disabled="{{busy || settlementLoading}}" placeholder="商品名称关键词" value="{{settlementKeyword}}" data-field="settlementKeyword" bindinput="settlementFilterChange" bindconfirm="filterSettlementOrders" />
        <view class="payment-entry-actions"><button disabled="{{busy || settlementLoading}}" bindtap="filterSettlementOrders">筛选订单</button><button disabled="{{busy || settlementLoading}}" bindtap="resetSettlementFilters">重置筛选</button></view>
        <view class="withdrawal-selection"><text>已选 {{selectedOrders.length}} 笔 · ¥{{selectedWithdrawalTotal}}</text><button disabled="{{busy || settlementLoading}}" bindtap="selectWithdrawalOrders">{{selectedOrders.length ? '清空选择' : '全选已加载可结算订单'}}</button></view>
        <checkbox-group bindchange="withdrawalOrderChange">
          <view class="settlement-order" wx:for="{{settlementRows}}" wx:key="orderId">
            <label class="withdrawal-order-heading"><checkbox value="{{item.orderId}}" checked="{{item.selected}}" disabled="{{busy || settlementLoading || !item.eligible}}" color="#1f2933" /><text>订单 {{item.orderNo || item.orderId}}</text><text class="status-tag">{{item.orderStatusLabel}} · {{item.settlementStatus}}</text></label>
            <view class="settlement-refund-tag" wx:if="{{item.hasRefundedItems}}">含已退款商品 · 佣金已扣除退款部分</view>
            <view class="withdrawal-product" wx:for="{{item.items}}" wx:for-item="product" wx:for-index="detailIndex" wx:key="orderItemId"><image wx:if="{{product.productImage}}" class="withdrawal-product-image" src="{{product.productImage}}" mode="aspectFill" data-index="{{index}}" data-detail-index="{{detailIndex}}" binderror="settlementProductImageError" /><view wx:else class="withdrawal-product-image withdrawal-image-placeholder">暂无图片</view><view class="withdrawal-product-info"><view>{{product.productName}}</view><view class="muted">{{product.specLabel}} · 原购买 {{product.originalQty}} 件</view><view class="settlement-refund-note" wx:if="{{product.hasRefund}}">{{product.refundLabel}}<text wx:if="{{product.refundedAmount > 0}}"> · 退款 ¥{{product.refundedAmountLabel}}</text></view><view class="muted" wx:if="{{product.remainingQty != null}}">剩余计佣数量 {{product.remainingQty}} 件</view><view class="muted">{{product.stallName || '档口未记录'}}</view><view class="muted" wx:if="{{product.bundleLabel}}">{{product.bundleLabel}}</view></view></view>
            <view>本单可结算佣金 ¥{{item.availableAmount}}</view><view class="muted">下单时间 {{item.orderedTime}}</view><view class="muted" wx:if="{{settlementMode === 'WECHAT'}}">分账截止 {{item.deadlineLabel}}</view><view class="error" wx:if="{{item.blockedReason}}">{{item.blockedReason}}</view>
          </view>
        </checkbox-group>
        <view class="muted">{{settlementLoading ? '加载并核验订单中...' : (settlementRows.length ? (settlementHasNext ? '上拉加载更多' : '已加载全部') : '没有符合筛选条件的可结算订单')}}</view>
        <button wx:if="{{settlementHasNext}}" disabled="{{busy || settlementLoading}}" bindtap="loadMoreSettlementOrders">加载更多订单</button>
    <view class="card" wx:if="{{settlementMode === 'OFFLINE'}}">
      <view class="title">登记线下付款 · ¥{{selectedWithdrawalTotal}}</view>
      <view class="muted">金额由所选订单佣金自动合计。这里只登记已付款记录，系统不会转账。</view>
      <view class="payment-label">实际付款时间（北京时间）</view>
      <view class="payment-time-row">
        <picker mode="date" disabled="{{busy}}" value="{{paidDate || paidDateEnd}}" end="{{paidDateEnd}}" data-field="paidDate" bindchange="paymentTimeChange"><view class="payment-picker {{!paidDate ? 'placeholder' : ''}}">{{paidDate || '选择日期'}}<text>⌄</text></view></picker>
        <picker mode="time" disabled="{{busy}}" value="{{paidTime || '00:00'}}" data-field="paidTime" bindchange="paymentTimeChange"><view class="payment-picker {{!paidTime ? 'placeholder' : ''}}">{{paidTime || '选择时间'}}<text>⌄</text></view></picker>
      </view>
      <view class="payment-label">付款方式</view>
      <picker disabled="{{busy}}" range="{{paymentMethods}}" value="{{paymentMethodIndex >= 0 ? paymentMethodIndex : 0}}" bindchange="paymentMethodChange"><view class="payment-picker {{paymentMethodIndex < 0 ? 'placeholder' : ''}}">{{paymentMethodIndex < 0 ? '选择付款方式' : paymentMethods[paymentMethodIndex]}}<text>⌄</text></view></picker>
      <input wx:if="{{paymentMethodIndex === 4}}" disabled="{{busy}}" placeholder="填写其他付款方式" value="{{paymentMethod}}" data-field="paymentMethod" bindinput="input" />
      <view class="payment-label">付款凭证（必填）</view>
      <textarea class="payment-voucher" disabled="{{busy}}" placeholder="填写转账流水号，或现金收款确认等凭证说明" value="{{voucher}}" data-field="voucher" bindinput="input" />
      <view class="payment-label">付款凭证图片（选填，最多9张）</view>
      <view class="voucher-images"><view class="voucher-image-item" wx:for="{{voucherImages}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewVoucherImage" /><button disabled="{{busy}}" data-index="{{index}}" bindtap="removeVoucherImage">移除</button></view></view>
      <button disabled="{{busy || voucherImages.length >= 9}}" bindtap="uploadVoucherImages">上传凭证图片</button>
      <view class="payment-note-toggle" bindtap="toggleSettlementNote">{{settlementNoteVisible ? '收起备注' : '添加备注（选填）'}}</view>
      <textarea wx:if="{{settlementNoteVisible}}" class="payment-voucher" disabled="{{busy}}" placeholder="补充本次付款说明（选填）" value="{{settlementReason}}" data-field="settlementReason" bindinput="input" />
      <button class="primary" disabled="{{busy || !selectedOrders.length || settlementLoading}}" bindtap="settleOffline">确认已付款并登记</button>
    </view>
        <button wx:if="{{settlementMode === 'WECHAT'}}" class="primary" disabled="{{busy || settlementLoading || !selectedOrders.length || pendingAdminRequest}}" bindtap="withdrawSelectedOrders">确认向该负责人分账 ¥{{selectedWithdrawalTotal}}</button>
      </scroll-view>
    </view>
  </view>

  <view class="overlay" wx:if="{{historyForm}}" catchtouchmove="noop">
    <scroll-view class="modal" scroll-y>
      <view class="title">历史订单核对</view>
      <view class="error" wx:if="{{error}}">{{error}}</view>
      <view class="order-product-name">{{historyForm.productName}}</view><view class="muted">{{historyForm.specLabel}} · {{historyForm.qty}} 件</view><view class="muted">下单 {{historyForm.orderedTime}}</view>
      <view class="detail-line"><text>创建归属</text><text>{{profile.nickname || historyForm.creatorName}}（本负责人）</text></view>
      <view class="row history-switch"><text>计入应付佣金</text><switch disabled="{{busy}}" checked="{{historyForm.eligible}}" color="#1f2933" bindchange="historyEligible" /></view>
      <view wx:if="{{historyForm.eligible}}">
        <view class="payment-label">历史{{historyForm.isBundle ? '每套' : '每件'}}佣金（元）</view><input disabled="{{busy}}" type="digit" placeholder="根据历史约定填写，允许0" value="{{historyForm.unitCommission}}" data-field="unitCommission" bindinput="historyInput" />
        <view class="evidence-box muted" wx:if="{{historyForm.hasAppointmentEvidence}}">系统已记录下单时的档口分配与上线状态，无需重复填写任职时间。</view>
        <view wx:else class="evidence-box"><view class="payment-label">补充历史任职依据（北京时间）</view><view class="muted">系统缺少下单时的任职记录，请按凭证选择实际区间。结束时间留空表示当时仍有效。</view>
          <view wx:for="{{historyForm.evidencePeriods}}" wx:for-item="period" wx:key="field"><view class="period-label"><text>{{period.label}}{{period.optional ? '（选填）' : '（必填）'}}</text><text class="link-text" wx:if="{{period.optional && (period.date || period.time)}}" data-index="{{index}}" bindtap="clearHistoryPeriod">清空</text></view><view class="payment-time-row"><picker mode="date" disabled="{{busy}}" value="{{period.date}}" data-index="{{index}}" data-part="date" bindchange="historyPeriodChange"><view class="payment-picker {{!period.date ? 'placeholder' : ''}}">{{period.date || '选择日期'}}<text>⌄</text></view></picker><picker mode="time" disabled="{{busy}}" value="{{period.time || '00:00'}}" data-index="{{index}}" data-part="time" bindchange="historyPeriodChange"><view class="payment-picker {{!period.time ? 'placeholder' : ''}}">{{period.time || '选择时间'}}<text>⌄</text></view></picker></view></view>
        </view>
      </view>
      <view wx:if="{{historyForm.isBundle || historyForm.bundleProductName}}"><view class="payment-label">实际售出套数（必填）</view><input disabled="{{busy}}" type="number" placeholder="按订单核实套数，不按子件数量推算" value="{{historyForm.saleUnits}}" data-field="saleUnits" bindinput="historyInput" /><view class="muted" wx:if="{{historyForm.bundleMemberIds}}">已关联同订单套装明细：{{historyForm.memberIds}}</view><view wx:else><view class="payment-label">完整套装子件明细</view><textarea disabled="{{busy}}" class="compact-textarea" placeholder="按订单详情核实完整子件编号，用逗号分隔" value="{{historyForm.memberIds}}" data-field="memberIds" bindinput="historyInput" /></view><button class="text-button" bindtap="openOrder" data-id="{{historyForm.orderId}}">查看完整订单核对套装 ›</button></view>
      <view class="payment-label">{{historyForm.eligible ? '核对依据（必填）' : '不计佣原因（必填）'}}</view><textarea disabled="{{busy}}" class="compact-textarea" placeholder="填写历史佣金约定及任职凭证说明" value="{{historyForm.reason}}" data-field="reason" bindinput="historyInput" />
      <view class="muted">确认这里只登记应付佣金，不代表已经向负责人付款。</view>
      <view class="assignment-actions"><button disabled="{{busy}}" bindtap="closeHistory">取消</button><button class="primary" disabled="{{busy}}" bindtap="confirmHistory">{{busy ? '保存中...' : '确认核对'}}</button></view>
    </scroll-view>
  </view>

  <view class="assignment-overlay" wx:if="{{reverseForm}}" catchtap="closeReverseSettlement" catchtouchmove="noop"><view class="assignment-dialog" catchtap="noop"><view class="title">冲正错误付款登记</view><view class="muted">原登记 ¥{{reverseForm.amountLabel}} · {{reverseForm.paidTimeLabel}}。冲正会撤销本次付款分配，原付款凭证和冲正原因继续保留。</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="payment-label">冲正原因（必填）</view><textarea class="compact-textarea" disabled="{{busy}}" placeholder="说明重复登记、金额填错等实际原因" value="{{reverseForm.reason}}" bindinput="reverseReasonInput" /><view class="assignment-actions"><button disabled="{{busy}}" bindtap="closeReverseSettlement">取消</button><button class="primary" disabled="{{busy}}" bindtap="reverseSettlement">确认冲正</button></view></view></view>

  <view class="overlay" wx:if="{{reconciliation}}">
    <scroll-view class="modal" scroll-y>
      <view class="title">{{reconciliationKind === 'PROFIT_SHARING' ? '原交易分账接收结果核验' : '历史商家转账原单账单核验'}}</view>
      <view class="error" wx:if="{{error}}">{{error}}</view>
      <view class="muted">本地商户单号 {{reconciliation.outOrderNo || reconciliation.merchantBillNo}}</view>
      <view class="muted">本地收款OpenID {{reconciliation.openId}}</view>
      <view>金额 ¥{{reconciliation.amount}} · {{reconciliation.statusLabel}}</view>
      <radio-group bindchange="reconciliationState">
        <label class="choice">
<radio value="SUCCESS" checked="{{reconciliationStatus === 'SUCCESS'}}" />账单确认已付款</label>
        <label class="choice">
<radio value="{{reconciliationKind === 'PROFIT_SHARING' ? 'CLOSED' : 'CANCELLED'}}" checked="{{reconciliationStatus === 'CANCELLED' || reconciliationStatus === 'CLOSED'}}" />账单确认未付款</label>
      </radio-group>
      <view class="muted" wx:if="{{reconciliationKind === 'PROFIT_SHARING'}}">原支付交易 {{reconciliation.transactionId}}；须核验指定接收人结果。超时、404、顶层FINISHED不证明该接收人未收款。</view>
      <input wx:if="{{reconciliationKind === 'PROFIT_SHARING'}}" placeholder="根据账单填写原支付交易号" value="{{verifiedTransactionId}}" data-field="verifiedTransactionId" bindinput="input" />
      <input placeholder="根据账单填写商户单号" value="{{verifiedMerchantBillNo}}" data-field="verifiedMerchantBillNo" bindinput="input" />
      <input placeholder="根据账单填写收款OpenID" value="{{verifiedOpenId}}" data-field="verifiedOpenId" bindinput="input" />
      <input type="digit" placeholder="根据账单填写金额" value="{{verifiedAmount}}" data-field="verifiedAmount" bindinput="input" />
      <textarea placeholder="微信商户账单凭证及核验依据（必填）" value="{{proof}}" data-field="proof" bindinput="input" />
      <textarea placeholder="人工核验原因（必填）" value="{{reconciliationReason}}" data-field="reconciliationReason" bindinput="input" />
      <button class="primary" disabled="{{busy}}" bindtap="reconcileWithdrawal">登记核验终态</button>
      <button bindtap="closeReconciliation">关闭</button>
    </scroll-view>
  </view>
</view>
