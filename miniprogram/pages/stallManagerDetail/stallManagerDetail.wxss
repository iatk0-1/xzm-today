.history-switch { justify-content:space-between; margin:20rpx 0; }
.period-label { display:flex; align-items:center; justify-content:space-between; margin:20rpx 0 10rpx; font-size:25rpx; }
.money-summary { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; padding:18rpx 0; border-top:1rpx solid #edf0f2; border-bottom:1rpx solid #edf0f2; }
