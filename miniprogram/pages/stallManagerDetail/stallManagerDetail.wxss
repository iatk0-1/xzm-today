page { background:#f5f6f8; color:#222; } .page { padding:24rpx; } .card { background:#fff; border-radius:18rpx; padding:24rpx; margin-bottom:20rpx; } .title { font-size:34rpx; font-weight:600; margin-bottom:16rpx; } .muted { color:#747a83; font-size:25rpx; line-height:1.7; } .error { padding:20rpx; background:#fff0ee; color:#ac2d24; margin-bottom:18rpx; white-space:pre-wrap; } .tabs { white-space:nowrap; margin-bottom:20rpx; } .tab { display:inline-block; padding:16rpx 22rpx; background:#fff; border-radius:12rpx; margin-right:12rpx; } .active { background:#173e33; color:#fff; } .row { display:flex; gap:12rpx; align-items:center; flex-wrap:wrap; } .choice { display:block; padding:16rpx 0; border-bottom:1rpx solid #eee; } input,textarea { background:#f5f6f8; border-radius:10rpx; padding:18rpx; margin:14rpx 0; box-sizing:border-box; width:100%; } textarea { min-height:110rpx; } button { margin:12rpx 0; font-size:28rpx; } .primary { background:#173e33; color:#fff; } .amount { color:#173e33; font-size:38rpx; margin-bottom:10rpx; } .grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; } .label { font-size:25rpx; color:#606873; } .metric { font-size:33rpx; } .overlay { position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:30; padding:35rpx 22rpx; box-sizing:border-box; } .modal { background:#fff; border-radius:18rpx; height:90vh; padding:25rpx; box-sizing:border-box; } .badge { font-size:24rpx; color:#747a83; }
.profile-heading, .section-heading, .stall-heading { display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.profile-name { flex:1; min-width:0; margin-bottom:0; overflow-wrap:anywhere; }
.profile-heading { margin-bottom:16rpx; }
.active-control { display:flex; align-items:center; gap:10rpx; flex-shrink:0; color:#606873; font-size:25rpx; }
.section-heading .title { margin-bottom:0; }
.assign-add { width:64rpx; height:64rpx; margin:0; padding:0; line-height:60rpx; font-size:42rpx; background:#edf4f1; color:#173e33; border-radius:50%; flex-shrink:0; }
.assign-add::after, .assignment-remove::after { border:0; }
.assignment-hint { margin:12rpx 0 20rpx; }
.assignment-empty { padding:35rpx 0; text-align:center; color:#8b929b; font-size:25rpx; }
.assigned-stall { padding:22rpx; margin-bottom:16rpx; background:#f8fafb; border:1rpx solid #e9edf0; border-radius:12rpx; }
.stall-name { flex:1; min-width:0; font-size:29rpx; font-weight:600; overflow-wrap:anywhere; }
.assignment-remove { margin:0; padding:0 18rpx; line-height:54rpx; color:#b9433b; background:#faeae7; font-size:24rpx; flex-shrink:0; }
.stall-meta { display:flex; justify-content:space-between; gap:10rpx; color:#747a83; font-size:24rpx; margin-top:12rpx; }
.stall-enter { color:#486780; white-space:nowrap; }
.stall-previews { display:flex; gap:14rpx; margin-top:18rpx; }
.stall-preview { width:calc((100% - 42rpx) / 4); min-width:0; }
.preview-image { width:100%; height:110rpx; border-radius:8rpx; background:#edf0f2; }
.preview-name { font-size:22rpx; color:#606873; margin-top:6rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.assignment-overlay { position:fixed; inset:0; z-index:60; display:flex; align-items:center; justify-content:center; padding:30rpx; background:rgba(0,0,0,.45); box-sizing:border-box; }
.assignment-dialog { width:100%; padding:28rpx; border-radius:18rpx; background:#fff; box-sizing:border-box; }
.assignment-options { height:48vh; margin-top:18rpx; }
.assignment-actions { display:flex; gap:18rpx; margin-top:18rpx; }
.assignment-actions button { flex:1; }
.receiver-summary { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding-top:22rpx; margin-top:22rpx; border-top:1rpx solid #edf0f2; }
.receiver-title { flex-shrink:0; font-size:29rpx; font-weight:600; }
.receiver-action { min-width:0; margin:0; padding:12rpx 0 12rpx 12rpx; background:transparent; color:#747a83; font-size:25rpx; line-height:1.6; text-align:right; overflow-wrap:anywhere; }
.receiver-action::after { border:0; }
.receiver-action.registered { color:#173e33; }
.receiver-arrow { margin-left:12rpx; color:#929ba4; }
.receiver-dialog { max-height:85vh; }
.receiver-fields { margin-top:12rpx; }
.receiver-picker { display:flex; align-items:center; justify-content:space-between; padding:20rpx 0; margin-top:8rpx; border-bottom:1rpx solid #eee; font-size:27rpx; }
.receiver-picker text { color:#929ba4; margin-left:12rpx; }
.receiver-reason { height:150rpx; min-height:150rpx; font-size:26rpx; }
.receiver-verification { font-size:25rpx; }
.commission-search, .commission-batch { display:flex; align-items:center; gap:14rpx; }
.commission-search input, .commission-batch input { flex:1; min-width:0; width:auto; margin:0; height:72rpx; font-size:25rpx; }
.commission-search button, .commission-batch button { flex-shrink:0; margin:0; padding:0 22rpx; line-height:72rpx; font-size:25rpx; }
.commission-filters { display:grid; grid-template-columns:1fr 1fr; gap:12rpx; margin-top:18rpx; }
.commission-filters picker { min-width:0; }
.commission-filter { display:flex; align-items:center; justify-content:space-between; gap:10rpx; padding:16rpx; color:#606873; background:#f5f6f8; border-radius:8rpx; font-size:24rpx; }
.commission-filter text { flex-shrink:0; color:#929ba4; }
.commission-selection { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin:14rpx 0; font-size:24rpx; color:#747a83; }
.commission-selection button { margin:0; padding:8rpx 18rpx; background:transparent; color:#173e33; font-size:25rpx; line-height:1.6; }
.commission-selection button::after, .commission-amount::after { border:0; }
.commission-product { padding:20rpx; }
.commission-product-main { display:flex; align-items:center; gap:14rpx; width:100%; }
.commission-product-main checkbox { flex-shrink:0; }
.commission-cover { flex-shrink:0; width:108rpx; height:108rpx; border-radius:8rpx; background:#edf0f2; }
.commission-product-info { flex:1; min-width:0; }
.commission-product-name { font-size:29rpx; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.commission-stall { margin-top:8rpx; color:#747a83; font-size:23rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.commission-statuses { display:flex; gap:10rpx; margin-top:10rpx; }
.commission-status { padding:3rpx 10rpx; border-radius:5rpx; font-size:21rpx; }
.commission-status.on { color:#246447; background:#e8f4ed; }
.commission-status.off { color:#747a83; background:#eef1f4; }
.commission-status.sold-out { color:#b54728; background:#fff1e8; }
.commission-product-bottom { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding-top:12rpx; margin-top:16rpx; border-top:1rpx solid #edf0f2; color:#747a83; font-size:24rpx; }
.commission-amount { margin:0; padding:8rpx 0 8rpx 12rpx; color:#173e33; background:transparent; font-size:27rpx; line-height:1.6; }
.commission-edit-label { margin-left:16rpx; font-size:23rpx; color:#486780; }
.commission-edit-name { font-size:28rpx; margin-bottom:18rpx; overflow-wrap:anywhere; }
