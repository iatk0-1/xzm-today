.commission-status { padding:3rpx 10rpx; border-radius:5rpx; font-size:21rpx; }
.commission-status.on { color:#246447; background:#e8f4ed; }
.commission-status.off { color:#747a83; background:#eef1f4; }
.commission-status.sold-out { color:#b54728; background:#fff1e8; }
.commission-product-bottom { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding-top:12rpx; margin-top:16rpx; border-top:1rpx solid #edf0f2; color:#747a83; font-size:24rpx; }
.commission-amount { margin:0; padding:8rpx 0 8rpx 12rpx; color:#1f2933; background:transparent; font-size:27rpx; line-height:1.6; }
.commission-edit-label { margin-left:16rpx; font-size:23rpx; color:#486780; }
.commission-edit-name { font-size:28rpx; margin-bottom:18rpx; overflow-wrap:anywhere; }
/* 单行输入框需要明确高度和横向内边距，避免默认高度被上下内边距挤掉。 */
input { height:80rpx; min-height:72rpx; padding:0 18rpx; font-size:27rpx; flex-shrink:0; }
textarea { font-size:27rpx; }
.record-toolbar { display:flex; align-items:center; gap:14rpx; }
.record-toolbar picker { flex:1; min-width:0; }
.record-toolbar button { margin:0; padding:0 18rpx; line-height:80rpx; font-size:24rpx; background:#f2f4f6; color:#1f2933; flex-shrink:0; }
.record-hint { margin-top:16rpx; }
.payment-label { margin:24rpx 0 12rpx; font-size:26rpx; font-weight:500; }
.payment-time-row { display:flex; gap:14rpx; }
.payment-time-row picker { flex:1; min-width:0; }
.payment-picker { display:flex; align-items:center; justify-content:space-between; gap:10rpx; min-height:80rpx; padding:16rpx 18rpx; box-sizing:border-box; border-radius:10rpx; background:#f5f6f8; font-size:26rpx; }
.payment-picker text { flex-shrink:0; color:#929ba4; }
.payment-picker.placeholder { color:#929ba4; }
.payment-voucher { height:150rpx; min-height:150rpx; margin:0; }
.payment-note-toggle { padding:20rpx 0; color:#486780; font-size:25rpx; }

/* 与商品、订单管理页统一的卡片、筛选和表单视觉。 */
page { background:#f4f6f8; color:#1f2933; font-size:28rpx; }
.page { padding:20rpx; padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); }
.card { background:#fff; border-radius:12rpx; padding:24rpx; margin-bottom:18rpx; }
.title { font-size:30rpx; font-weight:600; line-height:1.5; }
.profile-name { font-size:34rpx; }
button { min-height:72rpx; line-height:72rpx; border-radius:8rpx; font-size:26rpx; padding:0 20rpx; background:#f2f4f6; color:#1f2933; }
button::after { border:none; }
button.primary { background:#1f2933; color:#fff; }
button[disabled] { opacity:.5; }
.tabs { white-space:nowrap; background:#fff; border-radius:12rpx; padding:8rpx 0; margin-bottom:18rpx; }
.tab { display:inline-block; background:transparent; color:#747a83; border-radius:0; padding:20rpx 22rpx; margin:0; font-size:27rpx; }
.tab.active { color:#1f2933; font-weight:600; border-bottom:4rpx solid #1f2933; }
input { height:80rpx; min-height:80rpx; padding:0 20rpx; font-size:27rpx; border-radius:8rpx; background:#f5f5f5; }
textarea { padding:20rpx; line-height:1.6; border-radius:8rpx; background:#f5f5f5; }
.compact-textarea { height:150rpx; min-height:150rpx; width:100%; }
.payment-picker, .commission-filter { background:#f5f5f5; border-radius:8rpx; }
.commission-filter { min-height:72rpx; box-sizing:border-box; }
.assignment-dialog { max-height:85vh; border-radius:16rpx; }
.overlay { position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:60; box-sizing:border-box; display:flex; justify-content:center; align-items:center; padding:30rpx; }
.modal { background:#fff; width:100%; box-sizing:border-box; height:82vh; border-radius:16rpx; padding:28rpx; }
.amount { color:#1f2933; font-size:38rpx; margin:0; font-weight:600; }
.grid { display:grid; grid-template-columns:1fr 1fr; gap:22rpx 18rpx; margin-bottom:20rpx; }
.metric { font-weight:600; margin-top:6rpx; }
.history-filter { margin-top:20rpx; }
.order-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding-bottom:18rpx; border-bottom:1rpx solid #edf0f2; font-size:26rpx; }
