.assignment-actions button { flex:1; }
.receiver-summary { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding-top:22rpx; margin-top:22rpx; border-top:1rpx solid #edf0f2; }
.receiver-title { flex-shrink:0; font-size:29rpx; font-weight:600; }
.receiver-action { min-width:0; margin:0; padding:12rpx 0 12rpx 12rpx; background:transparent; color:#747a83; font-size:25rpx; line-height:1.6; text-align:right; overflow-wrap:anywhere; }
.receiver-action::after { border:0; }
