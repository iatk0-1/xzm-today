.muted { color:#747a83; font-size:25rpx; line-height:1.7; }
.error { padding:20rpx; background:#fff0ee; color:#ac2d24; margin-bottom:18rpx; white-space:pre-wrap; font-size:25rpx; border-radius:8rpx; }
.row { display:flex; gap:12rpx; align-items:center; flex-wrap:wrap; }
.choice { display:block; padding:16rpx 0; border-bottom:1rpx solid #eee; }
input,textarea { margin:14rpx 0; box-sizing:border-box; width:100%; flex-shrink:0; }
textarea { min-height:110rpx; font-size:27rpx; }
.label { font-size:25rpx; color:#606873; }
.metric { font-size:33rpx; }
.badge { font-size:24rpx; color:#747a83; }
.profile-heading, .section-heading, .stall-heading { display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.profile-name { flex:1; min-width:0; margin-bottom:0; overflow-wrap:anywhere; }
.profile-heading { margin-bottom:16rpx; }
.active-control { display:flex; align-items:center; gap:10rpx; flex-shrink:0; color:#606873; font-size:25rpx; }
