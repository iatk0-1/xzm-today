page {
  background-color: #f0f0f0;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.recycle-bin-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 25rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
}

.input-placeholder {
  color: #999;
}

.clear-icon {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx;
}

.search-btn {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
  gap: 20rpx;
}

.filter-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.filter-item.active {
  background-color: #e6f7ff;
  color: #1890ff;
}

.filter-item .filter-value {
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 商品列表 */
.product-scroll {
  flex: 1;
  padding: 0 20rpx 20rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-subtext {
  font-size: 24rpx;
  color: #ccc;
}

/* 加载状态 */
.loading-state {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

/* 商品卡片 */
.product-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.card-main {
  display: flex;
  margin-bottom: 24rpx;
}

.product-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  margin-right: 20rpx;
  flex-shrink: 0;
  opacity: 0.7;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #666;
}

.deleted-time {
  font-size: 22rpx;
  color: #999;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx dashed #eee;
  padding-top: 24rpx;
}

.sku-count {
  font-size: 22rpx;
  color: #999;
}

.btn-restore {
  padding: 0 32rpx;
  height: 56rpx;
  line-height: 54rpx;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  border-radius: 28rpx;
  font-weight: 500;
}

/* 加载更多 */
.load-more {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

/* 筛选面板（与首页保持一致） */
.stall-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.stall-mask.fade-in {
  opacity: 1;
}

.stall-panel {
  position: fixed;
  left: 0;
  right: 0;
  background-color: #fff;
  z-index: 101;
  padding: 24rpx 20rpx;
  max-height: 60vh;
  overflow-y: auto;
  transform: translateY(-100%);
  transition: transform 0.3s ease;
}

.stall-panel.slide-down {
  transform: translateY(0);
}

.stall-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stall-tag {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s ease;
}

.stall-tag.active {
  background-color: #1890ff;
  color: #fff;
}
